    paint.anti_alias = true

    var pb = PathBuilder.new_()
    defer pb.release()
    pb.move_to(50.0, 50.0)
    pb.line_to(50.0, 50.0)
    var path = pb.finish() else trap("finish")
    defer path.release()

    var stroke = Stroke()
    defer harness.release_stroke(&stroke)
    stroke.width = 20.0
