import harness
from harness import Test, TestCase
from raster import Paint, PathBuilder, Pixmap, PixmapPaint, Transform, Rect, Point, Color, ColorU8, Stroke, StrokeDash, LineCap, LineJoin, FillRule, BlendMode, SpreadMode, FilterQuality, GradientStop, LinearGradient, RadialGradient, SweepGradient, Pattern, Mask, MaskType, IntRect, ColorSpace, Shader

func round_caps_and_large_scale(t: Test*):
    var paint = Paint()
    defer paint.release()
    paint.set_color_rgba8(50, 127, 150, 200)
    paint.anti_alias = true

    var pb = PathBuilder.new_()
    defer pb.release()
    pb.move_to(60.0 / 16.0, 100.0 / 16.0)
    pb.line_to(140.0 / 16.0, 100.0 / 16.0)
    var path = pb.finish() else trap("finish")
    defer path.release()

    var stroke = Stroke()
    defer harness.release_stroke(&stroke)
    stroke.width = 6.0
    stroke.line_cap = LineCap.round

    let transform = Transform.from_scale(16.0, 16.0)

    var pixmap = Pixmap.new_(200, 200) else trap("pixmap")
    defer pixmap.release()
    pixmap.stroke_path(&path, &paint, &stroke, transform, none)

    harness.expect_png(t, &pixmap, "stroke/round-caps-and-large-scale.png")

func circle(t: Test*):
    var paint = Paint()
    defer paint.release()
    paint.set_color_rgba8(50, 127, 150, 200)
    paint.anti_alias = true

    var path = PathBuilder.from_circle(100.0, 100.0, 50.0) else trap("path")
    defer path.release()
    var stroke = Stroke()
    defer harness.release_stroke(&stroke)
    stroke.width = 2.0

    var pixmap = Pixmap.new_(200, 200) else trap("pixmap")
    defer pixmap.release()
    pixmap.stroke_path(&path, &paint, &stroke, Transform.identity(), none)

    harness.expect_png(t, &pixmap, "stroke/circle.png")

