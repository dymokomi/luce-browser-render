func round_cap_join(t: Test*):
    var paint = Paint()
    defer paint.release()
    paint.set_color_rgba8(50, 127, 150, 200)
    paint.anti_alias = true

    var pb = PathBuilder.new_()
    defer pb.release()
    pb.move_to(170.0, 30.0)
    pb.line_to(30.553378, 99.048418)
    pb.cubic_to(30.563658, 99.066835, 30.546308, 99.280724, 30.557592, 99.305282)
    var path = pb.finish() else trap("finish")
    defer path.release()

    var stroke = Stroke()
    defer harness.release_stroke(&stroke)
    stroke.width = 30.0
    stroke.line_cap = LineCap.round
    stroke.line_join = LineJoin.round

    var pixmap = Pixmap.new_(200, 200) else trap("pixmap")
    defer pixmap.release()
    pixmap.stroke_path(&path, &paint, &stroke, Transform.identity(), none)

    harness.expect_png(t, &pixmap, "stroke/round-cap-join.png")

pub let tests: TestCase[6] = [
    TestCase(name = "stroke::round_caps_and_large_scale", run = round_caps_and_large_scale),
    TestCase(name = "stroke::circle", run = circle),
    TestCase(name = "stroke::zero_len_subpath_butt_cap", run = zero_len_subpath_butt_cap),
    TestCase(name = "stroke::zero_len_subpath_round_cap", run = zero_len_subpath_round_cap),
    TestCase(name = "stroke::zero_len_subpath_square_cap", run = zero_len_subpath_square_cap),
    TestCase(name = "stroke::round_cap_join", run = round_cap_join),
]
