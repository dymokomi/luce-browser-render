import harness
from harness import Test, TestCase
from raster import Paint, PathBuilder, Pixmap, PixmapPaint, Transform, Rect, Point, Color, ColorU8, Stroke, StrokeDash, LineCap, LineJoin, FillRule, BlendMode, SpreadMode, FilterQuality, GradientStop, LinearGradient, RadialGradient, SweepGradient, Pattern, Mask, MaskType, IntRect, ColorSpace, Shader

func rect_(t: Test*):
    var clip_path = PathBuilder.from_rect((Rect.from_xywh(10.0, 10.0, 80.0, 80.0) else trap("unwrap")))
    defer clip_path.release()
    var mask = Mask.new_(100, 100) else trap("mask")
    defer mask.release()
    mask.fill_path(&clip_path, FillRule.winding, false, Transform.identity())

    var paint = Paint()
    defer paint.release()
    paint.set_color_rgba8(50, 127, 150, 200)
    paint.anti_alias = false

    var pixmap = Pixmap.new_(100, 100) else trap("pixmap")
    defer pixmap.release()
    let rect = (Rect.from_xywh(0.0, 0.0, 100.0, 100.0) else trap("unwrap"))
    pixmap.fill_rect(rect, &paint, Transform.identity(), (&mask))

    harness.expect_png(t, &pixmap, "mask/rect.png")

func rect_aa(t: Test*):
    var clip_path = PathBuilder.from_rect((Rect.from_xywh(10.5, 10.0, 80.0, 80.5) else trap("unwrap")))
    defer clip_path.release()
    var mask = Mask.new_(100, 100) else trap("mask")
    defer mask.release()
    mask.fill_path(&clip_path, FillRule.winding, true, Transform.identity())

    var paint = Paint()
    defer paint.release()
    paint.set_color_rgba8(50, 127, 150, 200)
    paint.anti_alias = false

    var pixmap = Pixmap.new_(100, 100) else trap("pixmap")
    defer pixmap.release()
    let rect = (Rect.from_xywh(0.0, 0.0, 100.0, 100.0) else trap("unwrap"))
    pixmap.fill_rect(rect, &paint, Transform.identity(), (&mask))

    harness.expect_png(t, &pixmap, "mask/rect-aa.png")

func rect_ts(t: Test*):
    var pixmap = Pixmap.new_(100, 100) else trap("pixmap")
    defer pixmap.release()

    var clip_path = PathBuilder.from_rect((Rect.from_xywh(10.0, 10.0, 80.0, 80.0) else trap("unwrap")))
    defer clip_path.release()
    if not clip_path.transform(Transform.from_row(1.0, -0.3, 0.0, 1.0, 0.0, 15.0)):
        trap("unwrap")

    var mask = Mask.new_(100, 100) else trap("mask")
    defer mask.release()
    mask.fill_path(&clip_path, FillRule.winding, false, Transform.identity())

    var paint = Paint()
    defer paint.release()
    paint.set_color_rgba8(50, 127, 150, 200)
    paint.anti_alias = false

    let rect = (Rect.from_xywh(0.0, 0.0, 100.0, 100.0) else trap("unwrap"))
    pixmap.fill_rect(rect, &paint, Transform.identity(), (&mask))

    harness.expect_png(t, &pixmap, "mask/rect-ts.png")

