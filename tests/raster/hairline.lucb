func chop_cubic_01(t: Test*):
    # This curve will invoke `path_geometry::chop_cubic_at_max_curvature` branch of `hair_cubic`.
    var result = draw_cubic([57.0, 13.0, 17.0, 15.0, 55.0, 97.0, 89.0, 62.0], true, 0.5, LineCap.butt)
    defer result.release()
    harness.expect_png(t, &result, "hairline/chop-cubic-01.png")

func clip_cubic_05_aa(t: Test*):
    var result = draw_cubic([-25.0, 80.0, 55.0, 25.0, 155.0, 75.0, 175.0, 20.0], true, 0.5, LineCap.butt)
    defer result.release()
    harness.expect_png(t, &result, "hairline/clip-cubic-05-aa.png")

func clip_cubic_00(t: Test*):
    var result = draw_cubic([-25.0, 80.0, 55.0, 25.0, 155.0, 75.0, 175.0, 20.0], false, 0.0, LineCap.butt)
    defer result.release()
    harness.expect_png(t, &result, "hairline/clip-cubic-00.png")

func clipped_circle_aa(t: Test*):
    var pixmap = Pixmap.new_(100, 100) else trap("pixmap")
    defer pixmap.release()

    var paint = Paint()
    defer paint.release()
    paint.set_color_rgba8(50, 127, 150, 200)
    paint.anti_alias = true

    var stroke = Stroke()
    defer harness.release_stroke(&stroke)
    stroke.width = 0.5

    var path = PathBuilder.from_circle(50.0, 50.0, 55.0) else trap("path")
    defer path.release()
    pixmap.stroke_path(&path, &paint, &stroke, Transform.identity(), none)

    harness.expect_png(t, &pixmap, "hairline/clipped-circle-aa.png")

