import harness
from harness import Test, TestCase
from raster import Paint, PathBuilder, Pixmap, PixmapPaint, Transform, Rect, Point, Color, ColorU8, Stroke, StrokeDash, LineCap, LineJoin, FillRule, BlendMode, SpreadMode, FilterQuality, GradientStop, LinearGradient, RadialGradient, SweepGradient, Pattern, Mask, MaskType, IntRect, ColorSpace, Shader

func draw_line(x0: f32, y0: f32, x1: f32, y1: f32, anti_alias: bool, width: f32, line_cap: LineCap) -> Pixmap:
    var pixmap = Pixmap.new_(100, 100) else trap("pixmap")

    var pb = PathBuilder.new_()
    defer pb.release()
    pb.move_to(x0, y0)
    pb.line_to(x1, y1)
    var path = pb.finish() else trap("finish")
    defer path.release()

    var paint = Paint()
    defer paint.release()
    paint.set_color_rgba8(50, 127, 150, 200)
    paint.anti_alias = anti_alias

    var stroke = Stroke()
    defer harness.release_stroke(&stroke)
    stroke.width = width
    stroke.line_cap = line_cap
    pixmap.stroke_path(&path, &paint, &stroke, Transform.identity(), none)

    return pixmap

func hline_05(t: Test*):
    var result = draw_line(10.0, 10.0, 90.0, 10.0, false, 0.5, LineCap.butt)
    defer result.release()
    harness.expect_png(t, &result, "hairline/hline-05.png")

func hline_05_aa(t: Test*):
    var result = draw_line(10.0, 10.0, 90.0, 10.0, true, 0.5, LineCap.butt)
    defer result.release()
    harness.expect_png(t, &result, "hairline/hline-05-aa.png")

func hline_05_aa_round(t: Test*):
    var result = draw_line(10.0, 10.0, 90.0, 10.0, true, 0.5, LineCap.round)
    defer result.release()
    harness.expect_png(t, &result, "hairline/hline-05-aa-round.png")

func vline_05(t: Test*):
    var result = draw_line(10.0, 10.0, 10.0, 90.0, false, 0.5, LineCap.butt)
    defer result.release()
    harness.expect_png(t, &result, "hairline/vline-05.png")

