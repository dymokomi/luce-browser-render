func clip_line_05_aa(t: Test*):
    var result = draw_line(-10.0, 10.0, 110.0, 70.0, true, 0.5, LineCap.butt)
    defer result.release()
    harness.expect_png(t, &result, "hairline/clip-line-05-aa.png")

func clip_line_00(t: Test*):
    var result = draw_line(-10.0, 10.0, 110.0, 70.0, false, 0.0, LineCap.butt)
    defer result.release()
    harness.expect_png(t, &result, "hairline/clip-line-00.png")

func clip_line_00_v2(t: Test*):
    var pixmap = Pixmap.new_(512, 512) else trap("pixmap")
    defer pixmap.release()

    var paint = Paint()
    defer paint.release()
    paint.set_color_rgba8(50, 127, 150, 200)
    paint.anti_alias = false

    var stroke = Stroke()
    defer harness.release_stroke(&stroke)
    stroke.width = 0.0

    var builder = PathBuilder.new_()
    defer builder.release()
    builder.move_to(369.26462, 577.8069)
    builder.line_to(488.0846, 471.04388)
    var path = builder.finish() else trap("finish")
    defer path.release()
    pixmap.stroke_path(&path, &paint, &stroke, Transform.identity(), none)

    harness.expect_png(t, &pixmap, "hairline/clip-line-00-v2.png")

