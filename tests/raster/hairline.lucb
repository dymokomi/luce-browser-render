    harness.expect_png(t, &result, "hairline/clip-vline-right-aa.png")

func draw_quad(anti_alias: bool, width: f32, line_cap: LineCap) -> Pixmap:
    var pixmap = Pixmap.new_(200, 100) else trap("pixmap")

    var pb = PathBuilder.new_()
    defer pb.release()
    pb.move_to(25.0, 80.0)
    pb.quad_to(155.0, 75.0, 175.0, 20.0)
    var path = pb.finish() else trap("finish")
    defer path.release()

    var paint = Paint()
    defer paint.release()
    paint.set_color_rgba8(50, 127, 150, 200)
    paint.anti_alias = anti_alias

    var stroke = Stroke()
    defer harness.release_stroke(&stroke)
    stroke.width = width
    stroke.line_cap = line_cap
    pixmap.stroke_path(&path, &paint, &stroke, Transform.identity(), none)

    return pixmap

func quad_width_05_aa(t: Test*):
    var result = draw_quad(true, 0.5, LineCap.butt)
    defer result.release()
    harness.expect_png(t, &result, "hairline/quad-width-05-aa.png")

func quad_width_05_aa_round(t: Test*):
    var result = draw_quad(true, 0.5, LineCap.round)
    defer result.release()
    harness.expect_png(t, &result, "hairline/quad-width-05-aa-round.png")

func quad_width_00(t: Test*):
    var result = draw_quad(false, 0.0, LineCap.butt)
    defer result.release()
    harness.expect_png(t, &result, "hairline/quad-width-00.png")

func draw_cubic(points: const f32[], anti_alias: bool, width: f32, line_cap: LineCap) -> Pixmap:
    var pixmap = Pixmap.new_(200, 100) else trap("pixmap")

    var pb = PathBuilder.new_()
    defer pb.release()
    pb.move_to(points[0], points[1])
    pb.cubic_to(points[2], points[3], points[4], points[5], points[6], points[7])
    var path = pb.finish() else trap("finish")
    defer path.release()

    var paint = Paint()
    defer paint.release()
    paint.set_color_rgba8(50, 127, 150, 200)
    paint.anti_alias = anti_alias

    var stroke = Stroke()
    defer harness.release_stroke(&stroke)
    stroke.width = width
    stroke.line_cap = line_cap
    pixmap.stroke_path(&path, &paint, &stroke, Transform.identity(), none)

    return pixmap

func cubic_width_10_aa(t: Test*):
    var result = draw_cubic([25.0, 80.0, 55.0, 25.0, 155.0, 75.0, 175.0, 20.0], true, 1.0, LineCap.butt)
    defer result.release()
    harness.expect_png(t, &result, "hairline/cubic-width-10-aa.png")

func cubic_width_05_aa(t: Test*):
    var result = draw_cubic([25.0, 80.0, 55.0, 25.0, 155.0, 75.0, 175.0, 20.0], true, 0.5, LineCap.butt)
    defer result.release()
    harness.expect_png(t, &result, "hairline/cubic-width-05-aa.png")

func cubic_width_00_aa(t: Test*):
