    TestCase(name = "hairline::cubic_width_00_round", run = cubic_width_00_round),
    TestCase(name = "hairline::chop_cubic_01", run = chop_cubic_01),
    TestCase(name = "hairline::clip_cubic_05_aa", run = clip_cubic_05_aa),
    TestCase(name = "hairline::clip_cubic_00", run = clip_cubic_00),
    TestCase(name = "hairline::clipped_circle_aa", run = clipped_circle_aa),
]
