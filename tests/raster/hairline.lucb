    TestCase(name = "hairline::hline_05", run = hline_05),
    TestCase(name = "hairline::hline_05_aa", run = hline_05_aa),
    TestCase(name = "hairline::hline_05_aa_round", run = hline_05_aa_round),
    TestCase(name = "hairline::vline_05", run = vline_05),
    TestCase(name = "hairline::vline_05_aa", run = vline_05_aa),
    TestCase(name = "hairline::vline_05_aa_round", run = vline_05_aa_round),
    TestCase(name = "hairline::horish_05_aa", run = horish_05_aa),
    TestCase(name = "hairline::vertish_05_aa", run = vertish_05_aa),
    TestCase(name = "hairline::clip_line_05_aa", run = clip_line_05_aa),
    TestCase(name = "hairline::clip_line_00", run = clip_line_00),
    TestCase(name = "hairline::clip_line_00_v2", run = clip_line_00_v2),
    TestCase(name = "hairline::clip_hline_top_aa", run = clip_hline_top_aa),
    TestCase(name = "hairline::clip_hline_bottom_aa", run = clip_hline_bottom_aa),
    TestCase(name = "hairline::clip_vline_left_aa", run = clip_vline_left_aa),
    TestCase(name = "hairline::clip_vline_right_aa", run = clip_vline_right_aa),
    TestCase(name = "hairline::quad_width_05_aa", run = quad_width_05_aa),
    TestCase(name = "hairline::quad_width_05_aa_round", run = quad_width_05_aa_round),
    TestCase(name = "hairline::quad_width_00", run = quad_width_00),
    TestCase(name = "hairline::cubic_width_10_aa", run = cubic_width_10_aa),
    TestCase(name = "hairline::cubic_width_05_aa", run = cubic_width_05_aa),
    TestCase(name = "hairline::cubic_width_00_aa", run = cubic_width_00_aa),
    TestCase(name = "hairline::cubic_width_00", run = cubic_width_00),
