    paint.set_color(rgba8(50, 127, 150, 200))
    blend_grid(t, &paint, true, "skia/pipeline/highp-blend-solid-aa.png")

func blend_gradient_highp(t: Test*):
    raster.set_force_highp_pipeline(true)
    defer raster.set_force_highp_pipeline(false)
    var paint = Paint()
    defer paint.release()
    paint.shader = linear(pt(0.0, 0.0), pt(132.0, 110.0), three_stops(), .repeat, Transform.identity())
    blend_grid(t, &paint, false, "skia/pipeline/highp-blend-gradient.png")

func linear_uneven_pad_highp(t: Test*):
    raster.set_force_highp_pipeline(true)
    defer raster.set_force_highp_pipeline(false)
    gradient_scene(t, linear(pt(0.0, 50.0), pt(120.0, 50.0), uneven_stops(), .pad_, Transform.identity()), false, "skia/pipeline/highp-linear-uneven-pad.png")

func radial_pad_highp(t: Test*):
    raster.set_force_highp_pipeline(true)
    defer raster.set_force_highp_pipeline(false)
    gradient_scene(t, radial(pt(60.0, 50.0), 0.0, pt(60.0, 50.0), 45.0, three_stops(), .pad_, Transform.identity()), false, "skia/pipeline/highp-radial-pad.png")

func sweep_full_highp(t: Test*):
    raster.set_force_highp_pipeline(true)
    defer raster.set_force_highp_pipeline(false)
    gradient_scene(t, sweep(pt(60.0, 50.0), 0.0, 360.0, three_stops(), .pad_, Transform.identity()), false, "skia/pipeline/highp-sweep-full.png")

func pattern_bilinear_pad_src_highp(t: Test*):
    raster.set_force_highp_pipeline(true)
    defer raster.set_force_highp_pipeline(false)
    pattern_scene(t, .pad_, .bilinear, .source, 1.0, rot(), "skia/pipeline/highp-pattern-bilinear-pad-src.png")

# mark: tiny-skia's patterns without anti-aliasing ============================================
# tiny-skia's pattern tests with the triangle filled without anti-aliasing.

func ts_pattern(t: Test*, mode: SpreadMode, quality: FilterQuality, ts: Transform, image: str):
    var tp = Paint()
    tp.set_color(rgba8(50, 127, 150, 200))
    tp.anti_alias = false
    var pb = PathBuilder.new_()
    defer pb.release()
    pb.move_to(0.0, 20.0)
    pb.line_to(20.0, 20.0)
    pb.line_to(10.0, 0.0)
    pb.close()
    var tri = pb.finish() else trap("finish")
    defer tri.release()
    var triangle = Pixmap.new_(20, 20) else trap("pixmap")
    defer triangle.release()
    triangle.fill_path(&tri, &tp, FillRule.winding, Transform.identity(), none)

    var paint = Paint()
    paint.anti_alias = false
    paint.shader = Pattern.new_(triangle.as_ref(), mode, quality, 1.0, ts)
    var path = PathBuilder.from_rect(Rect.from_ltrb(10.0, 10.0, 190.0, 190.0) else trap("rect"))
    defer path.release()
    var pixmap = Pixmap.new_(200, 200) else trap("pixmap")
    defer pixmap.release()
    pixmap.fill_path(&path, &paint, FillRule.winding, Transform.identity(), none)
    harness.expect_png(t, &pixmap, image)

func ts_pattern_pad_nearest(t: Test*):
    ts_pattern(t, .pad_, .nearest, Transform.identity(), "skia/rp-ts/pattern-pad-nearest.png")

func ts_pattern_repeat_nearest(t: Test*):
    ts_pattern(t, .repeat, .nearest, Transform.identity(), "skia/rp-ts/pattern-repeat-nearest.png")

func ts_pattern_reflect_nearest(t: Test*):
    ts_pattern(t, .reflect, .nearest, Transform.identity(), "skia/rp-ts/pattern-reflect-nearest.png")

func ts_pattern_pad_bicubic(t: Test*):
    ts_pattern(t, .pad_, .bicubic, Transform.from_row(1.1, 0.3, 0.0, 1.4, 0.0, 0.0), "skia/rp-ts/pattern-pad-bicubic.png")

func ts_pattern_repeat_bicubic(t: Test*):
    ts_pattern(t, .repeat, .bicubic, Transform.from_row(1.1, 0.3, 0.0, 1.4, 0.0, 0.0), "skia/rp-ts/pattern-repeat-bicubic.png")

func ts_pattern_reflect_bicubic(t: Test*):
    ts_pattern(t, .reflect, .bicubic, Transform.from_row(1.1, 0.3, 0.0, 1.4, 0.0, 0.0), "skia/rp-ts/pattern-reflect-bicubic.png")

func ts_pattern_filter_nearest(t: Test*):
    ts_pattern(t, .repeat, .nearest, Transform.from_row(1.5, 0.0, -0.4, -0.8, 5.0, 1.0), "skia/rp-ts/pattern-filter-nearest.png")

func ts_pattern_filter_bilinear(t: Test*):
