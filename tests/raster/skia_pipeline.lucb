func linear_many(t: Test*):
    gradient_scene(t, linear(pt(0.0, 0.0), pt(120.0, 30.0), many_stops(), .reflect, Transform.identity()), false, "skia/pipeline/linear-many.png")

func linear_opaque_rotated(t: Test*):
