func sweep_full(t: Test*):
    gradient_scene(t, sweep(pt(60.0, 50.0), 0.0, 360.0, three_stops(), .pad_, Transform.identity()), false, "skia/pipeline/sweep-full.png")

func sweep_partial(t: Test*):
    gradient_scene(t, sweep(pt(60.0, 50.0), 45.0, 270.0, uneven_stops(), .reflect, Transform.identity()), false, "skia/pipeline/sweep-partial.png")

