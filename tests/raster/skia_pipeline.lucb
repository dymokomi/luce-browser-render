func linear_two_pad(t: Test*):
    gradient_scene(t, linear(pt(10.0, 20.0), pt(100.0, 70.0), two_stops(), .pad_, Transform.identity()), false, "skia/pipeline/linear-two-pad.png")

func linear_two_pad_dither(t: Test*):
