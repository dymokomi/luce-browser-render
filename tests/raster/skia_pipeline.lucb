#==============================================================================================
#
#   skia_pipeline - the raster pipeline against Skia m144
#
#   DESCRIPTION:
#       Scenes of the raster pipeline (every blend mode, linear, radial, two-point conical
#       and sweep gradients with each tile mode, dither, premultiplied interpolation, and
#       image patterns sampled through the pipeline), each compared pixel for pixel with the
#       image Skia m144 renders for it (the oracle's scenes_rp.cpp, in the configuration
#       Ladybird paints with). Backgrounds and images are written directly into the pixels,
#       so only the pipeline is tested; shapes are non-AA pixel-aligned rects except in the
#       *_aa scenes, whose fractional rects test anti-aliased coverage.
#
#       Copyright (c) 2026 the luce-browser authors.
#       SPDX-License-Identifier: BSD-3-Clause (see LICENSE-skia)
#
#==============================================================================================

import harness
from harness import Test, TestCase
import raster
from raster import PathBuilder, FillRule, Paint, Pixmap, Transform, Rect, Point, Color, BlendMode, SpreadMode, FilterQuality, GradientStop, LinearGradient, RadialGradient, SweepGradient, Pattern, Shader

# mark: Helpers ===============================================================================

## A color from bytes divided by 255 (Color::from_rgba8).
func rgba8(r: u8, g: u8, b: u8, a: u8) -> Color:
    return Color.from_rgba8(r, g, b, a)

## The deterministic premultiplied background of every scene, written into the pixels.
func background(pixmap: Pixmap*):
    let alphas: u32[5] = [255, 0, 128, 200, 37]
    let w = pixmap.width()
    let data = pixmap.data_mut()
    for y in 0..<pixmap.height():
        for x in 0..<w:
            let a = alphas[(usize)((x // 3 + y // 5) % 5)]
            let r = (x * 7 + y * 3) & 255
            let g = (x * 2 + y * 5 + 40) & 255
            let b = (x * x + y * 11) & 255
            let i = (usize)((y * w + x) * 4)
            data[i] = (u8)(r * a // 255)
            data[i + 1] = (u8)(g * a // 255)
            data[i + 2] = (u8)(b * a // 255)
            data[i + 3] = (u8)a

## The deterministic premultiplied 24x20 pattern image with translucent pixels.
func pattern_image() -> Pixmap:
    var pixmap = Pixmap.new_(24, 20) else trap("pixmap")
    let data = pixmap.data_mut()
    for y: u32 in 0..<20:
        for x: u32 in 0..<24:
            var a: u32 = 255
            if (x + y) % 7 == 0:
                a = 90
            elif (x * 3 + y) % 11 == 0:
                a = 0
            let r = (x * 11) & 255
            let g = (y * 13) & 255
            let b = ((x ^ y) * 9) & 255
            let i = (usize)((y * 24 + x) * 4)
            data[i] = (u8)(r * a // 255)
            data[i + 1] = (u8)(g * a // 255)
            data[i + 2] = (u8)(b * a // 255)
            data[i + 3] = (u8)a
    return pixmap

let modes: BlendMode[29] = [
    .clear, .source, .destination, .source_over, .destination_over, .source_in, .destination_in, .source_out, .destination_out, .source_atop,
    .destination_atop, .xor, .plus, .modulate, .screen, .overlay, .darken, .lighten, .color_dodge, .color_burn,
    .hard_light, .soft_light, .difference, .exclusion, .multiply, .hue, .saturation, .color, .luminosity,
]

## Every blend mode in a 6x5 grid of 22x22 cells: `paint` (its blend mode replaced) fills an
## 18x18 rect in each, or a fractional one with anti-aliasing when `aa`.
func blend_grid(t: Test*, paint0: const Paint*, aa: bool, image: str):
    var pixmap = Pixmap.new_(132, 110) else trap("pixmap")
    defer pixmap.release()
    background(&pixmap)
    var paint = *paint0
    for i: u32 in 0..<29:
        let x = (f32)(i % 6) * 22.0
        let y = (f32)(i // 6) * 22.0
        paint.blend_mode = modes[(usize)i]
        paint.anti_alias = aa
        var rect = Rect.from_xywh(x + 2.0, y + 2.0, 18.0, 18.0) else trap("rect")
        if aa:
            rect = Rect.from_xywh(x + 2.3, y + 2.6, 16.4, 15.7) else trap("rect")
        pixmap.fill_rect(rect, &paint, Transform.identity(), none)
    harness.expect_png(t, &pixmap, image)

func two_stops() -> GradientStop[2]:
    return [GradientStop.new_(0.0, rgba8(50, 127, 150, 200)), GradientStop.new_(1.0, rgba8(220, 140, 75, 180))]

func three_stops() -> GradientStop[3]:
    return [GradientStop.new_(0.0, rgba8(50, 127, 150, 200)), GradientStop.new_(0.5, rgba8(220, 140, 75, 180)), GradientStop.new_(1.0, rgba8(40, 180, 55, 160))]

func uneven_stops() -> GradientStop[4]:
    return [GradientStop.new_(0.1, rgba8(50, 127, 150, 200)), GradientStop.new_(0.3, rgba8(220, 140, 75, 180)), GradientStop.new_(0.3, rgba8(10, 20, 250, 255)), GradientStop.new_(0.85, rgba8(40, 180, 55, 160))]

func opaque_stops() -> GradientStop[4]:
    return [GradientStop.new_(0.0, rgba8(250, 10, 10, 255)), GradientStop.new_(0.3, rgba8(10, 250, 10, 255)), GradientStop.new_(0.6, rgba8(10, 10, 250, 255)), GradientStop.new_(1.0, rgba8(200, 200, 30, 255))]

func many_stops() -> GradientStop[11]:
    var stops: GradientStop[11] = ---
    for i: u32 in 0..<11:
        let pos = (f32)(i * i) / 100.0
        stops[(usize)i] = GradientStop.new_(pos, rgba8((u8)((i * 50) & 255), (u8)((i * 90 + 30) & 255), (u8)((255 - i * 20) & 255), (u8)(120 + i * 13)))
    return stops

func linear(a: Point, b: Point, stops: const GradientStop[], mode: SpreadMode, ts: Transform) -> Shader:
    return LinearGradient.new_(a, b, stops, mode, ts) else trap("linear")

func radial(a: Point, ra: f32, b: Point, rb: f32, stops: const GradientStop[], mode: SpreadMode, ts: Transform) -> Shader:
    return RadialGradient.new_(a, ra, b, rb, stops, mode, ts) else trap("radial")

func sweep(c: Point, start: f32, end: f32, stops: const GradientStop[], mode: SpreadMode, ts: Transform) -> Shader:
    return SweepGradient.new_(c, start, end, stops, mode, ts) else trap("sweep")

func pt(x: f32, y: f32) -> Point:
    return Point.from_xy(x, y)

## A gradient filling a whole 120x100 pixmap (a non-AA rect) over the background. Takes
## ownership of `shader`.
func gradient_scene(t: Test*, shader: Shader, dither: bool, image: str):
    var pixmap = Pixmap.new_(120, 100) else trap("pixmap")
    defer pixmap.release()
    background(&pixmap)
    var paint = Paint()
    defer paint.release()
    paint.anti_alias = false
    paint.dither = dither
    paint.shader = shader
    pixmap.fill_rect(Rect.from_xywh(0.0, 0.0, 120.0, 100.0) else trap("rect"), &paint, Transform.identity(), none)
    harness.expect_png(t, &pixmap, image)

func premul(shader0: Shader) -> Shader:
    var shader = shader0
    shader.interpolate_in_premul()
    return shader

# mark: Blend modes ===========================================================================

func blend_solid(t: Test*):
    var paint = Paint()
    paint.set_color(rgba8(50, 127, 150, 200))
    blend_grid(t, &paint, false, "skia/pipeline/blend-solid.png")

func blend_solid_opaque(t: Test*):
    var paint = Paint()
    paint.set_color(rgba8(220, 140, 75, 255))
    blend_grid(t, &paint, false, "skia/pipeline/blend-solid-opaque.png")

func blend_solid_aa(t: Test*):
    var paint = Paint()
    paint.set_color(rgba8(50, 127, 150, 200))
    blend_grid(t, &paint, true, "skia/pipeline/blend-solid-aa.png")

func blend_gradient(t: Test*):
    var paint = Paint()
    defer paint.release()
    paint.shader = linear(pt(0.0, 0.0), pt(132.0, 110.0), three_stops(), .repeat, Transform.identity())
    blend_grid(t, &paint, false, "skia/pipeline/blend-gradient.png")

func blend_gradient_opaque(t: Test*):
    var paint = Paint()
    defer paint.release()
    paint.shader = linear(pt(0.0, 0.0), pt(40.0, 20.0), opaque_stops(), .reflect, Transform.identity())
    blend_grid(t, &paint, false, "skia/pipeline/blend-gradient-opaque.png")

func blend_gradient_aa(t: Test*):
    var paint = Paint()
    defer paint.release()
    paint.shader = linear(pt(0.0, 0.0), pt(132.0, 110.0), three_stops(), .repeat, Transform.identity())
    blend_grid(t, &paint, true, "skia/pipeline/blend-gradient-aa.png")

func blend_gradient_dither(t: Test*):
    var paint = Paint()
    defer paint.release()
    paint.dither = true
    paint.shader = linear(pt(0.0, 0.0), pt(132.0, 110.0), three_stops(), .repeat, Transform.identity())
    blend_grid(t, &paint, false, "skia/pipeline/blend-gradient-dither.png")

