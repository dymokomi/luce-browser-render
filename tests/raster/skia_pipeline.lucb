func linear_scaled(t: Test*):
    gradient_scene(t, linear(pt(0.0, 0.0), pt(10.0, 0.0), three_stops(), .reflect, Transform.from_row(3.0, 0.0, 0.0, 2.0, 7.5, 0.0)), false, "skia/pipeline/linear-scaled.png")

