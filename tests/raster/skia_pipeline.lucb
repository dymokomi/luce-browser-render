func radial_repeat_dither(t: Test*):
    gradient_scene(t, radial(pt(60.0, 50.0), 0.0, pt(60.0, 50.0), 17.0, uneven_stops(), .repeat, Transform.identity()), true, "skia/pipeline/radial-repeat-dither.png")

func radial_scaled(t: Test*):
    gradient_scene(t, radial(pt(20.0, 20.0), 0.0, pt(20.0, 20.0), 15.0, two_stops(), .reflect, Transform.from_row(1.5, 0.2, 0.0, 1.0, 10.0, 5.0)), false, "skia/pipeline/radial-scaled.png")

func conical_concentric(t: Test*):
    gradient_scene(t, radial(pt(60.0, 50.0), 10.0, pt(60.0, 50.0), 40.0, three_stops(), .repeat, Transform.identity()), false, "skia/pipeline/conical-concentric.png")

func conical_well_behaved(t: Test*):
    gradient_scene(t, radial(pt(50.0, 50.0), 0.0, pt(60.0, 50.0), 45.0, three_stops(), .pad_, Transform.identity()), false, "skia/pipeline/conical-well-behaved.png")

func conical_greater(t: Test*):
    gradient_scene(t, radial(pt(30.0, 40.0), 5.0, pt(80.0, 60.0), 20.0, three_stops(), .reflect, Transform.identity()), false, "skia/pipeline/conical-greater.png")

func conical_smaller(t: Test*):
    gradient_scene(t, radial(pt(30.0, 40.0), 30.0, pt(80.0, 60.0), 5.0, two_stops(), .pad_, Transform.identity()), true, "skia/pipeline/conical-smaller.png")

func conical_strip(t: Test*):
    gradient_scene(t, radial(pt(30.0, 50.0), 20.0, pt(90.0, 45.0), 20.0, uneven_stops(), .repeat, Transform.identity()), false, "skia/pipeline/conical-strip.png")

func conical_focal_on_circle(t: Test*):
