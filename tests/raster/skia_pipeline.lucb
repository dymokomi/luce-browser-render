func sweep_dither(t: Test*):
    gradient_scene(t, sweep(pt(50.0, 40.0), 0.0, 360.0, many_stops(), .pad_, Transform.from_row(1.0, 0.3, -0.3, 1.0, 0.0, 0.0)), true, "skia/pipeline/sweep-dither.png")

# mark: Patterns ==============================================================================

## The pattern image filling a 120x100 pixmap over the background.
func pattern_scene(t: Test*, mode: SpreadMode, quality: FilterQuality, blend: BlendMode, opacity: f32, ts: Transform, image: str):
    var img = pattern_image()
    defer img.release()
    var pixmap = Pixmap.new_(120, 100) else trap("pixmap")
    defer pixmap.release()
    background(&pixmap)
    var paint = Paint()
    paint.anti_alias = false
    paint.shader = Pattern.new_(img.as_ref(), mode, quality, opacity, ts)
    paint.blend_mode = blend
    pixmap.fill_rect(Rect.from_xywh(0.0, 0.0, 120.0, 100.0) else trap("rect"), &paint, Transform.identity(), none)
    harness.expect_png(t, &pixmap, image)

func rot() -> Transform:
    return Transform.from_row(2.2, 0.9, -0.7, 1.9, 20.0, 3.0)

func pattern_bicubic_pad(t: Test*):
    pattern_scene(t, .pad_, .bicubic, .source_over, 1.0, rot(), "skia/pipeline/pattern-bicubic-pad.png")

func pattern_bicubic_repeat(t: Test*):
    pattern_scene(t, .repeat, .bicubic, .source_over, 1.0, rot(), "skia/pipeline/pattern-bicubic-repeat.png")

func pattern_bicubic_reflect(t: Test*):
    pattern_scene(t, .reflect, .bicubic, .source_over, 1.0, rot(), "skia/pipeline/pattern-bicubic-reflect.png")

func pattern_bicubic_opacity(t: Test*):
    pattern_scene(t, .repeat, .bicubic, .source_over, 0.6, Transform.from_row(3.0, 0.0, 0.0, 2.5, 1.0, 2.0), "skia/pipeline/pattern-bicubic-opacity.png")

func pattern_bilinear_pad_src(t: Test*):
    pattern_scene(t, .pad_, .bilinear, .source, 1.0, rot(), "skia/pipeline/pattern-bilinear-pad-src.png")

func pattern_bilinear_repeat_multiply(t: Test*):
    pattern_scene(t, .repeat, .bilinear, .multiply, 1.0, rot(), "skia/pipeline/pattern-bilinear-repeat-multiply.png")

func pattern_bilinear_reflect_screen(t: Test*):
    pattern_scene(t, .reflect, .bilinear, .screen, 0.7, rot(), "skia/pipeline/pattern-bilinear-reflect-screen.png")

func pattern_nearest_repeat_src(t: Test*):
    pattern_scene(t, .repeat, .nearest, .source, 1.0, rot(), "skia/pipeline/pattern-nearest-repeat-src.png")

func pattern_nearest_reflect_xor(t: Test*):
    pattern_scene(t, .reflect, .nearest, .xor, 1.0, Transform.from_row(2.0, 0.0, 0.0, 2.0, 3.0, 1.0), "skia/pipeline/pattern-nearest-reflect-xor.png")

func pattern_nearest_pad_darken(t: Test*):
    pattern_scene(t, .pad_, .nearest, .darken, 1.0, Transform.from_row(-1.5, 0.0, 0.0, 1.5, 80.0, 10.0), "skia/pipeline/pattern-nearest-pad-darken.png")

# mark: Forced high precision =================================================================
# Skia's gForceHighPrecisionRasterPipeline: every pipeline in high precision.

func blend_solid_highp(t: Test*):
    raster.set_force_highp_pipeline(true)
    defer raster.set_force_highp_pipeline(false)
    var paint = Paint()
    paint.set_color(rgba8(50, 127, 150, 200))
    blend_grid(t, &paint, false, "skia/pipeline/highp-blend-solid.png")

func blend_solid_aa_highp(t: Test*):
