# Gradient doesn't add the Premultiply stage when all stops are opaque.
# But it checks colors only on creation, so we have to recheck them after calling `apply_opacity`.
func global_opacity(t: Test*):
    var paint = Paint()
    defer paint.release()
    paint.anti_alias = false
    paint.shader = (RadialGradient.new_( Point.from_xy(100.0, 100.0), 0.0, Point.from_xy(100.0, 100.0), 100.0, [ GradientStop.new_(0.25, Color.from_rgba8(50, 127, 150, 255)), GradientStop.new_(1.00, Color.from_rgba8(220, 140, 75, 255)), ], SpreadMode.pad_, Transform.identity(), ) else trap("unwrap"))
    paint.shader.apply_opacity(0.5)

    var path = PathBuilder.from_rect((Rect.from_ltrb(10.0, 10.0, 190.0, 190.0) else trap("unwrap")))
    defer path.release()

    var pixmap = Pixmap.new_(200, 200) else trap("pixmap")
    defer pixmap.release()
    pixmap.fill_path(&path, &paint, FillRule.winding, Transform.identity(), none)

    harness.expect_png(t, &pixmap, "gradients/global-opacity.png")

func strip_gradient(t: Test*):
    # Equal radii, different centers creates a Strip gradient
    var paint = Paint()
    defer paint.release()
    paint.anti_alias = false
    paint.shader = (RadialGradient.new_( Point.from_xy(50.0, 100.0), 50.0, Point.from_xy(150.0, 100.0), 50.0, [ GradientStop.new_(0.0, Color.from_rgba8(50, 127, 150, 200)), GradientStop.new_(1.0, Color.from_rgba8(220, 140, 75, 180)), ], SpreadMode.pad_, Transform.identity(), ) else trap("unwrap"))

    var path = PathBuilder.from_rect((Rect.from_ltrb(10.0, 10.0, 190.0, 190.0) else trap("unwrap")))
    defer path.release()

    var pixmap = Pixmap.new_(200, 200) else trap("pixmap")
    defer pixmap.release()
    pixmap.fill_path(&path, &paint, FillRule.winding, Transform.identity(), none)

    harness.expect_png(t, &pixmap, "gradients/strip-gradient.png")

func concentric_radial(t: Test*):
    # Same center, non-zero start radius (concentric gradient)
    var paint = Paint()
    defer paint.release()
    paint.anti_alias = false
    paint.shader = (RadialGradient.new_( Point.from_xy(100.0, 100.0), 30.0, Point.from_xy(100.0, 100.0), 90.0, [ GradientStop.new_(0.0, Color.from_rgba8(50, 127, 150, 200)), GradientStop.new_(1.0, Color.from_rgba8(220, 140, 75, 180)), ], SpreadMode.pad_, Transform.identity(), ) else trap("unwrap"))

    var path = PathBuilder.from_rect((Rect.from_ltrb(10.0, 10.0, 190.0, 190.0) else trap("unwrap")))
    defer path.release()

    var pixmap = Pixmap.new_(200, 200) else trap("pixmap")
    defer pixmap.release()
    pixmap.fill_path(&path, &paint, FillRule.winding, Transform.identity(), none)

    harness.expect_png(t, &pixmap, "gradients/concentric-radial.png")

func conical_smaller_radial(t: Test*):
    # Configuration that triggers XYTo2PtConicalSmaller stage
    # r0=60, r1=30, distance=50
    # r0_norm=1.2, r1_norm=0.6, focal_x = 1.2/0.6 = 2.0 > 1.0
    # self.r1 = 0.6 / |1.0 - 2.0| = 0.6, so is_well_behaved() = false
    # (1.0 - focal_x) < 0.0 is true, triggering XYTo2PtConicalSmaller
    var paint = Paint()
    defer paint.release()
    paint.anti_alias = false
    paint.shader = (RadialGradient.new_( Point.from_xy(100.0, 100.0), 60.0, Point.from_xy(150.0, 100.0), 30.0, [ GradientStop.new_(0.0, Color.from_rgba8(50, 127, 150, 200)), GradientStop.new_(1.0, Color.from_rgba8(220, 140, 75, 180)), ], SpreadMode.pad_, Transform.identity(), ) else trap("unwrap"))

    var path = PathBuilder.from_rect((Rect.from_ltrb(10.0, 10.0, 190.0, 190.0) else trap("unwrap")))
    defer path.release()

    var pixmap = Pixmap.new_(200, 200) else trap("pixmap")
    defer pixmap.release()
    pixmap.fill_path(&path, &paint, FillRule.winding, Transform.identity(), none)

    harness.expect_png(t, &pixmap, "gradients/conical-smaller-radial.png")

