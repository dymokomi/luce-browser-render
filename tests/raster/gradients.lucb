# The radial gradient is only supported by the high quality pipeline.
# Therefore we do not have a lq/hq split.

func well_behaved_radial(t: Test*):
    var paint = Paint()
    defer paint.release()
    paint.anti_alias = false
    paint.shader = (RadialGradient.new_( Point.from_xy(100.0, 100.0), 0.0, Point.from_xy(120.0, 80.0), 100.0, [ GradientStop.new_(0.25, Color.from_rgba8(50, 127, 150, 200)), GradientStop.new_(0.75, Color.from_rgba8(220, 140, 75, 180)), ], SpreadMode.pad_, Transform.identity(), ) else trap("unwrap"))

    var path = PathBuilder.from_rect((Rect.from_ltrb(10.0, 10.0, 190.0, 190.0) else trap("unwrap")))
    defer path.release()

    var pixmap = Pixmap.new_(200, 200) else trap("pixmap")
    defer pixmap.release()
    pixmap.fill_path(&path, &paint, FillRule.winding, Transform.identity(), none)

    harness.expect_png(t, &pixmap, "gradients/well-behaved-radial.png")

