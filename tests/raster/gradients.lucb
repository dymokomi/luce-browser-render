pub let tests: TestCase[22] = [
    TestCase(name = "gradients::two_stops_linear_pad_lq", run = two_stops_linear_pad_lq),
    TestCase(name = "gradients::two_stops_linear_repeat_lq", run = two_stops_linear_repeat_lq),
    TestCase(name = "gradients::two_stops_linear_reflect_lq", run = two_stops_linear_reflect_lq),
    TestCase(name = "gradients::three_stops_evenly_spaced_lq", run = three_stops_evenly_spaced_lq),
    TestCase(name = "gradients::two_stops_unevenly_spaced_lq", run = two_stops_unevenly_spaced_lq),
    TestCase(name = "gradients::two_stops_linear_pad_hq", run = two_stops_linear_pad_hq),
    TestCase(name = "gradients::two_stops_linear_repeat_hq", run = two_stops_linear_repeat_hq),
    TestCase(name = "gradients::two_stops_linear_reflect_hq", run = two_stops_linear_reflect_hq),
    TestCase(name = "gradients::three_stops_evenly_spaced_hq", run = three_stops_evenly_spaced_hq),
    TestCase(name = "gradients::two_stops_unevenly_spaced_hq", run = two_stops_unevenly_spaced_hq),
    TestCase(name = "gradients::well_behaved_radial", run = well_behaved_radial),
    TestCase(name = "gradients::focal_on_circle_radial", run = focal_on_circle_radial),
    TestCase(name = "gradients::conical_greater_radial", run = conical_greater_radial),
    TestCase(name = "gradients::simple_radial_lq", run = simple_radial_lq),
    TestCase(name = "gradients::simple_radial_hq", run = simple_radial_hq),
    TestCase(name = "gradients::simple_radial_with_ts_hq", run = simple_radial_with_ts_hq),
    TestCase(name = "gradients::global_opacity", run = global_opacity),
    TestCase(name = "gradients::strip_gradient", run = strip_gradient),
    TestCase(name = "gradients::concentric_radial", run = concentric_radial),
    TestCase(name = "gradients::conical_smaller_radial", run = conical_smaller_radial),
    TestCase(name = "gradients::sweep_gradient", run = sweep_gradient),
    TestCase(name = "gradients::sweep_gradient_full", run = sweep_gradient_full),
]
