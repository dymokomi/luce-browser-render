import harness
from harness import Test, TestCase
from raster import Paint, PathBuilder, Pixmap, PixmapPaint, Transform, Rect, Point, Color, ColorU8, Stroke, StrokeDash, LineCap, LineJoin, FillRule, BlendMode, SpreadMode, FilterQuality, GradientStop, LinearGradient, RadialGradient, SweepGradient, Pattern, Mask, MaskType, IntRect, ColorSpace, Shader

func two_stops_linear_pad_lq(t: Test*):
    var paint = Paint()
    defer paint.release()
    paint.anti_alias = false
    paint.shader = (LinearGradient.new_( Point.from_xy(10.0, 10.0), Point.from_xy(190.0, 190.0), [ GradientStop.new_(0.0, Color.from_rgba8(50, 127, 150, 200)), GradientStop.new_(1.0, Color.from_rgba8(220, 140, 75, 180)), ], SpreadMode.pad_, Transform.identity(), ) else trap("unwrap"))

    var path = PathBuilder.from_rect((Rect.from_ltrb(10.0, 10.0, 190.0, 190.0) else trap("unwrap")))
    defer path.release()

    var pixmap = Pixmap.new_(200, 200) else trap("pixmap")
    defer pixmap.release()
    pixmap.fill_path(&path, &paint, FillRule.winding, Transform.identity(), none)

    harness.expect_png(t, &pixmap, "gradients/two-stops-linear-pad-lq.png")

