func open_polygon(t: Test*):
    var paint = Paint()
    defer paint.release()
    paint.set_color_rgba8(50, 127, 150, 200)
    paint.anti_alias = false

    var pb = PathBuilder.new_()
    defer pb.release()
    pb.move_to(75.160671, 88.756136)
    pb.line_to(24.797274, 88.734053)
    pb.line_to(9.255130, 40.828792)
    pb.line_to(50.012955, 11.243795)
    pb.line_to(90.744819, 40.864522)
    var path = pb.finish() else trap("finish")
    defer path.release()

    var pixmap = Pixmap.new_(100, 100) else trap("pixmap")
    defer pixmap.release()
    pixmap.fill_path(&path, &paint, FillRule.winding, Transform.identity(), none)

    harness.expect_png(t, &pixmap, "fill/polygon.png")

# Must be the same a open.
