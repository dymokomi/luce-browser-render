func clip_line_2(t: Test*):
    var paint = Paint()
    defer paint.release()
    paint.set_color_rgba8(50, 127, 150, 200)
    paint.anti_alias = false

    # This strange path forces `line_clipper::clip` to return an empty array.
    # And we're checking that this case is handled correctly.
    var pb = PathBuilder.new_()
    defer pb.release()
    pb.move_to(0.0, -1.0)
    pb.line_to(50.0, 0.0)
    pb.line_to(0.0, 50.0)
    pb.close()
    var path = pb.finish() else trap("finish")
    defer path.release()

    var pixmap = Pixmap.new_(100, 100) else trap("pixmap")
    defer pixmap.release()
    pixmap.fill_path(&path, &paint, FillRule.winding, Transform.identity(), none)

    harness.expect_png(t, &pixmap, "fill/clip-line-2.png")

