func aa_endless_loop(t: Test*):
    var paint = Paint()
    defer paint.release()
    paint.anti_alias = true

    # This path was causing an endless loop before.
    var pb = PathBuilder.new_()
    defer pb.release()
    pb.move_to(2.1537175, 11.560721)
    pb.quad_to(1.9999998, 10.787931, 2.0, 10.0)
    var path = pb.finish() else trap("finish")
    defer path.release()

    # Must not loop.
    var pixmap = Pixmap.new_(100, 100) else trap("pixmap")
    defer pixmap.release()
    pixmap.fill_path(&path, &paint, FillRule.winding, Transform.identity(), none)

func clear_aa(t: Test*):
    # Make sure that Clear with AA doesn't fallback to memset.
    var paint = Paint()
    defer paint.release()
    paint.anti_alias = true
    paint.blend_mode = BlendMode.clear

    var pixmap = Pixmap.new_(100, 100) else trap("pixmap")
    defer pixmap.release()
    pixmap.fill(Color.from_rgba8(50, 127, 150, 200))
    var tmp_path1 = PathBuilder.from_circle(50.0, 50.0, 40.0) else trap("unwrap")
    defer tmp_path1.release()
    pixmap.fill_path(&tmp_path1, &paint, FillRule.winding, Transform.identity(), none)

    harness.expect_png(t, &pixmap, "fill/clear-aa.png")

func line_curve(t: Test*):
    var paint = Paint()
    defer paint.release()
    paint.anti_alias = true

    var pb = PathBuilder.new_()
    defer pb.release()
    pb.move_to(100.0, 20.0)
    pb.cubic_to(100.0, 40.0, 100.0, 160.0, 100.0, 180.0)
    var path = pb.finish() else trap("finish")
    defer path.release()

    var pixmap = Pixmap.new_(200, 200) else trap("pixmap")
    defer pixmap.release()
    pixmap.fill_path(&path, &paint, FillRule.winding, Transform.identity(), none)

# Must not panic.

func vertical_lines_merging_bug(t: Test*):
    # This path must not trigger edge_builder::combine_vertical,
    # otherwise AlphaRuns::add will crash later.
    var pb = PathBuilder.new_()
    defer pb.release()
    pb.move_to(765.56, 158.56)
    pb.line_to(754.4, 168.28)
    pb.cubic_to(754.4, 168.28, 754.4, 168.24, 754.4, 168.17)
    pb.cubic_to(754.4, 168.09, 754.4, 168.02, 754.4, 167.95)
    pb.line_to(754.4, 168.06)
    var path = pb.finish() else trap("finish")
    defer path.release()

    var paint = Paint()
    defer paint.release()
    paint.set_color_rgba8(50, 127, 150, 200)
    paint.anti_alias = true

    # Must not panic.
    var pixmap = Pixmap.new_(100, 100) else trap("pixmap")
    defer pixmap.release()
    pixmap.fill_path(&path, &paint, FillRule.winding, Transform.from_row(5.4, 0.0, 0.0, 5.4, -4050.0, -840.0), none)

    harness.expect_png(t, &pixmap, "fill/vertical-lines-merging-bug.png")

func fill_rect(t: Test*):
    var paint = Paint()
    defer paint.release()
    paint.set_color_rgba8(50, 127, 150, 200)
    paint.anti_alias = true

    var pixmap = Pixmap.new_(100, 100) else trap("pixmap")
    defer pixmap.release()
    pixmap.fill_rect((Rect.from_xywh(20.3, 10.4, 50.5, 30.2) else trap("unwrap")), &paint, Transform.from_row(1.2, 0.3, -0.7, 0.8, 12.0, 15.3), none)

    harness.expect_png(t, &pixmap, "canvas/fill-rect.png")

