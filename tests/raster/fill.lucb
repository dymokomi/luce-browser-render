func tiny_float_rect(t: Test*):
    var paint = Paint()
    defer paint.release()
    paint.set_color_rgba8(50, 127, 150, 200)
    paint.anti_alias = false

    let rect = (Rect.from_xywh(1.3, 1.4, 0.5, 0.6) else trap("unwrap"))
    var pixmap = Pixmap.new_(3, 3) else trap("pixmap")
    defer pixmap.release()
    pixmap.fill_rect(rect, &paint, Transform.identity(), none)

    let expected: raster.PremultipliedColorU8[9] = [
        ColorU8.from_rgba(0, 0, 0, 0).premultiply(),
        ColorU8.from_rgba(0, 0, 0, 0).premultiply(),
        ColorU8.from_rgba(0, 0, 0, 0).premultiply(),
        ColorU8.from_rgba(0, 0, 0, 0).premultiply(),
        ColorU8.from_rgba(50, 127, 150, 200).premultiply(),
        ColorU8.from_rgba(0, 0, 0, 0).premultiply(),
        ColorU8.from_rgba(0, 0, 0, 0).premultiply(),
        ColorU8.from_rgba(0, 0, 0, 0).premultiply(),
        ColorU8.from_rgba(0, 0, 0, 0).premultiply(),
    ]
    harness.expect_pixels(t, &pixmap, expected)

func tiny_float_rect_aa(t: Test*):
    var paint = Paint()
    defer paint.release()
    paint.set_color_rgba8(50, 127, 150, 200)
    paint.anti_alias = true

    let rect = (Rect.from_xywh(1.3, 1.4, 0.5, 0.6) else trap("unwrap"))

    var pixmap = Pixmap.new_(3, 3) else trap("pixmap")
    defer pixmap.release()
    pixmap.fill_rect(rect, &paint, Transform.identity(), none)

    let expected: raster.PremultipliedColorU8[9] = [
        ColorU8.from_rgba(0, 0, 0, 0).premultiply(),
        ColorU8.from_rgba(0, 0, 0, 0).premultiply(),
        ColorU8.from_rgba(0, 0, 0, 0).premultiply(),
        ColorU8.from_rgba(0, 0, 0, 0).premultiply(),
        # Skia m144 (NEON div255 and 1/255 colors); tiny-skia expects (51, 128, 153, 60) demultiplied.
        raster.PremultipliedColorU8.from_rgba(12, 30, 35, 60) else trap("color"),
        ColorU8.from_rgba(0, 0, 0, 0).premultiply(),
        ColorU8.from_rgba(0, 0, 0, 0).premultiply(),
        ColorU8.from_rgba(0, 0, 0, 0).premultiply(),
        ColorU8.from_rgba(0, 0, 0, 0).premultiply(),
    ]
    harness.expect_pixels(t, &pixmap, expected)

