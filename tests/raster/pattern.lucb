# We have to test tile mode for bilinear/bicubic separately,
# because they're using a different algorithm from nearest.
func pad_bicubic(t: Test*):
    var triangle = crate_triangle()
    defer triangle.release()

    var paint = Paint()
    defer paint.release()
    paint.anti_alias = false
    paint.shader = Pattern.new_(triangle.as_ref(), SpreadMode.pad_, FilterQuality.bicubic, 1.0, Transform.from_row(1.1, 0.3, 0.0, 1.4, 0.0, 0.0))

    var path = PathBuilder.from_rect((Rect.from_ltrb(10.0, 10.0, 190.0, 190.0) else trap("unwrap")))
    defer path.release()

    var pixmap = Pixmap.new_(200, 200) else trap("pixmap")
    defer pixmap.release()
    pixmap.fill_path(&path, &paint, FillRule.winding, Transform.identity(), none)

    harness.expect_png(t, &pixmap, "pattern/pad-bicubic.png")

