pub let tests: TestCase[10] = [
    TestCase(name = "pattern::pad_nearest", run = pad_nearest),
    TestCase(name = "pattern::repeat_nearest", run = repeat_nearest),
    TestCase(name = "pattern::reflect_nearest", run = reflect_nearest),
    TestCase(name = "pattern::pad_bicubic", run = pad_bicubic),
    TestCase(name = "pattern::repeat_bicubic", run = repeat_bicubic),
    TestCase(name = "pattern::reflect_bicubic", run = reflect_bicubic),
    TestCase(name = "pattern::filter_nearest_no_ts", run = filter_nearest_no_ts),
    TestCase(name = "pattern::filter_nearest", run = filter_nearest),
    TestCase(name = "pattern::filter_bilinear", run = filter_bilinear),
    TestCase(name = "pattern::filter_bicubic", run = filter_bicubic),
]
