import harness
from harness import Test, TestCase
from raster import Paint, PathBuilder, Pixmap, PixmapPaint, Transform, Rect, Point, Color, ColorU8, Stroke, StrokeDash, LineCap, LineJoin, FillRule, BlendMode, SpreadMode, FilterQuality, GradientStop, LinearGradient, RadialGradient, SweepGradient, Pattern, Mask, MaskType, IntRect, ColorSpace, Shader

func crate_triangle() -> Pixmap:
    var paint = Paint()
    defer paint.release()
    paint.set_color_rgba8(50, 127, 150, 200)
    paint.anti_alias = true

    var pb = PathBuilder.new_()
    defer pb.release()
    pb.move_to(0.0, 20.0)
    pb.line_to(20.0, 20.0)
    pb.line_to(10.0, 0.0)
    pb.close()
    var path = pb.finish() else trap("finish")
    defer path.release()

    var pixmap = Pixmap.new_(20, 20) else trap("pixmap")
    pixmap.fill_path(&path, &paint, FillRule.winding, Transform.identity(), none)
    return pixmap

func pad_nearest(t: Test*):
    var triangle = crate_triangle()
    defer triangle.release()

    var paint = Paint()
    defer paint.release()
    paint.anti_alias = false
    paint.shader = Pattern.new_(triangle.as_ref(), SpreadMode.pad_, FilterQuality.nearest, 1.0, Transform.identity())

    var path = PathBuilder.from_rect((Rect.from_ltrb(10.0, 10.0, 190.0, 190.0) else trap("unwrap")))
    defer path.release()

    var pixmap = Pixmap.new_(200, 200) else trap("pixmap")
    defer pixmap.release()
    pixmap.fill_path(&path, &paint, FillRule.winding, Transform.identity(), none)

    harness.expect_png(t, &pixmap, "pattern/pad-nearest.png")

