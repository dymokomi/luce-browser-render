# mark: circles and ellipses -------------------------------------------------------------------

func circle_small_radii(t: Test*):
    var pixmap = new_pixmap(96, 16, true)
    defer pixmap.release()
    var paint = solid(0, 0, 0, 255, true)
    defer paint.release()
    let centers: f32[6] = [6.3, 18.7, 31.1, 44.5, 60.2, 80.6]
    let radii: f32[6] = [0.5, 1.0, 1.5, 2.0, 3.0, 4.5]
    for i in 0..<6:
        fill(&pixmap, circle(centers[i], 8.4, radii[i]), &paint)
    harness.expect_png(t, &pixmap, "skia/ladybird/circle_small_radii.png")

func circle_frac(t: Test*):
    var pixmap = new_pixmap(48, 48, false)
    defer pixmap.release()
    var paint = solid(30, 90, 200, 230, true)
    defer paint.release()
    fill(&pixmap, circle(20.4, 20.6, 12.3), &paint)
    harness.expect_png(t, &pixmap, "skia/ladybird/circle_frac.png")

