    var paint = Paint()
    defer paint.release()
    paint.shader = (RadialGradient.new_(Point.from_xy(50.5, 50.5), 0.0, Point.from_xy(50.5, 50.5), 40.0, [GradientStop.new_(0.0, Color.from_rgba8(255, 255, 255, 255)), GradientStop.new_(1.0, Color.from_rgba8(30, 90, 200, 255))], SpreadMode.pad_, Transform.identity()) else trap("gradient"))
    fill(&pixmap, circle(50.5, 50.5, 40.0), &paint)
    harness.expect_png(t, &pixmap, "skia/ladybird/grad_radial_circle.png")

func grad_radial_rrect_3stops(t: Test*):
    var pixmap = new_pixmap(120, 80, true)
    defer pixmap.release()
    var paint = Paint()
    defer paint.release()
    paint.shader = (RadialGradient.new_(Point.from_xy(60.0, 40.0), 0.0, Point.from_xy(60.0, 40.0), 50.0, [GradientStop.new_(0.0, Color.from_rgba8(250, 220, 50, 255)), GradientStop.new_(0.6, Color.from_rgba8(220, 80, 40, 200)), GradientStop.new_(1.0, Color.from_rgba8(60, 20, 120, 160))], SpreadMode.pad_, Transform.identity()) else trap("gradient"))
    fill(&pixmap, rounded_rect(10.0, 10.0, 100.0, 60.0, 20.0), &paint)
    harness.expect_png(t, &pixmap, "skia/ladybird/grad_radial_rrect_3stops.png")

pub let tests: TestCase[71] = [
    TestCase(name = "ladybird::rrect_opaque_int", run = rrect_opaque_int),
    TestCase(name = "ladybird::rrect_translucent_frac", run = rrect_translucent_frac),
    TestCase(name = "ladybird::rrect_small_radius", run = rrect_small_radius),
    TestCase(name = "ladybird::rrect_pill", run = rrect_pill),
