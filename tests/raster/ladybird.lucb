#==============================================================================================
#
#   ladybird - scenes of what Ladybird draws, against Skia m144's pixels
#
#   DESCRIPTION:
#       Small scenes of the drawing LibWeb does through Skia: rounded rectangles and
#       ellipses built from conics, thin lines and hairlines, stroked and dashed borders,
#       translucent overlapping fills, images and patterns, clips, glyph-like outlines,
#       transformed paths and gradient-filled boxes. Each test renders one scene and
#       compares it with the image the Skia oracle (.donors/oracles/raster-skia,
#       scenes_ladybird_*.cpp) renders for the same drawing, pixel for pixel.
#
#       Copyright (c) 2026 the luce-browser authors.
#       SPDX-License-Identifier: BSD-3-Clause
#
#==============================================================================================

import harness
from harness import Test, TestCase
from raster import Paint, Path, PathBuilder, Pixmap, PixmapPaint, Transform, Rect, Point, Color, Stroke, StrokeDash, LineCap, LineJoin, FillRule, SpreadMode, FilterQuality, GradientStop, LinearGradient, RadialGradient, Pattern, Mask

# mark: helpers --------------------------------------------------------------------------------

## The conic weight of a quarter ellipse, sqrt(2) / 2.
let quarter_weight: f32 = 0.707106781

## A pixmap of the scene's size; `background` fills it with an opaque off-white first.
func new_pixmap(width: u32, height: u32, background: bool) -> Pixmap:
    var pixmap = Pixmap.new_(width, height) else trap("pixmap")
    if background:
        pixmap.fill(Color.from_rgba8(240, 236, 226, 255))
    return pixmap

## A solid color paint.
func solid(r: u8, g: u8, b: u8, a: u8, anti_alias: bool) -> Paint:
    var paint = Paint()
    paint.set_color_rgba8(r, g, b, a)
    paint.anti_alias = anti_alias
    return paint

func finish(pb: PathBuilder*) -> Path:
    return pb.finish() else trap("finish")

## A rounded rectangle: `radii` holds the (x, y) radii of the top-left, top-right,
## bottom-right and bottom-left corners; each corner is a conic of weight sqrt(2) / 2, and a
## corner with both radii zero is square.
func rounded_rect_radii(x: f32, y: f32, w: f32, h: f32, radii: const f32[]) -> Path:
    let right = x + w
    let bottom = y + h
    var pb = PathBuilder.new_()
    defer pb.release()
    pb.move_to(x + radii[0], y)
    pb.line_to(right - radii[2], y)
    if radii[2] > 0.0 or radii[3] > 0.0:
        pb.conic_to(right, y, right, y + radii[3], quarter_weight)
    pb.line_to(right, bottom - radii[5])
    if radii[4] > 0.0 or radii[5] > 0.0:
        pb.conic_to(right, bottom, right - radii[4], bottom, quarter_weight)
    pb.line_to(x + radii[6], bottom)
    if radii[6] > 0.0 or radii[7] > 0.0:
        pb.conic_to(x, bottom, x, bottom - radii[7], quarter_weight)
    pb.line_to(x, y + radii[1])
    if radii[0] > 0.0 or radii[1] > 0.0:
        pb.conic_to(x, y, x + radii[0], y, quarter_weight)
    pb.close()
    return finish(&pb)

## A rounded rectangle with the same elliptical radii at every corner.
func elliptical_rect(x: f32, y: f32, w: f32, h: f32, rx: f32, ry: f32) -> Path:
    return rounded_rect_radii(x, y, w, h, [rx, ry, rx, ry, rx, ry, rx, ry])

## A rounded rectangle with the same circular radius at every corner.
func rounded_rect(x: f32, y: f32, w: f32, h: f32, r: f32) -> Path:
    return elliptical_rect(x, y, w, h, r, r)

## A circle: PathBuilder.push_circle, four conics.
func circle(cx: f32, cy: f32, r: f32) -> Path:
    var pb = PathBuilder.new_()
    defer pb.release()
    pb.push_circle(cx, cy, r)
    return finish(&pb)

## An ellipse inside (x, y, w, h): PathBuilder.push_oval, four conics.
func oval(x: f32, y: f32, w: f32, h: f32) -> Path:
    var pb = PathBuilder.new_()
    defer pb.release()
    pb.push_oval((Rect.from_xywh(x, y, w, h) else trap("rect")))
    return finish(&pb)

func rect_path(x: f32, y: f32, w: f32, h: f32) -> Path:
    return PathBuilder.from_rect((Rect.from_xywh(x, y, w, h) else trap("rect")))

## Fill `path` (winding, no transform, no mask), then release it.
func fill(pixmap: Pixmap*, path: Path, paint: const Paint*):
    var p = path
    pixmap.fill_path(&p, paint, FillRule.winding, Transform.identity(), none)
    p.release()

## Fill `path` under `ts`, then release it.
func fill_ts(pixmap: Pixmap*, path: Path, paint: const Paint*, ts: Transform):
    var p = path
    pixmap.fill_path(&p, paint, FillRule.winding, ts, none)
    p.release()

## Stroke `path` (no transform, no mask), then release it.
func stroke(pixmap: Pixmap*, path: Path, paint: const Paint*, style: const Stroke*):
    var p = path
    pixmap.stroke_path(&p, paint, style, Transform.identity(), none)
    p.release()

## A test image of `size` x `size` premultiplied pixels: a red/green ramp with a blue
## checker, a translucent bottom-right quadrant and a transparent 2x2 top-left corner.
func source_image(size: u32) -> Pixmap:
    var pixmap = Pixmap.new_(size, size) else trap("pixmap")
    let n = (usize)size
    let data = pixmap.data_mut()
    for y in 0..<n:
        for x in 0..<n:
            var r = x * 255 // (n - 1)
            var g = y * 255 // (n - 1)
            var b = ((x + y) % 4) * 60
            var a: usize = 255
            if x >= n // 2 and y >= n // 2:
                a = 160
                r = r * a // 255
                g = g * a // 255
                b = b * a // 255
            if x < 2 and y < 2:
                r = 0
                g = 0
                b = 0
                a = 0
            let i = (y * n + x) * 4
            data[i + 0] = (u8)r
            data[i + 1] = (u8)g
            data[i + 2] = (u8)b
            data[i + 3] = (u8)a
    return pixmap

## Six lines, offset by `o`: horizontal, vertical, 45 degrees, 30 degrees, nearly horizontal
## and nearly vertical, as separate contours of one path.
func line_set(o: f32) -> Path:
    var pb = PathBuilder.new_()
    defer pb.release()
    pb.move_to(10.0 + o, 10.0 + o)
    pb.line_to(90.0 + o, 10.0 + o)
    pb.move_to(10.0 + o, 20.0 + o)
    pb.line_to(10.0 + o, 90.0 + o)
    pb.move_to(20.0 + o, 20.0 + o)
    pb.line_to(60.0 + o, 60.0 + o)
    pb.move_to(20.0 + o, 70.0 + o)
    pb.line_to(71.96 + o, 40.0 + o)
    pb.move_to(20.0 + o, 85.0 + o)
    pb.line_to(90.0 + o, 88.0 + o)
    pb.move_to(80.0 + o, 15.0 + o)
    pb.line_to(83.0 + o, 75.0 + o)
    return finish(&pb)

## An open zigzag polyline for the join tests.
func zigzag() -> Path:
    var pb = PathBuilder.new_()
    defer pb.release()
    pb.move_to(10.0, 50.0)
    pb.line_to(30.0, 15.0)
    pb.line_to(50.0, 50.0)
    pb.line_to(70.0, 20.0)
    pb.line_to(80.0, 55.0)
    pb.line_to(110.0, 30.0)
    return finish(&pb)

func triangle(x0: f32, y0: f32, x1: f32, y1: f32, x2: f32, y2: f32) -> Path:
    var pb = PathBuilder.new_()
    defer pb.release()
    pb.move_to(x0, y0)
    pb.line_to(x1, y1)
    pb.line_to(x2, y2)
    pb.close()
    return finish(&pb)

## A glyph like an 'o' in a 16 x 20 box: two elliptical cubic contours, the inner one a hole
## under the even-odd rule.
func push_glyph_o(pb: PathBuilder*):
    pb.move_to(16.0, 10.0)
    pb.cubic_to(16.0, 15.52, 12.42, 20.0, 8.0, 20.0)
    pb.cubic_to(3.58, 20.0, 0.0, 15.52, 0.0, 10.0)
    pb.cubic_to(0.0, 4.48, 3.58, 0.0, 8.0, 0.0)
    pb.cubic_to(12.42, 0.0, 16.0, 4.48, 16.0, 10.0)
    pb.close()
    pb.move_to(12.5, 10.0)
    pb.cubic_to(12.5, 13.59, 10.49, 16.5, 8.0, 16.5)
    pb.cubic_to(5.51, 16.5, 3.5, 13.59, 3.5, 10.0)
    pb.cubic_to(3.5, 6.41, 5.51, 3.5, 8.0, 3.5)
    pb.cubic_to(10.49, 3.5, 12.5, 6.41, 12.5, 10.0)
    pb.close()

## A glyph like an 'e' in a 16 x 20 box: a quadratic outline with a bar and an eye (a hole
## under the even-odd rule).
func push_glyph_e(pb: PathBuilder*):
    pb.move_to(15.0, 11.0)
    pb.line_to(3.8, 11.0)
    pb.quad_to(4.2, 16.8, 9.0, 16.8)
    pb.quad_to(12.0, 16.8, 13.6, 14.6)
    pb.line_to(15.4, 15.9)
    pb.quad_to(13.0, 20.0, 8.8, 20.0)
    pb.quad_to(0.2, 20.0, 0.2, 10.0)
    pb.quad_to(0.2, 0.0, 8.0, 0.0)
    pb.quad_to(15.0, 0.0, 15.0, 9.0)
    pb.close()
    pb.move_to(3.9, 8.0)
    pb.quad_to(4.3, 3.2, 8.0, 3.2)
    pb.quad_to(11.3, 3.2, 11.5, 8.0)
    pb.close()

func glyph(e: bool) -> Path:
    var pb = PathBuilder.new_()
    defer pb.release()
    if e:
        push_glyph_e(&pb)
    else:
        push_glyph_o(&pb)
    return finish(&pb)

## Draw a glyph scaled by `s` (20 * s pixels tall) at (x, y), even-odd.
func draw_glyph(pixmap: Pixmap*, e: bool, s: f32, x: f32, y: f32, paint: const Paint*):
    var path = glyph(e)
    defer path.release()
    pixmap.fill_path(&path, paint, FillRule.even_odd, Transform.from_row(s, 0.0, 0.0, s, x, y), none)

# mark: rounded rectangles ---------------------------------------------------------------------

func rrect_opaque_int(t: Test*):
    var pixmap = new_pixmap(100, 80, true)
    defer pixmap.release()
    var paint = solid(30, 90, 200, 255, true)
    defer paint.release()
    fill(&pixmap, rounded_rect(10.0, 10.0, 80.0, 60.0, 10.0), &paint)
    harness.expect_png(t, &pixmap, "skia/ladybird/rrect_opaque_int.png")

func rrect_translucent_frac(t: Test*):
    var pixmap = new_pixmap(100, 80, false)
    defer pixmap.release()
    var paint = solid(200, 50, 60, 150, true)
    defer paint.release()
    fill(&pixmap, rounded_rect(10.3, 12.6, 70.5, 50.25, 8.5), &paint)
    harness.expect_png(t, &pixmap, "skia/ladybird/rrect_translucent_frac.png")

func rrect_small_radius(t: Test*):
    var pixmap = new_pixmap(64, 48, true)
    defer pixmap.release()
    var blue = solid(30, 90, 200, 255, true)
    defer blue.release()
    var black = solid(0, 0, 0, 180, true)
    defer black.release()
    fill(&pixmap, rounded_rect(5.5, 6.5, 40.0, 20.0, 2.0), &blue)
    fill(&pixmap, rounded_rect(8.25, 30.75, 50.0, 12.0, 1.5), &black)
    harness.expect_png(t, &pixmap, "skia/ladybird/rrect_small_radius.png")

func rrect_pill(t: Test*):
    var pixmap = new_pixmap(128, 64, true)
    defer pixmap.release()
    var opaque = solid(80, 160, 70, 255, true)
    defer opaque.release()
    var translucent = solid(80, 160, 70, 200, true)
    defer translucent.release()
    fill(&pixmap, rounded_rect(10.0, 17.0, 100.0, 30.0, 15.0), &opaque)
    fill(&pixmap, rounded_rect(14.4, 50.2, 60.5, 9.0, 4.5), &translucent)
    harness.expect_png(t, &pixmap, "skia/ladybird/rrect_pill.png")

func rrect_elliptical(t: Test*):
    var pixmap = new_pixmap(128, 80, false)
    defer pixmap.release()
    var paint = solid(120, 40, 160, 220, true)
    defer paint.release()
    fill(&pixmap, elliptical_rect(8.0, 8.0, 110.0, 60.0, 30.0, 12.0), &paint)
    harness.expect_png(t, &pixmap, "skia/ladybird/rrect_elliptical.png")

func rrect_tiny(t: Test*):
    var pixmap = new_pixmap(24, 24, true)
    defer pixmap.release()
    var blue = solid(30, 90, 200, 200, true)
    defer blue.release()
    var orange = solid(220, 120, 20, 160, true)
    defer orange.release()
    fill(&pixmap, rounded_rect(3.25, 4.75, 12.0, 10.0, 3.0), &blue)
    fill(&pixmap, rounded_rect(10.5, 9.5, 9.0, 9.0, 4.5), &orange)
    harness.expect_png(t, &pixmap, "skia/ladybird/rrect_tiny.png")

func rrect_mixed_corners(t: Test*):
    var pixmap = new_pixmap(120, 90, true)
    defer pixmap.release()
    var paint = solid(40, 40, 40, 255, true)
    defer paint.release()
    fill(&pixmap, rounded_rect_radii(10.5, 10.5, 100.0, 70.0, [20.0, 20.0, 0.0, 0.0, 30.0, 15.0, 5.0, 40.0]), &paint)
    harness.expect_png(t, &pixmap, "skia/ladybird/rrect_mixed_corners.png")

func rrect_non_aa(t: Test*):
