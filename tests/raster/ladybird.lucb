## 25 circles with radii from 0.5 to 38.9, overlapping.
func circle_grid(t: Test*):
    var pixmap = new_pixmap(200, 200, true)
    defer pixmap.release()
    var paint = solid(30, 90, 200, 110, true)
    defer paint.release()
    for j in 0..<5:
        for i in 0..<5:
            let r = 0.5 + (f32)(j * 5 + i) * 1.6
            fill(&pixmap, circle(20.3 + (f32)i * 40.0, 20.6 + (f32)j * 40.0, r), &paint)
    harness.expect_png(t, &pixmap, "skia/ladybird/circle_grid.png")

# mark: thin lines -----------------------------------------------------------------------------

## The line set offset by `o`, stroked `width` wide with `cap`.
func lines_scene(t: Test*, image: str, width: f32, anti_alias: bool, cap: LineCap, o: f32):
    var pixmap = new_pixmap(100, 100, true)
    defer pixmap.release()
    var paint = solid(20, 20, 40, 220, anti_alias)
    defer paint.release()
    var s = Stroke()
    defer harness.release_stroke(&s)
    s.width = width
    s.line_cap = cap
    stroke(&pixmap, line_set(o), &paint, &s)
    harness.expect_png(t, &pixmap, image)

func lines_w0_aa(t: Test*):
    lines_scene(t, "skia/ladybird/lines_w0_aa.png", 0.0, true, LineCap.butt, 0.0)

func lines_w0_noaa(t: Test*):
    lines_scene(t, "skia/ladybird/lines_w0_noaa.png", 0.0, false, LineCap.butt, 0.0)

func lines_w05_aa(t: Test*):
    lines_scene(t, "skia/ladybird/lines_w05_aa.png", 0.5, true, LineCap.butt, 0.0)

func lines_w1_aa(t: Test*):
    lines_scene(t, "skia/ladybird/lines_w1_aa.png", 1.0, true, LineCap.butt, 0.0)

func lines_w1_half_aa(t: Test*):
    lines_scene(t, "skia/ladybird/lines_w1_half_aa.png", 1.0, true, LineCap.butt, 0.5)

func lines_w1_half_noaa(t: Test*):
    lines_scene(t, "skia/ladybird/lines_w1_half_noaa.png", 1.0, false, LineCap.butt, 0.5)

func lines_w15_aa_round(t: Test*):
    lines_scene(t, "skia/ladybird/lines_w15_aa_round.png", 1.5, true, LineCap.round, 0.25)

func lines_w2_aa_square(t: Test*):
    lines_scene(t, "skia/ladybird/lines_w2_aa_square.png", 2.0, true, LineCap.square, 0.0)

func lines_w2_noaa_square(t: Test*):
    lines_scene(t, "skia/ladybird/lines_w2_noaa_square.png", 2.0, false, LineCap.square, 0.5)

func lines_w3_half_aa_round(t: Test*):
    lines_scene(t, "skia/ladybird/lines_w3_half_aa_round.png", 3.0, true, LineCap.round, 0.5)

# mark: strokes --------------------------------------------------------------------------------

func stroke_rect_w1_int(t: Test*):
    var pixmap = new_pixmap(80, 60, true)
    defer pixmap.release()
    var paint = solid(30, 90, 200, 255, true)
    defer paint.release()
    var s = Stroke()
    defer harness.release_stroke(&s)
    stroke(&pixmap, rect_path(10.0, 10.0, 60.0, 40.0), &paint, &s)
    harness.expect_png(t, &pixmap, "skia/ladybird/stroke_rect_w1_int.png")

func stroke_rect_w1_half(t: Test*):
    var pixmap = new_pixmap(80, 60, true)
    defer pixmap.release()
    var paint = solid(30, 90, 200, 255, true)
    defer paint.release()
    var s = Stroke()
    defer harness.release_stroke(&s)
    stroke(&pixmap, rect_path(10.5, 10.5, 60.0, 40.0), &paint, &s)
