# mark: clips ----------------------------------------------------------------------------------

func clip_rrect_fill(t: Test*):
    var pixmap = new_pixmap(100, 80, true)
    defer pixmap.release()
    var clip = rounded_rect(10.5, 10.25, 80.0, 60.0, 14.0)
    defer clip.release()
    var mask = Mask.new_(100, 80) else trap("mask")
    defer mask.release()
    mask.fill_path(&clip, FillRule.winding, true, Transform.identity())
    var paint = solid(30, 90, 200, 255, false)
    defer paint.release()
    pixmap.fill_rect((Rect.from_xywh(0.0, 0.0, 100.0, 80.0) else trap("rect")), &paint, Transform.identity(), (&mask))
    harness.expect_png(t, &pixmap, "skia/ladybird/clip_rrect_fill.png")

func clip_circle_stroke(t: Test*):
    var pixmap = new_pixmap(100, 100, true)
    defer pixmap.release()
    var clip = circle(50.3, 50.6, 35.0)
    defer clip.release()
    var mask = Mask.new_(100, 100) else trap("mask")
    defer mask.release()
    mask.fill_path(&clip, FillRule.winding, true, Transform.identity())
    var paint = solid(200, 50, 60, 255, true)
    defer paint.release()
    var s = Stroke()
    defer harness.release_stroke(&s)
    s.width = 3.0
    var lines = line_set(0.0)
    defer lines.release()
    pixmap.stroke_path(&lines, &paint, &s, Transform.identity(), (&mask))
    harness.expect_png(t, &pixmap, "skia/ladybird/clip_circle_stroke.png")

func clip_circle_image(t: Test*):
    var source = source_image(16)
    defer source.release()
    var pixmap = new_pixmap(64, 64, true)
    defer pixmap.release()
    var clip = circle(32.5, 32.5, 24.0)
    defer clip.release()
    var mask = Mask.new_(64, 64) else trap("mask")
    defer mask.release()
    mask.fill_path(&clip, FillRule.winding, true, Transform.identity())
    var paint = PixmapPaint()
    paint.quality = FilterQuality.bilinear
    pixmap.draw_pixmap(0, 0, source.as_ref(), &paint, Transform.from_row(3.5, 0.0, 0.0, 3.5, 4.0, 4.0), (&mask))
    harness.expect_png(t, &pixmap, "skia/ladybird/clip_circle_image.png")

func clip_polygon_noaa(t: Test*):
    var pixmap = new_pixmap(100, 100, true)
    defer pixmap.release()
    var pb = PathBuilder.new_()
    defer pb.release()
    pb.move_to(50.0, 5.0)
    pb.line_to(61.0, 38.0)
    pb.line_to(95.0, 38.0)
    pb.line_to(67.0, 58.0)
    pb.line_to(78.0, 92.0)
    pb.line_to(50.0, 72.0)
    pb.line_to(22.0, 92.0)
    pb.line_to(33.0, 58.0)
    pb.line_to(5.0, 38.0)
    pb.line_to(39.0, 38.0)
    pb.close()
    var star = finish(&pb)
    defer star.release()
    var mask = Mask.new_(100, 100) else trap("mask")
    defer mask.release()
    mask.fill_path(&star, FillRule.winding, false, Transform.identity())
    var paint = solid(80, 160, 70, 200, true)
    defer paint.release()
    var disc = circle(50.0, 50.0, 45.0)
    defer disc.release()
    pixmap.fill_path(&disc, &paint, FillRule.winding, Transform.identity(), (&mask))
    harness.expect_png(t, &pixmap, "skia/ladybird/clip_polygon_noaa.png")

func clip_intersect(t: Test*):
    var pixmap = new_pixmap(100, 100, true)
    defer pixmap.release()
    var disc = circle(40.0, 50.0, 35.0)
    defer disc.release()
    var box = rounded_rect(30.5, 20.5, 60.0, 60.0, 10.0)
    defer box.release()
    var mask = Mask.new_(100, 100) else trap("mask")
    defer mask.release()
    mask.fill_path(&disc, FillRule.winding, true, Transform.identity())
    mask.intersect_path(&box, FillRule.winding, true, Transform.identity())
    var paint = solid(120, 40, 160, 255, false)
    defer paint.release()
    pixmap.fill_rect((Rect.from_xywh(0.0, 0.0, 100.0, 100.0) else trap("rect")), &paint, Transform.identity(), (&mask))
    harness.expect_png(t, &pixmap, "skia/ladybird/clip_intersect.png")

func clip_pixel_rect(t: Test*):
    var pixmap = new_pixmap(64, 64, true)
    defer pixmap.release()
    var clip = rect_path(8.0, 8.0, 48.0, 40.0)
    defer clip.release()
    var mask = Mask.new_(64, 64) else trap("mask")
    defer mask.release()
    mask.fill_path(&clip, FillRule.winding, false, Transform.identity())
    var paint = solid(120, 40, 160, 230, true)
    defer paint.release()
    var disc = circle(32.3, 30.7, 26.0)
    defer disc.release()
    pixmap.fill_path(&disc, &paint, FillRule.winding, Transform.identity(), (&mask))
    harness.expect_png(t, &pixmap, "skia/ladybird/clip_pixel_rect.png")

# mark: glyphs ---------------------------------------------------------------------------------

## Twelve 14-pixel 'o's at fractional positions.
func glyphs_o_row(t: Test*):
    var pixmap = new_pixmap(200, 32, false)
    defer pixmap.release()
    pixmap.fill(Color.white())
    var paint = solid(0, 0, 0, 255, true)
    defer paint.release()
    var x: f32 = 3.3
    for _i in 0..<12:
        draw_glyph(&pixmap, false, 0.7, x, 8.35, &paint)
        x += 15.7
    harness.expect_png(t, &pixmap, "skia/ladybird/glyphs_o_row.png")

## Two rows of 'o's and 'e's from 8 to 20 pixels tall on a common baseline.
func glyphs_mixed_sizes(t: Test*):
    var pixmap = new_pixmap(200, 52, false)
    defer pixmap.release()
    pixmap.fill(Color.white())
    var paint = solid(0, 0, 0, 255, true)
    defer paint.release()
    for row in 0..<2:
        var x = 2.7 + (f32)row * 0.45
        let baseline = 22.6 + (f32)row * 26.0
        for i in 0..<7:
            let s = 0.4 + (f32)i * 0.1
            draw_glyph(&pixmap, (i + row) % 2 == 1, s, x, baseline - 20.0 * s, &paint)
            x += 16.0 * s + 2.3
    harness.expect_png(t, &pixmap, "skia/ladybird/glyphs_mixed_sizes.png")

## Twenty translucent 9-pixel glyphs over the background.
func glyphs_translucent_small(t: Test*):
    var pixmap = new_pixmap(160, 24, true)
    defer pixmap.release()
    var paint = solid(20, 20, 60, 200, true)
    defer paint.release()
    var x: f32 = 1.3
    for i in 0..<20:
        draw_glyph(&pixmap, i % 3 == 0, 0.45, x, 7.35, &paint)
        x += 7.9
    harness.expect_png(t, &pixmap, "skia/ladybird/glyphs_translucent_small.png")

