# mark: gradients ------------------------------------------------------------------------------

func grad_linear_rrect(t: Test*):
    var pixmap = new_pixmap(100, 80, false)
    defer pixmap.release()
    var paint = Paint()
    defer paint.release()
    paint.shader = (LinearGradient.new_(Point.from_xy(10.0, 10.0), Point.from_xy(90.0, 70.0), [GradientStop.new_(0.0, Color.from_rgba8(50, 127, 150, 255)), GradientStop.new_(1.0, Color.from_rgba8(220, 140, 75, 255))], SpreadMode.pad_, Transform.identity()) else trap("gradient"))
    fill(&pixmap, rounded_rect(10.5, 10.5, 80.0, 60.0, 12.0), &paint)
    harness.expect_png(t, &pixmap, "skia/ladybird/grad_linear_rrect.png")

func grad_linear_circle_3stops(t: Test*):
