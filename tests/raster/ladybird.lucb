## The zigzag stroked 6 wide with `join`, translucent so overlaps would show.
func polyline_scene(t: Test*, image: str, join: LineJoin):
    var pixmap = new_pixmap(120, 70, true)
    defer pixmap.release()
    var paint = solid(200, 50, 60, 200, true)
    defer paint.release()
    var s = Stroke()
    defer harness.release_stroke(&s)
    s.width = 6.0
    s.line_join = join
    stroke(&pixmap, zigzag(), &paint, &s)
    harness.expect_png(t, &pixmap, image)

func stroke_polyline_miter(t: Test*):
    polyline_scene(t, "skia/ladybird/stroke_polyline_miter.png", LineJoin.miter)

func stroke_polyline_round(t: Test*):
    polyline_scene(t, "skia/ladybird/stroke_polyline_round.png", LineJoin.round)

func stroke_polyline_bevel(t: Test*):
    polyline_scene(t, "skia/ladybird/stroke_polyline_bevel.png", LineJoin.bevel)

func stroke_closed_w8_miter(t: Test*):
    var pixmap = new_pixmap(120, 80, true)
    defer pixmap.release()
    var paint = solid(30, 90, 200, 255, true)
    defer paint.release()
    var s = Stroke()
    defer harness.release_stroke(&s)
    s.width = 8.0
    stroke(&pixmap, triangle(15.0, 70.0, 60.0, 10.0, 105.0, 70.0), &paint, &s)
    harness.expect_png(t, &pixmap, "skia/ladybird/stroke_closed_w8_miter.png")

func stroke_dash_rect(t: Test*):
    var pixmap = new_pixmap(100, 70, true)
    defer pixmap.release()
    var paint = solid(40, 40, 40, 255, true)
    defer paint.release()
    var s = Stroke()
    defer harness.release_stroke(&s)
    s.width = 2.0
    s.dash = StrokeDash.new_([6.0, 3.0], 0.0)
    stroke(&pixmap, rect_path(10.5, 10.5, 80.0, 50.0), &paint, &s)
    harness.expect_png(t, &pixmap, "skia/ladybird/stroke_dash_rect.png")

## Dotted borders: zero-length dashes with round caps.
func stroke_dash_dotted(t: Test*):
    var pixmap = new_pixmap(120, 70, true)
    defer pixmap.release()
    var paint = solid(40, 40, 40, 255, true)
    defer paint.release()
    var line = PathBuilder.new_()
    defer line.release()
    line.move_to(10.0, 20.0)
    line.line_to(110.0, 20.0)
    var s = Stroke()
    defer harness.release_stroke(&s)
    s.width = 4.0
    s.line_cap = LineCap.round
    s.dash = StrokeDash.new_([0.0, 8.0], 0.0)
    stroke(&pixmap, finish(&line), &paint, &s)
    var s2 = Stroke()
    defer harness.release_stroke(&s2)
    s2.width = 2.0
    s2.line_cap = LineCap.round
    s2.dash = StrokeDash.new_([0.0, 6.0], 0.0)
    stroke(&pixmap, rect_path(10.0, 35.0, 100.0, 25.0), &paint, &s2)
    harness.expect_png(t, &pixmap, "skia/ladybird/stroke_dash_dotted.png")

func stroke_dash_offset_polyline(t: Test*):
    var pixmap = new_pixmap(120, 70, true)
    defer pixmap.release()
    var paint = solid(30, 90, 200, 255, true)
    defer paint.release()
    var s = Stroke()
    defer harness.release_stroke(&s)
    s.width = 2.0
    s.line_join = LineJoin.round
    s.dash = StrokeDash.new_([10.0, 5.0, 2.0, 5.0], 3.0)
    stroke(&pixmap, zigzag(), &paint, &s)
    harness.expect_png(t, &pixmap, "skia/ladybird/stroke_dash_offset_polyline.png")

func stroke_rrect(t: Test*):
    var pixmap = new_pixmap(100, 70, true)
    defer pixmap.release()
    var dark = solid(40, 40, 40, 255, true)
    defer dark.release()
    var red = solid(200, 50, 60, 180, true)
    defer red.release()
    var thin = Stroke()
    defer harness.release_stroke(&thin)
    stroke(&pixmap, rounded_rect(10.5, 10.5, 80.0, 50.0, 10.0), &dark, &thin)
    var thick = Stroke()
    defer harness.release_stroke(&thick)
    thick.width = 3.0
    stroke(&pixmap, rounded_rect(20.0, 20.0, 60.0, 30.0, 8.0), &red, &thick)
    harness.expect_png(t, &pixmap, "skia/ladybird/stroke_rrect.png")

func stroke_circles(t: Test*):
    var pixmap = new_pixmap(100, 80, true)
    defer pixmap.release()
    var paint = solid(40, 40, 40, 255, true)
    defer paint.release()
    var s1 = Stroke()
    defer harness.release_stroke(&s1)
    stroke(&pixmap, circle(25.5, 25.5, 15.0), &paint, &s1)
    var s2 = Stroke()
    defer harness.release_stroke(&s2)
    s2.width = 2.5
    stroke(&pixmap, circle(70.3, 25.7, 15.0), &paint, &s2)
    var s3 = Stroke()
    defer harness.release_stroke(&s3)
    s3.width = 0.0
    stroke(&pixmap, circle(47.5, 60.0, 12.0), &paint, &s3)
    harness.expect_png(t, &pixmap, "skia/ladybird/stroke_circles.png")

func stroke_rrect_dashed(t: Test*):
    var pixmap = new_pixmap(120, 80, true)
    defer pixmap.release()
    var paint = solid(30, 90, 200, 255, true)
    defer paint.release()
    var s = Stroke()
    defer harness.release_stroke(&s)
    s.width = 2.0
    s.dash = StrokeDash.new_([8.0, 4.0], 0.0)
    stroke(&pixmap, rounded_rect(10.0, 10.0, 100.0, 60.0, 15.0), &paint, &s)
    harness.expect_png(t, &pixmap, "skia/ladybird/stroke_rrect_dashed.png")

# mark: translucent overlaps -------------------------------------------------------------------

func overlap_small_circles(t: Test*):
    var pixmap = new_pixmap(32, 32, true)
    defer pixmap.release()
    var red = solid(220, 30, 30, 128, true)
    defer red.release()
    var green = solid(30, 180, 30, 128, true)
    defer green.release()
    var blue = solid(30, 30, 220, 128, true)
    defer blue.release()
    fill(&pixmap, circle(12.0, 12.0, 7.0), &red)
    fill(&pixmap, circle(19.5, 12.5, 7.0), &green)
    fill(&pixmap, circle(15.7, 18.9, 7.0), &blue)
    harness.expect_png(t, &pixmap, "skia/ladybird/overlap_small_circles.png")

func overlap_tiny_rects(t: Test*):
    var pixmap = new_pixmap(24, 24, true)
    defer pixmap.release()
    var red = solid(200, 50, 60, 140, true)
    defer red.release()
    var blue = solid(30, 90, 200, 140, true)
    defer blue.release()
    var green = solid(80, 160, 70, 180, true)
    defer green.release()
    pixmap.fill_rect((Rect.from_xywh(2.3, 3.7, 10.5, 8.2) else trap("rect")), &red, Transform.identity(), none)
    pixmap.fill_rect((Rect.from_xywh(7.6, 6.1, 12.2, 9.9) else trap("rect")), &blue, Transform.identity(), none)
    pixmap.fill_rect((Rect.from_xywh(4.5, 12.25, 6.0, 6.0) else trap("rect")), &green, Transform.identity(), none)
    harness.expect_png(t, &pixmap, "skia/ladybird/overlap_tiny_rects.png")

## The background is a fill_rect, not Pixmap.fill.
func overlap_large_circles(t: Test*):
    var pixmap = new_pixmap(200, 200, false)
    defer pixmap.release()
    var background = solid(250, 250, 245, 255, false)
    defer background.release()
    pixmap.fill_rect((Rect.from_xywh(0.0, 0.0, 200.0, 200.0) else trap("rect")), &background, Transform.identity(), none)
    var red = solid(220, 30, 30, 120, true)
    defer red.release()
    var green = solid(30, 180, 30, 120, true)
    defer green.release()
    var blue = solid(30, 30, 220, 120, true)
    defer blue.release()
    fill(&pixmap, circle(80.0, 80.0, 60.0), &red)
    fill(&pixmap, circle(120.5, 80.5, 60.0), &green)
    fill(&pixmap, circle(100.25, 115.75, 60.0), &blue)
    harness.expect_png(t, &pixmap, "skia/ladybird/overlap_large_circles.png")

func overlap_triangles(t: Test*):
    var pixmap = new_pixmap(100, 100, true)
    defer pixmap.release()
    var red = solid(200, 50, 60, 150, true)
    defer red.release()
    var blue = solid(30, 90, 200, 150, true)
    defer blue.release()
    var black = solid(0, 0, 0, 100, true)
    defer black.release()
    fill(&pixmap, triangle(10.0, 90.0, 50.5, 8.3, 90.0, 90.0), &red)
    fill(&pixmap, triangle(5.2, 30.4, 95.7, 45.1, 20.3, 85.9), &blue)
    fill(&pixmap, triangle(30.0, 10.0, 70.0, 12.0, 52.0, 95.0), &black)
    harness.expect_png(t, &pixmap, "skia/ladybird/overlap_triangles.png")

## Sixteen triangles 3 to 12 pixels wide at fractional positions.
func overlap_tiny_shapes(t: Test*):
    var pixmap = new_pixmap(64, 64, true)
    defer pixmap.release()
    var dark = solid(20, 20, 60, 160, true)
    defer dark.release()
    var red = solid(200, 50, 60, 200, true)
    defer red.release()
    for i in 0..<16:
        let x = 2.3 + (f32)(i % 4) * 15.1
        let y = 3.7 + (f32)(i // 4) * 15.3
        let size = 3.0 + (f32)i * 0.6
        let path = triangle(x, y + size, x + size, y + size, x + size * 0.5, y)
        if i % 2 == 0:
            fill(&pixmap, path, &dark)
        else:
            fill(&pixmap, path, &red)
    harness.expect_png(t, &pixmap, "skia/ladybird/overlap_tiny_shapes.png")

# mark: images ---------------------------------------------------------------------------------

## The 16x16 test image drawn into a `size` x `size` background at (x, y) under `ts`.
func image_scene(t: Test*, image: str, size: u32, x: i32, y: i32, quality: FilterQuality, opacity: f32, ts: Transform):
    var source = source_image(16)
    defer source.release()
    var pixmap = new_pixmap(size, size, true)
    defer pixmap.release()
    var paint = PixmapPaint()
    paint.quality = quality
    paint.opacity = opacity
    pixmap.draw_pixmap(x, y, source.as_ref(), &paint, ts, none)
    harness.expect_png(t, &pixmap, image)

func image_int(t: Test*):
    image_scene(t, "skia/ladybird/image_int.png", 48, 10, 12, FilterQuality.nearest, 1.0, Transform.identity())

func image_frac_nearest(t: Test*):
    image_scene(t, "skia/ladybird/image_frac_nearest.png", 48, 0, 0, FilterQuality.nearest, 1.0, Transform.from_translate(10.5, 12.25))

func image_frac_bilinear(t: Test*):
    image_scene(t, "skia/ladybird/image_frac_bilinear.png", 48, 0, 0, FilterQuality.bilinear, 1.0, Transform.from_translate(10.5, 12.25))

func image_scale2_nearest(t: Test*):
    image_scene(t, "skia/ladybird/image_scale2_nearest.png", 48, 0, 0, FilterQuality.nearest, 1.0, Transform.from_row(2.0, 0.0, 0.0, 2.0, 7.0, 5.0))

func image_scale2_bilinear(t: Test*):
    image_scene(t, "skia/ladybird/image_scale2_bilinear.png", 48, 0, 0, FilterQuality.bilinear, 1.0, Transform.from_row(2.0, 0.0, 0.0, 2.0, 7.0, 5.0))

func image_scale2_bicubic(t: Test*):
    image_scene(t, "skia/ladybird/image_scale2_bicubic.png", 48, 0, 0, FilterQuality.bicubic, 1.0, Transform.from_row(2.0, 0.0, 0.0, 2.0, 7.0, 5.0))

func image_rotate_bilinear(t: Test*):
    image_scene(t, "skia/ladybird/image_rotate_bilinear.png", 48, 0, 0, FilterQuality.bilinear, 1.0, Transform.from_row(0.8660254, 0.5, -0.5, 0.8660254, 20.0, 6.0))

func image_opacity_half(t: Test*):
    image_scene(t, "skia/ladybird/image_opacity_half.png", 48, 10, 12, FilterQuality.nearest, 0.5, Transform.identity())

func image_opacity_half_bicubic(t: Test*):
    image_scene(t, "skia/ladybird/image_opacity_half_bicubic.png", 48, 0, 0, FilterQuality.bicubic, 0.5, Transform.from_row(1.5, 0.0, 0.0, 1.5, 5.3, 6.6))

## A 32x32 image drawn at half size.
