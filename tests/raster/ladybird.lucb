func pattern_repeat_nearest(t: Test*):
    var source = source_image(16)
    defer source.release()
    var pixmap = new_pixmap(64, 64, true)
    defer pixmap.release()
    var paint = Paint()
    defer paint.release()
    paint.anti_alias = false
    paint.shader = Pattern.new_(source.as_ref(), SpreadMode.repeat, FilterQuality.nearest, 1.0, Transform.from_translate(3.0, 5.0))
    pixmap.fill_rect((Rect.from_xywh(4.0, 4.0, 56.0, 56.0) else trap("rect")), &paint, Transform.identity(), none)
    harness.expect_png(t, &pixmap, "skia/ladybird/pattern_repeat_nearest.png")

func pattern_pad_bilinear_rrect(t: Test*):
