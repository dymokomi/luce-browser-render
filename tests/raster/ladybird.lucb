    var paint = Paint()
    defer paint.release()
    paint.shader = (LinearGradient.new_(Point.from_xy(10.0, 50.0), Point.from_xy(90.0, 50.0), [GradientStop.new_(0.0, Color.from_rgba8(220, 30, 30, 255)), GradientStop.new_(0.5, Color.from_rgba8(20, 200, 75, 200)), GradientStop.new_(1.0, Color.from_rgba8(30, 30, 220, 255))], SpreadMode.pad_, Transform.identity()) else trap("gradient"))
    fill(&pixmap, circle(50.0, 50.0, 40.5), &paint)
    harness.expect_png(t, &pixmap, "skia/ladybird/grad_linear_circle_3stops.png")

