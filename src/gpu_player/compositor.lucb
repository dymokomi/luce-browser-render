#==============================================================================================
#
#   compositor - tiles kept across frames, drawn when missing, composited every frame
#
#   DESCRIPTION:
#       A GpuCompositor belongs to one view. Each frame it takes the display list and scroll
#       state the page presented and draws them onto a luce-gpu target:
#
#         1. a new display list is cut into layers (layers.lucb) and every tile is dropped
#            (their textures go back to a pool);
#         2. for each layer, the tiles of its plane that the viewport shows are found by key:
#            the layer's number, what its pixels depend on (gpu_layer_key) and the tile's place.
#            The schedule (schedule.lucb) draws the ones not kept yet (tile_raster.lucb):
#            all of them on a new list or a layer whose pixels changed, otherwise within the
#            frame's raster budget, visible tiles first, then the tiles ahead of the scroll;
#         3. every visible tile is composited, layer by layer in paint order, moved by its
#            layer's scroll offset. A visible tile the budget left for a later frame shows the
#            page's background color (Chrome's checkerboard) and is counted. Layers blend in
#            the encoded space, as the CPU player blends them into one surface: on a target
#            that blends on encoded values (an encoded surface, or an rgba8_linear texture)
#            tiles go straight onto it; on any other they go into a frame texture of the
#            viewport's size, which is then drawn onto the target decoded for its
#            linear-light pixels (shaders/composite.frag).
#
#       A scroll therefore moves tiles and draws only those it uncovers, mostly ahead of time.
#       Tiles not used for a while are released past a budget; textures are reused through a
#       small pool.
#
#       Copyright (c) 2026 the luce-browser authors.
#       SPDX-License-Identifier: BSD-2-Clause
#
#==============================================================================================

## Tiles kept (with textures) before the least recently used are released: 96 tiles of 1 MiB.
pub let gpu_tile_budget: usize = 96

## Textures kept for reuse when tiles are dropped.
let gpu_pool_limit: usize = 16

## One kept tile: its key, its place in its layer's plane, its texture (none when empty), the
## frame it was last used in, and whether it is a preview (drawn without what filters and clip
## paths apply to, until the scroll stops: schedule.lucb).
struct GpuTile:
    var key: u64
    var x: i32
    var y: i32
    var texture: gpu.Texture?
    var used: u64
    var preview: bool

## What the compositor keeps per layer of the current list: its bins, the key its tiles were
## last drawn for, and what drawing one of its tiles has cost lately on the GPU and on the CPU
## player (ns, 0 before the first).
struct GpuLayerState:
    var bins: GpuBins
    var key: u64
    var cost: u64
    var slow_cost: u64

## The GPU compositor of one view (see the header).
pub struct GpuCompositor:
    var device: gpu.Device?
    ## The pipelines (in memory.heap), which the player draws with too.
    var pipelines: GpuPipelines*?
    var atlas: GpuAtlas
    var images: GpuImageCache
    var player: DisplayListPlayerGpu*?
    ## The allocator the CPU player draws with (the caller's; see gpu_cpu_tile).
    var cpu_allocator: memory.Allocator?
    var pixels: u8[]
    var list: const display_list.DisplayList*?
    var layers: ak.Vector[GpuLayer]
    var states: ak.Vector[GpuLayerState]
    var tiles: ak.Vector[GpuTile]
    var keys: GpuIndexMap
    var pool: ak.Vector[gpu.Texture]
    var frame: u64
    ## Tiles with textures used in this frame (which eviction keeps).
    var protected: usize
    ## The schedule: budget, motion and the tiles wanted (schedule.lucb).
    pub var schedule: GpuSchedule
    ## The page's background, shown where a visible tile is not ready.
    var background: gfx.Color
    ## The viewport's frame texture (see step 3), and its size.
    var frame_texture: gpu.Texture?
    var frame_width: i32
    var frame_height: i32
    ## A tile's commands (bins.lucb), reused.
    var commands: ak.Vector[u32]

## A compositor with nothing drawn yet.
pub func gpu_compositor_create() -> GpuCompositor*:
    return (new GpuCompositor() in memory.heap) else trap("gpu_player: out of memory")

## Releases everything the compositor holds (main thread, as every GPU call).
pub func gpu_compositor_destroy(this: GpuCompositor*):
    with memory.heap:
        gpu_compositor_drop_device(this)
        gpu_compositor_drop_layers(this)
        ak.vector_clear(&this.commands)
        this.schedule.release()
    if this.pixels.length > 0:
        free(this.pixels) in memory.heap
    free(this) in memory.heap

## Releases the tiles, caches and pipelines (and the device they were on).
func gpu_compositor_drop_device(this: GpuCompositor*):
    gpu_compositor_drop_tiles(this)
    if let texture = this.frame_texture:
        var handle = texture
        handle.destroy()
        this.frame_texture = none
    for texture in ak.vector_span(&this.pool):
        var handle = texture
        handle.destroy()
    ak.vector_clear(&this.pool)
    this.atlas.release()
    this.images.release()
    if let pipelines = this.pipelines:
        pipelines.release()
        free(pipelines) in memory.heap
        this.pipelines = none
    if let player = this.player:
        display_list_player_gpu_destroy(player)
        this.player = none
    if let device = this.device:
        var handle = device
        handle.destroy()
        this.device = none
    gpu_player_stats_the.resident_tiles = 0
    gpu_player_stats_the.resident_bytes = 0

## Drops every tile, keeping up to the pool's limit of their textures.
func gpu_compositor_drop_tiles(this: GpuCompositor*):
    for tile in ak.vector_span(&this.tiles):
        if let texture = tile.texture:
            gpu_compositor_recycle(this, texture)
    ak.vector_clear(&this.tiles)
    this.keys.clear()
    this.protected = 0
    gpu_player_stats_the.resident_tiles = 0

## Forgets the list's layers and their bins.
func gpu_compositor_drop_layers(this: GpuCompositor*):
    for index in 0..<ak.vector_size(&this.states):
        ak.vector_at(&this.states, index).bins.release()
    ak.vector_clear(&this.states)
    ak.vector_clear(&this.layers)

## Gives a tile's texture back: to the pool, or released when the pool is full.
func gpu_compositor_recycle(this: GpuCompositor*, texture: gpu.Texture):
    if ak.vector_size(&this.pool) < gpu_pool_limit:
        ak.vector_append_t(&this.pool, texture)
        return
    var handle = texture
    handle.destroy()

## A tile texture: from the pool, or new.
func gpu_compositor_texture(this: GpuCompositor*, device: gpu.Device) -> gpu.Texture!:
    if not ak.vector_is_empty(&this.pool):
        return ak.vector_take_last(&this.pool)
    return try gpu.Texture.create(device, (u32)gpu_tile_size, (u32)gpu_tile_size, gpu.Format.rgba8_linear)

## Opens what drawing needs on `target`'s device the first time (or after a device change).
func gpu_compositor_open(this: GpuCompositor*, target: const gpu.RenderTarget*) -> gpu.Device!:
    var device = try gpu.device_of(target)
    if let current = this.device:
        if current.same(&device):
            device.destroy()
            return current
        gpu_compositor_drop_device(this)
        this.list = none
    this.device = device
    let made = try gpu_pipelines_create(device)
    let stored = try new GpuPipelines() in memory.heap
    *stored = made
    this.pipelines = stored
    this.player = display_list_player_gpu_create(&this.atlas, &this.images)
    if this.pixels.length == 0:
        this.pixels = try new u8[(usize)(gpu_tile_size * gpu_tile_size * 4)] --- in memory.heap
    return device

## Takes `list` as the current display list: a new one is cut into layers and its tiles are
## drawn from scratch. Answers whether it is new.
func gpu_compositor_take_list(this: GpuCompositor*, list: display_list.DisplayList*) -> bool:
    if this.list == list:
        return false
    gpu_player_stats_the.new_lists += 1
    gpu_compositor_drop_tiles(this)
    gpu_compositor_drop_layers(this)
    this.layers = gpu_layers_of(list)
    ak.vector_resize_with_default_value(&this.states, ak.vector_size(&this.layers), GpuLayerState())
    this.background = gpu_background_of(list)
    this.list = list
    return true

## The page's background: the color of the list's first command when it fills a rectangle
## (the canvas background Ladybird paints first), transparent otherwise.
func gpu_background_of(list: const display_list.DisplayList*) -> gfx.Color:
    let commands = display_list.display_list_commands(list)
    if ak.vector_is_empty(commands):
        return gfx.Color()
    match ak.vector_at_const(commands, 0).command:
        .fill_rect(fill): return fill.color
        _: return gfx.Color()

# mark: Drawing a frame ==========================================================================

## Draws `list` at `snapshot`'s scroll offsets onto `target`, the page's device pixel (0, 0) at
## the target's top left, one device pixel a backing pixel of the target, covering `width` by
## `height` device pixels. `complete` draws every visible tile now, whatever the budget, and
## nothing ahead (for comparisons and screenshots).
## Everything the compositor keeps is in the process heap (an engine's collected heap would not
## see the compositor's pointers into it); tiles the CPU player draws are drawn with
## `cpu_allocator`, the heap the engine's painting uses (the process heap when none).
pub func gpu_compositor_draw(this: GpuCompositor*, list: display_list.DisplayList*, snapshot: const display_list.ScrollStateSnapshot*, target: const gpu.RenderTarget*,
                             width: i32, height: i32, cpu_allocator: memory.Allocator? = none, complete: bool = false) -> !:
    if width <= 0 or height <= 0:
        return
    this.cpu_allocator = cpu_allocator
    # The frame's CPU player and tile surface, here where the engine's collector sees them.
    var scratch = GpuCpuScratch()
    with memory.heap:
        try gpu_compositor_draw_frame(this, &scratch, list, snapshot, target, width, height, complete)

## gpu_compositor_draw's work, in the process heap.
func gpu_compositor_draw_frame(this: GpuCompositor*, scratch: GpuCpuScratch*, list: display_list.DisplayList*, snapshot: const display_list.ScrollStateSnapshot*, target: const gpu.RenderTarget*,
                               width: i32, height: i32, complete: bool) -> !:
    let start = time.now()
    let extent = try target.size()
    let scale = extent.pixel_width / extent.width if extent.width > 0.0 else 1.0
    let device = try gpu_compositor_open(this, target)
    let target_format = try target.pixel_format()
    let direct = target_format == gpu.Format.rgba8_linear or (try target.blending()) == gpu.Blending.encoded
    let pipelines = this.pipelines else trap("gpu_player: no pipelines")
    let copy = try pipelines.composite_for(device, gpu.Format.rgba8_linear)
    let present = try pipelines.composite_for(device, target_format)
    let fresh = gpu_compositor_take_list(this, list)
    this.frame += 1
    this.images.frame = this.frame
    let viewport = GpuRect(width = width, height = height)
    # Steps 2: the tiles drawn now, within the budget unless the frame must be complete.
    try gpu_schedule_frame(this, scratch, device, list, snapshot, viewport, start, fresh or complete, not complete)
    # Step 3: composited.
    var not_ready: usize = 0
    if direct:
        # Tiles straight onto the target, kept to the viewport, at the target's pixels.
        if let texture = this.frame_texture:
            var handle = texture
            handle.destroy()
            this.frame_texture = none
            this.frame_width = 0
            this.frame_height = 0
        let placement = try target.placement()
        let page = try target.clipped(gpu.Rect(0.0, 0.0, (f64)width / scale, (f64)height / scale))
        defer page.release()
        let origin = gfx.IntPoint(m_x = (i32)(placement.x * scale), m_y = (i32)(placement.y * scale))
        for layer_index in 0..<ak.vector_size(&this.layers):
            not_ready += try gpu_compositor_layer(this, snapshot, layer_index, viewport, page.value(), present, origin, scale)
    else:
        let frame_texture = try gpu_compositor_frame_texture(this, device, width, height)
        let frame = try frame_texture.frame()
        defer frame.release()
        let canvas = try frame.value().target()
        defer canvas.release()
        for layer_index in 0..<ak.vector_size(&this.layers):
            not_ready += try gpu_compositor_layer(this, snapshot, layer_index, viewport, canvas.value(), copy, gfx.IntPoint(), 1.0)
        _ = try frame.value().present(gpu.Color(0.0, 0.0, 0.0, 0.0))
        # The frame onto the target, decoded.
        let placement = try target.placement()
        var params = gpu_composite_uniforms((f32)(placement.x * scale), (f32)(placement.y * scale), true)
        try gpu.shade(target, present, gpu.Rect(0.0, 0.0, (f64)width / scale, (f64)height / scale), u8[]((u8*)&params[0], 12), [frame_texture], gpu.Filter.nearest)
    this.schedule.not_ready = not_ready
    if not_ready > 0:
        gpu_player_stats_the.not_ready_tiles += (u64)not_ready
        gpu_player_stats_the.not_ready_frames += 1
    gpu_compositor_evict(this)

## The frame texture for a viewport of `width` by `height` pixels, made again when it changes.
func gpu_compositor_frame_texture(this: GpuCompositor*, device: gpu.Device, width: i32, height: i32) -> gpu.Texture!:
    if let texture = this.frame_texture:
        if this.frame_width == width and this.frame_height == height:
            return texture
        var handle = texture
        handle.destroy()
        this.frame_texture = none
    let texture = try gpu.Texture.create(device, (u32)width, (u32)height, gpu.Format.rgba8_linear)
    this.frame_texture = texture
    this.frame_width = width
    this.frame_height = height
    return texture

## Composites the tiles layer `layer_index` shows in `viewport` into `canvas` with the `copy`
## pipeline: the frame texture's target, or the target itself, whose backing pixels start at
## `origin` and are `scale` to a point. A visible tile not drawn yet shows the background in the
## bottom layer and nothing in the others. Answers how many visible tiles were not ready.
func gpu_compositor_layer(this: GpuCompositor*, snapshot: const display_list.ScrollStateSnapshot*, layer_index: usize, viewport: GpuRect, canvas: const gpu.RenderTarget*,
                          copy: gpu.Pipeline, origin: gfx.IntPoint, scale: f64) -> usize!:
    let layer = ak.vector_at_const(&this.layers, layer_index)
    let offset = gpu_layer_offset(layer, snapshot)
    let key = gpu_hash(gpu_layer_key(layer, snapshot), (u64)layer_index)
    let range = gpu_tile_range(viewport.translated(-offset.m_x, -offset.m_y))
    let side = (f64)gpu_tile_size / scale
    var not_ready: usize = 0
    for row in range.y..<range.y + range.height:
        for column in range.x..<range.x + range.width:
            let x = column * gpu_tile_size + offset.m_x
            let y = row * gpu_tile_size + offset.m_y
            let found = this.keys.get(gpu_tile_key(key, column * gpu_tile_size, row * gpu_tile_size))
            if found == none:
                not_ready += 1
                if layer_index == 0:
                    try gpu_compositor_checkerboard(this, canvas, GpuRect(x = x, y = y, width = gpu_tile_size, height = gpu_tile_size).intersected(viewport), scale)
                continue
            let index = found else continue
            let texture = ak.vector_at_const(&this.tiles, (usize)index).texture else continue
            var params = gpu_composite_uniforms((f32)(x + origin.m_x), (f32)(y + origin.m_y), false)
            try gpu.shade(canvas, copy, gpu.Rect((f64)x / scale, (f64)y / scale, side, side), u8[]((u8*)&params[0], 12), [texture], gpu.Filter.nearest)
            gpu_player_stats_the.composited_tiles += 1
    return not_ready

## Fills `area` (device pixels of the viewport) of `canvas` with the page's background.
func gpu_compositor_checkerboard(this: const GpuCompositor*, canvas: const gpu.RenderTarget*, area: GpuRect, scale: f64) -> !:
    if area.is_empty() or (this.background.m_value >> 24) == 0:
        return
    let region = try canvas.clipped(gpu.Rect((f64)area.x / scale, (f64)area.y / scale, (f64)area.width / scale, (f64)area.height / scale))
    defer region.release()
    let color = gpu_straight(this.background)
    let corner = gpu.Vertex(x = -1.0, y = 1.0, z = 0.0, red = color[0], green = color[1], blue = color[2], alpha = color[3])
    var right = corner
    right.x = 1.0
    var far = right
    far.y = -1.0
    var below = corner
    below.y = -1.0
    try region.value().triangles([corner, right, far, corner, far, below])

## The tiles (column, row, columns, rows) that cover `area` of a plane.
func gpu_tile_range(area: GpuRect) -> GpuRect:
    let first_column = gpu_floor_div(area.x, gpu_tile_size)
    let first_row = gpu_floor_div(area.y, gpu_tile_size)
    let last_column = gpu_floor_div(area.x + area.width - 1, gpu_tile_size)
    let last_row = gpu_floor_div(area.y + area.height - 1, gpu_tile_size)
    return GpuRect(x = first_column, y = first_row, width = last_column - first_column + 1, height = last_row - first_row + 1)

## The key of the tile at (`x`, `y`) of the plane of the layer whose key is `key`.
func gpu_tile_key(key: u64, x: i32, y: i32) -> u64:
    return gpu_hash(gpu_hash(key, (u64)(u32)x), (u64)(u32)y)

## The kept tile at (`x`, `y`) for `key`, marked used in this frame, or none.
func gpu_compositor_touch(this: GpuCompositor*, key: u64, x: i32, y: i32) -> GpuTile*?:
    let index = this.keys.get(gpu_tile_key(key, x, y)) else return none
    let kept = ak.vector_at(&this.tiles, (usize)index)
    if kept.used != this.frame:
        kept.used = this.frame
        if kept.texture != none:
            this.protected += 1
    return kept

# mark: Eviction ================================================================================

## Releases the least recently used tiles past the budget (never this frame's: a page whose
## frame needs more keeps them), and forgets empty tiles not used for a while.
func gpu_compositor_evict(this: GpuCompositor*):
    # When the older tiles were last used, newest first.
    var stamps: ak.Vector[u64]
    defer ak.vector_clear(&stamps)
    var resident: usize = 0
    var stale = false
    for tile in ak.vector_span_const(&this.tiles):
        if tile.texture != none:
            resident += 1
            if tile.used < this.frame:
                ak.vector_append_t(&stamps, tile.used)
        elif this.frame - tile.used > 64:
            stale = true
    let older = ak.vector_span(&stamps)
    let current = resident - older.length
    let allowed = gpu_tile_budget - current if gpu_tile_budget > current else 0
    if older.length <= allowed and not stale:
        gpu_compositor_note_memory(this, resident)
        return
    for i in 1..<older.length:
        let value = older[i]
        var j = i
        while j > 0 and older[j - 1] < value:
            older[j] = older[j - 1]
            j -= 1
        older[j] = value
    # Tiles last used at or before `cutoff` go (none when the budget holds them all).
    let cutoff: u64 = older[allowed] if allowed < older.length else 0
    let dropping = allowed < older.length
    var kept: ak.Vector[GpuTile]
    resident = 0
    for tile in ak.vector_span_const(&this.tiles):
        if let texture = tile.texture:
            if dropping and tile.used <= cutoff:
                gpu_compositor_recycle(this, texture)
                continue
            resident += 1
        elif this.frame - tile.used > 64:
            continue
        ak.vector_append_t(&kept, tile)
    ak.vector_clear(&this.tiles)
    this.tiles = kept
    this.keys.clear()
    for index in 0..<ak.vector_size(&this.tiles):
        this.keys.put(ak.vector_at(&this.tiles, index).key, (u32)index)
    gpu_compositor_note_memory(this, resident)

## Counts the GPU memory held: resident tiles, pooled textures, images, the atlas and the frame.
func gpu_compositor_note_memory(this: const GpuCompositor*, resident: usize):
    let tile_bytes = (u64)(gpu_tile_size * gpu_tile_size * 4)
    gpu_player_stats_the.resident_tiles = (u64)resident
    let tiles = (u64)(resident + ak.vector_size(&this.pool)) * tile_bytes
    let frame = (u64)this.frame_width * (u64)this.frame_height * 4
    gpu_player_stats_the.resident_bytes = tiles + this.images.resident_bytes() + (u64)(this.atlas.size * this.atlas.size) + frame

## `a` divided by `b` (positive), rounded down.
func gpu_floor_div(a: i32, b: i32) -> i32:
    return a // b if a >= 0 else -((-a + b - 1) // b)
