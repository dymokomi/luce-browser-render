## The vtable of Web::Painting::DisplayListPlayerGpu.
pub let display_list_player_gpu_vtable: display_list.DisplayListPlayerVTable = display_list.DisplayListPlayerVTable(
    class_info = &display_list_player_gpu_class, flush = gpu_flush_impl, draw_glyph_run = gpu_draw_glyph_run_impl, fill_rect = gpu_fill_rect_impl,
    draw_scaled_immutable_bitmap = gpu_scaled_bitmap_impl, draw_repeated_immutable_bitmap = gpu_repeated_bitmap_impl, draw_external_content = gpu_external_content_impl,
    save = gpu_save_impl, save_layer = gpu_save_layer_impl, restore = gpu_restore_impl, translate = gpu_translate_impl, add_clip_rect = gpu_add_clip_rect_impl,
    paint_linear_gradient = gpu_linear_gradient_impl, paint_radial_gradient = gpu_radial_gradient_impl, paint_conic_gradient = gpu_conic_gradient_impl,
    paint_outer_box_shadow = gpu_outer_box_shadow_impl, paint_inner_box_shadow = gpu_inner_box_shadow_impl, paint_text_shadow = gpu_text_shadow_impl,
    fill_rect_with_rounded_corners = gpu_fill_rect_with_rounded_corners_impl, fill_path = gpu_fill_path_impl, stroke_path = gpu_stroke_path_impl,
    draw_ellipse = gpu_draw_ellipse_impl, fill_ellipse = gpu_fill_ellipse_impl, draw_line = gpu_draw_line_impl, apply_backdrop_filter = gpu_backdrop_filter_impl,
    draw_rect = gpu_draw_rect_impl, add_rounded_rect_clip = gpu_add_rounded_rect_clip_impl, paint_nested_display_list = gpu_nested_display_list_impl,
    paint_scrollbar = gpu_paint_scrollbar_impl, apply_effects = gpu_apply_effects_impl, apply_transform = gpu_apply_transform_impl,
