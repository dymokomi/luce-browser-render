let composite_frag_msl: c.str = "#pragma clang diagnostic ignored \"-Wmissing-prototypes\"\n\n#include <metal_stdlib>\n#include <simd/simd.h>\n\nusing namespace metal;\n\nstruct Params\n{\n    float2 origin;\n    float decode;\n};\n\nstruct luce_fragment_out\n{\n    float4 fragment_color [[color(0)]];\n};\n\nstatic inline __attribute__((always_inline))\nfloat3 srgb_decode(thread const float3& c)\n{\n    return mix(c / float3(12.9200000762939453125), powr((c + float3(0.054999999701976776123046875)) / float3(1.05499994754791259765625), float3(2.400000095367431640625)), step(float3(0.040449999272823333740234375), c));\n}\n\nfragment luce_fragment_out luce_fragment(constant Params& params [[buffer(0)]], texture2d<float> source [[texture(1)]], sampler sourceSmplr [[sampler(1)]], float4 gl_FragCoord [[position]])\n{\n    luce_fragment_out out = {};\n    float4 t = source.read(uint2(int2(floor(gl_FragCoord.xy - params.origin))), 0);\n    if (params.decode < 0.5)\n    {\n        out.fragment_color = t;\n        return out;\n    }\n    float4 _81;\n    if (t.w > 0.0)\n    {\n        float3 param = t.xyz / float3(t.w);\n        _81 = float4(srgb_decode(param) * t.w, t.w);\n    }\n    else\n    {\n        _81 = float4(0.0);\n    }\n    out.fragment_color = _81;\n    return out;\n}\n\n"
