# mark: SVGPatternPaintStyle ===================================================================

## Ported from Libraries/LibWeb/Painting/PaintStyle.cpp:12 Web::Painting::SVGPatternPaintStyle::create.
pub func svg_pattern_paint_style_create(tile_display_list: DisplayList*, tile_rect: gfx.FloatRect, pattern_transform: gfx.AffineTransform?) -> SvgPatternPaintStyle*:
    let header = svg_paint_server_paint_style_header(&svg_pattern_paint_style_vtable, &svg_pattern_paint_style_class)
    let this = new SvgPatternPaintStyle(svg_paint_server_paint_style_base = header, m_tile_display_list = tile_display_list) else trap("out of memory")
    svg_pattern_paint_style_construct(this, tile_display_list, tile_rect, pattern_transform)
    return this

## Ported from Libraries/LibWeb/Painting/PaintStyle.cpp:17 Web::Painting::SVGPatternPaintStyle::SVGPatternPaintStyle.
func svg_pattern_paint_style_construct(this: SvgPatternPaintStyle*, tile_display_list: DisplayList*, tile_rect: gfx.FloatRect, pattern_transform: gfx.AffineTransform?):
    this.m_tile_display_list = tile_display_list
    this.m_tile_rect = tile_rect
    this.m_pattern_transform = pattern_transform

## Ported from Libraries/LibWeb/Painting/PaintStyle.h:136 Web::Painting::SVGPatternPaintStyle::tile_display_list.
pub func svg_pattern_paint_style_tile_display_list(this: const SvgPatternPaintStyle*) -> DisplayList*:
    return this.m_tile_display_list

## Ported from Libraries/LibWeb/Painting/PaintStyle.h:137 Web::Painting::SVGPatternPaintStyle::tile_rect.
pub func svg_pattern_paint_style_tile_rect(this: const SvgPatternPaintStyle*) -> gfx.FloatRect:
    return this.m_tile_rect

## Ported from Libraries/LibWeb/Painting/PaintStyle.h:138 Web::Painting::SVGPatternPaintStyle::pattern_transform.
pub func svg_pattern_paint_style_pattern_transform(this: const SvgPatternPaintStyle*) -> gfx.AffineTransform?:
    return this.m_pattern_transform
