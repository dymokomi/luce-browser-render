## Ported from Libraries/LibWeb/Painting/PaintStyle.h:100 Web::Painting::SVGRadialGradientPaintStyle::create.
pub func svg_radial_gradient_paint_style_create(start_center: gfx.FloatPoint, start_radius: f32, end_center: gfx.FloatPoint, end_radius: f32) -> SvgRadialGradientPaintStyle*:
    let header = svg_paint_server_paint_style_header(&svg_radial_gradient_paint_style_vtable, &svg_radial_gradient_paint_style_class)
    let this = new SvgRadialGradientPaintStyle(svg_gradient_paint_style_base = svg_gradient_paint_style_default(header)) else trap("out of memory")
    svg_radial_gradient_paint_style_construct(this, start_center, start_radius, end_center, end_radius)
    return this

