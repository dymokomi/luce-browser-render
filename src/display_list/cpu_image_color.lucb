#==============================================================================================
#
#   cpu_image_color - the color space conversion of an image drawn by the CPU player
#
#   DESCRIPTION:
#       New code for DisplayListPlayerCpu (DESIGN.md §7.3). Ladybird's Skia player draws an
#       ImmutableBitmap through its SkImage, which carries the bitmap's Gfx::ColorSpace
#       (ImmutableBitmap::create); the painting surface is sRGB (PaintingSurface makes every
#       SkSurface with SkColorSpace::MakeSRGB()), so SkImageShader converts the sampled
#       pixels from the image's color space to sRGB with SkColorSpaceXformSteps. This is that
#       conversion for a raster pattern: the steps from luce-color (`icc.Steps`), run by the
#       raster's color_xform stage. A bitmap without a color space is sRGB, and so draws as
#       before. The pattern's pixels are premultiplied (cpu_pixmap_of_immutable_bitmap
#       premultiplies an unpremultiplied bitmap as it copies it), so the steps start there.
#
#       Copyright (c) 2026 the luce-browser authors.
#       SPDX-License-Identifier: BSD-2-Clause
#
#==============================================================================================

from luce_color import icc

## The conversion of `image`'s pixels to the sRGB surface, or none when there is nothing to
## convert.
func cpu_image_color_xform(image: const gfx.ImmutableBitmap*) -> raster.ColorXform?:
    var color_space = image.m_impl.color_space
    let source = *gfx.color_space_color_space_sk_sp(&color_space) else return none
    let destination = icc.ColorSpace.srgb()
    return raster.ColorXform.make(icc.Steps.make(source, .premul, &destination, .premul))
