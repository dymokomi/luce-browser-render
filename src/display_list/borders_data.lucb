## Ported from Libraries/LibWeb/Painting/BordersData.h:37 Web::Painting::BordersDataDevicePixels::for_edge.
pub func borders_data_device_pixels_for_edge(this: BordersDataDevicePixels*, edge: BorderEdge) -> BorderDataDevicePixels*:
    match edge:
        .top: return &this.top
        .right: return &this.right
        .bottom: return &this.bottom
        # BorderEdge::Left:
        _: return &this.left

## Ported from Libraries/LibWeb/Painting/BordersData.h:51 Web::Painting::BordersDataDevicePixels::for_edge.
pub func borders_data_device_pixels_for_edge_const(this: const BordersDataDevicePixels*, edge: BorderEdge) -> const BorderDataDevicePixels*:
    return borders_data_device_pixels_for_edge((BordersDataDevicePixels*)this, edge)
