#==============================================================================================
#
#   tests_oracle - the web_fonts module against the reference build: faces, metrics, shaping,
#                  glyph paths and text-blob bounds
#
#   DESCRIPTION:
#       Printed by a local oracle program linked against the reference build's LibGfx
#       (Ladybird 47c82b38d0 with Skia's FreeType backend under the FontConfig font manager,
#       which Ladybird's test mode forces, and HarfBuzz 10.2.0); regenerate rather than edit.
#       Floats are compared bit for bit through their IEEE bits (DESIGN.md §6.7). The bodies
#       are in tests_support.lucb.
#
#==============================================================================================

test "blob_serenity_sans_87":
    test_body_blob_bounds("SerenitySans-Regular.ttf", f32.bits(0x41400000), "foo bar", f32.bits(0x3f800000), [0x40690000, 0x40f80000, 0x42869800, 0x41698000])

test "intercepts_serenity_sans_88":
    let expected: f32[12] = [f32.bits(0x40acfa23), f32.bits(0x40f07965), f32.bits(0x412fb3c7), f32.bits(0x4199a428), f32.bits(0x41aab9e4), f32.bits(0x41ec8428), f32.bits(0x421ddd43), f32.bits(0x423c44c1), f32.bits(0x4242b7ea), f32.bits(0x4260852d), f32.bits(0x426a5640), f32.bits(0x4282d000)]
    test_body_intercepts("SerenitySans-Regular.ttf", f32.bits(0x41400000), "foo bar", f32.bits(0x3f800000), expected[0..<12])

test "blob_serenity_sans_89":
    test_body_blob_bounds("SerenitySans-Regular.ttf", f32.bits(0x41400000), "Typography gjpqy", f32.bits(0x40000000), [0x40e90000, 0x41780000, 0x4392b400, 0x41e98000])

test "intercepts_serenity_sans_90":
    let expected: f32[30] = [f32.bits(0x418a2c3c), f32.bits(0x41b36ba3), f32.bits(0x420af9ba), f32.bits(0x422c5848), f32.bits(0x42404fa8), f32.bits(0x427b34de), f32.bits(0x4285bcf2), f32.bits(0x42a6a214), f32.bits(0x42ac8a2a), f32.bits(0x42c61717), f32.bits(0x42cdb640), f32.bits(0x42e90000), f32.bits(0x42eec7ea), f32.bits(0x43064a96), f32.bits(0x430b1bea), f32.bits(0x4319d538), f32.bits(0x431d8dd4), f32.bits(0x432c7000), f32.bits(0x43318e6f), f32.bits(0x4339e612), f32.bits(0x434d8515), f32.bits(0x435a4b8b), f32.bits(0x43613a44), f32.bits(0x4365a293), f32.bits(0x436aebea), f32.bits(0x4379a538), f32.bits(0x437d76db), f32.bits(0x4387c917), f32.bits(0x438a7337), f32.bits(0x438e9f09)]
    test_body_intercepts("SerenitySans-Regular.ttf", f32.bits(0x41400000), "Typography gjpqy", f32.bits(0x40000000), expected[0..<30])

test "blob_lato_bold_91":
    test_body_blob_bounds("Lato-Bold.ttf", f32.bits(0x41400000), "fi Tj AV", f32.bits(0x3f800000), [0x40056042, 0x40a8418a, 0x426d40e6, 0x418f0a3e])

test "intercepts_lato_bold_92":
    let expected: f32[10] = [f32.bits(0x409d0000), f32.bits(0x413e8000), f32.bits(0x419f2000), f32.bits(0x41b05800), f32.bits(0x41d73800), f32.bits(0x41e70800), f32.bits(0x420b4ed1), f32.bits(0x422b1aa7), f32.bits(0x423526ed), f32.bits(0x42512112)]
    test_body_intercepts("Lato-Bold.ttf", f32.bits(0x41400000), "fi Tj AV", f32.bits(0x3f800000), expected[0..<10])
