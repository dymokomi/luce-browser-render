#==============================================================================================
#
#   highp_color - the color-conversion stages of the high precision pipeline
#
#   DESCRIPTION:
#       The highp stages gradients interpolated in another color space end with before their
#       color_xform (Skia m144's unpremul, unpremul_polar and the css_* stages): each lane
#       goes through color_math.lucb's port of the stage's NEON arithmetic. Skia has no lowp
#       form of these stages, so a pipeline with one of them runs in highp.
#
#       Copyright (c) 2018 Google Inc. All rights reserved.
#       Copyright (c) 2026 the luce-browser authors.
#       SPDX-License-Identifier: BSD-3-Clause (see LICENSE-skia)
#
#==============================================================================================

## Runs `convert` on each lane's (r, g, b, a).
func highp_color_lanes(p: HighpPipeline*, convert: func(HighpPipeline*, f32[4]) -> f32[4]):
    for h: usize in 0..<2:
        for i: usize in 0..<4:
            let c = convert(p, [p.r[h][i], p.g[h][i], p.b[h][i], p.a[h][i]])
            p.r[h][i] = c[0]
            p.g[h][i] = c[1]
            p.b[h][i] = c[2]
            p.a[h][i] = c[3]

## unpremul: rgb divided by alpha.
func highp_unpremul_lane(p: HighpPipeline*, c: f32[4]) -> f32[4]:
    _ = p
    return color_unpremul(c)

func highp_unpremul(p: HighpPipeline*):
    highp_color_lanes(p, highp_unpremul_lane)
    highp_next_stage(p)

## unpremul_polar: the non-hue channels divided by alpha.
func highp_unpremul_polar_lane(p: HighpPipeline*, c: f32[4]) -> f32[4]:
    _ = p
    return color_unpremul_polar(c)

func highp_unpremul_polar(p: HighpPipeline*):
    highp_color_lanes(p, highp_unpremul_polar_lane)
    highp_next_stage(p)

## css_lab_to_xyz.
func highp_css_lab_to_xyz_lane(p: HighpPipeline*, c: f32[4]) -> f32[4]:
    _ = p
    return css_lab_to_xyz(c)

func highp_css_lab_to_xyz(p: HighpPipeline*):
    highp_color_lanes(p, highp_css_lab_to_xyz_lane)
    highp_next_stage(p)

## css_oklab_to_linear_srgb.
func highp_css_oklab_to_linear_srgb_lane(p: HighpPipeline*, c: f32[4]) -> f32[4]:
    _ = p
    return css_oklab_to_linear_srgb(c)

func highp_css_oklab_to_linear_srgb(p: HighpPipeline*):
    highp_color_lanes(p, highp_css_oklab_to_linear_srgb_lane)
    highp_next_stage(p)

## css_hcl_to_lab.
func highp_css_hcl_to_lab_lane(p: HighpPipeline*, c: f32[4]) -> f32[4]:
    _ = p
    return css_hcl_to_lab(c)

func highp_css_hcl_to_lab(p: HighpPipeline*):
    highp_color_lanes(p, highp_css_hcl_to_lab_lane)
    highp_next_stage(p)

## css_hsl_to_srgb.
func highp_css_hsl_to_srgb_lane(p: HighpPipeline*, c: f32[4]) -> f32[4]:
    _ = p
    return css_hsl_to_srgb(c)

func highp_css_hsl_to_srgb(p: HighpPipeline*):
    highp_color_lanes(p, highp_css_hsl_to_srgb_lane)
    highp_next_stage(p)

## css_hwb_to_srgb.
func highp_css_hwb_to_srgb_lane(p: HighpPipeline*, c: f32[4]) -> f32[4]:
    _ = p
    return css_hwb_to_srgb(c)

func highp_css_hwb_to_srgb(p: HighpPipeline*):
    highp_color_lanes(p, highp_css_hwb_to_srgb_lane)
    highp_next_stage(p)
