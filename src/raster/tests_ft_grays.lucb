#==============================================================================================
#
#   tests_ft_grays - FreeType's gray rasterizer against FreeType's bytes
#
#   DESCRIPTION:
#       ft_outline_render_gray against FreeType 2.13.3's FT_Outline_Get_Bitmap (the vcpkg build
#       of the reference Ladybird), recorded locally: lines, conics with implied on-curve
#       points, a contour starting on a control point, cubics, both fill rules, clipping by
#       the bitmap and a curve large enough to be cut into many lines. The rasterizer's
#       arithmetic is integer only, so the bytes match on every platform.
#
#==============================================================================================

## Renders an outline into a `width` x `height` bitmap and compares it with FreeType's rows
## (two hex digits per pixel, top row first).
func expect_ft_gray(name: str, xs: const i64[], ys: const i64[], tags: const u8[], ends: const usize[], even_odd: bool, width: i32, height: i32, expected: str):
    let outline = FtOutline(xs = xs, ys = ys, tags = tags, contour_ends = ends, even_odd = even_odd)
    let buffer = (new u8[(usize)(width * height)] in memory.heap) else trap("out of memory")
    defer free(buffer) in memory.heap
    assert(ft_outline_render_gray(&outline, buffer, width, height, width), "the outline is valid")
    let text = expected.bytes
    var index: usize = 0
    var i: usize = 0
    while i < text.length:
        if text[i] == ' ' or text[i] == '\n':
            i += 1
            continue
        let value = (ft_test_hex(text[i]) << 4) | ft_test_hex(text[i + 1])
        i += 2
        if buffer[index] != value:
            print(f"{name}: pixel ({index % (usize)width}, {index // (usize)width}) is {buffer[index]}, FreeType's {value}")
            trap("the gray bitmap differs from FreeType's")
        index += 1
    assert(index == buffer.length, "every pixel was compared")

## The value of a hexadecimal digit.
func ft_test_hex(c: u8) -> u8:
    if c >= '0' and c <= '9':
        return c - '0'
    return c - 'a' + 10

test "ft_grays: a self-overlapping star, non-zero":
    let xs: i64[5] = [640, 830, 130, 1150, 450]
    let ys: i64[5] = [1250, 60, 800, 820, 70]
    let tags: u8[5] = [1, 1, 1, 1, 1]
    let ends: usize[1] = [4]
    expect_ft_gray("star_nonzero", xs, ys, tags, ends, false, 20, 20, ft_gray_star_nonzero)

test "ft_grays: a self-overlapping star, even-odd":
    let xs: i64[5] = [640, 830, 130, 1150, 450]
    let ys: i64[5] = [1250, 60, 800, 820, 70]
    let tags: u8[5] = [1, 1, 1, 1, 1]
    let ends: usize[1] = [4]
    expect_ft_gray("star_even_odd", xs, ys, tags, ends, true, 20, 20, ft_gray_star_even_odd)

test "ft_grays: conics with implied on-curve points":
    let xs: i64[12] = [100, 100, 600, 1100, 1100, 1100, 600, 100, 300, 600, 900, 600]
    let ys: i64[12] = [600, 1100, 1100, 1100, 600, 100, 100, 100, 600, 900, 600, 300]
    let tags: u8[12] = [1, 0, 1, 0, 1, 0, 1, 0, 0, 0, 0, 0]
    let ends: usize[2] = [7, 11]
    expect_ft_gray("conics", xs, ys, tags, ends, false, 20, 20, ft_gray_conics)

test "ft_grays: a contour that starts on a conic control point":
    let xs: i64[5] = [200, 1000, 1100, 300, 150]
    let ys: i64[5] = [200, 250, 1000, 1150, 700]
    let tags: u8[5] = [0, 1, 0, 1, 1]
    let ends: usize[1] = [4]
    expect_ft_gray("conic_start_off", xs, ys, tags, ends, false, 20, 20, ft_gray_conic_start_off)

test "ft_grays: cubics, a hole wound the other way":
    let xs: i64[12] = [64, 64, 1216, 1216, 1216, 64, 400, 400, 880, 880, 880, 400]
    let ys: i64[12] = [640, 1300, 1300, 640, -20, -20, 640, 300, 300, 640, 980, 980]
    let tags: u8[12] = [1, 2, 2, 1, 2, 2, 1, 2, 2, 1, 2, 2]
    let ends: usize[2] = [5, 11]
    expect_ft_gray("cubics", xs, ys, tags, ends, false, 22, 22, ft_gray_cubics)

test "ft_grays: an outline clipped by the bitmap on every side":
    let xs: i64[5] = [-300, 700, 1500, 900, 20]
    let ys: i64[5] = [500, -250, 600, 1400, 1350]
    let tags: u8[5] = [1, 1, 1, 1, 1]
    let ends: usize[1] = [4]
    expect_ft_gray("clipped", xs, ys, tags, ends, false, 16, 16, ft_gray_clipped)

test "ft_grays: a sliver and a large conic":
    let xs: i64[7] = [70, 2500, 2500, 70, 200, 2400, 3000]
    let ys: i64[7] = [70, 90, 110, 100, 300, 3800, 300]
    let tags: u8[7] = [1, 1, 1, 1, 1, 0, 1]
    let ends: usize[2] = [3, 6]
    expect_ft_gray("sliver_and_big_conic", xs, ys, tags, ends, false, 48, 64, ft_gray_sliver_and_big_conic)

