## Ported from Libraries/LibGfx/Color.cpp:181 Gfx::Color::from_named_css_color_string.
pub func color_from_named_css_color_string(string: ak.StringView) -> Color?:
    if ak.string_view_is_empty(&string):
        return none

    for web_color in web_colors:
        if ak.string_view_equals_ignoring_ascii_case(&string, ak.sv(web_color.name)):
            return color_from_bgrx(web_color.color)

    return none
