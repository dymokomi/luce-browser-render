#==============================================================================================
#
#   painter - Painter: the abstract 2D painter (Canvas 2D and friends)
#
#   DESCRIPTION:
#       Port of Libraries/LibGfx/Painter.cpp (lines 1-22) and the pure virtual members of
#       Libraries/LibGfx/Painter.h (lines 1-50). The struct, its vtable and the dispatchers
#       are in types_painter. Painter::create answers the one implementation, PainterRaster
#       (painter_raster), which replaces PainterSkia. The virtual destructor has nothing to
#       port.
#
#==============================================================================================

## Ported from Libraries/LibGfx/Painter.cpp:16 Gfx::Painter::create.
pub func painter_create(target_bitmap: Bitmap*) -> Painter*:
    let painting_surface = painting_surface_wrap_bitmap(target_bitmap)
    return painter_raster_create(painting_surface).painter()

