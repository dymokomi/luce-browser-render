#==============================================================================================
#
#   color_space - ColorSpace: color spaces from CICP code points and ICC profiles
#
#   DESCRIPTION:
#       Port of Libraries/LibGfx/ColorSpace.cpp (lines 16-163): the constructors,
#       ColorSpace::from_cicp, ColorSpace::load_from_icc_bytes and the color_space<T>()
#       accessor. The IPC encoder and decoder (lines 167-205) are not ported.
#
#       Skia is replaced in this port. ColorSpace wraps Skia's `sk_sp<SkColorSpace>`; here it
#       wraps luce-color's `icc.ColorSpace`, the port of SkColorSpace, and the Skia and skcms
#       calls of the donor are luce-color's ports of them (DESIGN.md §7.0): skcms_Parse is
#       `icc.parse`, SkColorSpace::Make(profile) `icc.ColorSpace.from_profile`, MakeRGB
#       `icc.ColorSpace.rgb`, skcms_ApproximateCurve `icc.Curve.approximate`, and the
#       SkNamedPrimaries, SkNamedTransferFn and SkNamedGamut constants luce-color's.
#
#==============================================================================================

# mark: ColorSpace ==============================================================================

## Ported from Libraries/LibGfx/ColorSpace.cpp:26 Gfx::ColorSpace::ColorSpace.
pub func color_space_construct(this: ColorSpace*):
    this.m_color_space = new ColorSpaceImpl(color_space = none) else trap("out of memory")

## Ported from Libraries/LibGfx/ColorSpace.cpp:47 Gfx::ColorSpace::ColorSpace.
pub func color_space_construct_color_space_impl(this: ColorSpace*, color_space: ColorSpaceImpl*):
    this.m_color_space = color_space

## `ColorSpace { make<Details::ColorSpaceImpl>(color_space) }` as an expression.
func color_space_new_sk_color_space(color_space: icc.ColorSpace?) -> ColorSpace:
    var sk: SkSpSkColorSpace = none
    if let value = color_space:
        sk = new SkColorSpace(transfer_function = value.transfer_function, to_xyzd50 = value.to_xyzd50) else trap("out of memory")
    let impl = new ColorSpaceImpl(color_space = sk) else trap("out of memory")
    var result: ColorSpace = ---
    color_space_construct_color_space_impl(&result, impl)
    return result

## The primaries `switch` of ColorSpace::from_cicp (ColorSpace.cpp:58), a lambda answering
## ErrorOr<SkColorSpacePrimaries> in the C++.
func color_space_from_cicp_primaries(color_primaries: MediaColorPrimaries) -> icc.NamedPrimaries!:
    match color_primaries:
        .bt709, .unspecified:
            return icc.primaries_rec709
        .bt470m:
            return icc.primaries_rec470_system_m
        .bt470bg:
            return icc.primaries_rec470_system_bg
        .bt601:
            return icc.primaries_rec601
        .smpte240:
            return icc.primaries_smpte_st_240
        .generic_film:
            return icc.primaries_generic_film
        .bt2020:
            return icc.primaries_rec2020
        .xyz:
            trap("VERIFY_NOT_REACHED")
        .smpte431:
            return icc.primaries_smpte_rp_431_2
        .smpte432:
            return icc.primaries_smpte_eg_432_1
        .ebu3213:
            return icc.primaries_itu_t_h273_value22
        _:
            error(ak.ak_error, "Illegal color primaries")

## The gamut lambda of ColorSpace::from_cicp (ColorSpace.cpp:54), answering
## ErrorOr<skcms_Matrix3x3> in the C++.
func color_space_from_cicp_gamut(cicp: const MediaCodingIndependentCodePoints*) -> icc.Matrix3x3!:
    if cicp.m_color_primaries == MediaColorPrimaries.xyz:
        return icc.gamut_xyz

    let primaries = try color_space_from_cicp_primaries(cicp.m_color_primaries)
    return primaries.to_xyzd50() else trap("VERIFY(primaries.toXYZD50(&result))")

## The transfer function lambda of ColorSpace::from_cicp (ColorSpace.cpp:91), answering
## ErrorOr<skcms_TransferFunction> in the C++.
func color_space_from_cicp_transfer_function(transfer_characteristics: MediaTransferCharacteristics) -> icc.TransferFunction!:
    match transfer_characteristics:
        .bt709, .unspecified, .bt601, .bt2020_bit_depth10, .bt2020_bit_depth12:
            # This isn't technically correct, but Chromium has set the precedent that these are treated as sRGB as an
            # optimization. Using the actual transfer characteristics will produce output inconsistent with other
            # browsers, so we unfortunately have to follow suit.
            return icc.tf_srgb
        .bt470m:
            return icc.tf_rec470_system_m
        .bt470bg:
            return icc.tf_rec470_system_bg
        .smpte240:
            return icc.tf_smpte_st_240
        .linear:
            return icc.tf_linear
        .log100, .log100_sqrt10:
            error(ak.ak_error, "Logarithmic transfer characteristics are unsupported.")
        .iec61966:
            return icc.tf_iec61966_2_4
        .bt1361:
            error(ak.ak_error, "BT.1361 transfer characteristics are not supported.")
        .srgb:
            return icc.tf_srgb
        .smpte2084:
            return icc.tf_pq
        .smpte428:
            return icc.tf_smpte_st_428_1
        .hlg:
            # FIXME: This will need to change to use the HLG transfer function when the surface we're painting to
            #        supports HDR.
            return icc.tf_srgb
        _:
            error(ak.ak_error, "Illegal transfer characteristics")

## Ported from Libraries/LibGfx/ColorSpace.cpp:52 Gfx::ColorSpace::from_cicp.
pub func color_space_from_cicp(cicp: MediaCodingIndependentCodePoints) -> ColorSpace!:
    let gamut = try color_space_from_cicp_gamut(&cicp)

    let transfer_function = try color_space_from_cicp_transfer_function(cicp.m_transfer_characteristics)

    return color_space_new_sk_color_space(icc.ColorSpace.rgb(&transfer_function, &gamut))

## Ported from Libraries/LibGfx/ColorSpace.cpp:134 Gfx::ColorSpace::load_from_icc_bytes.
pub func color_space_load_from_icc_bytes(icc_bytes: const u8[]) -> ColorSpace!:
    if icc_bytes.length != 0:
        let icc_profile = icc.parse(icc_bytes) else error(ak.ak_error, "Failed to parse the ICC profile")

        var color_space_result = icc.ColorSpace.from_profile(&icc_profile)

        if color_space_result == none:
            if icc_profile.has_trc and icc_profile.has_to_xyzd50:
                if let found = icc_profile.trc[0].approximate():
                    let (transfer_function, max_error) = found
                    _ = max_error
                    color_space_result = icc.ColorSpace.rgb(&transfer_function, &icc_profile.to_xyzd50)

        return color_space_new_sk_color_space(color_space_result)
    var color_space: ColorSpace = ---
    color_space_construct(&color_space)
    return color_space

## Ported from Libraries/LibGfx/ColorSpace.cpp:160 Gfx::ColorSpace::color_space.
## The C++ template is specialized for sk_sp<SkColorSpace> only; this answers the reference to
## the stand-in.
pub func color_space_color_space_sk_sp(this: ColorSpace*) -> SkSpSkColorSpace*:
    return &this.m_color_space.color_space
