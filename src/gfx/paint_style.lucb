#==============================================================================================
#
#   paint_style - PaintStyle and its solid, gradient and pattern subclasses
#
#   DESCRIPTION:
#       Port of Libraries/LibGfx/PaintStyle.cpp (lines 1-29) with the inline members of
#       Libraries/LibGfx/PaintStyle.h (lines 1-279). The structs, vtables and ClassInfos are
#       in types_paint_style. PaintStyle is RefCounted in C++; here a style is a managed
#       allocation (DESIGN.md §3.3) whose header (vtable, class id) paint_style_allocate
#       fills in, as the C++ vptr is set by `new`. `create` reports a failed allocation as
#       an error, as adopt_nonnull_ref_or_enomem does.
#
#==============================================================================================

# mark: Allocation =============================================================================

# `new (nothrow) T(...)` for a class of the PaintStyle hierarchy: zeroed storage of the
# class's size whose header names the class, ready for the class's constructor.
func paint_style_allocate(class_info: const ak.ClassInfo*) -> PaintStyle*!:
    let block = try alloc(class_info.size, 8)
    memory.set(block, 0)
    let style = (PaintStyle*)block.data
    style.vtable = (const PaintStyleVTable*)class_info.vtable
    style.class_id = class_info.first_id
    return style

# mark: PaintStyle =============================================================================

## Ported from Libraries/LibGfx/PaintStyle.h:26 Gfx::PaintStyle::is_visible (virtual).
pub func paint_style_is_visible_impl(this: PaintStyle*) -> bool:
    return true

# mark: SolidColorPaintStyle ===================================================================

## Ported from Libraries/LibGfx/PaintStyle.h:31 Gfx::SolidColorPaintStyle::create.
pub func solid_color_paint_style_create(color: Color) -> SolidColorPaintStyle*!:
    let this = (SolidColorPaintStyle*)(try paint_style_allocate(&solid_color_paint_style_class))
    solid_color_paint_style_construct(this, color)
    return this

## Ported from Libraries/LibGfx/PaintStyle.h:36 Gfx::SolidColorPaintStyle::is_visible (override).
pub func solid_color_paint_style_is_visible_impl(base: PaintStyle*) -> bool:
    let this = (SolidColorPaintStyle*)base
    return color_alpha(&this.m_color) > 0

## Ported from Libraries/LibGfx/PaintStyle.h:38 Gfx::SolidColorPaintStyle::color.
pub func solid_color_paint_style_color(this: SolidColorPaintStyle*) -> Color:
    return this.m_color

## Ported from Libraries/LibGfx/PaintStyle.h:41 Gfx::SolidColorPaintStyle::SolidColorPaintStyle.
pub func solid_color_paint_style_construct(this: SolidColorPaintStyle*, color: Color):
    this.m_color = color

# mark: GradientPaintStyle =====================================================================

## Ported from Libraries/LibGfx/PaintStyle.h:51 Gfx::GradientPaintStyle::add_color_stop.
pub func gradient_paint_style_add_color_stop_f32(this: GradientPaintStyle*, position: f32, color: Color, transition_hint: f32? = none) -> !:
    try gradient_paint_style_add_color_stop_color_stop(this, ColorStop(color = color, position = position, transition_hint = transition_hint))

# add_color_stop's sort comparator: [](auto& a, auto& b) { return a.position < b.position; }
func gradient_paint_style_color_stop_less(context: void*?, a: const ColorStop*, b: const ColorStop*) -> bool:
    discard(context)
    return a.position < b.position

## Ported from Libraries/LibGfx/PaintStyle.h:56 Gfx::GradientPaintStyle::add_color_stop.
pub func gradient_paint_style_add_color_stop_color_stop(this: GradientPaintStyle*, stop: ColorStop, sort: bool = true) -> !:
    try ak.vector_try_append_t(&this.m_color_stops, stop)
    if sort:
        let less = ak.Function2[const ColorStop*, const ColorStop*, bool](call = gradient_paint_style_color_stop_less, context = none)
        ak.quick_sort_t_collection_t_less_than(ak.vector_span(&this.m_color_stops), less)

## Ported from Libraries/LibGfx/PaintStyle.h:64 Gfx::GradientPaintStyle::set_repeat_length.
pub func gradient_paint_style_set_repeat_length(this: GradientPaintStyle*, repeat_length: f32):
    this.m_repeat_length = repeat_length

## Ported from Libraries/LibGfx/PaintStyle.h:69 Gfx::GradientPaintStyle::color_stops.
pub func gradient_paint_style_color_stops(this: GradientPaintStyle*) -> const ColorStop[]:
    return ak.vector_span_const(&this.m_color_stops)

## Ported from Libraries/LibGfx/PaintStyle.h:70 Gfx::GradientPaintStyle::set_color_stops.
pub func gradient_paint_style_set_color_stops(this: GradientPaintStyle*, color_stops: ak.Vector[ColorStop]):
    # Vector&& moved in: the storage is taken over, not copied.
    this.m_color_stops = color_stops

## Ported from Libraries/LibGfx/PaintStyle.h:72 Gfx::GradientPaintStyle::repeat_length.
pub func gradient_paint_style_repeat_length(this: GradientPaintStyle*) -> f32?:
    return this.m_repeat_length

## Ported from Libraries/LibGfx/PaintStyle.h:74 Gfx::GradientPaintStyle::is_visible (override).
pub func gradient_paint_style_is_visible_impl(base: PaintStyle*) -> bool:
    let this = (GradientPaintStyle*)base
    # any_of(m_color_stops, [](auto& stop) { return stop.color.alpha() > 0; })
    for stop in ak.vector_span_const(&this.m_color_stops):
        if color_alpha(&stop.color) > 0:
            return true
    return false

