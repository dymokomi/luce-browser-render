## Ported from Libraries/LibGfx/Rect.h:84 Gfx::Rect::center for DevicePixelRect.
pub func device_pixel_rect_center(this: const DevicePixelRect*) -> IntPoint:
    return IntPoint(device_pixel_rect_x(this) + device_pixel_rect_width(this) // 2, device_pixel_rect_y(this) + device_pixel_rect_height(this) // 2)

