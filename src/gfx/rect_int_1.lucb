#==============================================================================================
#
#   rect_int_1 - Gfx::Rect<int> (IntRect, DevicePixelRect): construction to orientation
#
#   DESCRIPTION:
#       Port of Libraries/LibGfx/Rect.h (lines 19-347) for T = int. The skeleton names
#       Gfx::Rect<int> `DevicePixelRect` (DevicePixels is int in this port), so these are the
#       `device_pixel_rect_*` functions; rect_int_2.lucb has the rest of the class. The class
#       template is instantiated per type (DESIGN.md §2.8): rect_float_* and rect_css_pixels_*
#       hold the other instantiations, function for function.
#
#       Member templates over a second type U are instantiated for the types phase 1 uses: the
#       constructors from `Point<U>`/`Size<U>` and from `Rect<U>` are the `to_type_*` functions
#       of the other instantiations; `contains(Container)` and `intersects(Container)` take a
#       span of rects. As in C++, int overflow is not defined: it traps here.
#
#==============================================================================================

# mark: Construction and access =================================================================

## Ported from Libraries/LibGfx/Rect.h:24 Gfx::Rect::Rect<T> for DevicePixelRect.
pub func device_pixel_rect_construct_i32(this: DevicePixelRect*, x: i32, y: i32, width: i32, height: i32):
    this.m_location = IntPoint(x, y)
    this.m_size = IntSize(width, height)

## Ported from Libraries/LibGfx/Rect.h:31 Gfx::Rect::Rect<T>(U x, U y, U width, U height) for DevicePixelRect, with U = float.
pub func device_pixel_rect_construct_f32(this: DevicePixelRect*, x: f32, y: f32, width: f32, height: f32):
    int_point_construct_f32(&this.m_location, x, y)
    int_size_construct_f32(&this.m_size, width, height)

## Ported from Libraries/LibGfx/Rect.h:37 Gfx::Rect::Rect<T> for DevicePixelRect.
pub func device_pixel_rect_construct_int_point(this: DevicePixelRect*, location: IntPoint, size: IntSize):
    this.m_location = location
    this.m_size = size

## Ported from Libraries/LibGfx/Rect.h:57 Gfx::Rect::x for DevicePixelRect.
pub func device_pixel_rect_x(this: const DevicePixelRect*) -> i32:
    return int_point_x(&this.m_location)

## Ported from Libraries/LibGfx/Rect.h:58 Gfx::Rect::y for DevicePixelRect.
pub func device_pixel_rect_y(this: const DevicePixelRect*) -> i32:
    return int_point_y(&this.m_location)

## Ported from Libraries/LibGfx/Rect.h:59 Gfx::Rect::width for DevicePixelRect.
pub func device_pixel_rect_width(this: const DevicePixelRect*) -> i32:
    return int_size_width(&this.m_size)

## Ported from Libraries/LibGfx/Rect.h:60 Gfx::Rect::height for DevicePixelRect.
pub func device_pixel_rect_height(this: const DevicePixelRect*) -> i32:
    return int_size_height(&this.m_size)

## Ported from Libraries/LibGfx/Rect.h:62 Gfx::Rect::set_x for DevicePixelRect.
pub func device_pixel_rect_set_x(this: DevicePixelRect*, x: i32):
    int_point_set_x(&this.m_location, x)

## Ported from Libraries/LibGfx/Rect.h:63 Gfx::Rect::set_y for DevicePixelRect.
pub func device_pixel_rect_set_y(this: DevicePixelRect*, y: i32):
    int_point_set_y(&this.m_location, y)

## Ported from Libraries/LibGfx/Rect.h:64 Gfx::Rect::set_width for DevicePixelRect.
pub func device_pixel_rect_set_width(this: DevicePixelRect*, width: i32):
    int_size_set_width(&this.m_size, width)

## Ported from Libraries/LibGfx/Rect.h:65 Gfx::Rect::set_height for DevicePixelRect.
pub func device_pixel_rect_set_height(this: DevicePixelRect*, height: i32):
    int_size_set_height(&this.m_size, height)

## Ported from Libraries/LibGfx/Rect.h:67 Gfx::Rect::location for DevicePixelRect.
pub func device_pixel_rect_location(this: const DevicePixelRect*) -> IntPoint:
    return this.m_location

## Ported from Libraries/LibGfx/Rect.h:68 Gfx::Rect::size for DevicePixelRect.
pub func device_pixel_rect_size(this: const DevicePixelRect*) -> IntSize:
    return this.m_size

## Ported from Libraries/LibGfx/Rect.h:70 Gfx::Rect::is_empty for DevicePixelRect.
pub func device_pixel_rect_is_empty(this: const DevicePixelRect*) -> bool:
    return device_pixel_rect_width(this) <= 0 or device_pixel_rect_height(this) <= 0

