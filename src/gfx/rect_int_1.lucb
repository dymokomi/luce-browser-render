pub func device_pixel_rect_set_size_i32(this: DevicePixelRect*, width: i32, height: i32):
    int_size_set_width(&this.m_size, width)
    int_size_set_height(&this.m_size, height)

# mark: Inflating and shrinking =================================================================

## Ported from Libraries/LibGfx/Rect.h:105 Gfx::Rect::inflate for DevicePixelRect.
pub func device_pixel_rect_inflate_i32_i32(this: DevicePixelRect*, w: i32, h: i32):
    device_pixel_rect_set_x(this, device_pixel_rect_x(this) - w // 2)
    device_pixel_rect_set_width(this, device_pixel_rect_width(this) + w)
    device_pixel_rect_set_y(this, device_pixel_rect_y(this) - h // 2)
    device_pixel_rect_set_height(this, device_pixel_rect_height(this) + h)

## Ported from Libraries/LibGfx/Rect.h:113 Gfx::Rect::inflate for DevicePixelRect.
pub func device_pixel_rect_inflate_i32_i32_i32(this: DevicePixelRect*, top: i32, right: i32, bottom: i32, left: i32):
    device_pixel_rect_set_x(this, device_pixel_rect_x(this) - left)
    device_pixel_rect_set_width(this, device_pixel_rect_width(this) + left + right)
    device_pixel_rect_set_y(this, device_pixel_rect_y(this) - top)
    device_pixel_rect_set_height(this, device_pixel_rect_height(this) + top + bottom)

## Ported from Libraries/LibGfx/Rect.h:121 Gfx::Rect::inflate for DevicePixelRect.
pub func device_pixel_rect_inflate_int_size(this: DevicePixelRect*, size: IntSize):
    device_pixel_rect_set_x(this, device_pixel_rect_x(this) - int_size_width(&size) // 2)
    device_pixel_rect_set_width(this, device_pixel_rect_width(this) + int_size_width(&size))
    device_pixel_rect_set_y(this, device_pixel_rect_y(this) - int_size_height(&size) // 2)
    device_pixel_rect_set_height(this, device_pixel_rect_height(this) + int_size_height(&size))

## Ported from Libraries/LibGfx/Rect.h:129 Gfx::Rect::shrink for DevicePixelRect.
pub func device_pixel_rect_shrink_i32_i32(this: DevicePixelRect*, w: i32, h: i32):
    device_pixel_rect_set_x(this, device_pixel_rect_x(this) + w // 2)
    device_pixel_rect_set_width(this, device_pixel_rect_width(this) - w)
    device_pixel_rect_set_y(this, device_pixel_rect_y(this) + h // 2)
    device_pixel_rect_set_height(this, device_pixel_rect_height(this) - h)

## Ported from Libraries/LibGfx/Rect.h:137 Gfx::Rect::shrink for DevicePixelRect.
pub func device_pixel_rect_shrink_i32_i32_i32(this: DevicePixelRect*, top: i32, right: i32, bottom: i32, left: i32):
    device_pixel_rect_set_x(this, device_pixel_rect_x(this) + left)
    device_pixel_rect_set_width(this, device_pixel_rect_width(this) - (left + right))
    device_pixel_rect_set_y(this, device_pixel_rect_y(this) + top)
    device_pixel_rect_set_height(this, device_pixel_rect_height(this) - (top + bottom))

## Ported from Libraries/LibGfx/Rect.h:145 Gfx::Rect::shrink for DevicePixelRect.
pub func device_pixel_rect_shrink_int_size(this: DevicePixelRect*, size: IntSize):
    device_pixel_rect_set_x(this, device_pixel_rect_x(this) + int_size_width(&size) // 2)
    device_pixel_rect_set_width(this, device_pixel_rect_width(this) - int_size_width(&size))
    device_pixel_rect_set_y(this, device_pixel_rect_y(this) + int_size_height(&size) // 2)
    device_pixel_rect_set_height(this, device_pixel_rect_height(this) - int_size_height(&size))

## Ported from Libraries/LibGfx/Rect.h:153 Gfx::Rect::translated for DevicePixelRect.
pub func device_pixel_rect_translated_i32_i32(this: const DevicePixelRect*, dx: i32, dy: i32) -> DevicePixelRect:
    var rect = *this
    device_pixel_rect_translate_by_i32_i32(&rect, dx, dy)
    return rect

