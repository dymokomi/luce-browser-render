## Ported from Libraries/LibGfx/Rect.h:331 Gfx::Rect::set_secondary_size_for_orientation for DevicePixelRect.
pub func device_pixel_rect_set_secondary_size_for_orientation(this: DevicePixelRect*, orientation: Orientation, value: i32):
    int_size_set_secondary_size_for_orientation(&this.m_size, orientation, value)

## Ported from Libraries/LibGfx/Rect.h:333 Gfx::Rect::inflate_primary_for_orientation for DevicePixelRect.
pub func device_pixel_rect_inflate_primary_for_orientation(this: DevicePixelRect*, orientation: Orientation, before: i32, after: i32):
    if orientation == Orientation.horizontal:
        device_pixel_rect_inflate_i32_i32_i32(this, 0, after, 0, before)
    else:
        device_pixel_rect_inflate_i32_i32_i32(this, before, 0, after, 0)

## Ported from Libraries/LibGfx/Rect.h:341 Gfx::Rect::inflate_secondary_for_orientation for DevicePixelRect.
pub func device_pixel_rect_inflate_secondary_for_orientation(this: DevicePixelRect*, orientation: Orientation, before: i32, after: i32):
    if orientation == Orientation.horizontal:
        device_pixel_rect_inflate_i32_i32_i32(this, before, 0, after, 0)
    else:
        device_pixel_rect_inflate_i32_i32_i32(this, 0, after, 0, before)
