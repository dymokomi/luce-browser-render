# mark: Taking slices ===========================================================================

## Ported from Libraries/LibGfx/Rect.h:237 Gfx::Rect::take_from_right for DevicePixelRect.
pub func device_pixel_rect_take_from_right(this: DevicePixelRect*, w: i32) -> DevicePixelRect:
    var w_ = w
    if w_ > device_pixel_rect_width(this):
        w_ = device_pixel_rect_width(this)
    var rect = *this
    device_pixel_rect_set_width(this, device_pixel_rect_width(this) - w_)
    device_pixel_rect_set_x(&rect, device_pixel_rect_x(this) + device_pixel_rect_width(this))
    device_pixel_rect_set_width(&rect, w_)
    return rect

## Ported from Libraries/LibGfx/Rect.h:248 Gfx::Rect::take_from_left for DevicePixelRect.
pub func device_pixel_rect_take_from_left(this: DevicePixelRect*, w: i32) -> DevicePixelRect:
    var w_ = w
    if w_ > device_pixel_rect_width(this):
        w_ = device_pixel_rect_width(this)
    var rect = *this
    device_pixel_rect_set_x(this, device_pixel_rect_x(this) + w_)
    device_pixel_rect_set_width(this, device_pixel_rect_width(this) - w_)
    device_pixel_rect_set_width(&rect, w_)
    return rect

## Ported from Libraries/LibGfx/Rect.h:259 Gfx::Rect::take_from_top for DevicePixelRect.
pub func device_pixel_rect_take_from_top(this: DevicePixelRect*, h: i32) -> DevicePixelRect:
    var h_ = h
    if h_ > device_pixel_rect_height(this):
        h_ = device_pixel_rect_height(this)
    var rect = *this
    device_pixel_rect_set_y(this, device_pixel_rect_y(this) + h_)
    device_pixel_rect_set_height(this, device_pixel_rect_height(this) - h_)
    device_pixel_rect_set_height(&rect, h_)
    return rect

## Ported from Libraries/LibGfx/Rect.h:270 Gfx::Rect::take_from_bottom for DevicePixelRect.
pub func device_pixel_rect_take_from_bottom(this: DevicePixelRect*, h: i32) -> DevicePixelRect:
    var h_ = h
    if h_ > device_pixel_rect_height(this):
        h_ = device_pixel_rect_height(this)
    var rect = *this
    device_pixel_rect_set_height(this, device_pixel_rect_height(this) - h_)
    device_pixel_rect_set_y(&rect, device_pixel_rect_y(this) + device_pixel_rect_height(this))
    device_pixel_rect_set_height(&rect, h_)
    return rect

# mark: Containment =============================================================================

## Ported from Libraries/LibGfx/Rect.h:281 Gfx::Rect::contains_vertically for DevicePixelRect.
pub func device_pixel_rect_contains_vertically(this: const DevicePixelRect*, y: i32) -> bool:
    return y >= device_pixel_rect_top(this) and y < device_pixel_rect_bottom(this)

## Ported from Libraries/LibGfx/Rect.h:286 Gfx::Rect::contains_horizontally for DevicePixelRect.
pub func device_pixel_rect_contains_horizontally(this: const DevicePixelRect*, x: i32) -> bool:
    return x >= device_pixel_rect_left(this) and x < device_pixel_rect_right(this)

## Ported from Libraries/LibGfx/Rect.h:291 Gfx::Rect::contains for DevicePixelRect.
pub func device_pixel_rect_contains_i32(this: const DevicePixelRect*, x: i32, y: i32) -> bool:
    return device_pixel_rect_contains_horizontally(this, x) and device_pixel_rect_contains_vertically(this, y)

## Ported from Libraries/LibGfx/Rect.h:296 Gfx::Rect::contains for DevicePixelRect.
pub func device_pixel_rect_contains_int_point(this: const DevicePixelRect*, point: IntPoint) -> bool:
    return device_pixel_rect_contains_i32(this, int_point_x(&point), int_point_y(&point))

## Ported from Libraries/LibGfx/Rect.h:301 Gfx::Rect::contains for DevicePixelRect.
pub func device_pixel_rect_contains_device_pixel_rect(this: const DevicePixelRect*, other: DevicePixelRect) -> bool:
    return (device_pixel_rect_left(this) <= device_pixel_rect_left(&other) and device_pixel_rect_right(this) >= device_pixel_rect_right(&other) and device_pixel_rect_top(this) <= device_pixel_rect_top(&other) and device_pixel_rect_bottom(this) >= device_pixel_rect_bottom(&other))

## Ported from Libraries/LibGfx/Rect.h:310 Gfx::Rect::contains<Container> for DevicePixelRect.
pub func device_pixel_rect_contains_t_container(this: const DevicePixelRect*, others: const DevicePixelRect[]) -> bool:
    var have_any = false
    for other in others:
        if not device_pixel_rect_contains_device_pixel_rect(this, other):
            return false
        have_any = true
    return have_any

