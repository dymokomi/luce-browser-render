# mark: Rec. 2020 ===============================================================================

## The `to_linear` lambda of rec2020_to_linear_rec2020 (ColorConversion.cpp:616).
func rec2020_to_linear_rec2020_to_linear(c: f32) -> f32:
    let sign: f32 = -1.0 if c < 0.0 else 1.0
    let absolute = math32.abs(c)

    return sign * (f32)math.pow((f64)absolute, 2.4)

