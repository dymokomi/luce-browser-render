# mark: ProPhoto RGB ============================================================================

## The `to_linear` lambda of prophoto_rgb_to_linear_prophoto_rgb (ColorConversion.cpp:556).
func prophoto_rgb_to_linear_prophoto_rgb_to_linear(c: f32) -> f32:
    let sign: f32 = -1.0 if c < 0.0 else 1.0
    let absolute = math32.abs(c)
    if absolute <= 16.0 / 512.0:
        return c / 16.0
    return sign * (f32)math.pow((f64)absolute, 1.8)

## Ported from Libraries/LibGfx/ColorConversion.cpp:554 Gfx::prophoto_rgb_to_linear_prophoto_rgb.
# https://drafts.csswg.org/css-color-4/#predefined-prophoto-rgb
# https://drafts.csswg.org/css-color-4/#color-conversion-code
pub func prophoto_rgb_to_linear_prophoto_rgb(components: ColorComponents) -> ColorComponents:
    return color_components_new(
        prophoto_rgb_to_linear_prophoto_rgb_to_linear(color_components_at_const(&components, 0)),
        prophoto_rgb_to_linear_prophoto_rgb_to_linear(color_components_at_const(&components, 1)),
        prophoto_rgb_to_linear_prophoto_rgb_to_linear(color_components_at_const(&components, 2)),
        color_components_alpha(&components),
    )

## The `to_gamma` lambda of linear_prophoto_rgb_to_prophoto_rgb (ColorConversion.cpp:571).
func linear_prophoto_rgb_to_prophoto_rgb_to_gamma(c: f32) -> f32:
    let sign: f32 = -1.0 if c < 0.0 else 1.0
    let absolute = math32.abs(c)
    if absolute <= 1.0 / 512.0:
        return c * 16.0
    return sign * (f32)math.pow((f64)absolute, 1.0 / 1.8)

