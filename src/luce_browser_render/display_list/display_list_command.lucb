#==============================================================================================
#
#   display_list_command - the commands' bounding rectangles and dumps
#
#   DESCRIPTION:
#       Port of Libraries/LibWeb/Painting/DisplayListCommand.cpp (lines 1-163) with the inline
#       `bounding_rect()` and `is_clip()` members of DisplayListCommand.h (lines 1-407), in the
#       header's order. `dump` writes what `appendff` writes: AK's Formatters for Gfx::Rect
#       ("[x,y wxh]"), Point ("[x,y]"), Size ("[wxh]"), Color (its `to_byte_string()`), bool
#       and the numbers, spelled out in the `append_*` helpers at the end of the fragment.
#
#       Copyright (c) 2024-2025, Aliaksandr Kalenik <kalenik.aliaksandr@gmail.com>
#       SPDX-License-Identifier: BSD-2-Clause
#
#==============================================================================================

# mark: DrawGlyphRun, FillRect, bitmaps ========================================================

## Ported from Libraries/LibWeb/Painting/DisplayListCommand.cpp:23 Web::Painting::DrawGlyphRun::bounding_rect.
pub func draw_glyph_run_bounding_rect(this: const DrawGlyphRun*) -> gfx.DevicePixelRect:
    let bounds = web_fonts.glyph_run_cached_blob_bounds(this.glyph_run)
    return float_rect_to_rounded_int_rect(gfx.float_rect_translated_float_point(&bounds, this.translation))

## Ported from Libraries/LibWeb/Painting/DisplayListCommand.cpp:28 Web::Painting::DrawGlyphRun::dump.
pub func draw_glyph_run_dump(this: const DrawGlyphRun*, builder: ak.StringBuilder*):
    # " rect={} translation={} color={}"
    ak.string_builder_append(builder, " rect=")
    append_int_rect(builder, this.rect)
    ak.string_builder_append(builder, " translation=")
    append_float_point(builder, this.translation)
    ak.string_builder_append(builder, " color=")
    append_color(builder, this.color)

