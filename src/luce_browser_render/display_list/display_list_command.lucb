## Ported from Libraries/LibWeb/Painting/DisplayListCommand.cpp:11 Web::Painting::PaintOuterBoxShadow::bounding_rect.
pub func paint_outer_box_shadow_bounding_rect(this: const PaintOuterBoxShadow*) -> gfx.DevicePixelRect:
    var rect = this.shadow_rect
    gfx.device_pixel_rect_inflate_i32_i32_i32(&rect, this.blur_radius * 2, this.blur_radius * 2, this.blur_radius * 2, this.blur_radius * 2)
    return rect

## Ported from Libraries/LibWeb/Painting/DisplayListCommand.cpp:90 Web::Painting::PaintOuterBoxShadow::dump.
pub func paint_outer_box_shadow_dump(this: const PaintOuterBoxShadow*, builder: ak.StringBuilder*):
    # " content_rect={} shadow_rect={} blur_radius={} color={}"
    ak.string_builder_append(builder, " content_rect=")
    append_int_rect(builder, this.device_content_rect)
    ak.string_builder_append(builder, " shadow_rect=")
    append_int_rect(builder, this.shadow_rect)
    ak.string_builder_append(builder, " blur_radius=")
    ak.format_i64(builder, this.blur_radius)
    ak.string_builder_append(builder, " color=")
    append_color(builder, this.color)

