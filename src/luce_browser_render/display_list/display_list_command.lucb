# mark: Formatters =============================================================================

## AK::Formatter<Gfx::Rect<int>>: "[{},{} {}x{}]".
func append_int_rect(builder: ak.StringBuilder*, rect: gfx.DevicePixelRect):
    ak.string_builder_append(builder, "[")
    append_rect_bounds(builder, &rect)
    ak.string_builder_append(builder, "]")

## AK::Formatter<Gfx::Point<int>>: "[{},{}]".
func append_int_point(builder: ak.StringBuilder*, point: gfx.IntPoint):
    ak.string_builder_append(builder, "[")
    ak.format_i64(builder, gfx.int_point_x(&point))
    ak.string_builder_append(builder, ",")
    ak.format_i64(builder, gfx.int_point_y(&point))
    ak.string_builder_append(builder, "]")

## AK::Formatter<Gfx::Point<float>>: "[{},{}]".
func append_float_point(builder: ak.StringBuilder*, point: gfx.FloatPoint):
    ak.string_builder_append(builder, "[")
    ak.format_f32(builder, gfx.float_point_x(&point))
    ak.string_builder_append(builder, ",")
    ak.format_f32(builder, gfx.float_point_y(&point))
    ak.string_builder_append(builder, "]")

## AK::Formatter<Gfx::Size<int>>: "[{}x{}]".
func append_int_size(builder: ak.StringBuilder*, size: gfx.IntSize):
    ak.string_builder_append(builder, "[")
    ak.format_i64(builder, gfx.int_size_width(&size))
    ak.string_builder_append(builder, "x")
    ak.format_i64(builder, gfx.int_size_height(&size))
    ak.string_builder_append(builder, "]")

## AK::Formatter<Gfx::Color>: the color's `to_byte_string()`.
func append_color(builder: ak.StringBuilder*, color: gfx.Color):
    let text = gfx.color_to_byte_string(&color)
    ak.string_builder_append_string_view(builder, ak.byte_string_view(&text))

## AK::Formatter<bool>: "true" or "false".
func append_bool(builder: ak.StringBuilder*, value: bool):
    ak.string_builder_append(builder, "true" if value else "false")
