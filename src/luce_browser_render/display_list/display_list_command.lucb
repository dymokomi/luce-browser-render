## Ported from Libraries/LibWeb/Painting/DisplayListCommand.h:191 Web::Painting::PaintTextShadow::bounding_rect.
pub func paint_text_shadow_bounding_rect(this: const PaintTextShadow*) -> gfx.DevicePixelRect:
    return gfx.DevicePixelRect(m_location = float_point_to_int_point(this.draw_location), m_size = gfx.device_pixel_rect_size(&this.shadow_bounding_rect))

## Ported from Libraries/LibWeb/Painting/DisplayListCommand.cpp:100 Web::Painting::PaintTextShadow::dump.
pub func paint_text_shadow_dump(this: const PaintTextShadow*, builder: ak.StringBuilder*):
    # " shadow_rect={} text_rect={} draw_location={} blur_radius={} color={}"
    ak.string_builder_append(builder, " shadow_rect=")
    append_int_rect(builder, this.shadow_bounding_rect)
    ak.string_builder_append(builder, " text_rect=")
    append_int_rect(builder, this.text_rect)
    ak.string_builder_append(builder, " draw_location=")
    append_float_point(builder, this.draw_location)
    ak.string_builder_append(builder, " blur_radius=")
    ak.format_i64(builder, this.blur_radius)
    ak.string_builder_append(builder, " color=")
    append_color(builder, this.color)

