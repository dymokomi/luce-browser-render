## Ported from Libraries/LibWeb/Painting/DisplayListCommand.h:274 Web::Painting::DrawLine::bounding_rect.
pub func draw_line_bounding_rect(this: const DrawLine*) -> gfx.DevicePixelRect:
    let rect = gfx.device_pixel_rect_from_two_points(this.from_, this.to)
    return gfx.device_pixel_rect_inflated_i32_i32(&rect, this.thickness, this.thickness)

