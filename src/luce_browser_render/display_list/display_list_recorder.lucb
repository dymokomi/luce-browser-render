## Ported from Libraries/LibWeb/Painting/DisplayListRecorder.cpp:373 Web::Painting::DisplayListRecorder::fill_rect_with_rounded_corners.
pub func display_list_recorder_fill_rect_with_rounded_corners_corner_radii(this: DisplayListRecorder*, rect: gfx.DevicePixelRect, color: gfx.Color, corner_radii: CornerRadii):
    if gfx.device_pixel_rect_is_empty(&rect) or gfx.color_alpha(&color) == 0:
        return

    if not corner_radii_has_any_radius(&corner_radii):
        display_list_recorder_fill_rect(this, rect, color)
        return

    display_list_recorder_append(this, .fill_rect_with_rounded_corners(value = FillRectWithRoundedCorners(rect = rect, color = color, corner_radii = corner_radii)))

