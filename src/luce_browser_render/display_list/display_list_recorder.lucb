## Ported from Libraries/LibWeb/Painting/DisplayListRecorder.cpp:395 Web::Painting::DisplayListRecorder::fill_rect_with_rounded_corners.
pub func display_list_recorder_fill_rect_with_rounded_corners_i32_i32(this: DisplayListRecorder*, a_rect: gfx.DevicePixelRect, color: gfx.Color, top_left_radius: i32, top_right_radius: i32, bottom_right_radius: i32, bottom_left_radius: i32):
    display_list_recorder_fill_rect_with_rounded_corners_corner_radii(this, a_rect, color, CornerRadii(
        top_left = CornerRadius(horizontal_radius = top_left_radius, vertical_radius = top_left_radius),
        top_right = CornerRadius(horizontal_radius = top_right_radius, vertical_radius = top_right_radius),
        bottom_right = CornerRadius(horizontal_radius = bottom_right_radius, vertical_radius = bottom_right_radius),
        bottom_left = CornerRadius(horizontal_radius = bottom_left_radius, vertical_radius = bottom_left_radius)))

## Ported from Libraries/LibWeb/Painting/DisplayListRecorder.cpp:404 Web::Painting::DisplayListRecorder::paint_scrollbar.
pub func display_list_recorder_paint_scrollbar(this: DisplayListRecorder*, scroll_frame_index: u64, gutter_rect: gfx.DevicePixelRect, thumb_rect: gfx.DevicePixelRect, scroll_size: f64, thumb_color: gfx.Color, track_color: gfx.Color, vertical: bool):
