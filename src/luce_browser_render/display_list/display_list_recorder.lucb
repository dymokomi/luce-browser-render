## Ported from Libraries/LibWeb/Painting/DisplayListRecorder.cpp:279 Web::Painting::DisplayListRecorder::draw_text.
pub func display_list_recorder_draw_text(this: DisplayListRecorder*, rect: gfx.DevicePixelRect, raw_text: const ak.Utf16String*, font: const web_fonts.Font*, alignment: gfx.TextAlignment, color: gfx.Color):
    if gfx.device_pixel_rect_is_empty(&rect) or gfx.color_alpha(&color) == 0:
        return

    let glyph_run = web_fonts.shape_text_f32(gfx.FloatPoint(m_x = 0.0, m_y = 0.0), 0.0, ak.utf16_string_base_utf16_view(&raw_text.utf16_string_base), font, web_fonts.GlyphRunTextType.ltr)
    var baseline_x: f32 = 0.0
    if alignment == gfx.TextAlignment.center_left:
        baseline_x = (f32)gfx.device_pixel_rect_x(&rect)
    elif alignment == gfx.TextAlignment.center:
        baseline_x = (f32)gfx.device_pixel_rect_x(&rect) + ((f32)gfx.device_pixel_rect_width(&rect) - web_fonts.glyph_run_width(glyph_run)) / 2.0
    elif alignment == gfx.TextAlignment.center_right:
        baseline_x = (f32)gfx.device_pixel_rect_right(&rect) - web_fonts.glyph_run_width(glyph_run)
    else:
        # Unimplemented alignment.
        trap("TODO")
    let metrics = web_fonts.font_pixel_metrics(font)
    let baseline_y = (f32)gfx.device_pixel_rect_y(&rect) + metrics.ascent + ((f32)gfx.device_pixel_rect_height(&rect) - (metrics.ascent + metrics.descent)) / 2.0
    display_list_recorder_draw_glyph_run(this, gfx.FloatPoint(m_x = baseline_x, m_y = baseline_y), glyph_run, color, rect, 1.0, gfx.Orientation.horizontal)

## Ported from Libraries/LibWeb/Painting/DisplayListRecorder.cpp:301 Web::Painting::DisplayListRecorder::draw_glyph_run.
# Streamlined text drawing routine that does no wrapping/elision/alignment.
pub func display_list_recorder_draw_glyph_run(this: DisplayListRecorder*, baseline_start: gfx.FloatPoint, glyph_run: const web_fonts.GlyphRun*, color: gfx.Color, rect: gfx.DevicePixelRect, scale: f64, orientation: gfx.Orientation):
    if gfx.color_alpha(&color) == 0:
        return
    web_fonts.glyph_run_ensure_text_blob(glyph_run, (f32)scale)
    display_list_recorder_append(this, .draw_glyph_run(value = DrawGlyphRun(glyph_run = glyph_run, rect = rect, translation = baseline_start, color = color, orientation = orientation)))

