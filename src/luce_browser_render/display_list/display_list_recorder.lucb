#==============================================================================================
#
#   display_list_recorder - recording painting commands into a DisplayList
#
#   DESCRIPTION:
#       Port of Libraries/LibWeb/Painting/DisplayListRecorder.cpp (lines 1-421) and
#       DisplayListRecorder.h (lines 1-176). Every command goes through
#       `display_list_recorder_append`, the C++ APPEND macro: it tracks the save nesting
#       level and, while a CommandCapture is active, also keeps a copy of each command the
#       display list accepted. Commands are immutable once recorded, so the copy shares the
#       command's buffers (DESIGN.md §3.3 rule 2 needs no clone here).
#
#       The C++ destructors that do work become calls the owner makes where the C++ object
#       goes out of scope: `display_list_recorder_command_capture_destroy` (CommandCapture
#       ends a capture it did not hand out) and `display_list_recorder_state_saver_destroy`
#       (DisplayListRecorderStateSaver restores). Parameters the C++ takes by const
#       reference and keeps (`Gfx::GlyphRun const&`, `Gfx::ImmutableBitmap const&`, `Font
#       const&`, `Utf16String const&`) are pointers.
#
#       Copyright (c) 2023-2026, Aliaksandr Kalenik <kalenik.aliaksandr@gmail.com>
#       Copyright (c) 2025, Jelle Raaijmakers <jelle@ladybird.org>
#       SPDX-License-Identifier: BSD-2-Clause
#
#==============================================================================================

# mark: Construction and capture ===============================================================

## Ported from Libraries/LibWeb/Painting/DisplayListRecorder.cpp:14 Web::Painting::DisplayListRecorder::DisplayListRecorder.
pub func display_list_recorder_construct(this: DisplayListRecorder*, command_list: DisplayList*):
    this.m_display_list = command_list

## A recorder over `command_list`: `DisplayListRecorder recorder(command_list)`.
pub func display_list_recorder_new(command_list: DisplayList*) -> DisplayListRecorder:
    var recorder = DisplayListRecorder(m_display_list = command_list)
    display_list_recorder_construct(&recorder, command_list)
    return recorder

## Ported from Libraries/LibWeb/Painting/DisplayListRecorder.cpp:23 Web::Painting::DisplayListRecorder::CommandCapture::CommandCapture.
func display_list_recorder_command_capture_construct(this: DisplayListRecorderCommandCapture*, recorder: DisplayListRecorder*):
    this.m_recorder = recorder

## Ported from Libraries/LibWeb/Painting/DisplayListRecorder.cpp:28 Web::Painting::DisplayListRecorder::CommandCapture::~CommandCapture:
## call where the C++ capture goes out of scope.
pub func display_list_recorder_command_capture_destroy(this: DisplayListRecorderCommandCapture*):
    if let recorder = this.m_recorder:
        display_list_recorder_end_capture(recorder)

## Ported from Libraries/LibWeb/Painting/DisplayListRecorder.cpp:34 Web::Painting::DisplayListRecorder::CommandCapture::take.
pub func display_list_recorder_command_capture_take(this: DisplayListRecorderCommandCapture*) -> ak.Vector[DisplayListCommand]:
    let recorder = this.m_recorder else trap("VERIFY: CommandCapture::take without a recorder")
    # move(m_recorder->m_captured_commands) leaves the recorder's vector empty.
    let commands = recorder.m_captured_commands
    var empty: ak.Vector[DisplayListCommand]
    recorder.m_captured_commands = empty
    recorder.m_is_capturing = false
    this.m_recorder = none
    return commands

## Ported from Libraries/LibWeb/Painting/DisplayListRecorder.cpp:41 Web::Painting::DisplayListRecorder::begin_command_capture.
pub func display_list_recorder_begin_command_capture(this: DisplayListRecorder*) -> DisplayListRecorderCommandCapture:
    assert(not this.m_is_capturing)
    this.m_is_capturing = true
    ak.vector_clear(&this.m_captured_commands)
    var capture: DisplayListRecorderCommandCapture
    display_list_recorder_command_capture_construct(&capture, this)
    return capture

## Ported from Libraries/LibWeb/Painting/DisplayListRecorder.cpp:49 Web::Painting::DisplayListRecorder::end_capture.
func display_list_recorder_end_capture(this: DisplayListRecorder*):
    this.m_is_capturing = false
    ak.vector_clear(&this.m_captured_commands)

## Ported from Libraries/LibWeb/Painting/DisplayListRecorder.cpp:56 Web::Painting::command_nesting_level_change:
## the command's `nesting_level_change`, or 0 for commands that have none. The C++ template is
## instantiated per command type in APPEND and visited over the variant in
## `replay_cached_commands`; both answer this.
func command_nesting_level_change(command: const DisplayListCommand*) -> i32:
    match *command:
        .save(_): return save_nesting_level_change
        .save_layer(_): return save_layer_nesting_level_change
        .restore(_): return restore_nesting_level_change
        .apply_effects(_): return apply_effects_nesting_level_change
        _: return 0

## The C++ APPEND macro (DisplayListRecorder.cpp:63).
func display_list_recorder_append(this: DisplayListRecorder*, command: DisplayListCommand):
    this.m_save_nesting_level += command_nesting_level_change(&command)
    if this.m_is_capturing:
        let command_copy = command
        if display_list_append(this.m_display_list, command, this.m_accumulated_visual_context_index):
            ak.vector_append_t(&this.m_captured_commands, command_copy)
    else:
        discard(display_list_append(this.m_display_list, command, this.m_accumulated_visual_context_index))

## Ported from Libraries/LibWeb/Painting/DisplayListRecorder.cpp:76 Web::Painting::DisplayListRecorder::replay_cached_commands.
pub func display_list_recorder_replay_cached_commands(this: DisplayListRecorder*, commands: const DisplayListCommand[]):
    for command in commands:
        let command_copy = command
        this.m_save_nesting_level += command_nesting_level_change(&command_copy)
        discard(display_list_append(this.m_display_list, command_copy, this.m_accumulated_visual_context_index))

# mark: Nesting, clips and masks ===============================================================

## Ported from Libraries/LibWeb/Painting/DisplayListRecorder.cpp:89 Web::Painting::DisplayListRecorder::paint_nested_display_list.
pub func display_list_recorder_paint_nested_display_list(this: DisplayListRecorder*, display_list_: DisplayList*?, rect: gfx.DevicePixelRect):
    display_list_recorder_append(this, .paint_nested_display_list(value = PaintNestedDisplayList(display_list = display_list_, rect = rect)))

## Ported from Libraries/LibWeb/Painting/DisplayListRecorder.cpp:94 Web::Painting::DisplayListRecorder::add_rounded_rect_clip.
pub func display_list_recorder_add_rounded_rect_clip(this: DisplayListRecorder*, corner_radii: CornerRadii, border_rect: gfx.DevicePixelRect, corner_clip: CornerClip):
    display_list_recorder_append(this, .add_rounded_rect_clip(value = AddRoundedRectClip(corner_radii = corner_radii, border_rect = border_rect, corner_clip = corner_clip)))

## Ported from Libraries/LibWeb/Painting/DisplayListRecorder.cpp:99 Web::Painting::DisplayListRecorder::begin_masks.
pub func display_list_recorder_begin_masks(this: DisplayListRecorder*, masks: const DisplayListRecorderMaskInfo[]):
    for mask in masks:
        display_list_recorder_save(this)
        display_list_recorder_add_clip_rect(this, mask.rect)
        display_list_recorder_save_layer(this)

## Ported from Libraries/LibWeb/Painting/DisplayListRecorder.cpp:108 Web::Painting::DisplayListRecorder::end_masks.
pub func display_list_recorder_end_masks(this: DisplayListRecorder*, masks: const DisplayListRecorderMaskInfo[]):
    var i = masks.length
    while i > 0:
        i -= 1
        let mask = masks[i]
        let mask_kind: gfx.MaskKind? = gfx.MaskKind.luminance if mask.kind == gfx.MaskKind.luminance else none
        display_list_recorder_apply_effects(this, 1.0, gfx.CompositingAndBlendingOperator.destination_in, none, mask_kind)
        display_list_recorder_paint_nested_display_list(this, mask.display_list, mask.rect)
        display_list_recorder_restore(this) # DstIn layer
        display_list_recorder_restore(this) # content layer
        display_list_recorder_restore(this) # clip save

# mark: Rects, paths and ellipses ==============================================================

## Ported from Libraries/LibWeb/Painting/DisplayListRecorder.cpp:121 Web::Painting::DisplayListRecorder::fill_rect.
pub func display_list_recorder_fill_rect(this: DisplayListRecorder*, rect: gfx.DevicePixelRect, color: gfx.Color):
    if gfx.device_pixel_rect_is_empty(&rect) or gfx.color_alpha(&color) == 0:
        return
    display_list_recorder_append(this, .fill_rect(value = FillRect(rect = rect, color = color)))

## Ported from Libraries/LibWeb/Painting/DisplayListRecorder.cpp:128 Web::Painting::DisplayListRecorder::fill_rect_transparent.
pub func display_list_recorder_fill_rect_transparent(this: DisplayListRecorder*, rect: gfx.DevicePixelRect):
    if gfx.device_pixel_rect_is_empty(&rect):
        return
    display_list_recorder_append(this, .fill_rect(value = FillRect(rect = rect, color = color_transparent())))

## Whether a PaintStyleOrColor is a fully transparent color: C++'s
## `paint_style_or_color.has<Gfx::Color>() && paint_style_or_color.get<Gfx::Color>().alpha() == 0`.
func paint_style_or_color_is_transparent_color(paint_style_or_color: const PaintStyleOrColor*) -> bool:
    match *paint_style_or_color:
        .color(color): return gfx.color_alpha(&color) == 0
        _: return false

## Ported from Libraries/LibWeb/Painting/DisplayListRecorder.cpp:135 Web::Painting::DisplayListRecorder::fill_path.
pub func display_list_recorder_fill_path(this: DisplayListRecorder*, params: DisplayListRecorderFillPathParams):
    if paint_style_or_color_is_transparent_color(&params.paint_style_or_color):
        return
    let path_bounding_rect = gfx.path_bounding_box(&params.path)
    let path_bounding_int_rect = gfx.enclosing_int_rect(path_bounding_rect)
    if gfx.device_pixel_rect_is_empty(&path_bounding_int_rect):
        return
    display_list_recorder_append(this, .fill_path(value = FillPath(
        path_bounding_rect = path_bounding_int_rect,
        path = params.path,
        opacity = params.opacity,
        paint_style_or_color = params.paint_style_or_color,
        winding_rule = params.winding_rule,
        should_anti_alias = params.should_anti_alias)))

## Ported from Libraries/LibWeb/Painting/DisplayListRecorder.cpp:152 Web::Painting::DisplayListRecorder::stroke_path.
pub func display_list_recorder_stroke_path(this: DisplayListRecorder*, params: DisplayListRecorderStrokePathParams):
    # Skia treats zero thickness as a special case and will draw a hairline, while we want to draw nothing.
    if params.thickness == 0.0:
        return
    if paint_style_or_color_is_transparent_color(&params.paint_style_or_color):
        return
    var path_bounding_rect = gfx.path_bounding_box(&params.path)
    # Increase path bounding box by `thickness` to account for stroke.
    gfx.float_rect_inflate_f32_f32(&path_bounding_rect, params.thickness, params.thickness)
    let path_bounding_int_rect = gfx.enclosing_int_rect(path_bounding_rect)
    if gfx.device_pixel_rect_is_empty(&path_bounding_int_rect):
        return
    display_list_recorder_append(this, .stroke_path(value = StrokePath(
        cap_style = params.cap_style,
        join_style = params.join_style,
        miter_limit = params.miter_limit,
        dash_array = params.dash_array,
        dash_offset = params.dash_offset,
        path_bounding_rect = path_bounding_int_rect,
        path = params.path,
        opacity = params.opacity,
        paint_style_or_color = params.paint_style_or_color,
        thickness = params.thickness,
        should_anti_alias = params.should_anti_alias)))

