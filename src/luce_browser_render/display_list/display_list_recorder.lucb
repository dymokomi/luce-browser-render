# mark: DisplayListRecorderStateSaver ==========================================================

## Ported from Libraries/LibWeb/Painting/DisplayListRecorder.h:161 Web::Painting::DisplayListRecorderStateSaver::DisplayListRecorderStateSaver.
pub func display_list_recorder_state_saver_construct(this: DisplayListRecorderStateSaver*, recorder: DisplayListRecorder*):
    this.m_recorder = recorder
    display_list_recorder_save(this.m_recorder)

## A saver over `recorder`, having saved: `DisplayListRecorderStateSaver saver(recorder)`.
pub func display_list_recorder_state_saver_new(recorder: DisplayListRecorder*) -> DisplayListRecorderStateSaver:
    var saver = DisplayListRecorderStateSaver(m_recorder = recorder)
    display_list_recorder_state_saver_construct(&saver, recorder)
    return saver

## Ported from Libraries/LibWeb/Painting/DisplayListRecorder.h:167 Web::Painting::DisplayListRecorderStateSaver::~DisplayListRecorderStateSaver:
## call where the C++ saver goes out of scope.
pub func display_list_recorder_state_saver_destroy(this: DisplayListRecorderStateSaver*):
    display_list_recorder_restore(this.m_recorder)

# mark: Support ================================================================================

## `Gfx::Color::Transparent` (Color(NamedColor::Transparent)): all four channels zero.
func color_transparent() -> gfx.Color:
    return gfx.Color(m_value = 0)
