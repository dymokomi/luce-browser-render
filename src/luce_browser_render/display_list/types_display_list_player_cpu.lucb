## is<Web::Painting::DisplayListPlayerCpu>: the class-id range test.
pub func is_display_list_player_cpu[P: IsDisplayListPlayer](p: P*) -> bool:
    let id = p.display_list_player().class_id
    return id >= display_list_player_cpu_class.first_id and id <= display_list_player_cpu_class.last_id

## as_if<Web::Painting::DisplayListPlayerCpu>.
pub func as_if_display_list_player_cpu[P: IsDisplayListPlayer](p: P*) -> DisplayListPlayerCpu*?:
