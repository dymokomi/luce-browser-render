# mark: CpuSurfaceCanvas =======================================================================

## The canvas the player draws on for one PaintingSurface (the Skia player draws on the
## surface's SkCanvas): made when the player first draws on the surface, written back and
## dropped when it flushes.
struct CpuSurfaceCanvas:
    var surface: gfx.PaintingSurface*
    var canvas: CpuCanvas*

