test "cpu player: draw_line dotted and dashed (gated on r08's distance_from)":
    test_cpu_player_draw_line_styles()

noinline func test_cpu_player_draw_line_styles():
    if not gfx_geometry_is_ported:
        return
    let dotted = test_scene_new(24, 8)
    defer test_scene_release(&dotted)
    display_list_player_draw_line(test_scene_player(&dotted), DrawLine(color = test_color(255, 0, 0, 255), from_ = test_point(2, 4), to = test_point(21, 4), thickness = 2,
                                                                       style = gfx.LineStyle.dotted, alternate_color = test_color(0, 0, 0, 0)))
    expect_like_skia(&dotted, "draw_line_dotted", skia_draw_line_dotted, 32, 40)

    let dashed = test_scene_new(24, 8)
    defer test_scene_release(&dashed)
    display_list_player_draw_line(test_scene_player(&dashed), DrawLine(color = test_color(255, 0, 0, 255), from_ = test_point(2, 4), to = test_point(21, 4), thickness = 2,
                                                                       style = gfx.LineStyle.dashed, alternate_color = test_color(0, 0, 0, 0)))
    expect_like_skia(&dashed, "draw_line_dashed", skia_draw_line_dashed, 32, 16)
