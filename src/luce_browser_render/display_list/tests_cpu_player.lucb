#==============================================================================================
#
#   tests_cpu_player - the CPU player's pixels against Skia's
#
#   DESCRIPTION:
#       Each scene draws a small display list through DisplayListPlayerCpu's virtuals
#       (what DisplayListPlayer::execute_impl calls for it) and compares the pixels with
#       what Ladybird's DisplayListPlayerSkia renders for the same display list
#       (tests_skia_reference_data.lucb), under Ladybird's fuzzy reftest rule. Pixels
#       inside shapes and away from their edges match exactly; the tolerances cover
#       anti-aliased edges, where Skia's analytic coverage and the rasterizer's 4x4
#       supersampling differ by a few levels, Skia's gradient dithering, and the blur.
#
#==============================================================================================

# mark: Rects and rounded rects ================================================================

test "cpu player: fill_rect":
    test_cpu_player_fill_rect()

noinline func test_cpu_player_fill_rect():
    let scene = test_scene_new(8, 8)
    defer test_scene_release(&scene)
    display_list_player_fill_rect(test_scene_player(&scene), FillRect(rect = test_rect(2, 3, 4, 2), color = test_color(255, 0, 0, 255)))
    expect_like_skia(&scene, "fill_rect", skia_fill_rect, 0, 0)

test "cpu player: fill_rect_with_rounded_corners":
    test_cpu_player_rounded_rect()

noinline func test_cpu_player_rounded_rect():
    let scene = test_scene_new(16, 16)
    defer test_scene_release(&scene)
    display_list_player_fill_rect_with_rounded_corners(test_scene_player(&scene), FillRectWithRoundedCorners(rect = test_rect(1, 1, 14, 14), color = test_color(0, 0, 255, 255), corner_radii = test_uniform_radii(5)))
    expect_like_skia(&scene, "rounded_rect", skia_rounded_rect, 40, 40)

test "cpu player: fill_rect_with_rounded_corners, elliptical corners":
    test_cpu_player_rounded_rect_elliptic()

noinline func test_cpu_player_rounded_rect_elliptic():
    let scene = test_scene_new(16, 16)
    defer test_scene_release(&scene)
    let radii = CornerRadii(top_left = CornerRadius(horizontal_radius = 6, vertical_radius = 3), top_right = CornerRadius(horizontal_radius = 2, vertical_radius = 2),
                            bottom_right = CornerRadius(horizontal_radius = 0, vertical_radius = 0), bottom_left = CornerRadius(horizontal_radius = 4, vertical_radius = 8))
    display_list_player_fill_rect_with_rounded_corners(test_scene_player(&scene), FillRectWithRoundedCorners(rect = test_rect(1, 1, 14, 14), color = test_color(0, 128, 0, 255), corner_radii = radii))
    expect_like_skia(&scene, "rounded_rect_elliptic", skia_rounded_rect_elliptic, 40, 30)

# mark: Clips ==================================================================================

test "cpu player: add_clip_rect":
    test_cpu_player_clip_rect()

noinline func test_cpu_player_clip_rect():
    let scene = test_scene_new(16, 16)
    defer test_scene_release(&scene)
    let player = test_scene_player(&scene)
    display_list_player_save(player, Save())
    display_list_player_add_clip_rect(player, AddClipRect(rect = test_rect(4, 4, 8, 8)))
    display_list_player_fill_rect(player, FillRect(rect = test_rect(0, 0, 16, 16), color = test_color(255, 0, 0, 255)))
    display_list_player_restore(player, Restore())
    expect_like_skia(&scene, "clip_rect", skia_clip_rect, 0, 0)

