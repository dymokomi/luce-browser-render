    with memory.heap:
        let directories = font_database_font_directories() else trap("font_directories failed")
        assert(ak.vector_size(&directories) >= 2)

test "font_directories":
    test_body_font_directories()

# mark: The OpenType reader ======================================================================

noinline func test_body_fixed_point():
    # FreeType's arithmetic (ftcalc.c): FT_MulFix rounds halves away from zero.
    assert(ft_mul_fix(0x10000, 3) == 3)
    assert(ft_mul_fix(0x8000, 1) == 1)
    assert(ft_mul_fix(0x7FFF, 1) == 0)
    assert(ft_mul_fix(-0x7FFF, 1) == 0)
    assert(ft_mul_fix(-0x8000, 1) == -1)
    assert(ft_div_fix(1, 2) == 0x8000)
    assert(ft_div_fix(-1, 2) == -0x8000)
    assert(ft_div_fix(5, 0) == 0x7FFFFFFF)
    assert(ft_mul_div(7, 3, 2) == 11)
    assert(ft_mul_div(-7, 3, 2) == -11)
    assert(ft_pix_round(95) == 64)
    assert(ft_pix_round(96) == 128)
    assert(ft_pix_round(-33) == -64)
    assert(ft_pix_round(-32) == 0)

test "fixed_point":
    test_body_fixed_point()

noinline func test_body_sfnt_reads():
    let data: u8[5] = [0x12, 0x34, 0x56, 0x78, 0x9A]
    assert(sfnt_u16(data, 0) == 0x1234)
    assert(sfnt_u24(data, 1) == 0x345678)
    assert(sfnt_u32(data, 1) == 0x3456789A)
    # Reads past the end answer 0 instead of trapping.
    assert(sfnt_u16(data, 4) == 0)
    assert(sfnt_u32(data, 2) == 0)
    assert(sfnt_u8(data, 9) == 0)
    assert(sfnt_i16(data, 3) == (i16)0x789A)
    assert(sfnt_slice(data, 3, 10).length == 2)
    assert(sfnt_slice(data, 7, 1).length == 0)
    assert(sfnt_tag('k', 'e', 'r', 'n') == 0x6B65726E)

test "sfnt_reads":
    test_body_sfnt_reads()
