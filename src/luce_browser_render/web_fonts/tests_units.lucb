#==============================================================================================
#
#   tests_units - the web_fonts tests that need no reference build: Ladybird's TestWOFF and
#                 TestWOFF2, and focused tests of the ported classes
#
#   DESCRIPTION:
#       Ported from Tests/LibGfx/TestWOFF.cpp and TestWOFF2.cpp (their inputs are in
#       tests/web_fonts/woff), and focused tests pinned to the donor's code for UnicodeRange,
#       FontStyleMapping, FontSupport, FontCascadeList, Typeface's font cache, Font,
#       PathFontProvider, FontDatabase, GlyphRun and the TTC reader. The tests that need
#       FourCC (region r10: its hash, to_u32 and operator<) wait for that region:
#       `tests_r10_four_cc_is_ported` gates them until the integration merges r10.
#
#==============================================================================================

## Whether region r10's FourCC functions are ported (flip at integration).
var tests_r10_four_cc_is_ported: bool = false

# mark: Tests/LibGfx/TestWOFF.cpp and TestWOFF2.cpp ===============================================

noinline func test_body_malformed_woff():
    with memory.heap:
        let test_inputs: str[1] = ["tests/web_fonts/woff/invalid_sfnt_size.woff"]
        for test_input in test_inputs:
            let file = test_read_file(test_input)
            let font_or_error: Typeface*? = woff_try_load_from_bytes(ak.byte_buffer_bytes_const(&file)) catch:
                recover none
            assert(font_or_error == none)

test "malformed_woff":
    test_body_malformed_woff()

