## WOFF2ByteBufferOut's two writes and size.
noinline func test_body_woff2_byte_buffer_out():
    with memory.heap:
        var buffer: ak.ByteBuffer
        var output = woff2_byte_buffer_out_create(&buffer)
        let first: u8[3] = [1, 2, 3]
        assert(woff2_byte_buffer_out_write(&output, (const void*)&first[0], 3))
        assert(woff2_byte_buffer_out_size(&output) == 3)
        let second: u8[2] = [8, 9]
        assert(woff2_byte_buffer_out_write_usize(&output, (const void*)&second[0], 5, 2))
        assert(woff2_byte_buffer_out_size(&output) == 7)
        assert(ak.byte_buffer_bytes_const(&buffer)[5] == 8 and ak.byte_buffer_bytes_const(&buffer)[6] == 9)
        assert(not woff2_byte_buffer_out_write_usize(&output, (const void*)&second[0], ~(usize)0, 2))

test "woff2_byte_buffer_out":
    test_body_woff2_byte_buffer_out()

## Whether WOFF::try_load_from_bytes succeeds.
func test_woff_loads(bytes: const u8[]) -> bool:
    let font_or_error: Typeface*? = woff_try_load_from_bytes(bytes) catch:
        recover none
    return font_or_error != none

## WOFF's header checks, on hand-made headers.
noinline func test_body_woff_header_checks():
    with memory.heap:
        var header: u8[44]
        # A wrong signature.
        assert(not test_woff_loads(header))
        # 'wOFF' with no tables.
        header[0] = 'w'
        header[1] = 'O'
        header[2] = 'F'
        header[3] = 'F'
        header[11] = 44
        assert(not test_woff_loads(header))
        # Too short for a header.
        assert(not test_woff_loads(header[0..<20]))
        assert(woff_pow_2_less_than_or_equal(1) == 1)
        assert(woff_pow_2_less_than_or_equal(5) == 8)
        assert(woff_pow_2_less_than_or_equal(16) == 16)

test "woff_header_checks":
    test_body_woff_header_checks()

# mark: UnicodeRange, FontStyleMapping, FontSupport ==========================================

noinline func test_body_unicode_range():
    with memory.heap:
        let range = unicode_range_create(0x41, 0x5A)
        assert(unicode_range_contains(&range, 0x41))
        assert(unicode_range_contains(&range, 0x5A))
        assert(not unicode_range_contains(&range, 0x40))
        assert(not unicode_range_contains(&range, 0x5B))
        assert(unicode_range_eq(&range, unicode_range_create(0x41, 0x5A)))
        assert(not unicode_range_eq(&range, unicode_range_create(0x41, 0x5B)))
        let text = unicode_range_to_string(&range)
        assert(ak.string_view_text(ak.string_bytes_as_string_view(&text)) == "U+41-5A")
        let single = unicode_range_create(0x1F600, 0x1F600)
        let single_text = unicode_range_to_string(&single)
        assert(ak.string_view_text(ak.string_bytes_as_string_view(&single_text)) == "U+1F600")
        let everything = unicode_range_create(0, 0x10FFFF)
        let everything_text = unicode_range_to_string(&everything)
        assert(ak.string_view_text(ak.string_bytes_as_string_view(&everything_text)) == "U+0-10FFFF")

test "unicode_range":
    test_body_unicode_range()

noinline func test_body_font_style_mapping():
    assert(ak.string_view_text(weight_to_name(700)) == "Bold")
    assert(ak.string_view_text(weight_to_name(950)) == "Extra Black")
    assert(ak.string_view_text(weight_to_name(450)) == "")
    assert(name_to_weight(ak.sv("Semi Bold")) == 600)
    assert(name_to_weight(ak.sv("Bolder")) == 0)
    assert(ak.string_view_text(slope_to_name(2)) == "Oblique")
    assert(name_to_slope(ak.sv("Reclined")) == 3)
    assert(ak.string_view_text(width_to_name(5)) == "Normal")
    assert(name_to_width(ak.sv("Ultra Expanded")) == 9)
    assert(name_to_width(ak.sv("")) == 0)

