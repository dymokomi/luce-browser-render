#==============================================================================================
#
#   typeface - Typeface: a font face loaded from bytes, and its cache of Fonts per size
#
#   DESCRIPTION:
#       Port of Libraries/LibGfx/Font/Typeface.cpp (lines 1-85) with the inline functions of
#       Libraries/LibGfx/Font/Typeface.h (lines 1-109), and AK::Traits<Gfx::ShapeFeatures>
#       of Libraries/LibGfx/ShapeFeature.h (lines 1-45), which FontCacheKey::hash uses.
#       Typeface is abstract (TypefaceSkia is the one implementation); its pure virtuals
#       stay traps. ~Typeface's hb_face_destroy/hb_blob_destroy have nothing to release
#       (managed memory, DESIGN.md §3.3).
#
#==============================================================================================

## Ported from Libraries/LibGfx/Font/Typeface.h:35 Gfx::ScaledFontMetrics::height.
pub func scaled_font_metrics_height(this: const ScaledFontMetrics*) -> f32:
    return this.ascender + this.descender

## Ported from Libraries/LibGfx/Font/Typeface.h:46 Gfx::FontCacheKey::operator==.
pub func font_cache_key_eq(this: const FontCacheKey*, other: FontCacheKey) -> bool:
    return this.point_size == other.point_size and ak.vector_eq(&this.axes, &other.axes) and ak.vector_eq(&this.shape_features, &other.shape_features)

## Ported from Libraries/LibGfx/ShapeFeature.h:30 AK::Traits<Gfx::ShapeFeatures>::hash.
pub func shape_features_hash(features: const ak.Vector[ShapeFeature]*) -> u32:
    var features_hash: u32 = 0

    for feature in ak.vector_span_const(features):
        # `char` is signed in the donor's build (-fsigned-char): tags widen with their sign.
        features_hash = ak.pair_int_hash(features_hash, (u32)(i32)(i8)feature.tag[0])
        features_hash = ak.pair_int_hash(features_hash, (u32)(i32)(i8)feature.tag[1])
        features_hash = ak.pair_int_hash(features_hash, (u32)(i32)(i8)feature.tag[2])
        features_hash = ak.pair_int_hash(features_hash, (u32)(i32)(i8)feature.tag[3])
        features_hash = ak.pair_int_hash(features_hash, feature.value)

    return features_hash

## Ported from Libraries/LibGfx/Font/Typeface.h:51 Gfx::FontCacheKey::hash.
pub func font_cache_key_hash(this: const FontCacheKey*) -> u32:
    var h = ak.pair_int_hash(this.point_size.bits(), (u32)ak.vector_size(&this.axes))
    for axis in ak.vector_span_const(&this.axes):
        h = ak.pair_int_hash(h, ak.pair_int_hash(gfx.four_cc_to_u32(&axis.tag), axis.value.bits()))
    h = ak.pair_int_hash(h, shape_features_hash(&this.shape_features))
    return h

# mark: Loading =================================================================================

## Ported from Libraries/LibGfx/Font/Typeface.cpp:16 Gfx::Typeface::try_load_from_resource.
pub func typeface_try_load_from_resource(resource: const ak.CoreResource*, ttc_index: u32 = 0) -> Typeface*!:
    let font_data = font_data_create_from_resource(resource)
    return try typeface_try_load_from_font_data(font_data, ttc_index)

## Ported from Libraries/LibGfx/Font/Typeface.cpp:22 Gfx::Typeface::try_load_from_font_data.
pub func typeface_try_load_from_font_data(font_data: FontData*, ttc_index: u32 = 0) -> Typeface*!:
    let typeface = try typeface_try_load_from_externally_owned_memory(font_data_bytes(font_data), ttc_index)
    typeface.m_font_data = font_data
    return typeface

## Ported from Libraries/LibGfx/Font/Typeface.cpp:29 Gfx::Typeface::try_load_from_temporary_memory.
pub func typeface_try_load_from_temporary_memory(bytes: const u8[], ttc_index: u32 = 0) -> Typeface*!:
    let buffer = try ak.byte_buffer_copy_span_u8(bytes)
    let font_data = font_data_create_from_byte_buffer(buffer)
    return try typeface_try_load_from_font_data(font_data, ttc_index)

## Ported from Libraries/LibGfx/Font/Typeface.cpp:36 Gfx::Typeface::try_load_from_externally_owned_memory.
pub func typeface_try_load_from_externally_owned_memory(bytes: const u8[], ttc_index: u32 = 0) -> Typeface*!:
    let typeface = try typeface_skia_load_from_buffer(bytes, ttc_index)
    return typeface.typeface()

