## `Typeface::font`'s cap on the fonts a typeface caches.
let typeface_max_cached_font_size_count: usize = 128

## Ported from Libraries/LibGfx/Font/Typeface.cpp:51 Gfx::Typeface::font.
pub func typeface_font(this: Typeface*, point_size: f32, variations: FontVariationSettings = FontVariationSettings(), shape_features: ak.Vector[ShapeFeature] = ak.Vector[ShapeFeature]()) -> Font*:
    let key = FontCacheKey(point_size = point_size, axes = font_variation_settings_to_sorted_list(&variations), shape_features = ak.vector_clone(&shape_features))

    if let cached = ak.hash_map_get_k(&this.m_fonts, key):
        return *cached

    # FIXME: It might be nice to have a global cap on the number of fonts we cache
    #        instead of doing it at the per-Typeface level like this.
    if ak.hash_map_size(&this.m_fonts) > typeface_max_cached_font_size_count:
        ak.hash_map_remove_opaque(&this.m_fonts, ak.hash_map_begin(&this.m_fonts))

    var used_typeface: Typeface* = this
    if not font_variation_settings_is_empty(&variations):
        if let skia_typeface = as_if_typeface_skia(this):
            if let derived = typeface_skia_clone_with_variations(skia_typeface, font_variation_settings_to_sorted_list(&variations)):
                used_typeface = derived.typeface()

    let font = new Font(m_typeface = used_typeface) else trap("out of memory")
    font_construct(font, used_typeface, point_size, point_size, default_dpi, default_dpi, variations, shape_features)
    discard(ak.hash_map_set(&this.m_fonts, key, font))
    return font

## Ported from Libraries/LibGfx/Font/Typeface.cpp:76 Gfx::Typeface::harfbuzz_typeface.
pub func typeface_harfbuzz_typeface(this: Typeface*) -> HbFaceT*?:
    if this.m_harfbuzz_blob == none:
        this.m_harfbuzz_blob = hb_blob_create(typeface_buffer(this))
    if this.m_harfbuzz_face == none:
        let blob = this.m_harfbuzz_blob else trap("VERIFY_NOT_REACHED")
        this.m_harfbuzz_face = hb_face_create(blob, typeface_ttc_index(this))
    return this.m_harfbuzz_face

## Ported from Libraries/LibGfx/Font/Typeface.h:85 Gfx::Typeface::is_skia (virtual).
pub func typeface_is_skia_impl(this: Typeface*) -> bool:
    return false

