#==============================================================================================
#
#   tests_oracle - the web_fonts module against the reference build: faces, metrics, shaping,
#                  glyph paths and text-blob bounds
#
#   DESCRIPTION:
#       Printed by a local oracle program linked against the reference build's LibGfx
#       (Ladybird 47c82b38d0 with Skia's FreeType backend under the FontConfig font manager,
#       which Ladybird's test mode forces, and HarfBuzz 10.2.0); regenerate rather than edit.
#       Floats are compared bit for bit through their IEEE bits (DESIGN.md §6.7). The bodies
#       are in tests_support.lucb.
#
#==============================================================================================

test "face_serenity_sans":
    test_body_face("SerenitySans-Regular.ttf", "SerenitySans", 400, 5, 0, 1024, 98)
    let code_points: u32[12] = [0x20, 0x41, 0x61, 0x30, 0xA0, 0xE9, 0x2003, 0x200D, 0x1F600, 0x10FFFF, 0xFFFD, 0x66]
    let glyphs: u32[12] = [3, 36, 68, 19, 0, 0, 0, 0, 0, 0, 0, 73]
    test_body_glyph_ids("SerenitySans-Regular.ttf", code_points, glyphs)

test "face_lato_bold":
    test_body_face("Lato-Bold.ttf", "Lato", 700, 5, 0, 2000, 275)
    let code_points: u32[12] = [0x20, 0x41, 0x61, 0x30, 0xA0, 0xE9, 0x2003, 0x200D, 0x1F600, 0x10FFFF, 0xFFFD, 0x66]
    let glyphs: u32[12] = [3, 36, 68, 19, 98, 171, 0, 0, 0, 0, 0, 73]
    test_body_glyph_ids("Lato-Bold.ttf", code_points, glyphs)

test "face_noto_emoji":
    test_body_face("NotoEmoji.ttf", "Noto Emoji", 400, 5, 0, 2048, 1895)
    let code_points: u32[12] = [0x20, 0x41, 0x61, 0x30, 0xA0, 0xE9, 0x2003, 0x200D, 0x1F600, 0x10FFFF, 0xFFFD, 0x66]
    let glyphs: u32[12] = [3, 0, 0, 6, 0, 0, 0, 18, 895, 0, 0, 0]
    test_body_glyph_ids("NotoEmoji.ttf", code_points, glyphs)

test "face_noto_sans_tifinagh":
    test_body_face("NotoSansTifinagh-Regular.otf", "Noto Sans Tifinagh", 400, 5, 0, 1000, 161)
    let code_points: u32[12] = [0x20, 0x41, 0x61, 0x30, 0xA0, 0xE9, 0x2003, 0x200D, 0x1F600, 0x10FFFF, 0xFFFD, 0x66]
    let glyphs: u32[12] = [139, 0, 0, 0, 140, 0, 0, 142, 0, 0, 0, 0]
    test_body_glyph_ids("NotoSansTifinagh-Regular.otf", code_points, glyphs)

