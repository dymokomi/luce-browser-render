test "color conversion edge cases":
    test_color_conversion_edge_cases()

noinline func test_color_conversion_edge_cases():
    expect_components(hsv_to_srgb(color_components_new(300.0, 0.5, 0.8)), [0x3f4ccccd, 0x3ecccccd, 0x3f4ccccd, 0x3f800000], "hsv_to_srgb 300")
    expect_components(hsl_to_srgb(color_components_new(725.0, 1.5, 0.3, 2.0)), [0x3f400000, 0xbd999988, 0xbe19999a, 0x3f800000], "hsl_to_srgb big")
    expect_components(lab_to_xyz50(color_components_new(90.0, -10.0, 40.0)), [0x3f304354, 0x3f43562b, 0x3e99a315, 0x3f800000], "lab_to_xyz50 bright")
    expect_components(color_to_srgb(color_new_u8_u8_u8_u8(200, 100, 50, 128)), [0x3f48c8c9, 0x3ec8c8c9, 0x3e48c8c9, 0x3f008081], "color_to_srgb")
    expect_color(srgb_to_color(color_components_new(-0.3, 0.01, 1.5)), 0xff0003ff, "srgb_to_color")
    expect_components(hwb_to_srgb(color_components_new(10.0, 0.7, 0.6)), [0x3f09d89e, 0x3f09d89e, 0x3f09d89e, 0x3f800000], "hwb_to_srgb gray")
    expect_components(srgb_to_hsl(color_components_new(1.2, -0.1, 0.3)), [0x43aac4ec, 0x3fb8e38f, 0x3f0ccccd, 0x3f800000], "srgb_to_hsl neg")
    var components: ColorComponents
    color_components_init_fields(&components)
    assert(color_components_at_const(&components, 0) == 0.0 and color_components_alpha(&components) == 1.0)
    let first = color_components_at(&components, 1)
    *first = 0.25
    color_components_set_alpha(&components, 0.5)
    assert(color_components_at_const(&components, 1) == 0.25 and color_components_alpha(&components) == 0.5)
