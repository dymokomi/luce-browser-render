test "hsv":
    test_hsv()

noinline func test_hsv():
    expect_eq_color(color_from_hsv_f64(120.0, 0.714285714, 0.7), color_new_u8_u8_u8(51, 179, 51))
    let half = color_from_hsv_f64(120.0, 0.714285714, 0.7)
    expect_eq_color(color_with_opacity(&half, 0.5), color_new_u8_u8_u8_u8(51, 179, 51, 128))
    expect_eq_color(color_from_hsv_f64(108.0, 0.4, 0.5), color_new_u8_u8_u8(87, 128, 77))

test "hsl":
    test_hsl()

noinline func test_hsl():
    expect_eq_color(color_from_hsl(-300.0, 1.0, 0.375), color_new_u8_u8_u8(191, 191, 0))
    expect_eq_color(color_from_hsl(400.0, 0.25, 0.5), color_new_u8_u8_u8(159, 138, 96))
    expect_eq_color(color_from_hsl(330.0, 0.25, 0.5), color_new_u8_u8_u8(159, 96, 128))
    expect_eq_color(color_from_hsl(300.0, 1.0, 0.25), color_new_u8_u8_u8(128, 0, 128))
    expect_eq_color(color_from_hsl(180.0, 1.0, 0.25), color_new_u8_u8_u8(0, 128, 128))
    expect_eq_color(color_from_hsl(90.0, 0.875, 0.5), color_new_u8_u8_u8(128, 239, 16))
    expect_eq_color(color_from_hsl(90.0, 0.75, 0.5), color_new_u8_u8_u8(128, 223, 32))
    expect_eq_color(color_from_hsl(90.0, 0.625, 0.5), color_new_u8_u8_u8(128, 207, 48))
    expect_eq_color(color_from_hsl(90.0, 0.5, 0.5), color_new_u8_u8_u8(128, 191, 64))
    expect_eq_color(color_from_hsl(90.0, 0.375, 0.5), color_new_u8_u8_u8(128, 175, 80))
    expect_eq_color(color_from_hsl(90.0, 0.25, 0.5), color_new_u8_u8_u8(128, 159, 96))

# mark: Channels, blending and filters ==========================================================

test "blend":
    test_blend()

noinline func test_blend():
    let a = color_new_u8_u8_u8_u8(200, 100, 50, 128)
    let b = color_new_u8_u8_u8_u8(10, 20, 30, 200)
    let op = color_new_u8_u8_u8_u8(12, 34, 56, 255)
    let tr = color_new_u8_u8_u8_u8(1, 2, 3, 0)
    expect_color(color_blend(&a, b), 0xe3211d20, "blend_ab")
    expect_color(color_blend(&b, a), 0xe3744029, "blend_ba")
    expect_color(color_blend(&a, op), 0xff0c2238, "blend_a_op")
    expect_color(color_blend(&a, tr), 0x80c86432, "blend_a_tr")
    expect_color(color_blend(&tr, a), 0x80c86432, "blend_tr_a")

test "mixed_with and interpolate":
    test_mixed_with_and_interpolate()

noinline func test_mixed_with_and_interpolate():
    let a = color_new_u8_u8_u8_u8(200, 100, 50, 128)
    let b = color_new_u8_u8_u8_u8(10, 20, 30, 200)
    let a40 = color_with_alpha(&a, 40)
    expect_color(color_mixed_with(&a, b, 0.0), 0x80c86432, "mixed_ab 0")
    expect_color(color_interpolate(&a, b, 0.0), 0x80c86432, "interp_ab 0")
    expect_color(color_mixed_with(&a, a40, 0.0), 0x80c86432, "mixed_a_op 0")
    expect_color(color_mixed_with(&a, b, 0.25), 0x9287492b, "mixed_ab 0.25")
    expect_color(color_interpolate(&a, b, 0.25), 0x9298502d, "interp_ab 0.25")
    expect_color(color_mixed_with(&a, a40, 0.25), 0x6ac86432, "mixed_a_op 0.25")
    expect_color(color_mixed_with(&a, b, 0.5), 0xa4543326, "mixed_ab 0.5")
    expect_color(color_interpolate(&a, b, 0.5), 0xa4693c28, "interp_ab 0.5")
    expect_color(color_mixed_with(&a, a40, 0.5), 0x54c86432, "mixed_a_op 0.5")
    expect_color(color_mixed_with(&a, b, 0.75), 0xb62b2222, "mixed_ab 0.75")
    expect_color(color_interpolate(&a, b, 0.75), 0xb63a2823, "interp_ab 0.75")
    expect_color(color_mixed_with(&a, a40, 0.75), 0x3ec86432, "mixed_a_op 0.75")
    expect_color(color_mixed_with(&a, b, 1.0), 0xc80a141e, "mixed_ab 1")
    expect_color(color_interpolate(&a, b, 1.0), 0xc80a141e, "interp_ab 1")
    expect_color(color_mixed_with(&a, a40, 1.0), 0x28c86432, "mixed_a_op 1")
    expect_color(color_mixed_with(&a, b, 0.3), 0x967c442a, "mixed_ab 0.3")
    expect_color(color_interpolate(&a, b, 0.3), 0x968f4c2c, "interp_ab 0.3")
    expect_color(color_mixed_with(&a, a40, 0.3), 0x66c86432, "mixed_a_op 0.3")

test "multiply, distance, luminosity and contrast":
    test_multiply_distance_luminosity_contrast()

noinline func test_multiply_distance_luminosity_contrast():
    let a = color_new_u8_u8_u8_u8(200, 100, 50, 128)
    let b = color_new_u8_u8_u8_u8(10, 20, 30, 200)
    let op = color_new_u8_u8_u8_u8(12, 34, 56, 255)
    expect_color(color_multiply(&a, b), 0x64070705, "multiply")
    expect_f32_bits(color_distance_squared_to(&a, b), 0x3e0179c9, "distance_ab")
    expect_f32_bits(color_distance_squared_to(&a, op), 0x3e67b30c, "distance_a_op")
    assert(color_luminosity(&a) == 118 and color_luminosity(&b) == 19 and color_luminosity(&op) == 31)
    var mutable_a = a
    expect_f32_bits(color_contrast_ratio(&mutable_a, b), 0x4083c78f, "contrast_ab")
    var white = color_new_named_color(ColorNamedColor.white)
    expect_f32_bits(color_contrast_ratio(&white, color_new_named_color(ColorNamedColor.black)), 0x41a80000, "contrast_white_black")

test "filters":
    test_filters()

noinline func test_filters():
    let a = color_new_u8_u8_u8_u8(200, 100, 50, 128)
    let b = color_new_u8_u8_u8_u8(10, 20, 30, 200)
    let op = color_new_u8_u8_u8_u8(12, 34, 56, 255)
    expect_color(color_to_grayscale(&a), 0x80767676, "gray_a")
    expect_color(color_sepia(&a), 0x80a59372, "sepia_a")
    expect_color(color_sepia(&a, 0.5), 0x80b67b52, "sepia_a_half")
    expect_color(color_sepia(&b, 0.0), 0xc80a141e, "sepia_b_0")
    expect_color(color_with_opacity(&a, 0.3), 0x26c86432, "opacity_a")
    expect_color(color_with_opacity(&op, 0.5), 0x800c2238, "opacity_op")
    expect_color(color_darkened(&a), 0x80643219, "darkened_a")
    expect_color(color_darkened(&a, 0.3), 0x803c1e0f, "darkened_a_03")
    expect_color(color_lightened(&a), 0x80f0783c, "lightened_a")
    expect_color(color_lightened(&a, 2.0), 0x80ffc864, "lightened_a_2")
    expect_color(color_saturated_to(&a, 0.2), 0x80c8ada0, "saturated_a")
    expect_color(color_saturated_to(&op, 1.0), 0xff001c38, "saturated_op")
    expect_color(color_inverted(&a), 0x80379bcd, "inverted_a")
    expect_color(color_xored(&a, b), 0x80c2702c, "xored_ab")

test "alpha, setters, shades and tints":
    test_alpha_setters_shades_tints()

noinline func test_alpha_setters_shades_tints():
    let a = color_new_u8_u8_u8_u8(200, 100, 50, 128)
    let b = color_new_u8_u8_u8_u8(10, 20, 30, 200)
    let white = color_new_named_color(ColorNamedColor.white)
    expect_color(color_with_alpha(&a, 100, AlphaType.premultiplied), 0x644e2713, "with_alpha_pre")
    expect_color(color_with_alpha(&a, 100), 0x64c86432, "with_alpha_unpre")
    var x = a
    color_set_red(&x, 1)
    color_set_green(&x, 2)
    color_set_blue(&x, 3)
    expect_color(x, 0x80010203, "setters")
    assert(is_valid_alpha_type(0) and is_valid_alpha_type(1) and not is_valid_alpha_type(2))
    assert(color_red(&a) == 200 and color_green(&a) == 100 and color_blue(&a) == 50 and color_alpha(&a) == 128)
    assert(color_value(&a) == 0x80c86432)
    expect_color(color_from_rgba(0x11223344), 0x11443322, "from_rgba")
    expect_color(color_suggested_foreground_color(&a), 0xffffffff, "suggest_a")
    expect_color(color_suggested_foreground_color(&white), 0xff000000, "suggest_white")
    var shades = color_shades(&a, 4)
    assert(ak.vector_size(&shades) == 4)
    expect_color(*ak.vector_at(&shades, 0), 0x80964b25, "shade 0")
    expect_color(*ak.vector_at(&shades, 1), 0x80643219, "shade 1")
    expect_color(*ak.vector_at(&shades, 2), 0x8032190c, "shade 2")
    expect_color(*ak.vector_at(&shades, 3), 0x80000000, "shade 3")
    var tints = color_tints(&b, 3, 0.9)
    assert(ak.vector_size(&tints) == 3)
    expect_color(*ak.vector_at(&tints, 0), 0xc80d1a27, "tint 0")
    expect_color(*ak.vector_at(&tints, 1), 0xc80f1f2f, "tint 1")
    expect_color(*ak.vector_at(&tints, 2), 0xc8122538, "tint 2")

test "named and branded colors":
    test_named_and_branded_colors()

noinline func test_named_and_branded_colors():
    expect_color(color_new_named_color(ColorNamedColor.transparent), 0x00000000, "named 0")
    expect_color(color_new_named_color(ColorNamedColor.black), 0xff000000, "named 1")
    expect_color(color_new_named_color(ColorNamedColor.white), 0xffffffff, "named 2")
    expect_color(color_new_named_color(ColorNamedColor.red), 0xffff0000, "named 3")
    expect_color(color_new_named_color(ColorNamedColor.green), 0xff00ff00, "named 4")
    expect_color(color_new_named_color(ColorNamedColor.cyan), 0xff00ffff, "named 5")
    expect_color(color_new_named_color(ColorNamedColor.blue), 0xff0000ff, "named 6")
    expect_color(color_new_named_color(ColorNamedColor.yellow), 0xffffff00, "named 7")
    expect_color(color_new_named_color(ColorNamedColor.magenta), 0xffff00ff, "named 8")
    expect_color(color_new_named_color(ColorNamedColor.dark_gray), 0xff404040, "named 9")
    expect_color(color_new_named_color(ColorNamedColor.mid_gray), 0xff7f7f7f, "named 10")
    expect_color(color_new_named_color(ColorNamedColor.light_gray), 0xffc0c0c0, "named 11")
    expect_color(color_new_named_color(ColorNamedColor.warm_gray), 0xffd4d0c8, "named 12")
