#==============================================================================================
#
#   tests_color_1 - tests of Color: TestColor.cpp, channels, blending and filters
#
#   DESCRIPTION:
#       Port of Tests/LibGfx/TestColor.cpp (Ladybird 47c82b38d0), then tests pinned to the C++ for
#       what TestColor does not cover: blend, mixed_with, interpolate, multiply, distance,
#       luminosity, contrast, grayscale, sepia, opacity, darkening, lightening, saturation,
#       inversion, xor, the alpha and channel setters, shades and tints, the suggested foreground,
#       and the named and branded colors.
#       The expected values were printed by a C++ program built against the donor's LibGfx
#       (Build/release, clang -ffp-contract=off as the donor builds) and are compared exactly:
#       colors by value, floats by their bits.
#
#       Each test's body is a noinline function the test block calls, so that the test
#       runner's `main` does not inline every body (# workaround:
#       compiler-issues/ranges_facts_cubic).
#
#==============================================================================================

# mark: Helpers =================================================================================

## EXPECT_EQ on two colors, printing both on a mismatch.
func expect_eq_color(actual: Color, expected: Color):
    if not color_eq(&actual, expected):
        print(f"got {hex(color_value(&actual))}, expected {hex(color_value(&expected))}")
    assert(color_eq(&actual, expected))

## Checks a color against the BGRA8888 value the C++ computed, printing both on a mismatch.
func expect_color(actual: Color, expected: u32, what: str):
    let value = color_value(&actual)
    if value != expected:
        print(f"{what}: got {hex(value)}, expected {hex(expected)}")
    assert(value == expected)

## Checks a float against the bits the C++ computed.
func expect_f32_bits(actual: f32, expected: u32, what: str):
    let bits = actual.bits()
    if not within_libm_ulps((u64)bits, (u64)expected):
        print(f"{what}: got {hex(bits)} ({actual}), expected {hex(expected)}")
    assert(within_libm_ulps((u64)bits, (u64)expected))

## Checks a double against the bits the C++ computed.
func expect_f64_bits(actual: f64, expected: u64, what: str):
    let bits = actual.bits()
    if not within_libm_ulps(bits, expected):
        print(f"{what}: got {hex(bits)} ({actual}), expected {hex(expected)}")
    assert(within_libm_ulps(bits, expected))

## How many units in the last place a result may differ from the expected bits. The expected
## values were printed on macOS, and the color conversions call the C library's cbrt, atan2,
## sin and cos, whose last bits differ between C libraries (the donor built on Linux differs
## from them the same way; conversions such as Oklab compound the difference), so only macOS
## compares exactly.
let libm_ulps: u64 = 0 if os.macos else 64

## Whether two floats' bit patterns (of one width, same sign) are at most libm_ulps apart.
func within_libm_ulps(bits: u64, expected: u64) -> bool:
    let distance = bits - expected if bits >= expected else expected - bits
    return distance <= libm_ulps

# mark: TestColor.cpp ===========================================================================

test "color":
    test_color()

noinline func test_color():
    var i: u16 = 0
    while i < 256:
        let gray = color_new_u8_u8_u8((u8)i, (u8)i, (u8)i)
        expect_eq_color(gray, color_to_grayscale(&gray))
        i += 1

test "from_bgrx":
    test_from_bgrx()

noinline func test_from_bgrx():
    expect_eq_color(color_from_bgrx(0x000000ff), color_new_u8_u8_u8(0x00, 0x00, 0xff))
    expect_eq_color(color_from_bgrx(0x0000ff00), color_new_u8_u8_u8(0x00, 0xff, 0x00))
    expect_eq_color(color_from_bgrx(0x00ff0000), color_new_u8_u8_u8(0xff, 0x00, 0x00))

    expect_eq_color(color_from_bgrx(0xff0000ff), color_new_u8_u8_u8(0x00, 0x00, 0xff))
    expect_eq_color(color_from_bgrx(0xff00ff00), color_new_u8_u8_u8(0x00, 0xff, 0x00))
    expect_eq_color(color_from_bgrx(0xffff0000), color_new_u8_u8_u8(0xff, 0x00, 0x00))

    expect_eq_color(color_from_bgrx(0x00aabbcc), color_new_u8_u8_u8(0xaa, 0xbb, 0xcc))

test "from_bgra":
    test_from_bgra()

noinline func test_from_bgra():
    expect_eq_color(color_from_bgra(0xff000000), color_new_u8_u8_u8_u8(0x00, 0x00, 0x00, 0xff))
    expect_eq_color(color_from_bgra(0x000000ff), color_new_u8_u8_u8_u8(0x00, 0x00, 0xff, 0x00))
    expect_eq_color(color_from_bgra(0x0000ff00), color_new_u8_u8_u8_u8(0x00, 0xff, 0x00, 0x00))
    expect_eq_color(color_from_bgra(0x00ff0000), color_new_u8_u8_u8_u8(0xff, 0x00, 0x00, 0x00))

    expect_eq_color(color_from_bgra(0xddaabbcc), color_new_u8_u8_u8_u8(0xaa, 0xbb, 0xcc, 0xdd))

