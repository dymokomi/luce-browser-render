#==============================================================================================
#
#   tests_color_3 - tests of Color's strings and parsing, TextAlignment and Cursor
#
#   DESCRIPTION:
#       Tests pinned to the C++ for serialize_a_srgb_value (every alpha), to_string and its
#       variants, from_string (hex, rgb(), rgba(), keywords and named colors) and
#       from_utf16_string; TextAlignment's classification and string conversion; and
#       standard_cursor_to_string. ImageCursor::operator== is not tested: it reads
#       ShareableBitmap::bitmap, which region r10 ports.
#       The expected values were printed by a C++ program built against the donor's LibGfx
#       (Build/release, clang -ffp-contract=off as the donor builds) and are compared exactly:
#       colors by value, floats by their bits.
#
#       Each test's body is a noinline function the test block calls, so that the test
#       runner's `main` does not inline every body (# workaround:
#       compiler-issues/ranges_facts_cubic).
#
#==============================================================================================

# mark: Helpers =================================================================================

## Checks a String's text, printing both on a mismatch.
func expect_string(actual: const ak.String*, expected: str, what: str):
    let view = ak.string_bytes_as_string_view(actual)
    if not ak.string_view_equals(&view, expected):
        print(f"{what}: got {ak.string_view_text(view)}, expected {expected}")
    assert(ak.string_view_equals(&view, expected))

## Checks an optional color against the C++ result (none, or a BGRA8888 value).
func expect_optional_color(actual: Color?, expected: u32?, what: str):
    if let color = actual:
        if let value = expected:
            if color_value(&color) != value:
                print(f"{what}: got {hex(color_value(&color))}, expected {hex(value)}")
            assert(color_value(&color) == value)
        else:
            print(f"{what}: got {hex(color_value(&color))}, expected none")
            assert(false)
    elif let value = expected:
        print(f"{what}: got none, expected {hex(value)}")
        assert(false)

## Whether a StringView spells `text`.
func string_view_is(view: ak.StringView, text: str) -> bool:
    return ak.string_view_equals(&view, text)

## Whether a NUL-terminated C string (a `char const*`) spells `text`.
func c_string_equals(characters: const u8*?, text: str) -> bool:
    let pointer = characters else return false
    for i in 0..<text.length:
        if pointer[i] != text.bytes[i]:
            return false
    return pointer[text.length] == 0

# mark: Serialization ===========================================================================

