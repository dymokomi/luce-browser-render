#==============================================================================================
#
#   tests_sk_path_cases - Gfx::Path cases replayed on the SkPath port (generated)
#
#   DESCRIPTION:
#       Each case replays Gfx::Path calls with the helpers of tests_sk_path and checks the
#       to_svg_string, bounding_box (as bits), last_point (as bits), is_empty and contains
#       (nonzero, even-odd) answers that Ladybird 47c82b38d0 (Build/release) printed for the same
#       calls. Generated test vectors; each test body is a noinline function (# workaround:
#       compiler-issues/ranges_facts_cubic).
#
#==============================================================================================

test "sk path: basic":
    test_sk_case_basic()

noinline func test_sk_case_basic():
    var p = test_sk_gfx_path()
    test_sk_move_to(&p, 10.0, 20.0)
    sk_path_line_to(&p.path, 30.5, 40.25)
    sk_path_quad_to(&p.path, 1.0, 2.0, 3.0, 4.0)
    test_sk_close(&p)
    test_sk_elliptical_arc_to(&p, 50.0, 60.0, 20.0, 10.0, 0.3, false, true)
    test_sk_check_svg(&p, "M10 20L30.5 40.25Q1 2 3 4L10 20ZM10 20Q10.709711 19.898115 11.442657 19.820444Q12.175604 19.742773 12.93002 19.689503Q13.684437 19.63623 14.458506 19.607491Q15.232574 19.578747 16.024431 19.574604Q16.816288 19.570461 17.624027 19.590925Q18.431765 19.611389 19.253437 19.656414Q20.075109 19.701439 20.908737 19.770912Q21.742363 19.840387 22.585938 19.934145Q23.429512 20.027903 24.281 20.145718Q25.132488 20.263535 25.98984 20.405123Q26.847191 20.546711 27.708338 20.711731Q28.569489 20.876751 29.43236 21.064806Q30.295231 21.252861 31.157749 21.463499Q32.020264 21.674137 32.880348 21.906849Q33.740433 22.139559 34.596008 22.393784Q35.451584 22.648008 36.300598 22.923136Q37.149609 23.198261 37.990005 23.493626Q38.830406 23.788992 39.660168 24.103886Q40.489929 24.418776 41.307056 24.752436Q42.124184 25.086094 42.926704 25.437719Q43.729225 25.789343 44.515213 26.158085Q45.301197 26.526825 46.068752 26.911798Q46.836304 27.296768 47.583576 27.697041Q48.330849 28.097313 49.056046 28.511923Q49.781239 28.926533 50.482605 29.354481Q51.183975 29.782429 51.859825 30.222687Q52.535675 30.662941 53.18438 31.114443Q53.833084 31.565945 54.453079 32.027607Q55.073074 32.489265 55.662872 32.959976Q56.25267 33.430687 56.810844 33.909309Q57.369011 34.387932 57.894215 34.873314Q58.419418 35.358696 58.910393 35.849667Q59.401367 36.340637 59.856926 36.836021Q60.312485 37.331398 60.731529 37.829994Q61.150574 38.32859 61.532093 38.829197Q61.913612 39.329803 62.256691 39.831219Q62.59977 40.332634 62.903584 40.833649Q63.207397 41.334663 63.47121 41.834072Q63.73502 42.333477 63.958199 42.83007Q64.181374 43.326668 64.36338 43.819256Q64.545387 44.311844 64.685783 44.79924Q64.826172 45.286636 64.924622 45.767666Q65.023064 46.248692 65.079315 46.722191Q65.135574 47.195694 65.149506 47.660526Q65.163437 48.125359 65.135025 48.580402Q65.106606 49.035446 65.035904 49.479614Q64.965195 49.923775 64.852364 50.355984Q64.73954 50.788193 64.584869 51.207405Q64.430199 51.626617 64.234055 52.031826Q64.037918 52.437035 63.80077 52.827267Q63.563622 53.217491 63.286049 53.591797Q63.008476 53.966103 62.691143 54.323586Q62.37381 54.681068 62.017483 55.020866Q61.661156 55.360672 61.266689 55.681969Q60.872223 56.003265 60.440567 56.305286Q60.008915 56.607307 59.541115 56.88932Q59.073318 57.171337 58.570499 57.432671Q58.06768 57.694004 57.531052 57.934025Q56.994423 58.174042 56.425278 58.39217Q55.856133 58.610298 55.255844 58.806007Q54.655556 59.00172 54.02557 59.174545Q53.39558 59.347366 52.737411 59.496887Q52.079239 59.646408 51.394478 59.772263Q50.709709 59.898113 50 60")
    test_sk_check_bounds(&p, 0x3f800000, 0x40000000, 0x429bd21f, 0x42680000)
    test_sk_check_last_point(&p, 0x42480000, 0x42700000)
    assert(sk_path_is_empty(&p.path) == false)
    test_sk_check_contains(&p, 20.0, 30.0, true, true)
    test_sk_check_contains(&p, 10.0, 20.0, true, false)
    test_sk_check_contains(&p, 40.0, 40.0, true, true)

test "sk path: every_verb":
    test_sk_case_every_verb()

noinline func test_sk_case_every_verb():
    var p = test_sk_gfx_path()
    test_sk_move_to(&p, 0.0, 0.0)
    sk_path_line_to(&p.path, 10.0, 0.0)
    sk_path_quad_to(&p.path, 20.0, 0.0, 20.0, 10.0)
    sk_path_cubic_to(&p.path, 20.0, 20.0, 10.0, 20.0, 0.0, 20.0)
    test_sk_close(&p)
    test_sk_check_svg(&p, "M0 0L10 0Q20 0 20 10C20 20 10 20 0 20L0 0Z")
    test_sk_check_bounds(&p, 0x0, 0x0, 0x41a00000, 0x41a00000)
    test_sk_check_last_point(&p, 0x0, 0x0)
    assert(sk_path_is_empty(&p.path) == false)
    test_sk_check_contains(&p, 5.0, 5.0, true, true)
    test_sk_check_contains(&p, 15.0, 15.0, true, true)
    test_sk_check_contains(&p, 0.0, 0.0, true, true)
    test_sk_check_contains(&p, 10.0, 0.0, true, true)
    test_sk_check_contains(&p, -1.0, 5.0, false, false)
    test_sk_check_contains(&p, 20.0, 10.0, true, true)
    test_sk_check_contains(&p, 19.9, 10.0, true, true)
    test_sk_check_contains(&p, 5.0, 20.0, false, false)
    test_sk_check_contains(&p, 0.0, 10.0, true, true)
    test_sk_check_contains(&p, 15.0, 18.5, false, false)

test "sk path: move_collapse":
    test_sk_case_move_collapse()

noinline func test_sk_case_move_collapse():
    var p = test_sk_gfx_path()
    test_sk_move_to(&p, 1.0, 1.0)
    test_sk_move_to(&p, 2.0, 2.0)
    sk_path_line_to(&p.path, 3.0, 3.0)
    test_sk_move_to(&p, 5.0, 5.0)
    test_sk_check_svg(&p, "M2 2L3 3")
    test_sk_check_bounds(&p, 0x40000000, 0x40000000, 0x40400000, 0x40400000)
    test_sk_check_last_point(&p, 0x40a00000, 0x40a00000)
    assert(sk_path_is_empty(&p.path) == false)

test "sk path: close_continue":
    test_sk_case_close_continue()

noinline func test_sk_case_close_continue():
    var p = test_sk_gfx_path()
    test_sk_move_to(&p, 0.0, 0.0)
    sk_path_line_to(&p.path, 10.0, 0.0)
    sk_path_line_to(&p.path, 10.0, 10.0)
    test_sk_close(&p)
    test_sk_close(&p)
    sk_path_line_to(&p.path, 20.0, 20.0)
    sk_path_quad_to(&p.path, 30.0, 20.0, 30.0, 30.0)
    test_sk_check_svg(&p, "M0 0L10 0L10 10L0 0ZM0 0ZM0 0L20 20Q30 20 30 30")
    test_sk_check_bounds(&p, 0x0, 0x0, 0x41f00000, 0x41f00000)
    test_sk_check_last_point(&p, 0x41f00000, 0x41f00000)
    assert(sk_path_is_empty(&p.path) == false)
    test_sk_check_contains(&p, 8.0, 2.0, true, true)
    test_sk_check_contains(&p, 25.0, 24.0, true, true)

test "sk path: line_first":
    test_sk_case_line_first()

noinline func test_sk_case_line_first():
    var p = test_sk_gfx_path()
    sk_path_line_to(&p.path, 5.0, 5.0)
    sk_path_line_to(&p.path, 5.0, 0.0)
    test_sk_check_svg(&p, "M0 0L5 5L5 0")
    test_sk_check_bounds(&p, 0x0, 0x0, 0x40a00000, 0x40a00000)
    test_sk_check_last_point(&p, 0x40a00000, 0x0)
    assert(sk_path_is_empty(&p.path) == false)
    test_sk_check_contains(&p, 4.0, 2.0, true, true)

