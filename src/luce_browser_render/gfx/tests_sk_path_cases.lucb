    test_sk_elliptical_arc_to(&p, 3.0, 3.0, 5.0, 5.0, 0.0, false, false)
    test_sk_check_svg(&p, "M3 3L3 3")
    test_sk_check_bounds(&p, 0x40400000, 0x40400000, 0x0, 0x0)
    test_sk_check_last_point(&p, 0x40400000, 0x40400000)
    assert(sk_path_is_empty(&p.path) == false)

