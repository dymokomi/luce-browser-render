noinline func test_sk_case_evenodd_nested():
    var p = test_sk_gfx_path()
    test_sk_move_to(&p, 0.0, 0.0)
    sk_path_line_to(&p.path, 100.0, 0.0)
    sk_path_line_to(&p.path, 100.0, 100.0)
    sk_path_line_to(&p.path, 0.0, 100.0)
    test_sk_close(&p)
    test_sk_move_to(&p, 25.0, 25.0)
    sk_path_line_to(&p.path, 75.0, 25.0)
    sk_path_line_to(&p.path, 75.0, 75.0)
    sk_path_line_to(&p.path, 25.0, 75.0)
    test_sk_close(&p)
    test_sk_check_svg(&p, "M0 0L100 0L100 100L0 100L0 0ZM25 25L75 25L75 75L25 75L25 25Z")
    test_sk_check_bounds(&p, 0x0, 0x0, 0x42c80000, 0x42c80000)
    test_sk_check_last_point(&p, 0x41c80000, 0x41c80000)
    assert(sk_path_is_empty(&p.path) == false)
    test_sk_check_contains(&p, 50.0, 50.0, true, false)
    test_sk_check_contains(&p, 10.0, 10.0, true, true)
    test_sk_check_contains(&p, 25.0, 25.0, true, true)
    test_sk_check_contains(&p, 50.0, 25.0, true, true)
    test_sk_check_contains(&p, 0.0, 50.0, true, true)
    test_sk_check_contains(&p, 100.0, 50.0, true, true)
    test_sk_check_contains(&p, 101.0, 50.0, false, false)

