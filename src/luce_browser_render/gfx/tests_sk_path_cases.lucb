test "sk path: hv":
    test_sk_case_hv()

noinline func test_sk_case_hv():
    var p = test_sk_gfx_path()
    test_sk_move_to(&p, 1.0, 2.0)
    test_sk_horizontal_line_to(&p, 7.0)
    test_sk_vertical_line_to(&p, 9.0)
    test_sk_horizontal_line_to(&p, 1.0)
    test_sk_close(&p)
    test_sk_check_svg(&p, "M1 2L7 2L7 9L1 9L1 2Z")
    test_sk_check_bounds(&p, 0x3f800000, 0x40000000, 0x40c00000, 0x40e00000)
    test_sk_check_last_point(&p, 0x3f800000, 0x40000000)
    assert(sk_path_is_empty(&p.path) == false)
    test_sk_check_contains(&p, 3.0, 3.0, true, true)

test "sk path: offset":
    test_sk_case_offset()

noinline func test_sk_case_offset():
    var p = test_sk_gfx_path()
    test_sk_move_to(&p, 0.0, 0.0)
    sk_path_line_to(&p.path, 10.0, 10.0)
    sk_path_quad_to(&p.path, 20.0, 0.0, 30.0, 10.0)
    test_sk_close(&p)
    sk_path_offset(&p.path, 5.5, -3.25)
    test_sk_check_svg(&p, "M5.5 -3.25L15.5 6.75Q25.5 -3.25 35.5 6.75L5.5 -3.25Z")
    test_sk_check_bounds(&p, 0x40b00000, 0xc0500000, 0x41f00000, 0x41200000)
    test_sk_check_last_point(&p, 0x40b00000, 0xc0500000)
    assert(sk_path_is_empty(&p.path) == false)
    test_sk_check_contains(&p, 10.0, 5.0, false, false)

