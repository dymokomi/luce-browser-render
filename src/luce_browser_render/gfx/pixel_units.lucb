# mark: Free functions ==========================================================================

## Ported from Libraries/LibWeb/PixelUnits.h:429 abs(Web::CSSPixels).
pub func abs_css_pixels(value: CssPixels) -> CssPixels:
    return css_pixels_abs(&value)

## Ported from Libraries/LibWeb/PixelUnits.h:434 floor(Web::CSSPixels).
pub func floor(value: CssPixels) -> CssPixels:
    return css_pixels_from_raw(css_pixels_raw_value(&value) & ~css_pixels_radix_mask)

## Ported from Libraries/LibWeb/PixelUnits.h:439 ceil(Web::CSSPixels).
pub func ceil(value: CssPixels) -> CssPixels:
    let floor_value = css_pixels_raw_value(&value) & ~css_pixels_radix_mask
    # The addition overflows (undefined in C++, wrapping in practice) only within 1px of the
    # largest value.
    let ceil_value = floor_value +% (css_pixels_fixed_point_denominator if (css_pixels_raw_value(&value) & css_pixels_radix_mask) != 0 else 0)
    return css_pixels_from_raw(ceil_value)

## Ported from Libraries/LibWeb/PixelUnits.h:446 round(Web::CSSPixels).
pub func round(value: CssPixels) -> CssPixels:
    # FIXME: Maybe do this with bit-fiddling instead
    if gt_css_pixels_int(value, 0):
        return floor(css_pixels_add_css_pixels(&value, css_pixels_from_raw(css_pixels_fixed_point_denominator >> 1)))  # 0.5
    return ceil(css_pixels_sub(&value, css_pixels_from_raw(css_pixels_fixed_point_denominator >> 1)))  # 0.5

## Ported from Libraries/LibWeb/PixelUnits.h:454 sqrt(Web::CSSPixels).
pub func sqrt(value: CssPixels) -> CssPixels:
    return css_pixels_nearest_value_for_f32(ak.sqrt_f32(css_pixels_to_float_const(&value)))

## Ported from Libraries/LibWeb/PixelUnits.h:459 abs(Web::DevicePixels).
pub func abs_i32(value: i32) -> i32:
    return ak.abs_i32(value)

## Ported from Libraries/LibWeb/PixelUnits.h:464 square_distance_between.
pub func square_distance_between(a: CssPixelPoint, b: CssPixelPoint) -> CssPixels:
    let delta_x = abs_css_pixels(css_pixel_point_x(&a).sub(css_pixel_point_x(&b)))
    let delta_y = abs_css_pixels(css_pixel_point_y(&a).sub(css_pixel_point_y(&b)))
    return delta_x.mul(delta_x).add(delta_y.mul(delta_y))

## Ported from Libraries/LibWeb/PixelUnits.h:471 constrained.
pub func constrained(point: CssPixelPoint, rect: CssPixelRect) -> CssPixelPoint:
    return CssPixelPoint(
        ak.clamp(css_pixel_point_x(&point), css_pixel_rect_left(&rect), css_pixel_rect_right(&rect).sub(css_pixels_from_int(1))),
        ak.clamp(css_pixel_point_y(&point), css_pixel_rect_top(&rect), css_pixel_rect_bottom(&rect).sub(css_pixels_from_int(1))),
    )

## Ported from Libraries/LibWeb/PixelUnits.h:481 Web::CSSPixelRect::to_rounded<Web::CSSPixels>.
pub func css_pixel_rect_to_rounded(this: const CssPixelRect*) -> CssPixelRect:
    return CssPixelRect(
        CssPixelPoint(round(css_pixel_rect_x(this)), round(css_pixel_rect_y(this))),
        CssPixelSize(round(css_pixel_rect_width(this)), round(css_pixel_rect_height(this))),
    )
