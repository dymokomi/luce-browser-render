#==============================================================================================
#
#   tests_pixel_units - CSSPixels, CSSPixelFraction and DevicePixels, pinned to the donor
#
#   DESCRIPTION:
#       Values computed by the donor's PixelUnits.h (Ladybird 47c82b38d0, compiled locally)
#       for the cases Tests/LibWeb/TestCSSPixels.cpp does not cover: float conversions and
#       their rounding, saturation, the fraction arithmetic, the free functions and the hash.
#       Raw values are the fixed-point integers (1px = 64).
#
#       Each test's body is a noinline function the test block calls, so that the test
#       runner's `main` does not inline every body (# workaround:
#       compiler-issues/ranges_facts_cubic).
#
#==============================================================================================

test "pixel_units: nearest_f32_0_3":
    test_pixel_units_nearest_f32_0_3()

# C++:  CSSPixels::nearest_value_for(0.3f).raw_value()
noinline func test_pixel_units_nearest_f32_0_3():
    assert((i64)(css_pixels_nearest_value_for_f32(0.3).raw_value()) == 19)

test "pixel_units: nearest_f32_minus_0_3":
    test_pixel_units_nearest_f32_minus_0_3()

