noinline func test_pixel_units_square_distance_between():
    assert((i64)(square_distance_between(CssPixelPoint(css_pixels_from_int(1), css_pixels_from_int(2)), CssPixelPoint(css_pixels_from_f64(4.5), css_pixels_from_int(-2))).raw_value()) == 1808)

test "pixel_units: constrained_x":
    test_pixel_units_constrained_x()

# C++: p.x().raw_value()
noinline func test_pixel_units_constrained_x():
    let p = constrained(CssPixelPoint(css_pixels_from_int(100), css_pixels_from_int(-5)), CssPixelRect(CssPixelPoint(css_pixels_from_int(0), css_pixels_from_int(0)), CssPixelSize(css_pixels_from_int(10), css_pixels_from_int(10))))
    assert((i64)(css_pixel_point_x(&p).raw_value()) == 576)

test "pixel_units: constrained_y":
    test_pixel_units_constrained_y()

# C++: p.y().raw_value()
noinline func test_pixel_units_constrained_y():
    let p = constrained(CssPixelPoint(css_pixels_from_int(100), css_pixels_from_int(-5)), CssPixelRect(CssPixelPoint(css_pixels_from_int(0), css_pixels_from_int(0)), CssPixelSize(css_pixels_from_int(10), css_pixels_from_int(10))))
    assert((i64)(css_pixel_point_y(&p).raw_value()) == 0)

test "pixel_units: rect_to_rounded":
    test_pixel_units_rect_to_rounded()

# C++: r.x().raw_value() * 1000000 + r.y().raw_value() * 10000 + r.width().raw_value() * 100 + r.height().raw_value()
noinline func test_pixel_units_rect_to_rounded():
    let source = CssPixelRect(CssPixelPoint(css_pixels_from_f64(1.5), css_pixels_from_f64(-1.5)), CssPixelSize(css_pixels_from_f64(0.49), css_pixels_from_f64(2.51)))
    let r = css_pixel_rect_to_rounded(&source)
    assert((i64)((i64)css_pixel_rect_x(&r).raw_value() * 1000000 + (i64)css_pixel_rect_y(&r).raw_value() * 10000 + (i64)css_pixel_rect_width(&r).raw_value() * 100 + (i64)css_pixel_rect_height(&r).raw_value()) == 126720192)

test "pixel_units: hash":
    test_pixel_units_hash()

# C++:  Traits<CSSPixels>::hash(CSSPixels(3))
noinline func test_pixel_units_hash():
    var traits: CssPixelsTraits
    let v = css_pixels_from_int(3)
    assert((i64)(traits.hash_of(&v)) == 2813460772)

