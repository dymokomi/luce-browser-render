## The transfer function and matrix of a color space as float bits, in CicpCase's order.
func color_space_bits(color_space: const SkColorSpace*) -> u32[16]:
    let tf = color_space.fTransferFn
    let values: f32[16] = [
        tf.g, tf.a, tf.b, tf.c, tf.d, tf.e, tf.f,
        color_space.fToXYZD50.vals[0][0], color_space.fToXYZD50.vals[0][1], color_space.fToXYZD50.vals[0][2],
        color_space.fToXYZD50.vals[1][0], color_space.fToXYZD50.vals[1][1], color_space.fToXYZD50.vals[1][2],
        color_space.fToXYZD50.vals[2][0], color_space.fToXYZD50.vals[2][1], color_space.fToXYZD50.vals[2][2],
    ]
    var bits: u32[16]
    for i in 0..<16:
        let value = values[i]
        bits[i] = value.bits()
    return bits

test "from_cicp":
    test_from_cicp()

noinline func test_from_cicp():
    for test_case in cicp_cases:
        let cicp = MediaCodingIndependentCodePoints(
            m_color_primaries = (MediaColorPrimaries)test_case.primaries,
            m_transfer_characteristics = (MediaTransferCharacteristics)test_case.transfer,
            m_matrix_coefficients = MediaMatrixCoefficients.bt709,
            m_video_full_range_flag = MediaVideoFullRangeFlag.full,
        )
        var failed = false
        var color_space = color_space_from_cicp(cicp) catch failure:
            failed = true
            if failure.message != test_case.error_message:
                print(f"cicp {test_case.primaries} {test_case.transfer}: error {failure.message}, expected {test_case.error_message}")
            assert(failure.message == test_case.error_message)
            continue
        if test_case.error_message.length != 0:
            print(f"cicp {test_case.primaries} {test_case.transfer}: no error, expected {test_case.error_message}")
        assert(not failed and test_case.error_message.length == 0)
        let sk = *color_space_color_space_sk_sp(&color_space) else trap("null color space")
        let bits = color_space_bits(sk)
        if bits != test_case.bits:
            print(f"cicp {test_case.primaries} {test_case.transfer}: bits differ")
            for i in 0..<16:
                if bits[i] != test_case.bits[i]: print(f"    [{i}] got {hex(bits[i])}, expected {hex(test_case.bits[i])}")
        assert(bits == test_case.bits)

test "color space constructors":
    test_color_space_constructors()

noinline func test_color_space_constructors():
    var color_space: ColorSpace = ---
    color_space_construct(&color_space)
    assert(*color_space_color_space_sk_sp(&color_space) == none)
    let empty: u8[1] = [0]
    var loaded = color_space_load_from_icc_bytes(empty[0..<0]) else trap("empty profile")
    assert(*color_space_color_space_sk_sp(&loaded) == none)
    var failed = false
    discard(color_space_load_from_icc_bytes(empty) catch failure:
        assert(failure.message == "Failed to parse the ICC profile")
        failed = true
        recover loaded)
    assert(failed)
    let impl = new ColorSpaceImpl(color_space = none) else trap("out of memory")
    var wrapped: ColorSpace = ---
    color_space_construct_color_space_impl(&wrapped, impl)
    assert(wrapped.m_color_space == impl)

# mark: Palette and AnonymousBuffer =============================================================

test "anonymous buffer":
    test_anonymous_buffer()

noinline func test_anonymous_buffer():
    let invalid = CoreAnonymousBuffer(m_impl = none)
    assert(not core_anonymous_buffer_is_valid(&invalid))
    assert(core_anonymous_buffer_size(&invalid) == 0 and core_anonymous_buffer_data(&invalid) == none)
    let empty = core_anonymous_buffer_create_with_size(0) else trap("create")
    assert(core_anonymous_buffer_is_valid(&empty) and core_anonymous_buffer_size(&empty) == 0 and core_anonymous_buffer_data(&empty) == none)
    let buffer = core_anonymous_buffer_create_with_size(100) else trap("create")
    assert(core_anonymous_buffer_size(&buffer) == 100)
    let data = core_anonymous_buffer_data(&buffer) else trap("no data")
    let bytes = u8[]((u8*)data, 100)
    for byte in bytes: assert(byte == 0)

## A Palette over a new SystemTheme whose every color, alignment, flag, metric and path is
## derived from its role, so that each accessor can be checked against the role it reads.
func palette_with_role_values() -> Palette:
    let buffer = core_anonymous_buffer_create_with_size(sizeof(SystemTheme)) else trap("create")
    let impl = palette_impl_create_with_anonymous_buffer(buffer)
    let theme = (SystemTheme*)palette_impl_theme(impl)
    for i in 0..<99: theme.color[i] = 0xff000000 | (u32)i
    theme.alignment[1] = TextAlignment.bottom_left
    theme.flag[1] = true
    theme.flag[3] = true
    for i in 0..<6: theme.metric[i] = (i32)i * 10
    for i in 0..<8:
        theme.path[i][0] = '/'
        theme.path[i][1] = (u8)((u8)'a' + (u8)i)
    var palette: Palette = ---
    palette_construct(&palette, impl)
    return palette

test "palette accessors":
    test_palette_accessors()

