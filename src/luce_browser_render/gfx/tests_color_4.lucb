#==============================================================================================
#
#   tests_color_4 - tests of ColorSpace, Palette and AnonymousBuffer
#
#   DESCRIPTION:
#       ColorSpace::from_cicp for every color primaries value 0-23 with the transfer
#       characteristics 1-18 that matter (and a reserved one), pinned to the transfer function and
#       XYZ D50 matrix of the SkColorSpace the donor builds (printed by a C++ program linked against
#       the donor's LibGfx and Skia), and the error messages; the default and ICC constructors;
#       Palette over a SystemTheme in an AnonymousBuffer: every named accessor reads its own role,
#       and the setters copy the theme before writing (see palette_1).
#
#       Each test's body is a noinline function the test block calls, so that the test
#       runner's `main` does not inline every body (# workaround:
#       compiler-issues/ranges_facts_cubic).
#
#==============================================================================================

# mark: ColorSpace ==============================================================================

## One from_cicp case: the code points, and the C++ result: an error message, or the
## transfer function { g, a, b, c, d, e, f } and the row-major XYZ D50 matrix as float bits.
struct CicpCase:
    var primaries: u8
    var transfer: u8
    var error_message: str
    var bits: u32[16]

## The from_cicp cases, as the donor computes them.
let cicp_cases: CicpCase[336] = [
    CicpCase(primaries = 0, transfer = 1, error_message = "Illegal color primaries", bits = [0x00000000, 0x00000000, 0x00000000, 0x00000000, 0x00000000, 0x00000000, 0x00000000, 0x00000000, 0x00000000, 0x00000000, 0x00000000, 0x00000000, 0x00000000, 0x00000000, 0x00000000, 0x00000000]),
