    let taskbar_shadow_path = palette_taskbar_shadow_path(&palette)
    assert(ak.byte_string_length(&taskbar_shadow_path) == 2 and ak.byte_string_bytes(&taskbar_shadow_path)[1] == (u8)((u8)'a' + (u8)PathRole.taskbar_shadow))
    let tooltip_shadow_path = palette_tooltip_shadow_path(&palette)
    assert(ak.byte_string_length(&tooltip_shadow_path) == 2 and ak.byte_string_bytes(&tooltip_shadow_path)[1] == (u8)((u8)'a' + (u8)PathRole.tooltip_shadow))
    let color_scheme_path = palette_color_scheme_path(&palette)
    assert(ak.byte_string_length(&color_scheme_path) == 2 and ak.byte_string_bytes(&color_scheme_path)[1] == (u8)((u8)'a' + (u8)PathRole.color_scheme))
    let impl = palette_impl_const(&palette)
    let base = palette_impl_color(impl, ColorRole.base)
    assert(color_value(&base) == 0xff000008)
    assert(palette_theme(&palette).metric[5] == 50)

test "palette setters":
    test_palette_setters()

noinline func test_palette_setters():
    var palette = palette_with_role_values()
    let original = palette_impl(&palette)
    palette_set_color(&palette, ColorRole.accent, color_new_u8_u8_u8(1, 2, 3))
    let accent = palette_accent(&palette)
    assert(color_value(&accent) == 0xff010203)
    # The setter copied the theme: the original PaletteImpl is unchanged.
    assert(palette_impl(&palette) != original)
    let original_accent = palette_impl_color(original, ColorRole.accent)
    assert(color_value(&original_accent) == 0xff000001)
    palette_set_alignment(&palette, AlignmentRole.title_alignment, TextAlignment.top_right)
    assert(palette_title_alignment(&palette) == TextAlignment.top_right)
    palette_set_flag(&palette, FlagRole.is_dark, true)
    assert(palette_is_dark(&palette))
    palette_set_flag(&palette, FlagRole.is_dark, false)
    assert(not palette_is_dark(&palette))
    palette_set_metric(&palette, MetricRole.title_height, -7)
    assert(palette_window_title_height(&palette) == -7)
    palette_set_path(&palette, PathRole.menu_shadow, ak.byte_string_from_str("/res/menu-shadow.png"))
    let menu_shadow = palette_menu_shadow_path(&palette)
    assert(string_view_is(ak.byte_string_view(&menu_shadow), "/res/menu-shadow.png"))
    # A path of 300 characters keeps its first 255 and a NUL.
    var builder = ak.string_builder_new()
    ak.string_builder_append_repeated_u8(&builder, 'x', 300)
    palette_set_path(&palette, PathRole.color_scheme, ak.string_builder_to_byte_string(&builder))
    let color_scheme = palette_color_scheme_path(&palette)
    assert(ak.byte_string_length(&color_scheme) == 255)
    # Every other value survived the copies.
    let base = palette_base(&palette)
    assert(color_value(&base) == 0xff000008)
    assert(palette_window_border_thickness(&palette) == 10)
    assert(string_view_is(ak.byte_string_view(&menu_shadow), "/res/menu-shadow.png"))
    let clone = palette_impl_clone(palette_impl_const(&palette))
    let cloned_accent = palette_impl_color(clone, ColorRole.accent)
    assert(color_value(&cloned_accent) == 0xff010203)
    let replacement = core_anonymous_buffer_create_with_size(sizeof(SystemTheme)) else trap("create")
    palette_impl_replace_internal_buffer(clone, replacement)
    let replaced_accent = palette_impl_color(clone, ColorRole.accent)
    assert(color_value(&replaced_accent) == 0)
