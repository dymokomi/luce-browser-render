pub func css_pixel_rect_scale_by_css_pixel_point(this: CssPixelRect*, delta: CssPixelPoint):
    css_pixel_rect_scale_by_css_pixels_css_pixels(this, css_pixel_point_x(&delta), css_pixel_point_y(&delta))

## Ported from Libraries/LibGfx/Rect.h:84 Gfx::Rect::center for CssPixelRect.
pub func css_pixel_rect_center(this: const CssPixelRect*) -> CssPixelPoint:
    return CssPixelPoint(css_pixel_rect_x(this).add(css_pixels_halved(css_pixel_rect_width(this))), css_pixel_rect_y(this).add(css_pixels_halved(css_pixel_rect_height(this))))

## Ported from Libraries/LibGfx/Rect.h:89 Gfx::Rect::set_location for CssPixelRect.
pub func css_pixel_rect_set_location(this: CssPixelRect*, location: CssPixelPoint):
    this.m_location = location

