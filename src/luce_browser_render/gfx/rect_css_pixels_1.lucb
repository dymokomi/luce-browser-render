pub func css_pixel_rect_set_size_css_pixel_size(this: CssPixelRect*, size: CssPixelSize):
    this.m_size = size

## Ported from Libraries/LibGfx/Rect.h:99 Gfx::Rect::set_size for CssPixelRect.
pub func css_pixel_rect_set_size_css_pixels(this: CssPixelRect*, width: CssPixels, height: CssPixels):
    css_pixel_size_set_width(&this.m_size, width)
    css_pixel_size_set_height(&this.m_size, height)

# mark: Inflating and shrinking =================================================================

## Ported from Libraries/LibGfx/Rect.h:105 Gfx::Rect::inflate for CssPixelRect.
pub func css_pixel_rect_inflate_css_pixels_css_pixels(this: CssPixelRect*, w: CssPixels, h: CssPixels):
    css_pixel_rect_set_x(this, css_pixel_rect_x(this).sub(css_pixels_halved(w)))
    css_pixel_rect_set_width(this, css_pixel_rect_width(this).add(w))
    css_pixel_rect_set_y(this, css_pixel_rect_y(this).sub(css_pixels_halved(h)))
    css_pixel_rect_set_height(this, css_pixel_rect_height(this).add(h))

## Ported from Libraries/LibGfx/Rect.h:113 Gfx::Rect::inflate for CssPixelRect.
pub func css_pixel_rect_inflate_css_pixels_css_pixels_css_pixels(this: CssPixelRect*, top: CssPixels, right: CssPixels, bottom: CssPixels, left: CssPixels):
    css_pixel_rect_set_x(this, css_pixel_rect_x(this).sub(left))
    css_pixel_rect_set_width(this, css_pixel_rect_width(this).add(left).add(right))
    css_pixel_rect_set_y(this, css_pixel_rect_y(this).sub(top))
    css_pixel_rect_set_height(this, css_pixel_rect_height(this).add(top).add(bottom))

## Ported from Libraries/LibGfx/Rect.h:121 Gfx::Rect::inflate for CssPixelRect.
pub func css_pixel_rect_inflate_css_pixel_size(this: CssPixelRect*, size: CssPixelSize):
    css_pixel_rect_set_x(this, css_pixel_rect_x(this).sub(css_pixels_halved(css_pixel_size_width(&size))))
    css_pixel_rect_set_width(this, css_pixel_rect_width(this).add(css_pixel_size_width(&size)))
    css_pixel_rect_set_y(this, css_pixel_rect_y(this).sub(css_pixels_halved(css_pixel_size_height(&size))))
    css_pixel_rect_set_height(this, css_pixel_rect_height(this).add(css_pixel_size_height(&size)))

## Ported from Libraries/LibGfx/Rect.h:129 Gfx::Rect::shrink for CssPixelRect.
pub func css_pixel_rect_shrink_css_pixels_css_pixels(this: CssPixelRect*, w: CssPixels, h: CssPixels):
    css_pixel_rect_set_x(this, css_pixel_rect_x(this).add(css_pixels_halved(w)))
    css_pixel_rect_set_width(this, css_pixel_rect_width(this).sub(w))
    css_pixel_rect_set_y(this, css_pixel_rect_y(this).add(css_pixels_halved(h)))
    css_pixel_rect_set_height(this, css_pixel_rect_height(this).sub(h))

## Ported from Libraries/LibGfx/Rect.h:137 Gfx::Rect::shrink for CssPixelRect.
pub func css_pixel_rect_shrink_css_pixels_css_pixels_css_pixels(this: CssPixelRect*, top: CssPixels, right: CssPixels, bottom: CssPixels, left: CssPixels):
    css_pixel_rect_set_x(this, css_pixel_rect_x(this).add(left))
    css_pixel_rect_set_width(this, css_pixel_rect_width(this).sub(left.add(right)))
    css_pixel_rect_set_y(this, css_pixel_rect_y(this).add(top))
    css_pixel_rect_set_height(this, css_pixel_rect_height(this).sub(top.add(bottom)))

## Ported from Libraries/LibGfx/Rect.h:145 Gfx::Rect::shrink for CssPixelRect.
pub func css_pixel_rect_shrink_css_pixel_size(this: CssPixelRect*, size: CssPixelSize):
    css_pixel_rect_set_x(this, css_pixel_rect_x(this).add(css_pixels_halved(css_pixel_size_width(&size))))
    css_pixel_rect_set_width(this, css_pixel_rect_width(this).sub(css_pixel_size_width(&size)))
    css_pixel_rect_set_y(this, css_pixel_rect_y(this).add(css_pixels_halved(css_pixel_size_height(&size))))
    css_pixel_rect_set_height(this, css_pixel_rect_height(this).sub(css_pixel_size_height(&size)))

## Ported from Libraries/LibGfx/Rect.h:153 Gfx::Rect::translated for CssPixelRect.
pub func css_pixel_rect_translated_css_pixels_css_pixels(this: const CssPixelRect*, dx: CssPixels, dy: CssPixels) -> CssPixelRect:
    var rect = *this
    css_pixel_rect_translate_by_css_pixels_css_pixels(&rect, dx, dy)
    return rect

