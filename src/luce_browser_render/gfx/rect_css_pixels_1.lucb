#==============================================================================================
#
#   rect_css_pixels_1 - Gfx::Rect<Web::CSSPixels> (CSSPixelRect): construction to orientation
#
#   DESCRIPTION:
#       Port of Libraries/LibGfx/Rect.h (lines 19-347) for T = CSSPixels, in the order of
#       rect_int_1.lucb; rect_css_pixels_2.lucb has the rest of the class. Arithmetic is
#       CSSPixels' (saturating, fixed point), spelled with its methods (pixel_units.lucb). A
#       CSSPixels divided by 2 is a CSSPixelFraction that converts back to CSSPixels, as the
#       C++ expression `x() + width() / 2` does implicitly (`css_pixels_halved`); a literal 0 is
#       CSSPixels(0).
#
#       Member templates over a second type U are instantiated for the types phase 1 uses: the
#       constructors from `Point<U>`/`Size<U>` and from `Rect<U>` are the `to_type_*` functions
#       of the other instantiations; `contains(Container)` and `intersects(Container)` take a
#       span of rects.
#
#==============================================================================================

# mark: Construction and access =================================================================

## Ported from Libraries/LibGfx/Rect.h:24 Gfx::Rect::Rect<T> for CssPixelRect.
pub func css_pixel_rect_construct_css_pixels(this: CssPixelRect*, x: CssPixels, y: CssPixels, width: CssPixels, height: CssPixels):
    this.m_location = CssPixelPoint(x, y)
    this.m_size = CssPixelSize(width, height)

## Ported from Libraries/LibGfx/Rect.h:31 Gfx::Rect::Rect<T>(U x, U y, U width, U height) for CssPixelRect, with U a signed integer.
pub func css_pixel_rect_construct_int(this: CssPixelRect*, x: i64, y: i64, width: i64, height: i64):
    css_pixel_point_construct_int(&this.m_location, x, y)
    css_pixel_size_construct_int(&this.m_size, width, height)

## Ported from Libraries/LibGfx/Rect.h:37 Gfx::Rect::Rect<T> for CssPixelRect.
pub func css_pixel_rect_construct_css_pixel_point(this: CssPixelRect*, location: CssPixelPoint, size: CssPixelSize):
    this.m_location = location
    this.m_size = size

## Ported from Libraries/LibGfx/Rect.h:57 Gfx::Rect::x for CssPixelRect.
pub func css_pixel_rect_x(this: const CssPixelRect*) -> CssPixels:
    return css_pixel_point_x(&this.m_location)

## Ported from Libraries/LibGfx/Rect.h:58 Gfx::Rect::y for CssPixelRect.
pub func css_pixel_rect_y(this: const CssPixelRect*) -> CssPixels:
