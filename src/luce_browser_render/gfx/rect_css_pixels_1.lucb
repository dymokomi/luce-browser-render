## Ported from Libraries/LibGfx/Rect.h:67 Gfx::Rect::location for CssPixelRect.
pub func css_pixel_rect_location(this: const CssPixelRect*) -> CssPixelPoint:
    return this.m_location

## Ported from Libraries/LibGfx/Rect.h:68 Gfx::Rect::size for CssPixelRect.
pub func css_pixel_rect_size(this: const CssPixelRect*) -> CssPixelSize:
    return this.m_size

## Ported from Libraries/LibGfx/Rect.h:70 Gfx::Rect::is_empty for CssPixelRect.
pub func css_pixel_rect_is_empty(this: const CssPixelRect*) -> bool:
    return css_pixel_rect_width(this).le(css_pixels_from_int(0)) or css_pixel_rect_height(this).le(css_pixels_from_int(0))

# CSSPixels::operator/(T) then CSSPixelFraction's operator CSSPixels: the C++ `value / 2` where a
# CSSPixels is expected.
func css_pixels_halved(value: CssPixels) -> CssPixels:
    let fraction = div_css_pixels_int(value, 2)
    return css_pixel_fraction_to_css_pixels(&fraction)

