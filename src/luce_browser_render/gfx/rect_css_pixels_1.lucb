## Ported from Libraries/LibGfx/Rect.h:331 Gfx::Rect::set_secondary_size_for_orientation for CssPixelRect.
pub func css_pixel_rect_set_secondary_size_for_orientation(this: CssPixelRect*, orientation: Orientation, value: CssPixels):
    css_pixel_size_set_secondary_size_for_orientation(&this.m_size, orientation, value)

## Ported from Libraries/LibGfx/Rect.h:333 Gfx::Rect::inflate_primary_for_orientation for CssPixelRect.
pub func css_pixel_rect_inflate_primary_for_orientation(this: CssPixelRect*, orientation: Orientation, before: CssPixels, after: CssPixels):
    if orientation == Orientation.horizontal:
        css_pixel_rect_inflate_css_pixels_css_pixels_css_pixels(this, css_pixels_from_int(0), after, css_pixels_from_int(0), before)
    else:
        css_pixel_rect_inflate_css_pixels_css_pixels_css_pixels(this, before, css_pixels_from_int(0), after, css_pixels_from_int(0))

