# mark: Taking slices ===========================================================================

## Ported from Libraries/LibGfx/Rect.h:237 Gfx::Rect::take_from_right for CssPixelRect.
pub func css_pixel_rect_take_from_right(this: CssPixelRect*, w: CssPixels) -> CssPixelRect:
    var w_ = w
    if w_.gt(css_pixel_rect_width(this)):
        w_ = css_pixel_rect_width(this)
    var rect = *this
    css_pixel_rect_set_width(this, css_pixel_rect_width(this).sub(w_))
    css_pixel_rect_set_x(&rect, css_pixel_rect_x(this).add(css_pixel_rect_width(this)))
    css_pixel_rect_set_width(&rect, w_)
    return rect

## Ported from Libraries/LibGfx/Rect.h:248 Gfx::Rect::take_from_left for CssPixelRect.
pub func css_pixel_rect_take_from_left(this: CssPixelRect*, w: CssPixels) -> CssPixelRect:
    var w_ = w
    if w_.gt(css_pixel_rect_width(this)):
        w_ = css_pixel_rect_width(this)
    var rect = *this
    css_pixel_rect_set_x(this, css_pixel_rect_x(this).add(w_))
    css_pixel_rect_set_width(this, css_pixel_rect_width(this).sub(w_))
    css_pixel_rect_set_width(&rect, w_)
    return rect

## Ported from Libraries/LibGfx/Rect.h:259 Gfx::Rect::take_from_top for CssPixelRect.
pub func css_pixel_rect_take_from_top(this: CssPixelRect*, h: CssPixels) -> CssPixelRect:
    var h_ = h
    if h_.gt(css_pixel_rect_height(this)):
        h_ = css_pixel_rect_height(this)
    var rect = *this
    css_pixel_rect_set_y(this, css_pixel_rect_y(this).add(h_))
    css_pixel_rect_set_height(this, css_pixel_rect_height(this).sub(h_))
    css_pixel_rect_set_height(&rect, h_)
    return rect

## Ported from Libraries/LibGfx/Rect.h:270 Gfx::Rect::take_from_bottom for CssPixelRect.
pub func css_pixel_rect_take_from_bottom(this: CssPixelRect*, h: CssPixels) -> CssPixelRect:
    var h_ = h
    if h_.gt(css_pixel_rect_height(this)):
        h_ = css_pixel_rect_height(this)
    var rect = *this
    css_pixel_rect_set_height(this, css_pixel_rect_height(this).sub(h_))
    css_pixel_rect_set_y(&rect, css_pixel_rect_y(this).add(css_pixel_rect_height(this)))
    css_pixel_rect_set_height(&rect, h_)
    return rect

# mark: Containment =============================================================================

## Ported from Libraries/LibGfx/Rect.h:281 Gfx::Rect::contains_vertically for CssPixelRect.
pub func css_pixel_rect_contains_vertically(this: const CssPixelRect*, y: CssPixels) -> bool:
    return y.ge(css_pixel_rect_top(this)) and y.lt(css_pixel_rect_bottom(this))

## Ported from Libraries/LibGfx/Rect.h:286 Gfx::Rect::contains_horizontally for CssPixelRect.
pub func css_pixel_rect_contains_horizontally(this: const CssPixelRect*, x: CssPixels) -> bool:
    return x.ge(css_pixel_rect_left(this)) and x.lt(css_pixel_rect_right(this))

## Ported from Libraries/LibGfx/Rect.h:291 Gfx::Rect::contains for CssPixelRect.
pub func css_pixel_rect_contains_css_pixels(this: const CssPixelRect*, x: CssPixels, y: CssPixels) -> bool:
    return css_pixel_rect_contains_horizontally(this, x) and css_pixel_rect_contains_vertically(this, y)

## Ported from Libraries/LibGfx/Rect.h:296 Gfx::Rect::contains for CssPixelRect.
pub func css_pixel_rect_contains_css_pixel_point(this: const CssPixelRect*, point: CssPixelPoint) -> bool:
    return css_pixel_rect_contains_css_pixels(this, css_pixel_point_x(&point), css_pixel_point_y(&point))

## Ported from Libraries/LibGfx/Rect.h:301 Gfx::Rect::contains for CssPixelRect.
pub func css_pixel_rect_contains_css_pixel_rect(this: const CssPixelRect*, other: CssPixelRect) -> bool:
    return (css_pixel_rect_left(this).le(css_pixel_rect_left(&other))
        and css_pixel_rect_right(this).ge(css_pixel_rect_right(&other))
        and css_pixel_rect_top(this).le(css_pixel_rect_top(&other))
        and css_pixel_rect_bottom(this).ge(css_pixel_rect_bottom(&other)))

## Ported from Libraries/LibGfx/Rect.h:310 Gfx::Rect::contains<Container> for CssPixelRect.
pub func css_pixel_rect_contains_t_container(this: const CssPixelRect*, others: const CssPixelRect[]) -> bool:
    var have_any = false
    for other in others:
        if not css_pixel_rect_contains_css_pixel_rect(this, other):
            return false
        have_any = true
    return have_any

