## Ported from Libraries/LibGfx/Rect.h:62 Gfx::Rect::set_x for CssPixelRect.
pub func css_pixel_rect_set_x(this: CssPixelRect*, x: CssPixels):
    css_pixel_point_set_x(&this.m_location, x)

## Ported from Libraries/LibGfx/Rect.h:63 Gfx::Rect::set_y for CssPixelRect.
pub func css_pixel_rect_set_y(this: CssPixelRect*, y: CssPixels):
