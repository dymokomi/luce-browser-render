## Ported from Libraries/LibGfx/Rect.h:322 Gfx::Rect::set_primary_offset_for_orientation for FloatRect.
pub func float_rect_set_primary_offset_for_orientation(this: FloatRect*, orientation: Orientation, value: f32):
