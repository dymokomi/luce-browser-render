#==============================================================================================
#
#   rect_float_1 - Gfx::Rect<float> (FloatRect): construction to orientation
#
#   DESCRIPTION:
#       Port of Libraries/LibGfx/Rect.h (lines 19-347) for T = float; rect_float_2.lucb has the
#       rest of the class. The class template is instantiated per type (DESIGN.md §2.8):
#       rect_int_* and rect_css_pixels_* hold the other instantiations, function for function.
#
#       Member templates over a second type U are instantiated for the types phase 1 uses: the
#       constructors from `Point<U>`/`Size<U>` and from `Rect<U>` are the `to_type_*` functions
#       of the other instantiations; `contains(Container)` and `intersects(Container)` take a
#       span of rects.
#
#==============================================================================================

# mark: Construction and access =================================================================

## Ported from Libraries/LibGfx/Rect.h:24 Gfx::Rect::Rect<T> for FloatRect.
pub func float_rect_construct_f32(this: FloatRect*, x: f32, y: f32, width: f32, height: f32):
    this.m_location = FloatPoint(x, y)
    this.m_size = FloatSize(width, height)

## Ported from Libraries/LibGfx/Rect.h:31 Gfx::Rect::Rect<T>(U x, U y, U width, U height) for FloatRect, with U = int.
pub func float_rect_construct_i32(this: FloatRect*, x: i32, y: i32, width: i32, height: i32):
    float_point_construct_i32(&this.m_location, x, y)
    float_size_construct_i32(&this.m_size, width, height)

## Ported from Libraries/LibGfx/Rect.h:37 Gfx::Rect::Rect<T> for FloatRect.
pub func float_rect_construct_float_point(this: FloatRect*, location: FloatPoint, size: FloatSize):
    this.m_location = location
    this.m_size = size

## Ported from Libraries/LibGfx/Rect.h:57 Gfx::Rect::x for FloatRect.
pub func float_rect_x(this: const FloatRect*) -> f32:
    return float_point_x(&this.m_location)

## Ported from Libraries/LibGfx/Rect.h:58 Gfx::Rect::y for FloatRect.
pub func float_rect_y(this: const FloatRect*) -> f32:
    return float_point_y(&this.m_location)

## Ported from Libraries/LibGfx/Rect.h:59 Gfx::Rect::width for FloatRect.
pub func float_rect_width(this: const FloatRect*) -> f32:
    return float_size_width(&this.m_size)

## Ported from Libraries/LibGfx/Rect.h:60 Gfx::Rect::height for FloatRect.
pub func float_rect_height(this: const FloatRect*) -> f32:
    return float_size_height(&this.m_size)

## Ported from Libraries/LibGfx/Rect.h:62 Gfx::Rect::set_x for FloatRect.
pub func float_rect_set_x(this: FloatRect*, x: f32):
    float_point_set_x(&this.m_location, x)

## Ported from Libraries/LibGfx/Rect.h:63 Gfx::Rect::set_y for FloatRect.
pub func float_rect_set_y(this: FloatRect*, y: f32):
    float_point_set_y(&this.m_location, y)

## Ported from Libraries/LibGfx/Rect.h:64 Gfx::Rect::set_width for FloatRect.
pub func float_rect_set_width(this: FloatRect*, width: f32):
    float_size_set_width(&this.m_size, width)

## Ported from Libraries/LibGfx/Rect.h:65 Gfx::Rect::set_height for FloatRect.
pub func float_rect_set_height(this: FloatRect*, height: f32):
    float_size_set_height(&this.m_size, height)

## Ported from Libraries/LibGfx/Rect.h:67 Gfx::Rect::location for FloatRect.
pub func float_rect_location(this: const FloatRect*) -> FloatPoint:
    return this.m_location

## Ported from Libraries/LibGfx/Rect.h:68 Gfx::Rect::size for FloatRect.
pub func float_rect_size(this: const FloatRect*) -> FloatSize:
    return this.m_size

## Ported from Libraries/LibGfx/Rect.h:70 Gfx::Rect::is_empty for FloatRect.
pub func float_rect_is_empty(this: const FloatRect*) -> bool:
    return float_rect_width(this) <= 0.0 or float_rect_height(this) <= 0.0

