pub func float_rect_set_secondary_offset_for_orientation(this: FloatRect*, orientation: Orientation, value: f32):
    float_point_set_secondary_offset_for_orientation(&this.m_location, orientation, value)

## Ported from Libraries/LibGfx/Rect.h:325 Gfx::Rect::translate_primary_offset_for_orientation for FloatRect.
pub func float_rect_translate_primary_offset_for_orientation(this: FloatRect*, orientation: Orientation, delta: f32):
    float_point_set_primary_offset_for_orientation(&this.m_location, orientation, float_point_primary_offset_for_orientation(&this.m_location, orientation) + delta)

## Ported from Libraries/LibGfx/Rect.h:326 Gfx::Rect::translate_secondary_offset_for_orientation for FloatRect.
pub func float_rect_translate_secondary_offset_for_orientation(this: FloatRect*, orientation: Orientation, delta: f32):
    float_point_set_secondary_offset_for_orientation(&this.m_location, orientation, float_point_secondary_offset_for_orientation(&this.m_location, orientation) + delta)

## Ported from Libraries/LibGfx/Rect.h:328 Gfx::Rect::primary_size_for_orientation for FloatRect.
pub func float_rect_primary_size_for_orientation(this: const FloatRect*, orientation: Orientation) -> f32:
    return float_size_primary_size_for_orientation(&this.m_size, orientation)

## Ported from Libraries/LibGfx/Rect.h:329 Gfx::Rect::secondary_size_for_orientation for FloatRect.
pub func float_rect_secondary_size_for_orientation(this: const FloatRect*, orientation: Orientation) -> f32:
    return float_size_secondary_size_for_orientation(&this.m_size, orientation)

## Ported from Libraries/LibGfx/Rect.h:330 Gfx::Rect::set_primary_size_for_orientation for FloatRect.
pub func float_rect_set_primary_size_for_orientation(this: FloatRect*, orientation: Orientation, value: f32):
    float_size_set_primary_size_for_orientation(&this.m_size, orientation, value)

## Ported from Libraries/LibGfx/Rect.h:331 Gfx::Rect::set_secondary_size_for_orientation for FloatRect.
pub func float_rect_set_secondary_size_for_orientation(this: FloatRect*, orientation: Orientation, value: f32):
    float_size_set_secondary_size_for_orientation(&this.m_size, orientation, value)

## Ported from Libraries/LibGfx/Rect.h:333 Gfx::Rect::inflate_primary_for_orientation for FloatRect.
pub func float_rect_inflate_primary_for_orientation(this: FloatRect*, orientation: Orientation, before: f32, after: f32):
    if orientation == Orientation.horizontal:
        float_rect_inflate_f32_f32_f32(this, 0.0, after, 0.0, before)
    else:
        float_rect_inflate_f32_f32_f32(this, before, 0.0, after, 0.0)

## Ported from Libraries/LibGfx/Rect.h:341 Gfx::Rect::inflate_secondary_for_orientation for FloatRect.
pub func float_rect_inflate_secondary_for_orientation(this: FloatRect*, orientation: Orientation, before: f32, after: f32):
    if orientation == Orientation.horizontal:
        float_rect_inflate_f32_f32_f32(this, before, 0.0, after, 0.0)
    else:
        float_rect_inflate_f32_f32_f32(this, 0.0, after, 0.0, before)
