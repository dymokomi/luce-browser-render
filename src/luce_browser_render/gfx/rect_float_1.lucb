pub func float_rect_set_size_float_size(this: FloatRect*, size: FloatSize):
    this.m_size = size

## Ported from Libraries/LibGfx/Rect.h:99 Gfx::Rect::set_size for FloatRect.
pub func float_rect_set_size_f32(this: FloatRect*, width: f32, height: f32):
    float_size_set_width(&this.m_size, width)
    float_size_set_height(&this.m_size, height)

# mark: Inflating and shrinking =================================================================

## Ported from Libraries/LibGfx/Rect.h:105 Gfx::Rect::inflate for FloatRect.
pub func float_rect_inflate_f32_f32(this: FloatRect*, w: f32, h: f32):
    float_rect_set_x(this, float_rect_x(this) - w / 2.0)
    float_rect_set_width(this, float_rect_width(this) + w)
    float_rect_set_y(this, float_rect_y(this) - h / 2.0)
    float_rect_set_height(this, float_rect_height(this) + h)

## Ported from Libraries/LibGfx/Rect.h:113 Gfx::Rect::inflate for FloatRect.
pub func float_rect_inflate_f32_f32_f32(this: FloatRect*, top: f32, right: f32, bottom: f32, left: f32):
    float_rect_set_x(this, float_rect_x(this) - left)
    float_rect_set_width(this, float_rect_width(this) + left + right)
    float_rect_set_y(this, float_rect_y(this) - top)
    float_rect_set_height(this, float_rect_height(this) + top + bottom)

## Ported from Libraries/LibGfx/Rect.h:121 Gfx::Rect::inflate for FloatRect.
pub func float_rect_inflate_float_size(this: FloatRect*, size: FloatSize):
    float_rect_set_x(this, float_rect_x(this) - float_size_width(&size) / 2.0)
    float_rect_set_width(this, float_rect_width(this) + float_size_width(&size))
    float_rect_set_y(this, float_rect_y(this) - float_size_height(&size) / 2.0)
    float_rect_set_height(this, float_rect_height(this) + float_size_height(&size))

## Ported from Libraries/LibGfx/Rect.h:129 Gfx::Rect::shrink for FloatRect.
pub func float_rect_shrink_f32_f32(this: FloatRect*, w: f32, h: f32):
    float_rect_set_x(this, float_rect_x(this) + w / 2.0)
    float_rect_set_width(this, float_rect_width(this) - w)
    float_rect_set_y(this, float_rect_y(this) + h / 2.0)
    float_rect_set_height(this, float_rect_height(this) - h)

## Ported from Libraries/LibGfx/Rect.h:137 Gfx::Rect::shrink for FloatRect.
pub func float_rect_shrink_f32_f32_f32(this: FloatRect*, top: f32, right: f32, bottom: f32, left: f32):
    float_rect_set_x(this, float_rect_x(this) + left)
    float_rect_set_width(this, float_rect_width(this) - (left + right))
    float_rect_set_y(this, float_rect_y(this) + top)
    float_rect_set_height(this, float_rect_height(this) - (top + bottom))

## Ported from Libraries/LibGfx/Rect.h:145 Gfx::Rect::shrink for FloatRect.
pub func float_rect_shrink_float_size(this: FloatRect*, size: FloatSize):
    float_rect_set_x(this, float_rect_x(this) + float_size_width(&size) / 2.0)
    float_rect_set_width(this, float_rect_width(this) - float_size_width(&size))
    float_rect_set_y(this, float_rect_y(this) + float_size_height(&size) / 2.0)
    float_rect_set_height(this, float_rect_height(this) - float_size_height(&size))

## Ported from Libraries/LibGfx/Rect.h:153 Gfx::Rect::translated for FloatRect.
pub func float_rect_translated_f32_f32(this: const FloatRect*, dx: f32, dy: f32) -> FloatRect:
    var rect = *this
    float_rect_translate_by_f32_f32(&rect, dx, dy)
    return rect

