pub func float_rect_scale_by_float_point(this: FloatRect*, delta: FloatPoint):
    float_rect_scale_by_f32_f32(this, float_point_x(&delta), float_point_y(&delta))

## Ported from Libraries/LibGfx/Rect.h:84 Gfx::Rect::center for FloatRect.
pub func float_rect_center(this: const FloatRect*) -> FloatPoint:
    return FloatPoint(float_rect_x(this) + float_rect_width(this) / 2.0, float_rect_y(this) + float_rect_height(this) / 2.0)

## Ported from Libraries/LibGfx/Rect.h:89 Gfx::Rect::set_location for FloatRect.
pub func float_rect_set_location(this: FloatRect*, location: FloatPoint):
