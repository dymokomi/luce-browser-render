# mark: Taking slices ===========================================================================

## Ported from Libraries/LibGfx/Rect.h:237 Gfx::Rect::take_from_right for FloatRect.
pub func float_rect_take_from_right(this: FloatRect*, w: f32) -> FloatRect:
    var w_ = w
    if w_ > float_rect_width(this):
        w_ = float_rect_width(this)
    var rect = *this
    float_rect_set_width(this, float_rect_width(this) - w_)
    float_rect_set_x(&rect, float_rect_x(this) + float_rect_width(this))
    float_rect_set_width(&rect, w_)
    return rect

## Ported from Libraries/LibGfx/Rect.h:248 Gfx::Rect::take_from_left for FloatRect.
pub func float_rect_take_from_left(this: FloatRect*, w: f32) -> FloatRect:
    var w_ = w
    if w_ > float_rect_width(this):
        w_ = float_rect_width(this)
    var rect = *this
    float_rect_set_x(this, float_rect_x(this) + w_)
    float_rect_set_width(this, float_rect_width(this) - w_)
    float_rect_set_width(&rect, w_)
    return rect

## Ported from Libraries/LibGfx/Rect.h:259 Gfx::Rect::take_from_top for FloatRect.
pub func float_rect_take_from_top(this: FloatRect*, h: f32) -> FloatRect:
    var h_ = h
    if h_ > float_rect_height(this):
        h_ = float_rect_height(this)
    var rect = *this
    float_rect_set_y(this, float_rect_y(this) + h_)
    float_rect_set_height(this, float_rect_height(this) - h_)
    float_rect_set_height(&rect, h_)
    return rect

## Ported from Libraries/LibGfx/Rect.h:270 Gfx::Rect::take_from_bottom for FloatRect.
pub func float_rect_take_from_bottom(this: FloatRect*, h: f32) -> FloatRect:
    var h_ = h
    if h_ > float_rect_height(this):
        h_ = float_rect_height(this)
    var rect = *this
    float_rect_set_height(this, float_rect_height(this) - h_)
    float_rect_set_y(&rect, float_rect_y(this) + float_rect_height(this))
    float_rect_set_height(&rect, h_)
    return rect

# mark: Containment =============================================================================

## Ported from Libraries/LibGfx/Rect.h:281 Gfx::Rect::contains_vertically for FloatRect.
pub func float_rect_contains_vertically(this: const FloatRect*, y: f32) -> bool:
    return y >= float_rect_top(this) and y < float_rect_bottom(this)

## Ported from Libraries/LibGfx/Rect.h:286 Gfx::Rect::contains_horizontally for FloatRect.
pub func float_rect_contains_horizontally(this: const FloatRect*, x: f32) -> bool:
    return x >= float_rect_left(this) and x < float_rect_right(this)

## Ported from Libraries/LibGfx/Rect.h:291 Gfx::Rect::contains for FloatRect.
pub func float_rect_contains_f32(this: const FloatRect*, x: f32, y: f32) -> bool:
    return float_rect_contains_horizontally(this, x) and float_rect_contains_vertically(this, y)

## Ported from Libraries/LibGfx/Rect.h:296 Gfx::Rect::contains for FloatRect.
pub func float_rect_contains_float_point(this: const FloatRect*, point: FloatPoint) -> bool:
    return float_rect_contains_f32(this, float_point_x(&point), float_point_y(&point))

## Ported from Libraries/LibGfx/Rect.h:301 Gfx::Rect::contains for FloatRect.
pub func float_rect_contains_float_rect(this: const FloatRect*, other: FloatRect) -> bool:
    return (float_rect_left(this) <= float_rect_left(&other)
        and float_rect_right(this) >= float_rect_right(&other)
        and float_rect_top(this) <= float_rect_top(&other)
        and float_rect_bottom(this) >= float_rect_bottom(&other))

## Ported from Libraries/LibGfx/Rect.h:310 Gfx::Rect::contains<Container> for FloatRect.
pub func float_rect_contains_t_container(this: const FloatRect*, others: const FloatRect[]) -> bool:
    var have_any = false
    for other in others:
        if not float_rect_contains_float_rect(this, other):
            return false
        have_any = true
    return have_any

