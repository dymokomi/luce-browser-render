## Ported from Libraries/LibGfx/Bitmap.h:105 Gfx::Bitmap::size_in_bytes.
pub func bitmap_size_in_bytes_usize(pitch: usize, height: i32) -> usize:
    return pitch * (usize)height

## Ported from Libraries/LibGfx/Bitmap.h:106 Gfx::Bitmap::size_in_bytes.
pub func bitmap_size_in_bytes(this: const Bitmap*) -> usize:
