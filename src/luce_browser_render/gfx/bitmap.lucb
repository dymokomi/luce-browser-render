## Ported from Libraries/LibGfx/Bitmap.h:111 Gfx::Bitmap::anonymous_buffer.
pub func bitmap_anonymous_buffer(this: Bitmap*) -> CoreAnonymousBuffer*:
    return &this.m_buffer

## Ported from Libraries/LibGfx/Bitmap.h:112 Gfx::Bitmap::anonymous_buffer.
pub func bitmap_anonymous_buffer_const(this: const Bitmap*) -> CoreAnonymousBuffer:
    return this.m_buffer

## Ported from Libraries/LibGfx/Bitmap.h:137 Gfx::Bitmap::alpha_type.
pub func bitmap_alpha_type(this: const Bitmap*) -> AlphaType:
    return this.m_alpha_type

# mark: Pixels =================================================================================

## Ported from Libraries/LibGfx/Bitmap.h:229 Gfx::Bitmap::get_pixel.
pub func bitmap_get_pixel(this: const Bitmap*, x: i32, y: i32) -> Color:
    assert(x >= 0)
    assert(x < bitmap_width(this))
    let row = bitmap_scanline_const(this, y) else trap("VERIFY: bitmap data")
    let pixel = row[(usize)x]
    match this.m_format:
        .bg_rx8888: return color_from_bgrx(pixel)
        .bgra8888: return color_from_bgra(pixel)
        .rgba8888: return color_from_rgba(pixel)
        .rg_bx8888: return color_from_rgbx(pixel)
        .invalid: trap("VERIFY_NOT_REACHED")
        _: trap("VERIFY_NOT_REACHED")

## Ported from Libraries/LibGfx/Bitmap.h:249 Gfx::Bitmap::set_pixel.
pub func bitmap_set_pixel(this: Bitmap*, x: i32, y: i32, color: Color):
    let row = bitmap_scanline(this, y) else trap("VERIFY: bitmap data")
    match this.m_format:
        .bgra8888:
            row[(usize)x] = color_value(&color)
        .bg_rx8888:
            row[(usize)x] = color_value(&color) | ((u32)0xFF << 24)
        .rgba8888:
            row[(usize)x] = ((u32)color_alpha(&color) << 24) | ((u32)color_blue(&color) << 16) | ((u32)color_green(&color) << 8) | (u32)color_red(&color)
        .rg_bx8888:
            row[(usize)x] = ((u32)0xFF << 24) | ((u32)color_blue(&color) << 16) | ((u32)color_green(&color) << 8) | (u32)color_red(&color)
        .invalid: trap("VERIFY_NOT_REACHED")
        _: trap("VERIFY_NOT_REACHED")

# The absolute difference of two channel values, as `abs(static_cast<int>(a) - b)`.
func bitmap_channel_error(a: u8, b: u8) -> u8:
    return a - b if a > b else b - a

## Ported from Libraries/LibGfx/Bitmap.cpp:271 Gfx::Bitmap::diff.
pub func bitmap_diff(this: const Bitmap*, other: const Bitmap*) -> BitmapDiffResult:
    let own_width = bitmap_width(this)
    let own_height = bitmap_height(this)
    assert(own_width == bitmap_width(other) and own_height == bitmap_height(other))

    var result: BitmapDiffResult
    for y in 0..<own_height:
        for x in 0..<own_width:
            let own_pixel = bitmap_get_pixel(this, x, y)
            let other_pixel = bitmap_get_pixel(other, x, y)
            if color_eq(&own_pixel, other_pixel):
                continue

            result.pixel_error_count += 1

            let red_error = bitmap_channel_error(color_red(&own_pixel), color_red(&other_pixel))
            let green_error = bitmap_channel_error(color_green(&own_pixel), color_green(&other_pixel))
            let blue_error = bitmap_channel_error(color_blue(&own_pixel), color_blue(&other_pixel))
            let alpha_error = bitmap_channel_error(color_alpha(&own_pixel), color_alpha(&other_pixel))

            result.total_red_error += red_error
            result.total_green_error += green_error
            result.total_blue_error += blue_error
            result.total_alpha_error += alpha_error

            if red_error > result.maximum_red_error: result.maximum_red_error = red_error
            if green_error > result.maximum_green_error: result.maximum_green_error = green_error
            if blue_error > result.maximum_blue_error: result.maximum_blue_error = blue_error
            if alpha_error > result.maximum_alpha_error: result.maximum_alpha_error = alpha_error

    result.identical = result.pixel_error_count == 0
    result.total_error = result.total_red_error + result.total_green_error + result.total_blue_error + result.total_alpha_error

    let maximum_red_green_error = result.maximum_green_error if result.maximum_red_error < result.maximum_green_error else result.maximum_red_error
    let maximum_blue_alpha_error = result.maximum_alpha_error if result.maximum_blue_error < result.maximum_alpha_error else result.maximum_blue_error
    result.maximum_error = maximum_blue_alpha_error if maximum_red_green_error < maximum_blue_alpha_error else maximum_red_green_error

    return result

## Ported from Libraries/LibGfx/Bitmap.cpp:314 Gfx::Bitmap::set_alpha_type_destructive (the
## non-macOS branch: Skia's SkPixmap::readPixels between the two alpha types, which is
## SkOpts::RGBA_to_rgbA / rgbA_to_RGBA on 8888 pixels).
pub func bitmap_set_alpha_type_destructive(this: Bitmap*, alpha_type: AlphaType):
    if alpha_type == this.m_alpha_type:
        return

    if this.m_format == BitmapFormat.bg_rx8888 or this.m_format == BitmapFormat.rg_bx8888:
        this.m_alpha_type = alpha_type
        return

    # The channel order does not matter: alpha is the top byte of both BGRA8888 and RGBA8888.
    assert(this.m_format == BitmapFormat.bgra8888 or this.m_format == BitmapFormat.rgba8888)
    for y in 0..<bitmap_height(this):
        let row = u32[](bitmap_scanline(this, y) else trap("VERIFY"), (usize)bitmap_width(this))
        if this.m_alpha_type == AlphaType.unpremultiplied:
            raster_premultiply_row(row)
        else:
            raster_unpremultiply_row(row)
    this.m_alpha_type = alpha_type
