# C++: auto r = IntRect { 1, -2, 3, 4 } * 3; r.x(); r.y(); r.width(); r.height()
noinline func test_geometry_int_rect_mul():
    let a = test_irect(1, -2, 3, 4)
    let r = device_pixel_rect_mul(&a, 3)
    assert((i64)(device_pixel_rect_x(&r)) == 3)
    assert((i64)(device_pixel_rect_y(&r)) == -6)
    assert((i64)(device_pixel_rect_width(&r)) == 9)
    assert((i64)(device_pixel_rect_height(&r)) == 12)

