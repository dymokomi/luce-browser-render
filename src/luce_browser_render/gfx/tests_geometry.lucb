# C++: r.x().raw_value(); r.y().raw_value(); r.width().raw_value(); r.height().raw_value()
noinline func test_geometry_css_rect_mul_assign():
    var r = test_crect(1.0, -2.0, 3.0, 4.0)
    discard(css_pixel_rect_mul_assign(&r, test_px(1.5)))
    assert((i64)(css_pixel_rect_x(&r).raw_value()) == 96)
    assert((i64)(css_pixel_rect_y(&r).raw_value()) == -192)
    assert((i64)(css_pixel_rect_width(&r).raw_value()) == 288)
    assert((i64)(css_pixel_rect_height(&r).raw_value()) == 384)

