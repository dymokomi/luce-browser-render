test "geometry: int_rect_set_right_without_resize":
    test_geometry_int_rect_set_right_without_resize()

# C++: r.x(); r.y(); r.width(); r.height()
noinline func test_geometry_int_rect_set_right_without_resize():
    var r = test_irect(1, 2, 3, 4)
    device_pixel_rect_set_right_without_resize(&r, 10)
    device_pixel_rect_set_bottom_without_resize(&r, -2)
    assert((i64)(device_pixel_rect_x(&r)) == 7)
    assert((i64)(device_pixel_rect_y(&r)) == -6)
    assert((i64)(device_pixel_rect_width(&r)) == 3)
    assert((i64)(device_pixel_rect_height(&r)) == 4)

