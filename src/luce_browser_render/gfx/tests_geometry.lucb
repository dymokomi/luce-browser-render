#==============================================================================================
#
#   tests_geometry - Point, Size and Rect of every instantiation, pinned to the donor
#
#   DESCRIPTION:
#       Values computed by the donor's LibGfx Point/Size/Rect templates (Ladybird 47c82b38d0,
#       compiled locally) for the cases Tests/LibGfx/TestRect.cpp does not cover. Floats are
#       compared by their bits, CSSPixels by their raw fixed-point values (1px = 64). The
#       helpers (`test_irect`, `test_crect`, ...) are in tests_rect.lucb.
#
#       Each test's body is a noinline function the test block calls, so that the test
#       runner's `main` does not inline every body (# workaround:
#       compiler-issues/ranges_facts_cubic).
#
#==============================================================================================

test "geometry: int_point_distance_from":
    test_geometry_int_point_distance_from()

# C++:  IntPoint(3, 4).distance_from({ 0, 0 })
noinline func test_geometry_int_point_distance_from():
    let a = IntPoint(3, 4)
    assert((int_point_distance_from(&a, IntPoint(0, 0))).bits() == 0x40a00000)  # 5

test "geometry: int_point_distance_from_self":
    test_geometry_int_point_distance_from_self()

# C++:  IntPoint(3, 4).distance_from({ 3, 4 })
noinline func test_geometry_int_point_distance_from_self():
    let a = IntPoint(3, 4)
    assert((int_point_distance_from(&a, IntPoint(3, 4))).bits() == 0x0)  # 0

test "geometry: float_point_distance_from":
    test_geometry_float_point_distance_from()

# C++:  FloatPoint(0.5f, 1.25f).distance_from({ -2.0f, 7.0f })
noinline func test_geometry_float_point_distance_from():
    let a = FloatPoint(0.5, 1.25)
    assert((float_point_distance_from(&a, FloatPoint(-2.0, 7.0))).bits() == 0x40c8a394)  # 6.26996803

test "geometry: int_point_pixels_moved":
    test_geometry_int_point_pixels_moved()

# C++:  IntPoint(1, 2).pixels_moved({ -5, 10 })
noinline func test_geometry_int_point_pixels_moved():
    let a = IntPoint(1, 2)
    assert((i64)(int_point_pixels_moved(&a, IntPoint(-5, 10))) == 8)

test "geometry: int_point_absolute_relative_distance_to":
    test_geometry_int_point_absolute_relative_distance_to()

# C++: auto p = IntPoint(1, 2).absolute_relative_distance_to({ -5, 10 }); p.x(); p.y()
noinline func test_geometry_int_point_absolute_relative_distance_to():
    let a = IntPoint(1, 2)
    let p = int_point_absolute_relative_distance_to(&a, IntPoint(-5, 10))
    assert((i64)(int_point_x(&p)) == 6)
    assert((i64)(int_point_y(&p)) == 8)

test "geometry: int_point_end_point_for_aspect_ratio":
    test_geometry_int_point_end_point_for_aspect_ratio()

# C++: p.x(); p.y()
noinline func test_geometry_int_point_end_point_for_aspect_ratio():
    let a = IntPoint(0, 0)
    let p = int_point_end_point_for_aspect_ratio(&a, IntPoint(10, -3), 2.0)
    assert((i64)(int_point_x(&p)) == 10)
    assert((i64)(int_point_y(&p)) == -5)

test "geometry: int_point_end_point_for_aspect_ratio_tall":
    test_geometry_int_point_end_point_for_aspect_ratio_tall()

# C++: p.x(); p.y()
noinline func test_geometry_int_point_end_point_for_aspect_ratio_tall():
    let a = IntPoint(5, 5)
    let p = int_point_end_point_for_aspect_ratio(&a, IntPoint(4, 20), 0.75)
    assert((i64)(int_point_x(&p)) == -6)
    assert((i64)(int_point_y(&p)) == 20)

test "geometry: float_point_end_point_for_aspect_ratio":
    test_geometry_float_point_end_point_for_aspect_ratio()

# C++: fb(p.x()); fb(p.y())
noinline func test_geometry_float_point_end_point_for_aspect_ratio():
    let a = FloatPoint(1.0, 1.0)
    let p = float_point_end_point_for_aspect_ratio(&a, FloatPoint(-4.0, 7.0), 1.5)
    assert((i64)(float_point_x(&p).bits()) == 3238002688)
    assert((i64)(float_point_y(&p).bits()) == 1088421888)

test "geometry: int_point_constrained":
    test_geometry_int_point_constrained()

# C++: auto p = IntPoint(100, -5).constrained(IntRect { 0, 0, 10, 10 }); p.x(); p.y()
noinline func test_geometry_int_point_constrained():
    let a = IntPoint(100, -5)
    let p = int_point_constrained(&a, test_irect(0, 0, 10, 10))
    assert((i64)(int_point_x(&p)) == 9)
    assert((i64)(int_point_y(&p)) == 0)

