    let a = test_frect(-1.3, 2.6, 0.01, 40.0)
    let r = float_rect_to_type_css_pixels(&a)
    assert((i64)(css_pixel_rect_x(&r).raw_value()) == -83)
    assert((i64)(css_pixel_rect_y(&r).raw_value()) == 166)
    assert((i64)(css_pixel_rect_width(&r).raw_value()) == 1)
    assert((i64)(css_pixel_rect_height(&r).raw_value()) == 2560)

