test "geometry: css_rect_eq":
    test_geometry_css_rect_eq()

# C++:  crect(1, 2, 3, 4) == CSSPixelRect(CSSPixelPoint(1, 2), CSSPixelSize(3, 4))
noinline func test_geometry_css_rect_eq():
    let a = test_crect(1.0, 2.0, 3.0, 4.0)
    assert((css_pixel_rect_eq(&a, CssPixelRect(CssPixelPoint(css_pixels_from_int(1), css_pixels_from_int(2)), CssPixelSize(css_pixels_from_int(3), css_pixels_from_int(4))))) == true)
