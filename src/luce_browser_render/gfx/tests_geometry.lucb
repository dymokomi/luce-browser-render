test "geometry: css_point_div":
    test_geometry_css_point_div()

# C++: p.x().raw_value(); p.y().raw_value()
noinline func test_geometry_css_point_div():
    let a = CssPixelPoint(css_pixels_from_int(10), css_pixels_from_int(-20))
    let p = css_pixel_point_div(&a, css_pixels_from_int(3))
    assert((i64)(css_pixel_point_x(&p).raw_value()) == 213)
    assert((i64)(css_pixel_point_y(&p).raw_value()) == -426)

test "geometry: css_point_div_assign":
    test_geometry_css_point_div_assign()

# C++: p.x().raw_value(); p.y().raw_value()
noinline func test_geometry_css_point_div_assign():
    var p = CssPixelPoint(css_pixels_from_int(10), css_pixels_from_int(-20))
    discard(css_pixel_point_div_assign(&p, css_pixels_from_int(3)))
    assert((i64)(css_pixel_point_x(&p).raw_value()) == 1920)
    assert((i64)(css_pixel_point_y(&p).raw_value()) == -3840)

