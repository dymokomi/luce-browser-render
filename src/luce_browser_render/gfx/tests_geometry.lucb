test "geometry: css_point_moved":
    test_geometry_css_point_moved()

# C++: p.x().raw_value(); p.y().raw_value()
noinline func test_geometry_css_point_moved():
    let a = CssPixelPoint(css_pixels_from_int(1), css_pixels_from_int(1))
    let b = css_pixel_point_moved_left(&a, test_px(0.5))
    let p = css_pixel_point_moved_down(&b, test_px(3.0))
    assert((i64)(css_pixel_point_x(&p).raw_value()) == 32)
    assert((i64)(css_pixel_point_y(&p).raw_value()) == 256)

