test "geometry: css_point_neg_sub":
    test_geometry_css_point_neg_sub()

# C++: p.x().raw_value(); p.y().raw_value()
noinline func test_geometry_css_point_neg_sub():
    let a = CssPixelPoint(css_pixels_from_int(1), css_pixels_from_int(2))
    let b = css_pixel_point_sub(&a, test_cpoint(0.5, 5.0))
    let p = css_pixel_point_neg(&b)
    assert((i64)(css_pixel_point_x(&p).raw_value()) == -32)
    assert((i64)(css_pixel_point_y(&p).raw_value()) == 192)

