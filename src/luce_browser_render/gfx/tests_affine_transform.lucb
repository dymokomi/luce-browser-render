test "affine_transform: transform_point":
    test_affine_transform_transform_point()

# C++: fb(p.x()); fb(p.y()); fb(p.z())
noinline func test_affine_transform_transform_point():
    let p = transform_point(test_sample_matrix(), FloatVector3([1.5, -2.0, 3.0]))
    assert((i64)(p.m_data[0].bits()) == 1085276160)
    assert((i64)(p.m_data[1].bits()) == 3237478400)
    assert((i64)(p.m_data[2].bits()) == 1091567616)

test "affine_transform: matrix_times_vector":
    test_affine_transform_matrix_times_vector()

# C++: fb(p.x()); fb(p.y()); fb(p.z()); fb(p.w())
noinline func test_affine_transform_matrix_times_vector():
    let p = mul_float_matrix4_x4_float_vector4(test_sample_matrix(), FloatVector4([1.5, -2.0, 3.0, 0.5]))
    assert((i64)(p.m_data[0].bits()) == 1082130432)
    assert((i64)(p.m_data[1].bits()) == 3238264832)
    assert((i64)(p.m_data[2].bits()) == 1092616192)
    assert((i64)(p.m_data[3].bits()) == 1085800448)
