    let p = affine_transform_map_f32_float_point(&t, FloatPoint(3.3, 5.0))
    assert((i64)(float_point_x(&p).bits()) == 3224790630)
    assert((i64)(float_point_y(&p).bits()) == 1095054131)

test "affine_transform: map_int_size":
    test_affine_transform_map_int_size()

# C++: s.width(); s.height()
noinline func test_affine_transform_map_int_size():
    var t = test_affine_identity()
    discard(affine_transform_rotate_radians(&t, 0.4))
    discard(affine_transform_scale_f32(&t, 1.5, 3.0))
    let s = affine_transform_map_i32_int_size(&t, IntSize(7, 9))
    assert((i64)(int_size_width(&s)) == 10)
    assert((i64)(int_size_height(&s)) == 27)

