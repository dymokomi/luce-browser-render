    assert((i64)(float_matrix4_x4_at_const(&r, 0, 1).bits()) == 1061158912)
    assert((i64)(float_matrix4_x4_at_const(&r, 0, 2).bits()) == 3205758976)
    assert((i64)(float_matrix4_x4_at_const(&r, 0, 3).bits()) == 1080557568)
    assert((i64)(float_matrix4_x4_at_const(&r, 1, 0).bits()) == 3212050432)
    assert((i64)(float_matrix4_x4_at_const(&r, 1, 1).bits()) == 1059061760)
    assert((i64)(float_matrix4_x4_at_const(&r, 1, 2).bits()) == 3196846080)
    assert((i64)(float_matrix4_x4_at_const(&r, 1, 3).bits()) == 1071120384)
    assert((i64)(float_matrix4_x4_at_const(&r, 2, 0).bits()) == 1065877504)
    assert((i64)(float_matrix4_x4_at_const(&r, 2, 1).bits()) == 3204448256)
    assert((i64)(float_matrix4_x4_at_const(&r, 2, 2).bits()) == 1055916032)
    assert((i64)(float_matrix4_x4_at_const(&r, 2, 3).bits()) == 3219128320)
    assert((i64)(float_matrix4_x4_at_const(&r, 3, 0).bits()) == 1071251456)
    assert((i64)(float_matrix4_x4_at_const(&r, 3, 1).bits()) == 3206545408)
    assert((i64)(float_matrix4_x4_at_const(&r, 3, 2).bits()) == 1053556736)
    assert((i64)(float_matrix4_x4_at_const(&r, 3, 3).bits()) == 3224109056)

test "affine_transform: matrix_mul":
    test_affine_transform_matrix_mul()

# C++: fb(r[0, 0]); fb(r[0, 1]); fb(r[0, 2]); fb(r[0, 3]); fb(r[1, 0]); fb(r[1, 1]); fb(r[1, 2]); fb(r[1, 3]); fb(r[2, 0]); fb(r[2, 1]); fb(r[2, 2]); fb(r[2, 3]); fb(r[3, 0]); fb(r[3, 1]); fb(r[3, 2]); fb(r[3, 3])
noinline func test_affine_transform_matrix_mul():
    let m = test_sample_matrix()
    let r = float_matrix4_x4_mul(&m, float_matrix4_x4_transpose(&m))
    assert((i64)(float_matrix4_x4_at_const(&r, 0, 0).bits()) == 1097072640)
    assert((i64)(float_matrix4_x4_at_const(&r, 0, 1).bits()) == 1084489728)
    assert((i64)(float_matrix4_x4_at_const(&r, 0, 2).bits()) == 3217031168)
    assert((i64)(float_matrix4_x4_at_const(&r, 0, 3).bits()) == 1087373312)
    assert((i64)(float_matrix4_x4_at_const(&r, 1, 0).bits()) == 1084489728)
    assert((i64)(float_matrix4_x4_at_const(&r, 1, 1).bits()) == 1099988992)
    assert((i64)(float_matrix4_x4_at_const(&r, 1, 2).bits()) == 1088946176)
    assert((i64)(float_matrix4_x4_at_const(&r, 1, 3).bits()) == 3196059648)
    assert((i64)(float_matrix4_x4_at_const(&r, 2, 0).bits()) == 3217031168)
    assert((i64)(float_matrix4_x4_at_const(&r, 2, 1).bits()) == 1088946176)
    assert((i64)(float_matrix4_x4_at_const(&r, 2, 2).bits()) == 1107558400)
    assert((i64)(float_matrix4_x4_at_const(&r, 2, 3).bits()) == 1077936128)
    assert((i64)(float_matrix4_x4_at_const(&r, 3, 0).bits()) == 1087373312)
    assert((i64)(float_matrix4_x4_at_const(&r, 3, 1).bits()) == 3196059648)
    assert((i64)(float_matrix4_x4_at_const(&r, 3, 2).bits()) == 1077936128)
    assert((i64)(float_matrix4_x4_at_const(&r, 3, 3).bits()) == 1082654720)

test "affine_transform: matrix_add_div":
    test_affine_transform_matrix_add_div()

# C++: fb(r[0, 0]); fb(r[0, 1]); fb(r[0, 2]); fb(r[0, 3]); fb(r[1, 0]); fb(r[1, 1]); fb(r[1, 2]); fb(r[1, 3]); fb(r[2, 0]); fb(r[2, 1]); fb(r[2, 2]); fb(r[2, 3]); fb(r[3, 0]); fb(r[3, 1]); fb(r[3, 2]); fb(r[3, 3])
noinline func test_affine_transform_matrix_add_div():
    let m = test_sample_matrix()
    let sum = float_matrix4_x4_add(&m, float_matrix4_x4_identity())
    let r = float_matrix4_x4_div(&sum, 3.0)
    assert((i64)(float_matrix4_x4_at_const(&r, 0, 0).bits()) == 1065353216)
    assert((i64)(float_matrix4_x4_at_const(&r, 0, 1).bits()) == 1051372203)
    assert((i64)(float_matrix4_x4_at_const(&r, 0, 2).bits()) == 1042983595)
    assert((i64)(float_matrix4_x4_at_const(&r, 0, 3).bits()) == 1065353216)
    assert((i64)(float_matrix4_x4_at_const(&r, 1, 0).bits()) == 3198855851)
    assert((i64)(float_matrix4_x4_at_const(&r, 1, 1).bits()) == 1070945621)
    assert((i64)(float_matrix4_x4_at_const(&r, 1, 2).bits()) == 1034594987)
    assert((i64)(float_matrix4_x4_at_const(&r, 1, 3).bits()) == 1051372203)
    assert((i64)(float_matrix4_x4_at_const(&r, 2, 0).bits()) == 0)
    assert((i64)(float_matrix4_x4_at_const(&r, 2, 1).bits()) == 1059760811)
    assert((i64)(float_matrix4_x4_at_const(&r, 2, 2).bits()) == 1073741824)
    assert((i64)(float_matrix4_x4_at_const(&r, 2, 3).bits()) == 3207244459)
    assert((i64)(float_matrix4_x4_at_const(&r, 3, 0).bits()) == 1056964608)
    assert((i64)(float_matrix4_x4_at_const(&r, 3, 1).bits()) == 0)
    assert((i64)(float_matrix4_x4_at_const(&r, 3, 2).bits()) == 1051372203)
    assert((i64)(float_matrix4_x4_at_const(&r, 3, 3).bits()) == 1059760811)

test "affine_transform: matrix_is_identity":
    test_affine_transform_matrix_is_identity()

# C++:  FloatMatrix4x4::identity().is_identity() && !sample_matrix().is_identity()
noinline func test_affine_transform_matrix_is_identity():
    let m = test_sample_matrix()
    let identity = float_matrix4_x4_identity()
    assert((float_matrix4_x4_is_identity(&identity) and not float_matrix4_x4_is_identity(&m)) == true)

test "affine_transform: matrix_is_invertible_singular":
    test_affine_transform_matrix_is_invertible_singular()

# C++: m.is_invertible()
noinline func test_affine_transform_matrix_is_invertible_singular():
    var m = test_sample_matrix()
    *float_matrix4_x4_at(&m, 3, 0) = float_matrix4_x4_at_const(&m, 0, 0)
    *float_matrix4_x4_at(&m, 3, 1) = float_matrix4_x4_at_const(&m, 0, 1)
    *float_matrix4_x4_at(&m, 3, 2) = float_matrix4_x4_at_const(&m, 0, 2)
    *float_matrix4_x4_at(&m, 3, 3) = float_matrix4_x4_at_const(&m, 0, 3)
    assert((float_matrix4_x4_is_invertible(&m)) == false)

test "affine_transform: matrix_elements":
    test_affine_transform_matrix_elements()

# C++: auto m = sample_matrix(); auto e = m.elements(); fb(e[1][2]); fb(e[3][0])
noinline func test_affine_transform_matrix_elements():
    let m = test_sample_matrix()
    let e = float_matrix4_x4_elements_const(&m)
    assert((i64)((*e)[1][2].bits()) == 1048576000)
    assert((i64)((*e)[3][0].bits()) == 1069547520)

test "affine_transform: rotation_matrix":
    test_affine_transform_rotation_matrix()

# C++: fb(r[0, 0]); fb(r[0, 1]); fb(r[0, 2]); fb(r[0, 3]); fb(r[1, 0]); fb(r[1, 1]); fb(r[1, 2]); fb(r[1, 3]); fb(r[2, 0]); fb(r[2, 1]); fb(r[2, 2]); fb(r[2, 3]); fb(r[3, 0]); fb(r[3, 1]); fb(r[3, 2]); fb(r[3, 3])
noinline func test_affine_transform_rotation_matrix():
    let r = rotation_matrix(FloatVector3([0.6, 0.0, 0.8]), 0.9)
    assert((i64)(float_matrix4_x4_at_const(&r, 0, 0).bits()) == 1061290284)
    assert((i64)(float_matrix4_x4_at_const(&r, 0, 1).bits()) == 3206573284)
    assert((i64)(float_matrix4_x4_at_const(&r, 0, 2).bits()) == 1043987580)
    assert((i64)(float_matrix4_x4_at_const(&r, 0, 3).bits()) == 0)
    assert((i64)(float_matrix4_x4_at_const(&r, 1, 0).bits()) == 1059089636)
    assert((i64)(float_matrix4_x4_at_const(&r, 1, 1).bits()) == 1059004885)
    assert((i64)(float_matrix4_x4_at_const(&r, 1, 2).bits()) == 3203441495)
    assert((i64)(float_matrix4_x4_at_const(&r, 1, 3).bits()) == 0)
    assert((i64)(float_matrix4_x4_at_const(&r, 2, 0).bits()) == 1043987580)
    assert((i64)(float_matrix4_x4_at_const(&r, 2, 1).bits()) == 1055957847)
    assert((i64)(float_matrix4_x4_at_const(&r, 2, 2).bits()) == 1063067817)
    assert((i64)(float_matrix4_x4_at_const(&r, 2, 3).bits()) == 0)
    assert((i64)(float_matrix4_x4_at_const(&r, 3, 0).bits()) == 0)
    assert((i64)(float_matrix4_x4_at_const(&r, 3, 1).bits()) == 0)
    assert((i64)(float_matrix4_x4_at_const(&r, 3, 2).bits()) == 0)
    assert((i64)(float_matrix4_x4_at_const(&r, 3, 3).bits()) == 1065353216)

test "affine_transform: rotation_matrix_half_turn":
    test_affine_transform_rotation_matrix_half_turn()

# C++: fb(r[0, 0]); fb(r[0, 1]); fb(r[0, 2]); fb(r[0, 3]); fb(r[1, 0]); fb(r[1, 1]); fb(r[1, 2]); fb(r[1, 3]); fb(r[2, 0]); fb(r[2, 1]); fb(r[2, 2]); fb(r[2, 3]); fb(r[3, 0]); fb(r[3, 1]); fb(r[3, 2]); fb(r[3, 3])
noinline func test_affine_transform_rotation_matrix_half_turn():
    let r = rotation_matrix(FloatVector3([0.0, 0.0, 1.0]), ak.pi_f32)
    assert((i64)(float_matrix4_x4_at_const(&r, 0, 0).bits()) == 3212836864)
    assert((i64)(float_matrix4_x4_at_const(&r, 0, 1).bits()) == 0)
    assert((i64)(float_matrix4_x4_at_const(&r, 0, 2).bits()) == 0)
    assert((i64)(float_matrix4_x4_at_const(&r, 0, 3).bits()) == 0)
    assert((i64)(float_matrix4_x4_at_const(&r, 1, 0).bits()) == 0)
    assert((i64)(float_matrix4_x4_at_const(&r, 1, 1).bits()) == 3212836864)
    assert((i64)(float_matrix4_x4_at_const(&r, 1, 2).bits()) == 0)
    assert((i64)(float_matrix4_x4_at_const(&r, 1, 3).bits()) == 0)
    assert((i64)(float_matrix4_x4_at_const(&r, 2, 0).bits()) == 0)
    assert((i64)(float_matrix4_x4_at_const(&r, 2, 1).bits()) == 0)
    assert((i64)(float_matrix4_x4_at_const(&r, 2, 2).bits()) == 1065353216)
    assert((i64)(float_matrix4_x4_at_const(&r, 2, 3).bits()) == 0)
    assert((i64)(float_matrix4_x4_at_const(&r, 3, 0).bits()) == 0)
    assert((i64)(float_matrix4_x4_at_const(&r, 3, 1).bits()) == 0)
    assert((i64)(float_matrix4_x4_at_const(&r, 3, 2).bits()) == 0)
    assert((i64)(float_matrix4_x4_at_const(&r, 3, 3).bits()) == 1065353216)

test "affine_transform: translation_matrix":
    test_affine_transform_translation_matrix()

# C++: fb(r[0, 0]); fb(r[0, 1]); fb(r[0, 2]); fb(r[0, 3]); fb(r[1, 0]); fb(r[1, 1]); fb(r[1, 2]); fb(r[1, 3]); fb(r[2, 0]); fb(r[2, 1]); fb(r[2, 2]); fb(r[2, 3]); fb(r[3, 0]); fb(r[3, 1]); fb(r[3, 2]); fb(r[3, 3])
noinline func test_affine_transform_translation_matrix():
    let r = translation_matrix(FloatVector3([1.5, -2.0, 3.0]))
    assert((i64)(float_matrix4_x4_at_const(&r, 0, 0).bits()) == 1065353216)
    assert((i64)(float_matrix4_x4_at_const(&r, 0, 1).bits()) == 0)
    assert((i64)(float_matrix4_x4_at_const(&r, 0, 2).bits()) == 0)
    assert((i64)(float_matrix4_x4_at_const(&r, 0, 3).bits()) == 1069547520)
    assert((i64)(float_matrix4_x4_at_const(&r, 1, 0).bits()) == 0)
    assert((i64)(float_matrix4_x4_at_const(&r, 1, 1).bits()) == 1065353216)
    assert((i64)(float_matrix4_x4_at_const(&r, 1, 2).bits()) == 0)
    assert((i64)(float_matrix4_x4_at_const(&r, 1, 3).bits()) == 3221225472)
    assert((i64)(float_matrix4_x4_at_const(&r, 2, 0).bits()) == 0)
    assert((i64)(float_matrix4_x4_at_const(&r, 2, 1).bits()) == 0)
    assert((i64)(float_matrix4_x4_at_const(&r, 2, 2).bits()) == 1065353216)
    assert((i64)(float_matrix4_x4_at_const(&r, 2, 3).bits()) == 1077936128)
    assert((i64)(float_matrix4_x4_at_const(&r, 3, 0).bits()) == 0)
    assert((i64)(float_matrix4_x4_at_const(&r, 3, 1).bits()) == 0)
    assert((i64)(float_matrix4_x4_at_const(&r, 3, 2).bits()) == 0)
    assert((i64)(float_matrix4_x4_at_const(&r, 3, 3).bits()) == 1065353216)

