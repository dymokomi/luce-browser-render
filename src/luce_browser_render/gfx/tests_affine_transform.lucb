test "affine_transform: rotation":
    test_affine_transform_rotation()

# C++: AffineTransform t; t.rotate_radians(2.5f).rotate_radians(2.5f); t.rotation()
noinline func test_affine_transform_rotation():
    var t = test_affine_identity()
    discard(affine_transform_rotate_radians(&t, 2.5))
    discard(affine_transform_rotate_radians(&t, 2.5))
    assert((affine_transform_rotation(&t)).bits() == 0xbfa43f6a)  # -1.28318524

test "affine_transform: map_int_point":
    test_affine_transform_map_int_point()

# C++: p.x(); p.y()
noinline func test_affine_transform_map_int_point():
    let t = test_affine(0.5, 0.25, -1.0, 2.0, 0.5, 1.5)
    let p = affine_transform_map_i32_int_point(&t, IntPoint(3, 5))
    assert((i64)(int_point_x(&p)) == -3)
    assert((i64)(int_point_y(&p)) == 12)

test "affine_transform: map_float_point":
