    let m = test_sample_matrix()
    let r = float_matrix4_x4_adjugate(&m)
    assert((i64)(float_matrix4_x4_at_const(&r, 0, 0).bits()) == 1105985536)
    assert((i64)(float_matrix4_x4_at_const(&r, 0, 1).bits()) == 3242196992)
    assert((i64)(float_matrix4_x4_at_const(&r, 0, 2).bits()) == 1091829760)
    assert((i64)(float_matrix4_x4_at_const(&r, 0, 3).bits()) == 3261595648)
    assert((i64)(float_matrix4_x4_at_const(&r, 1, 0).bits()) == 1098121216)
    assert((i64)(float_matrix4_x4_at_const(&r, 1, 1).bits()) == 3240099840)
    assert((i64)(float_matrix4_x4_at_const(&r, 1, 2).bits()) == 1082916864)
    assert((i64)(float_matrix4_x4_at_const(&r, 1, 3).bits()) == 3252158464)
    assert((i64)(float_matrix4_x4_at_const(&r, 2, 0).bits()) == 3246915584)
    assert((i64)(float_matrix4_x4_at_const(&r, 2, 1).bits()) == 1090519040)
    assert((i64)(float_matrix4_x4_at_const(&r, 2, 2).bits()) == 3236954112)
    assert((i64)(float_matrix4_x4_at_const(&r, 2, 3).bits()) == 1105199104)
    assert((i64)(float_matrix4_x4_at_const(&r, 3, 0).bits()) == 3252289536)
    assert((i64)(float_matrix4_x4_at_const(&r, 3, 1).bits()) == 1092616192)
    assert((i64)(float_matrix4_x4_at_const(&r, 3, 2).bits()) == 3234594816)
    assert((i64)(float_matrix4_x4_at_const(&r, 3, 3).bits()) == 1110179840)

test "affine_transform: matrix_inverse":
    test_affine_transform_matrix_inverse()

# C++: fb(r[0, 0]); fb(r[0, 1]); fb(r[0, 2]); fb(r[0, 3]); fb(r[1, 0]); fb(r[1, 1]); fb(r[1, 2]); fb(r[1, 3]); fb(r[2, 0]); fb(r[2, 1]); fb(r[2, 2]); fb(r[2, 3]); fb(r[3, 0]); fb(r[3, 1]); fb(r[3, 2]); fb(r[3, 3])
