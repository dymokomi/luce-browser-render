#==============================================================================================
#
#   scan_path_aa - the anti-aliased path scan converter: 4x4 supersampling
#
#   DESCRIPTION:
#       Port of tiny-skia scan/path_aa.rs (SkScan_AntiPath.cpp): fill_path, which walks the
#       path's edges at 4x resolution (SUPERSAMPLE_SHIFT = 2) through the shared
#       fill_path_impl, and SuperBlitter, which accumulates the supersampled spans of each
#       pixel row into AlphaRuns and flushes them as anti-aliased runs. Rust's `Drop` flush
#       of SuperBlitter is the explicit `flush()` after the walk.
#
#==============================================================================================

let supersample_shift: u32 = 2

let aa_shift: u32 = supersample_shift
let aa_scale: u32 = 1 << aa_shift
let aa_mask: u32 = aa_scale - 1

func scan_aa_fill_path(path: const Path*, fill_rule: FillRule, clip: ScreenIntRect, blitter: Blitter):
    # Unlike `path.bounds.to_rect()?.round_out()`, this method rounds out first and then
    # converts into a Rect.
    let bounds = path.bounds()
    let r = Rect.from_ltrb(math32.floor(bounds.left()), math32.floor(bounds.top()), math32.ceil(bounds.right()), math32.ceil(bounds.bottom())) else return
    let ir = r.round_out() else return

    # TODO: remove
    # If the intersection of the path bounds and the clip bounds will overflow 32767 when <<
    # by SHIFT, we can't supersample, so draw without antialiasing.
    let clipped_ir = ir.intersect(clip.to_int_rect()) else return
    if rect_overflows_short_shift(clipped_ir, (i32)aa_shift) != 0:
        scan_fill_path(path, fill_rule, clip, blitter)
        return

    # TODO: remove
    # Our antialiasing can't handle a clip larger than 32767.
    # TODO: skia actually limits the clip to 32767
    let max_clip_coord: u32 = 32767
    if clip.right() > max_clip_coord or clip.bottom() > max_clip_coord:
        return

    # TODO: SkScanClipper
    # TODO: AAA

    scan_aa_fill_path_impl(path, fill_rule, ir, clip, blitter)

# Would any of the coordinates of this rectangle not fit in a short, when left-shifted by
# shift?
func rect_overflows_short_shift(rect: IntRect, shift: i32) -> i32:
    # Since we expect these to succeed, we bit-or together for a tiny extra bit of speed.
    return overflows_short_shift(rect.left(), shift) | overflows_short_shift(rect.top(), shift) | overflows_short_shift(rect.right(), shift) | overflows_short_shift(rect.bottom(), shift)

func overflows_short_shift(value: i32, shift: i32) -> i32:
    let s = 16 + shift
    return (left_shift(value, s) >> s) - value

func scan_aa_fill_path_impl(path: const Path*, fill_rule: FillRule, bounds: IntRect, clip: ScreenIntRect, blitter: Blitter):
    # TODO: MaskSuperBlitter

    # TODO: 15% slower than skia, find out why
    var super_blitter = SuperBlitter.new_(bounds, clip, blitter) else return # clipped out, nothing else to do

    var path_contained_in_clip = false
    if let b = bounds.to_screen_int_rect():
        path_contained_in_clip = clip.contains(b)
    else:
        # If bounds cannot be converted into ScreenIntRect, the path is out of clip.
        path_contained_in_clip = false

    fill_path_impl(path, fill_rule, clip, bounds.top(), bounds.bottom(), (i32)aa_shift, path_contained_in_clip, &super_blitter)

    # Drop
    super_blitter.flush()
    super_blitter.runs.release()

struct BaseSuperBlitter:
    var real_blitter: Blitter

    var curr_iy: i32
    var width: u32
    var left: u32
    var super_left: u32

    var curr_y: i32
    var top: i32

    static func new_(bounds: IntRect, clip_rect: ScreenIntRect, blitter: Blitter) -> BaseSuperBlitter?:
        let r = bounds.intersect(clip_rect.to_int_rect()) else return none
        let sect = r.to_screen_int_rect() else return none
        return BaseSuperBlitter(
            real_blitter = blitter,
            curr_iy = (i32)sect.top() - 1,
            width = sect.width(),
            left = sect.left(),
            super_left = sect.left() << aa_shift,
            curr_y = (i32)(sect.top() << aa_shift) - 1,
            top = (i32)sect.top(),
        )

struct SuperBlitter: Blitter:
    var base: BaseSuperBlitter
    var runs: AlphaRuns
    var offset_x: usize

    static func new_(bounds: IntRect, clip_rect: ScreenIntRect, blitter: Blitter) -> SuperBlitter?:
        let base = BaseSuperBlitter.new_(bounds, clip_rect, blitter) else return none
        let runs_width = base.width
        return SuperBlitter(base = base, runs = AlphaRuns.new_(runs_width), offset_x = 0)

    ## Once `runs` contains a complete supersampled row, flush() blits it out through the
    ## wrapped blitter.
    mutating func flush():
        if self.base.curr_iy >= self.base.top:
            if not self.runs.is_empty():
                self.base.real_blitter.blit_anti_h(self.base.left, u32(self.base.curr_iy), self.runs.alpha, self.runs.runs)
                self.runs.reset(self.base.width)
                self.offset_x = 0

            self.base.curr_iy = self.base.top - 1

    ## Blits a row of pixels, with location and width specified in supersampled
    ## coordinates.
    pub mutating func blit_h(x0: u32, y: u32, width0: u32):
        var x = x0
        var width = width0
        let iy = (i32)(y >> aa_shift)

        # hack, until I figure out why my cubics (I think) go beyond the bounds
        if x >= self.base.super_left:
            x -= self.base.super_left
        else:
            width = x + width
            if width == 0:
                trap("unreachable")
            x = 0

        if self.base.curr_y != (i32)y:
            self.offset_x = 0
            self.base.curr_y = (i32)y

        if iy != self.base.curr_iy:
            # new scanline
            self.flush()
            self.base.curr_iy = iy

        let start = x
        let stop = x + width

        # integer-pixel-aligned ends of blit, rounded out
        var fb = start & aa_mask
        var fe = stop & aa_mask
        var n: i32 = ((i32)stop >> (i32)aa_shift) - ((i32)start >> (i32)aa_shift) - 1

        if n < 0:
            fb = fe - fb
            n = 0
            fe = 0
        else:
            if fb == 0:
                n += 1
            else:
                fb = aa_scale - fb

        let max_value = u8(((u32)1 << (8 - aa_shift)) - (((y & aa_mask) + 1) >> aa_shift))
        self.offset_x = self.runs.add(x >> aa_shift, coverage_to_partial_alpha(fb), (usize)n, coverage_to_partial_alpha(fe), max_value, self.offset_x)

    pub mutating func blit_anti_h(x: u32, y: u32, antialias: AlphaU8[], runs: AlphaRun[]):
        trap("unreachable")

    pub mutating func blit_v(x: u32, y: u32, height: u32, alpha: AlphaU8):
        trap("unreachable")

    pub mutating func blit_anti_h2(x: u32, y: u32, alpha0: AlphaU8, alpha1: AlphaU8):
        trap("unreachable")

    pub mutating func blit_anti_v2(x: u32, y: u32, alpha0: AlphaU8, alpha1: AlphaU8):
        trap("unreachable")

    pub mutating func blit_rect(rect: ScreenIntRect):
        trap("unreachable")

    pub mutating func blit_mask(mask: const BlitMask*, clip: ScreenIntRect):
        trap("unreachable")

# coverage_to_partial_alpha() is being used by AlphaRuns, which *accumulates* SCALE pixels
# worth of "alpha" in [0,(256/SCALE)] to produce a final value in [0, 255] and handles
# clamping 256->255 itself, with the same (alpha - (alpha >> 8)) correction as
# coverage_to_exact_alpha().
func coverage_to_partial_alpha(aa0: u32) -> AlphaU8:
    let aa = aa0 << (8 - 2 * aa_shift)
    return (u8)aa
