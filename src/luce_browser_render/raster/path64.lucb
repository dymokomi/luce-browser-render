#==============================================================================================
#
#   path64 - monotonic chopping, and the f64 line/cubic intersections of SkPathOps
#
#   DESCRIPTION:
#       Port of tiny-skia path_geometry.rs (chop_quad_at_x/y_extrema,
#       chop_cubic_at_x/y_extrema, chop_cubic_at, chop_cubic_at_max_curvature,
#       chop_mono_cubic_at_x/y, cubic_dchop_at_intercept) and of path64/ (mod.rs Scalar64
#       and cube_root, point64.rs, quad64.rs, cubic64.rs, line_cubic_intersections.rs):
#       the code from SkPathOpsTypes, SkPathOpsQuad, SkPathOpsCubic and
#       SkDCubicLineIntersection that chops a cubic exactly where it crosses a clip line.
#
#==============================================================================================

# mark: Monotonic chopping (path_geometry.rs) =================================================

# TODO: return custom type
func chop_quad_at_x_extrema(src: const Point[], dst: Point[]) -> usize:
    let a = src[0].x
    var b = src[1].x
    let c = src[2].x

    if is_not_monotonic(a, b, c):
        if let t_value = valid_unit_divide(a - b, a - b - b + c):
            chop_quad_at(src, t_value, dst)

            # flatten double quad extrema
            dst[1].x = dst[2].x
            dst[3].x = dst[2].x

            return 1

        # if we get here, we need to force dst to be monotonic, even though we couldn't
        # compute a unit_divide value (probably underflow).
        b = a if math32.abs(a - b) < math32.abs(b - c) else c

    dst[0] = Point.from_xy(a, src[0].y)
    dst[1] = Point.from_xy(b, src[1].y)
    dst[2] = Point.from_xy(c, src[2].y)
    return 0

func chop_quad_at_y_extrema(src: const Point[], dst: Point[]) -> usize:
    let a = src[0].y
    var b = src[1].y
    let c = src[2].y

    if is_not_monotonic(a, b, c):
        if let t_value = valid_unit_divide(a - b, a - b - b + c):
            chop_quad_at(src, t_value, dst)

            # flatten double quad extrema
            dst[1].y = dst[2].y
            dst[3].y = dst[2].y

            return 1

        # if we get here, we need to force dst to be monotonic, even though we couldn't
        # compute a unit_divide value (probably underflow).
        b = a if math32.abs(a - b) < math32.abs(b - c) else c

    dst[0] = Point.from_xy(src[0].x, a)
    dst[1] = Point.from_xy(src[1].x, b)
    dst[2] = Point.from_xy(src[2].x, c)
    return 0

func is_not_monotonic(a: f32, b: f32, c: f32) -> bool:
    let ab = a - b
    var bc = b - c
    if ab < 0.0:
        bc = -bc
    return ab == 0.0 or bc < 0.0

func chop_cubic_at_x_extrema(src: const Point[], dst: Point[]) -> usize:
    var t_values = new_t_values()
    let count = find_cubic_extrema(src[0].x, src[1].x, src[2].x, src[3].x, t_values)

    chop_cubic_at(src, t_values[..<count], dst)
    if count > 0:
        # we do some cleanup to ensure our X extrema are flat
        dst[2].x = dst[3].x
        dst[4].x = dst[3].x
        if count == 2:
            dst[5].x = dst[6].x
            dst[7].x = dst[6].x

    return count

func chop_cubic_at_y_extrema(src: const Point[], dst: Point[]) -> usize:
    var t_values = new_t_values()
    let count = find_cubic_extrema(src[0].y, src[1].y, src[2].y, src[3].y, t_values)

    chop_cubic_at(src, t_values[..<count], dst)
    if count > 0:
        # we do some cleanup to ensure our Y extrema are flat
        dst[2].y = dst[3].y
        dst[4].y = dst[3].y
        if count == 2:
            dst[5].y = dst[6].y
            dst[7].y = dst[6].y

    return count

# http://code.google.com/p/skia/issues/detail?id=32
#
# This test code would fail when we didn't check the return result of valid_unit_divide in
# SkChopCubicAt(... NormalizedF32Exclusives[], int roots). The reason is that after the first
# chop, the parameters to valid_unit_divide are equal (thanks to finite float precision and
# rounding in the subtracts). Thus even though the 2nd NormalizedF32Exclusive looks < 1.0,
# after we renormalize it, we end up with 1.0, hence the need to check and just return the
# last cubic as a degenerate clump of 4 points in the same place.
func chop_cubic_at(src0: const Point[], t_values: const f32[], dst: Point[]):
    if t_values.length == 0:
        # nothing to chop
        dst[0] = src0[0]
        dst[1] = src0[1]
        dst[2] = src0[2]
        dst[3] = src0[3]
        return

    var t = t_values[0]
    var tmp: Point[4]
    var src: Point[4] = [src0[0], src0[1], src0[2], src0[3]]

    var dst_offset: usize = 0
    for i in 0..<t_values.length:
        chop_cubic_at2(src, t, dst[dst_offset..])
        if i == t_values.length - 1:
            break

        dst_offset += 3
        # have src point to the remaining cubic (after the chop)
        tmp[0] = dst[dst_offset + 0]
        tmp[1] = dst[dst_offset + 1]
        tmp[2] = dst[dst_offset + 2]
        tmp[3] = dst[dst_offset + 3]
        src = tmp

        # watch out in case the renormalized t isn't in range
        if let n = valid_unit_divide(t_values[i + 1] - t_values[i], 1.0 - t_values[i]):
            t = n
        else:
            # if we can't, just create a degenerate cubic
            dst[dst_offset + 4] = src[3]
            dst[dst_offset + 5] = src[3]
            dst[dst_offset + 6] = src[3]
            break

func chop_cubic_at_max_curvature(src: const Point[], t_values: f32[], dst: Point[]) -> usize:
    var roots: f32[3] = [0.0, 0.0, 0.0]
    let roots_len = find_cubic_max_curvature(src, roots)

    # Throw out values not inside 0..1.
    var count: usize = 0
    for root in roots[..<roots_len]:
        if 0.0 < root and root < 1.0:
            t_values[count] = normalized_exclusive_new_bounded(root)
            count += 1

    if count == 0:
        for i: usize in 0..<4:
            dst[i] = src[i]
    else:
        chop_cubic_at(src, t_values[..<count], dst)

    return count + 1

func chop_mono_cubic_at_x(src: const Point[], x: f32, dst: Point[]) -> bool:
    return cubic_dchop_at_intercept(src, x, true, dst)

func chop_mono_cubic_at_y(src: const Point[], y: f32, dst: Point[]) -> bool:
    return cubic_dchop_at_intercept(src, y, false, dst)

func cubic_dchop_at_intercept(src: const Point[], intercept: f32, is_vertical: bool, dst: Point[]) -> bool:
    let cubic = Cubic64(points = [Point64.from_point(src[0]), Point64.from_point(src[1]), Point64.from_point(src[2]), Point64.from_point(src[3])])
    var roots: f64[3] = [0.0, 0.0, 0.0]
    let count = vertical_intersect(&cubic, (f64)intercept, roots) if is_vertical else horizontal_intersect(&cubic, (f64)intercept, roots)

    if count > 0:
        let pair = cubic.chop_at(roots[0])
        for i: usize in 0..<7:
            dst[i] = pair[i].to_point()
        return true
    return false

# mark: Scalar64 (path64/mod.rs) ==============================================================
# The code below is from SkPathOpsTypes.

let dbl_epsilon_err: f64 = 2.220446049250313e-16 * 4.0
let flt_epsilon_half: f64 = (f64)(1.1920929e-7f32 / 2.0f32)
let flt_epsilon_cubed: f64 = (f64)(1.1920929e-7f32 * 1.1920929e-7f32 * 1.1920929e-7f32)
let flt_epsilon_inverse: f64 = 1.0 / (f64)1.1920929e-7f32

# Works just like SkTPin, returning `max` for NaN/inf
func bound64(x: f64, min: f64, max: f64) -> f64:
    return fmax64(fmin64(max, x), min)

func between64(x: f64, a: f64, b: f64) -> bool:
    return (a - x) * (b - x) <= 0.0


func approximately_zero_or_more(x: f64) -> bool:
    return x > -f64_epsilon

func approximately_one_or_less(x: f64) -> bool:
    return x < 1.0 + f64_epsilon

func approximately_zero(x: f64) -> bool:
    return math.abs(x) < f64_epsilon

func approximately_zero_inverse(x: f64) -> bool:
    return math.abs(x) > flt_epsilon_inverse

func approximately_zero_cubed(x: f64) -> bool:
    return math.abs(x) < flt_epsilon_cubed

func approximately_zero_half(x: f64) -> bool:
    return x < flt_epsilon_half

func approximately_zero_when_compared_to(x: f64, other: f64) -> bool:
    return x == 0.0 or math.abs(x) < math.abs(other * (f64)f32_epsilon)

# Use this for comparing Ts in the range of 0 to 1. For general numbers (larger and smaller)
# use AlmostEqualUlps instead.
func approximately_equal(x: f64, other: f64) -> bool:
    return approximately_zero(x - other)

func approximately_equal_half(x: f64, other: f64) -> bool:
    return approximately_zero_half(x - other)

func almost_dequal_ulps64(x: f64, other: f64) -> bool:
    if math.abs(x) < (f64)scalar_max and math.abs(other) < (f64)scalar_max:
        return almost_dequal_ulps((f32)x, (f32)other)
    return math.abs(x - other) / fmax64(math.abs(x), math.abs(other)) < (f64)(f32_epsilon * 16.0)

func cube_root(x: f64) -> f64:
    if approximately_zero_cubed(x):
        return 0.0

    let result = halley_cbrt3d(math.abs(x))
    if x < 0.0:
        return -result
    return result

# cube root approximation using 3 iterations of Halley's method (double)
func halley_cbrt3d(d: f64) -> f64:
    var a = cbrt_5d(d)
    a = cbrta_halleyd(a, d)
    a = cbrta_halleyd(a, d)
    return cbrta_halleyd(a, d)

# cube root approximation using bit hack for 64-bit float
# adapted from Kahan's cbrt
func cbrt_5d(d: f64) -> f64:
    let b1: u32 = 715094163
    let hi = (u32)(d.bits() >> 32)
    return f64.bits((u64)(hi // 3 + b1) << 32)

# iterative cube root approximation using Halley's method (double)
func cbrta_halleyd(a: f64, r: f64) -> f64:
    let a3 = a * a * a
    return a * (a3 + r + r) / (a3 + a3 + r)

func interp64(a: f64, b: f64, t: f64) -> f64:
    return a + (b - a) * t

# mark: Point64 (path64/point64.rs) ===========================================================

enum SearchAxis as u8:
    x = 0
    y = 1

struct Point64:
    var x: f64
    var y: f64

    static func from_xy(x: f64, y: f64) -> Point64:
        return Point64(x = x, y = y)

    static func from_point(p: Point) -> Point64:
        return Point64(x = (f64)p.x, y = (f64)p.y)

    func to_point() -> Point:
        return Point.from_xy((f32)self.x, (f32)self.y)

    func axis_coord(axis: SearchAxis) -> f64:
        if axis == .x:
            return self.x
        return self.y

# mark: Quad64 (path64/quad64.rs) =============================================================

func push_valid_ts(s: const f64[], real_roots: usize, t: f64[]) -> usize:
    var found_roots: usize = 0
    outer: for index in 0..<real_roots:
        var t_value = s[index]
        if approximately_zero_or_more(t_value) and approximately_one_or_less(t_value):
            t_value = bound64(t_value, 0.0, 1.0)

            for idx2 in 0..<found_roots:
                if approximately_equal(t[idx2], t_value):
                    continue outer

            t[found_roots] = t_value
            found_roots += 1

    return found_roots

# note: caller expects multiple results to be sorted smaller first
# note: http://en.wikipedia.org/wiki/Loss_of_significance has an interesting analysis of the
#  quadratic equation, suggesting why the following looks at the sign of B -- and further
#  suggesting that the greatest loss of precision is in b squared less two a c
func quad64_roots_valid_t(a: f64, b: f64, c: f64, t: f64[]) -> usize:
    var s: f64[3] = [0.0, 0.0, 0.0]
    let real_roots = quad64_roots_real(a, b, c, s)
    return push_valid_ts(s, real_roots, t)

# Numeric Solutions (5.6) suggests to solve the quadratic by computing
#     Q = -1/2(B + sgn(B)Sqrt(B^2 - 4 A C))
# and using the roots
#     t1 = Q / A
#     t2 = C / Q
#
# this does not discard real roots <= 0 or >= 1
func quad64_roots_real(a: f64, b: f64, c: f64, s: f64[]) -> usize:
    if a == 0.0:
        return handle_zero(b, c, s)

    let p = b / (2.0 * a)
    let q = c / a
    if approximately_zero(a) and (approximately_zero_inverse(p) or approximately_zero_inverse(q)):
        return handle_zero(b, c, s)

    # normal form: x^2 + px + q = 0
    let p2 = p * p
    if not almost_dequal_ulps64(p2, q) and p2 < q:
        return 0

    var sqrt_d: f64 = 0.0
    if p2 > q:
        sqrt_d = math.sqrt(p2 - q)

    s[0] = sqrt_d - p
    s[1] = -sqrt_d - p
    return 1 + (usize)(not almost_dequal_ulps64(s[0], s[1]))

func handle_zero(b: f64, c: f64, s: f64[]) -> usize:
    if approximately_zero(b):
        s[0] = 0.0
        return (usize)(c == 0.0)
    s[0] = -c / b
    return 1
