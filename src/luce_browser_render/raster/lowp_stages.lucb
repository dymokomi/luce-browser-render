#==============================================================================================
#
#   lowp_stages - the blend and shader stages of the low precision pipeline
#
#   DESCRIPTION:
#       Port of tiny-skia pipeline/lowp.rs, part 2: the blend_fn! / blend_fn2! stages in
#       u16 math (div255), transform, the x1 tiling stages, the gradient stages
#       (gradient lookup, evenly spaced two-stop gradient, radius) and round_f32_to_u16.
#
#==============================================================================================

# The blend kernels work on one half (8 lanes) of the u16x16 registers, called directly per
# half by the stage: through a function pointer on whole registers they were several times
# slower.

func lowp_blend_fn(p: LowpPipeline*, f: func(U16x8, U16x8, U16x8, U16x8) -> U16x8):
    for h: usize in 0..<2:
        let sa = p.a[h]
        let da = p.da[h]
        p.r[h] = f(p.r[h], p.dr[h], sa, da)
        p.g[h] = f(p.g[h], p.dg[h], sa, da)
        p.b[h] = f(p.b[h], p.db[h], sa, da)
        p.a[h] = f(sa, da, sa, da)

    lowp_next_stage(p)

# The same logic applied to color, and source_over for alpha.
func lowp_blend_fn2(p: LowpPipeline*, f: func(U16x8, U16x8, U16x8, U16x8) -> U16x8):
    for h: usize in 0..<2:
        let sa = p.a[h]
        let da = p.da[h]
        p.r[h] = f(p.r[h], p.dr[h], sa, da)
        p.g[h] = f(p.g[h], p.dg[h], sa, da)
        p.b[h] = f(p.b[h], p.db[h], sa, da)
        p.a[h] = sa +% div255(da *% lowp_inv(sa))

    lowp_next_stage(p)

# mark: blend_fn! =============================================================================

func lowp_clear_k(_s: U16x8, _d: U16x8, _sa: U16x8, _da: U16x8) -> U16x8:
    return u16[8](0)

func lowp_source_atop_k(s: U16x8, d: U16x8, sa: U16x8, da: U16x8) -> U16x8:
    return div255(s *% da +% d *% lowp_inv(sa))

func lowp_destination_atop_k(s: U16x8, d: U16x8, sa: U16x8, da: U16x8) -> U16x8:
    return div255(d *% sa +% s *% lowp_inv(da))

func lowp_source_in_k(s: U16x8, _d: U16x8, _sa: U16x8, da: U16x8) -> U16x8:
    return div255(s *% da)

func lowp_destination_in_k(_s: U16x8, d: U16x8, sa: U16x8, _da: U16x8) -> U16x8:
    return div255(d *% sa)

func lowp_source_out_k(s: U16x8, _d: U16x8, _sa: U16x8, da: U16x8) -> U16x8:
    return div255(s *% lowp_inv(da))

func lowp_destination_out_k(_s: U16x8, d: U16x8, sa: U16x8, _da: U16x8) -> U16x8:
    return div255(d *% lowp_inv(sa))

func lowp_source_over_k(s: U16x8, d: U16x8, sa: U16x8, _da: U16x8) -> U16x8:
    return s +% div255(d *% lowp_inv(sa))

func lowp_destination_over_k(s: U16x8, d: U16x8, _sa: U16x8, da: U16x8) -> U16x8:
    return d +% div255(s *% lowp_inv(da))

func lowp_modulate_k(s: U16x8, d: U16x8, _sa: U16x8, _da: U16x8) -> U16x8:
    return div255(s *% d)

func lowp_multiply_k(s: U16x8, d: U16x8, sa: U16x8, da: U16x8) -> U16x8:
    return div255(s *% lowp_inv(da) +% d *% lowp_inv(sa) +% s *% d)

func lowp_screen_k(s: U16x8, d: U16x8, _sa: U16x8, _da: U16x8) -> U16x8:
    return s +% d -% div255(s *% d)

func lowp_xor_k(s: U16x8, d: U16x8, sa: U16x8, da: U16x8) -> U16x8:
    return div255(s *% lowp_inv(da) +% d *% lowp_inv(sa))

func lowp_plus_k(s: U16x8, d: U16x8, _sa: U16x8, _da: U16x8) -> U16x8:
    return u16x8_min(s +% d, u16[8](255))

func lowp_clear(p: LowpPipeline*):
    lowp_blend_fn(p, lowp_clear_k)

func lowp_source_atop(p: LowpPipeline*):
    lowp_blend_fn(p, lowp_source_atop_k)

func lowp_destination_atop(p: LowpPipeline*):
    lowp_blend_fn(p, lowp_destination_atop_k)

func lowp_source_in(p: LowpPipeline*):
    lowp_blend_fn(p, lowp_source_in_k)

func lowp_destination_in(p: LowpPipeline*):
    lowp_blend_fn(p, lowp_destination_in_k)

func lowp_source_out(p: LowpPipeline*):
    lowp_blend_fn(p, lowp_source_out_k)

func lowp_destination_out(p: LowpPipeline*):
    lowp_blend_fn(p, lowp_destination_out_k)

func lowp_source_over(p: LowpPipeline*):
    for h: usize in 0..<2:
        let inv_a = lowp_inv(p.a[h])
        p.r[h] = p.r[h] +% div255(p.dr[h] *% inv_a)
        p.g[h] = p.g[h] +% div255(p.dg[h] *% inv_a)
        p.b[h] = p.b[h] +% div255(p.db[h] *% inv_a)
        p.a[h] = p.a[h] +% div255(p.da[h] *% inv_a)

    lowp_next_stage(p)

func lowp_destination_over(p: LowpPipeline*):
    lowp_blend_fn(p, lowp_destination_over_k)

func lowp_modulate(p: LowpPipeline*):
    lowp_blend_fn(p, lowp_modulate_k)

func lowp_multiply(p: LowpPipeline*):
    lowp_blend_fn(p, lowp_multiply_k)

func lowp_screen(p: LowpPipeline*):
    lowp_blend_fn(p, lowp_screen_k)

func lowp_xor(p: LowpPipeline*):
    lowp_blend_fn(p, lowp_xor_k)

func lowp_plus(p: LowpPipeline*):
    lowp_blend_fn(p, lowp_plus_k)

# mark: blend_fn2! ============================================================================

func lowp_darken_k(s: U16x8, d: U16x8, sa: U16x8, da: U16x8) -> U16x8:
    return s +% d -% div255(u16x8_max(s *% da, d *% sa))

func lowp_lighten_k(s: U16x8, d: U16x8, sa: U16x8, da: U16x8) -> U16x8:
    return s +% d -% div255(u16x8_min(s *% da, d *% sa))

func lowp_exclusion_k(s: U16x8, d: U16x8, _sa: U16x8, _da: U16x8) -> U16x8:
    return s +% d -% u16[8](2) *% div255(s *% d)

func lowp_difference_k(s: U16x8, d: U16x8, sa: U16x8, da: U16x8) -> U16x8:
    return s +% d -% u16[8](2) *% div255(u16x8_min(s *% da, d *% sa))

func lowp_hard_light_k(s: U16x8, d: U16x8, sa: U16x8, da: U16x8) -> U16x8:
    let two = u16[8](2)
    return div255(s *% lowp_inv(da) +% d *% lowp_inv(sa) +% u16x8_blend(u16x8_cmp_le(s +% s, sa), two *% s *% d, sa *% da -% two *% (sa -% s) *% (da -% d)))

func lowp_overlay_k(s: U16x8, d: U16x8, sa: U16x8, da: U16x8) -> U16x8:
    let two = u16[8](2)
    return div255(s *% lowp_inv(da) +% d *% lowp_inv(sa) +% u16x8_blend(u16x8_cmp_le(d +% d, da), two *% s *% d, sa *% da -% two *% (sa -% s) *% (da -% d)))

func lowp_darken(p: LowpPipeline*):
    lowp_blend_fn2(p, lowp_darken_k)

func lowp_lighten(p: LowpPipeline*):
    lowp_blend_fn2(p, lowp_lighten_k)

func lowp_exclusion(p: LowpPipeline*):
    lowp_blend_fn2(p, lowp_exclusion_k)

func lowp_difference(p: LowpPipeline*):
    lowp_blend_fn2(p, lowp_difference_k)

func lowp_hard_light(p: LowpPipeline*):
    lowp_blend_fn2(p, lowp_hard_light_k)

func lowp_overlay(p: LowpPipeline*):
    lowp_blend_fn2(p, lowp_overlay_k)

# mark: Shaders ===============================================================================
# Coordinates are f32x16 (`F16`, four F4 quarters) carried in the u16 registers.

func lowp_transform(p: LowpPipeline*):
    let ts = p.ctx.transform

    let x = lowp_join(p.r, p.g)
    let y = lowp_join(p.b, p.a)

    var nx: F16 = ---
    var ny: F16 = ---
    for q: usize in 0..<4:
        nx[q] = lowp_mad(x[q], f32[4](ts.sx), lowp_mad(y[q], f32[4](ts.kx), f32[4](ts.tx)))
        ny[q] = lowp_mad(x[q], f32[4](ts.ky), lowp_mad(y[q], f32[4](ts.sy), f32[4](ts.ty)))

    lowp_split(nx, &p.r, &p.g)
    lowp_split(ny, &p.b, &p.a)

    lowp_next_stage(p)

func lowp_pad_x1(p: LowpPipeline*):
    var x = lowp_join(p.r, p.g)
    for q: usize in 0..<4:
        x[q] = f4_normalize(x[q])
    lowp_split(x, &p.r, &p.g)

    lowp_next_stage(p)

func lowp_reflect_x1(p: LowpPipeline*):
    var x = lowp_join(p.r, p.g)
    let one = f32[4](1.0)
    for q: usize in 0..<4:
        let fl = f16_floor_quarter((x[q] - one) * f32[4](0.5))
        x[q] = f4_normalize(f4_abs(x[q] - one - (fl + fl) - one))
    lowp_split(x, &p.r, &p.g)

    lowp_next_stage(p)

func lowp_repeat_x1(p: LowpPipeline*):
    var x = lowp_join(p.r, p.g)
    for q: usize in 0..<4:
        x[q] = f4_normalize(x[q] - f16_floor_quarter(x[q]))
    lowp_split(x, &p.r, &p.g)

    lowp_next_stage(p)

func lowp_gradient(p: LowpPipeline*):
    let ctx = &p.ctx.gradient

    # N.B. The loop starts at 1 because idx 0 is the color to use before the first stop.
    let t = lowp_join(p.r, p.g)
    var idx = u16_splat(0)
    for i in 1..<ctx.len:
        let tt = ctx.t_values.data[i]
        for l: usize in 0..<16:
            idx[l >> 3][l & 7] +%= (u16)(t[l >> 2][l & 3] >= tt)
    lowp_gradient_lookup(ctx, idx, t, &p.r, &p.g, &p.b, &p.a)

    lowp_next_stage(p)

func lowp_evenly_spaced_2_stop_gradient(p: LowpPipeline*):
    let ctx = p.ctx.evenly_spaced_2_stop_gradient

    let t = lowp_join(p.r, p.g)
    var rf: F16 = ---
    var gf: F16 = ---
    var bf: F16 = ---
    var af: F16 = ---
    for q: usize in 0..<4:
        rf[q] = lowp_mad(t[q], f32[4](ctx.factor.r), f32[4](ctx.bias.r))
        gf[q] = lowp_mad(t[q], f32[4](ctx.factor.g), f32[4](ctx.bias.g))
        bf[q] = lowp_mad(t[q], f32[4](ctx.factor.b), f32[4](ctx.bias.b))
        af[q] = lowp_mad(t[q], f32[4](ctx.factor.a), f32[4](ctx.bias.a))
    round_f32_to_u16(&rf, &gf, &bf, &af, &p.r, &p.g, &p.b, &p.a)

    lowp_next_stage(p)

func lowp_xy_to_radius(p: LowpPipeline*):
    var x = lowp_join(p.r, p.g)
    let y = lowp_join(p.b, p.a)
    for q: usize in 0..<4:
        x[q] = f4_sqrt(x[q] * x[q] + y[q] * y[q])
    lowp_split(x, &p.r, &p.g)
    lowp_split(y, &p.b, &p.a)

    lowp_next_stage(p)

# We are using u16 for index, not u32 as Skia, to simplify the code a bit. The gradient
# creation code will not allow that many stops anyway.
func lowp_gradient_lookup(ctx: const GradientCtx*, idx: U16x16, t: F16, r: U16x16*, g: U16x16*, b: U16x16*, a: U16x16*):
    # Surprisingly, but bound checking doesn't affect the performance. And since `idx` can
    # contain any number, we should leave it in place.
    let factors = ctx.factors.view()
    let biases = ctx.biases.view()
    var fr: F16 = ---
    var fg: F16 = ---
    var fb: F16 = ---
    var fa: F16 = ---
    var br: F16 = ---
    var bg: F16 = ---
    var bb: F16 = ---
    var ba: F16 = ---
    for l: usize in 0..<16:
        let i = (usize)idx[l >> 3][l & 7]
        let f = factors[i]
        let bias = biases[i]
        let h = l >> 2
        let k = l & 3
        fr[h][k] = f.r
        fg[h][k] = f.g
        fb[h][k] = f.b
        fa[h][k] = f.a
        br[h][k] = bias.r
        bg[h][k] = bias.g
        bb[h][k] = bias.b
        ba[h][k] = bias.a

    for q: usize in 0..<4:
        fr[q] = lowp_mad(t[q], fr[q], br[q])
        fg[q] = lowp_mad(t[q], fg[q], bg[q])
        fb[q] = lowp_mad(t[q], fb[q], bb[q])
        fa[q] = lowp_mad(t[q], fa[q], ba[q])
    round_f32_to_u16(&fr, &fg, &fb, &fa, r, g, b, a)

func round_f32_to_u16(rf: const F16*, gf: const F16*, bf: const F16*, af: const F16*, r: U16x16*, g: U16x16*, b: U16x16*, a: U16x16*):
    # TODO: may produce a slightly different result to Skia
    #       affects the two_stops_linear_mirror test

    let scale = f32[4](255.0)
    let half_ = f32[4](0.5)
    for q: usize in 0..<4:
        let rq = f4_normalize((*rf)[q]) * scale + half_
        let gq = f4_normalize((*gf)[q]) * scale + half_
        let bq = f4_normalize((*bf)[q]) * scale + half_
        let aq = (*af)[q] * scale + half_

        # Do not use to_i32x8, because it involves rounding, and Skia cast's without it.
        let h = q >> 1
        let o = (q & 1) * 4
        for k: usize in 0..<4:
            (*r)[h][o + k] = (u16)rq[k]
            (*g)[h][o + k] = (u16)gq[k]
            (*b)[h][o + k] = (u16)bq[k]
            (*a)[h][o + k] = (u16)aq[k]
