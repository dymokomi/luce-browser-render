#==============================================================================================
#
#   scan_path - the non-AA rectangle and path scan converters
#
#   DESCRIPTION:
#       Port of tiny-skia scan/mod.rs (fill_rect, fill_int_rect, fill_rect_aa) and
#       scan/path.rs (fill_path, conservative rounding, fill_path_impl, and the active edge
#       list walk of SkScan_Path.cpp: walk_edges, insert/remove/backward-insert of edges).
#       `fill_path_impl` is shared with the supersampling converter (scan_path_aa.lucb),
#       which calls it with a shift and its SuperBlitter.
#
#==============================================================================================

# mark: scan/mod.rs ===========================================================================

func scan_fill_rect(rect: Rect, clip: ScreenIntRect, blitter: Blitter):
    if let r = rect.round():
        fill_int_rect(r, clip, blitter)

func fill_int_rect(rect0: IntRect, clip: ScreenIntRect, blitter: Blitter):
    let rect1 = rect0.intersect(clip.to_int_rect()) else return # everything was clipped out
    let rect = rect1.to_screen_int_rect() else return
    var b = blitter
    b.blit_rect(rect)

func scan_fill_rect_aa(rect: Rect, clip: ScreenIntRect, blitter: Blitter):
    hairline_aa_fill_rect(rect, clip, blitter)

# mark: scan/path.rs ==========================================================================

func scan_fill_path(path: const Path*, fill_rule: FillRule, clip: ScreenIntRect, blitter: Blitter):
    let ir = conservative_round_to_int(path.bounds()) else return

    var path_contained_in_clip = false
    if let bounds = ir.to_screen_int_rect():
        path_contained_in_clip = clip.contains(bounds)
    else:
        # If bounds cannot be converted into ScreenIntRect, the path is out of clip.
        path_contained_in_clip = false

    # TODO: SkScanClipper

    fill_path_impl(path, fill_rule, clip, ir.y(), ir.bottom(), 0, path_contained_in_clip, blitter)

# Conservative rounding function, which effectively nudges the int-rect to be slightly
# larger than Rect::round() might have produced. This is a safety-net for the scan-converter,
# which inspects the returned int-rect, and may disable clipping (for speed) if it thinks all
# of the edges will fit inside the clip's bounds. The scan-converter introduces slight
# numeric errors due to accumulated += of the slope, so this function is used to return a
# conservatively large int-bounds, and thus we will only disable clipping if we're sure the
# edges will stay in-bounds.
func conservative_round_to_int(src: Rect) -> IntRect?:
    # We must use `from_ltrb`, otherwise rounding will be incorrect.
    return IntRect.from_ltrb(round_down_to_int(src.left()), round_down_to_int(src.top()), round_up_to_int(src.right()), round_up_to_int(src.bottom()))

# Bias used for conservative rounding of float rects to int rects, to nudge the irects a
# little larger, so we don't "think" a path's bounds are inside a clip, when (due to numeric
# drift in the scan-converter) we might walk beyond the predicted limits.
#
# This value has been determined trial and error: pick the smallest value (after the 0.5)
# that fixes any problematic cases (e.g. crbug.com/844457)
# NOTE: cubics appear to be the main reason for needing this slop. If we could (perhaps)
# have a more accurate walker for cubics, we may be able to reduce this fudge factor.
let conservative_round_bias: f64 = 0.5 + 1.5 / 64.0

# Round the value down. This is used to round the top and left of a rectangle, and
# corresponds to the way the scan converter treats the top and left edges. It has a slight
# bias to make the "rounded" int smaller than a normal round, to create a more conservative
# int-bounds (larger) from a float rect.
func round_down_to_int(x: f32) -> i32:
    var xx = (f64)x
    xx -= conservative_round_bias
    return saturate_from64(math.ceil(xx))

# Round the value up. This is used to round the right and bottom of a rectangle. It has a
# slight bias to make the "rounded" int smaller than a normal round, to create a more
# conservative int-bounds (larger) from a float rect.
func round_up_to_int(x: f32) -> i32:
    var xx = (f64)x
    xx += conservative_round_bias
    return saturate_from64(math.floor(xx))

func edge_less(a: const Edge*, b: const Edge*) -> bool:
    var value_a = a.data.line.first_y
    var value_b = b.data.line.first_y

    if value_a == value_b:
        value_a = a.data.line.x
        value_b = b.data.line.x

    return value_a < value_b

func fill_path_impl(path: const Path*, fill_rule: FillRule, clip_rect: ScreenIntRect, start_y0: i32, stop_y0: i32, shift_edges_up: i32, path_contained_in_clip: bool, blitter: Blitter):
    var start_y = start_y0
    var stop_y = stop_y0
    let shifted_clip = ShiftedIntRect.new_(clip_rect, shift_edges_up) else return

    let clip: const ShiftedIntRect*? = none if path_contained_in_clip else &shifted_clip
    var edges = BasicEdgeBuilder.build_edges(path, clip, shift_edges_up) else return # no edges to render, just return
    defer edges.release()

    stable_sort(edges.view(), edge_less)

    for i in 0..<edges.len:
        # 0 will be set later, so start with 1.
        edges.data[i].data.line.prev = (u32)i + 0
        edges.data[i].data.line.next = (u32)i + 2

    let edge_head_y = i32_min
    let edge_tail_y = i32_max

    var head_line: LineEdge
    head_line.prev = edge_none
    head_line.next = 1
    head_line.x = i32_min
    head_line.first_y = edge_head_y
    edges.insert(0, Edge.from_line(head_line))

    var tail_line: LineEdge
    tail_line.prev = (u32)edges.len - 1
    tail_line.next = edge_none
    tail_line.first_y = edge_tail_y
    edges.push(Edge.from_line(tail_line))

    start_y <<= shift_edges_up
    stop_y <<= shift_edges_up

    let top = (i32)shifted_clip.shifted().y()
    if not path_contained_in_clip and start_y < top:
        start_y = top

    let bottom = (i32)shifted_clip.shifted().bottom()
    if not path_contained_in_clip and stop_y > bottom:
        stop_y = bottom

    if start_y < 0 or stop_y < 0:
        return

    # TODO: walk_simple_edges

    walk_edges(fill_rule, (u32)start_y, (u32)stop_y, shifted_clip.shifted().right(), edges.view(), blitter)

# TODO: simplify!
func walk_edges(fill_rule: FillRule, start_y: u32, stop_y: u32, right_clip: u32, edges: Edge[], blitter0: Blitter):
    var blitter = blitter0
    var curr_y = start_y
    let winding_mask: i32 = 1 if fill_rule == .even_odd else -1

    while true:
        var w: i32 = 0
        var left: u32 = 0
        var prev_x = edges[0].data.line.x

        var curr_idx = (usize)edges[0].data.line.next
        while edges[curr_idx].data.line.first_y <= (i32)curr_y:
            let x = (u32)fdot16_round_to_i32(edges[curr_idx].data.line.x) # TODO: check

            if (w & winding_mask) == 0:
                # we're starting interval
                left = x

            w += (i32)edges[curr_idx].data.line.winding

            if (w & winding_mask) == 0:
                # we finished an interval
                let width = x - left
                if width != 0:
                    blitter.blit_h(left, curr_y, width)

            let next_idx = edges[curr_idx].data.line.next
            var new_x: FDot16

            if edges[curr_idx].data.line.last_y == (i32)curr_y:
                # are we done with this edge?
                match edges[curr_idx].kind:
                    .line:
                        remove_edge(curr_idx, edges)
                    .quadratic:
                        if edges[curr_idx].data.quad.curve_count > 0 and edges[curr_idx].data.quad.update():
                            new_x = edges[curr_idx].data.quad.line.x

                            if new_x < prev_x:
                                # ripple current edge backwards until it is x-sorted
                                backward_insert_edge_based_on_x(curr_idx, edges)
                            else:
                                prev_x = new_x
                        else:
                            remove_edge(curr_idx, edges)
                    .cubic:
                        if edges[curr_idx].data.cubic.curve_count < 0 and edges[curr_idx].data.cubic.update():
                            new_x = edges[curr_idx].data.cubic.line.x

                            if new_x < prev_x:
                                # ripple current edge backwards until it is x-sorted
                                backward_insert_edge_based_on_x(curr_idx, edges)
                            else:
                                prev_x = new_x
                        else:
                            remove_edge(curr_idx, edges)
                    _:
                        trap("unreachable")
            else:
                new_x = edges[curr_idx].data.line.x + edges[curr_idx].data.line.dx
                edges[curr_idx].data.line.x = new_x

                if new_x < prev_x:
                    # ripple current edge backwards until it is x-sorted
                    backward_insert_edge_based_on_x(curr_idx, edges)
                else:
                    prev_x = new_x

            curr_idx = (usize)next_idx

        if (w & winding_mask) != 0:
            # was our right-edge culled away?
            let width = right_clip - left
            if width != 0:
                blitter.blit_h(left, curr_y, width)

        curr_y += 1
        if curr_y >= stop_y:
            break

        # now current edge points to the first edge with a Yint larger than curr_y
        insert_new_edges(curr_idx, (i32)curr_y, edges)

func remove_edge(curr_idx: usize, edges: Edge[]):
    let prev = edges[curr_idx].data.line.prev
    let next = edges[curr_idx].data.line.next

    edges[(usize)prev].data.line.next = next
    edges[(usize)next].data.line.prev = prev

func backward_insert_edge_based_on_x(curr_idx: usize, edges: Edge[]):
    let x = edges[curr_idx].data.line.x
    var prev_idx = (usize)edges[curr_idx].data.line.prev
    while prev_idx != 0:
        if edges[prev_idx].data.line.x > x:
            prev_idx = (usize)edges[prev_idx].data.line.prev
        else:
            break

    let next_idx = (usize)edges[prev_idx].data.line.next
    if next_idx != curr_idx:
        remove_edge(curr_idx, edges)
        insert_edge_after(curr_idx, prev_idx, edges)

func insert_edge_after(curr_idx: usize, after_idx: usize, edges: Edge[]):
    edges[curr_idx].data.line.prev = (u32)after_idx
    edges[curr_idx].data.line.next = edges[after_idx].data.line.next

    let after_next_idx = (usize)edges[after_idx].data.line.next
    edges[after_next_idx].data.line.prev = (u32)curr_idx
    edges[after_idx].data.line.next = (u32)curr_idx

# Start from the right side, searching backwards for the point to begin the new edge list
# insertion, marching forwards from here. The implementation could have started from the
# left of the prior insertion, and search to the right, or with some additional caching,
# binary search the starting point. More work could be done to determine optimal new edge
# insertion.
func backward_insert_start(prev_idx0: usize, x: FDot16, edges: const Edge[]) -> usize:
    var prev_idx = prev_idx0
    while edges[prev_idx].data.line.prev != edge_none:
        prev_idx = (usize)edges[prev_idx].data.line.prev
        if edges[prev_idx].data.line.x <= x:
            break

    return prev_idx

func insert_new_edges(new_idx0: usize, curr_y: i32, edges: Edge[]):
    var new_idx = new_idx0
    if edges[new_idx].data.line.first_y != curr_y:
        return

    let prev_idx = (usize)edges[new_idx].data.line.prev
    if edges[prev_idx].data.line.x <= edges[new_idx].data.line.x:
        return

    # find first x pos to insert
    var start_idx = backward_insert_start(prev_idx, edges[new_idx].data.line.x, edges)
    # insert the lot, fixing up the links as we go
    while true:
        let next_idx = (usize)edges[new_idx].data.line.next
        var keep_edge = false
        while true:
            let after_idx = (usize)edges[start_idx].data.line.next
            if after_idx == new_idx:
                keep_edge = true
                break

            if edges[after_idx].data.line.x >= edges[new_idx].data.line.x:
                break

            start_idx = after_idx

        if not keep_edge:
            remove_edge(new_idx, edges)
            insert_edge_after(new_idx, start_idx, edges)

        start_idx = new_idx
        new_idx = next_idx

        if edges[new_idx].data.line.first_y != curr_y:
            break
