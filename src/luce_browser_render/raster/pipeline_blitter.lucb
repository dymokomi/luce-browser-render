#==============================================================================================
#
#   pipeline_blitter - the blitter that runs raster pipelines
#
#   DESCRIPTION:
#       Port of tiny-skia pipeline/blitter.rs: RasterPipelineBlitter, which builds three
#       pipelines from a paint (anti-aliased spans, rectangles, two-pixel masks), strength-
#       reduces SourceOver/Clear to memsets where Skia does, and implements the Blitter
#       interface for the scan converters. `new_mask` builds the variant that renders
#       coverage into a Mask. It owns its compiled pipelines; `release()` frees them.
#
#==============================================================================================

struct RasterPipelineBlitter: Blitter:
    var mask: SubMaskRef?
    var pixmap_src: PixmapRef
    var pixmap: SubPixmapMut*
    var memset2d_color: PremultipliedColorU8?
    var blit_anti_h_rp: RasterPipeline
    var blit_rect_rp: RasterPipeline
    var blit_mask_rp: RasterPipeline
    var is_mask: bool

    static func new_(paint: const Paint*, mask: SubMaskRef?, pixmap: SubPixmapMut*) -> RasterPipelineBlitter?:
        # Make sure that `mask` has the same size as `pixmap`.
        var has_mask = false
        if let m = mask:
            has_mask = true
            if m.size.width() != pixmap.size.width() or m.size.height() != pixmap.size.height():
                # log::warn!("Pixmap and Mask are expected to have the same size")
                return none

        # Fast-reject.
        # This is basically SkInterpretXfermode().
        if paint.blend_mode == .destination:
            # `Destination` keep the pixmap unchanged. Nothing to do here.
            return none
        if paint.blend_mode == .destination_in and shader_is_opaque(&paint.shader) and paint.is_solid_color():
            return none

        # We can strength-reduce SourceOver into Source when opaque.
        var blend_mode = paint.blend_mode
        if shader_is_opaque(&paint.shader) and blend_mode == .source_over and not has_mask:
            blend_mode = .source

        # When we're drawing a constant color in Source mode, we can sometimes just memset.
        var memset2d_color: PremultipliedColorU8? = none
        if paint.is_solid_color() and blend_mode == .source and not has_mask:
            # Unlike Skia, our shader cannot be constant. Therefore there is no need to run a
            # raster pipeline to get shader's color.
            match paint.shader:
                .solid_color(color):
                    memset2d_color = color.premultiply().to_color_u8()
                _:
                    memset2d_color = none

        # Clear is just a transparent color memset.
        if blend_mode == .clear and not paint.anti_alias and not has_mask:
            blend_mode = .source
            memset2d_color = PremultipliedColorU8.transparent()

        var anti_h = RasterPipelineBuilder.new_()
        anti_h.set_force_hq_pipeline(paint.force_hq_pipeline)
        if not shader_push_stages(&paint.shader, paint.colorspace, &anti_h):
            anti_h.release()
            return none

        if has_mask:
            anti_h.push(.mask_u8)

        if blend_mode_should_pre_scale_coverage(blend_mode):
            anti_h.push(.scale_1_float)
            anti_h.push(.load_destination)
            if let stage = colorspace_expand_dest_stage(paint.colorspace):
                anti_h.push(stage)
            if let blend_stage = blend_mode_to_stage(blend_mode):
                anti_h.push(blend_stage)
        else:
            anti_h.push(.load_destination)
            if let stage = colorspace_expand_dest_stage(paint.colorspace):
                anti_h.push(stage)
            if let blend_stage = blend_mode_to_stage(blend_mode):
                anti_h.push(blend_stage)

            anti_h.push(.lerp_1_float)

        if let stage = colorspace_compress_stage(paint.colorspace):
            anti_h.push(stage)
        anti_h.push(.store)

        var blit_anti_h_rp = anti_h.compile()

        var rect_p = RasterPipelineBuilder.new_()
        rect_p.set_force_hq_pipeline(paint.force_hq_pipeline)
        if not shader_push_stages(&paint.shader, paint.colorspace, &rect_p):
            rect_p.release()
            blit_anti_h_rp.release()
            return none

        if has_mask:
            rect_p.push(.mask_u8)

        if blend_mode == .source_over and not has_mask:
            if let stage = colorspace_compress_stage(paint.colorspace):
                rect_p.push(stage)
            # TODO: ignore when dither_rate is non-zero
            rect_p.push(.source_over_rgba)
        else:
            if blend_mode != .source:
                rect_p.push(.load_destination)
                if let blend_stage = blend_mode_to_stage(blend_mode):
                    if let stage = colorspace_expand_dest_stage(paint.colorspace):
                        rect_p.push(stage)
                    rect_p.push(blend_stage)

            if let stage = colorspace_compress_stage(paint.colorspace):
                rect_p.push(stage)
            rect_p.push(.store)

        var blit_rect_rp = rect_p.compile()

        var mask_p = RasterPipelineBuilder.new_()
        mask_p.set_force_hq_pipeline(paint.force_hq_pipeline)
        if not shader_push_stages(&paint.shader, paint.colorspace, &mask_p):
            mask_p.release()
            blit_anti_h_rp.release()
            blit_rect_rp.release()
            return none

        if has_mask:
            mask_p.push(.mask_u8)

        if blend_mode_should_pre_scale_coverage(blend_mode):
            mask_p.push(.scale_u8)
            mask_p.push(.load_destination)
            if let stage = colorspace_expand_dest_stage(paint.colorspace):
                mask_p.push(stage)
            if let blend_stage = blend_mode_to_stage(blend_mode):
                mask_p.push(blend_stage)
        else:
            mask_p.push(.load_destination)
            if let stage = colorspace_expand_dest_stage(paint.colorspace):
                mask_p.push(stage)
            if let blend_stage = blend_mode_to_stage(blend_mode):
                mask_p.push(blend_stage)

            mask_p.push(.lerp_u8)

        if let stage = colorspace_compress_stage(paint.colorspace):
            mask_p.push(stage)
        mask_p.push(.store)

        let blit_mask_rp = mask_p.compile()

        var pixmap_src = dummy_pixmap_ref()
        match paint.shader:
            .pattern(patt):
                pixmap_src = patt.pixmap
            _:
                # Just a dummy one.
                pixmap_src = dummy_pixmap_ref()

        return RasterPipelineBlitter(
            mask = mask,
            pixmap_src = pixmap_src,
            pixmap = pixmap,
            memset2d_color = memset2d_color,
            blit_anti_h_rp = blit_anti_h_rp,
            blit_rect_rp = blit_rect_rp,
            blit_mask_rp = blit_mask_rp,
            is_mask = false,
        )

    static func new_mask(pixmap: SubPixmapMut*) -> RasterPipelineBlitter?:
        let color = Color.white().premultiply()

        let memset2d_color: PremultipliedColorU8? = color.to_color_u8()

        var anti_h = RasterPipelineBuilder.new_()
        anti_h.push_uniform_color(color)
        anti_h.push(.load_destination_u8)
        anti_h.push(.lerp_1_float)
        anti_h.push(.store_u8)
        let blit_anti_h_rp = anti_h.compile()

        var rect_p = RasterPipelineBuilder.new_()
        rect_p.push_uniform_color(color)
        rect_p.push(.store_u8)
        let blit_rect_rp = rect_p.compile()

        var mask_p = RasterPipelineBuilder.new_()
        mask_p.push_uniform_color(color)
        mask_p.push(.load_destination_u8)
        mask_p.push(.lerp_u8)
        mask_p.push(.store_u8)
        let blit_mask_rp = mask_p.compile()

        return RasterPipelineBlitter(
            mask = none,
            pixmap_src = dummy_pixmap_ref(),
            pixmap = pixmap,
            memset2d_color = memset2d_color,
            blit_anti_h_rp = blit_anti_h_rp,
            blit_rect_rp = blit_rect_rp,
            blit_mask_rp = blit_mask_rp,
            is_mask = true,
        )

    ## Frees the compiled pipelines.
    mutating func release():
        self.blit_anti_h_rp.release()
        self.blit_rect_rp.release()
        self.blit_mask_rp.release()

    func mask_ctx() -> MaskCtx:
        if let m = self.mask:
            return m.mask_ctx()
        return MaskCtx()

    pub mutating func blit_h(x: u32, y: u32, width: u32):
        let r = ScreenIntRect.from_xywh_safe(x, y, width, 1)
        self.blit_rect(r)

    pub mutating func blit_anti_h(x0: u32, y: u32, aa: AlphaU8[], runs: AlphaRun[]):
        let mask_ctx = self.mask_ctx()

        var x = x0
        var aa_offset: usize = 0
        var run_offset: usize = 0
        var run = runs[0]
        while run != 0:
            let width = (u32)run

            let alpha = aa[aa_offset]
            if alpha == alpha_u8_opaque:
                self.blit_h(x, y, width)
            elif alpha != alpha_u8_transparent:
                self.blit_anti_h_rp.ctx.current_coverage = (f32)alpha * (1.0 / 255.0)

                let rect = ScreenIntRect.from_xywh_safe(x, y, width, 1)
                self.blit_anti_h_rp.run(rect, AAMaskCtx(), mask_ctx, self.pixmap_src, self.pixmap)

            x += width
            run_offset += (usize)run
            aa_offset += (usize)run
            run = runs[run_offset]

    pub mutating func blit_v(x: u32, y: u32, height: u32, alpha: AlphaU8):
        let bounds = ScreenIntRect.from_xywh_safe(x, y, 1, height)

        let mask = BlitMask(image = [alpha, alpha], bounds = bounds, row_bytes = 0) # so we reuse the 1 "row" for all of height

        self.blit_mask(&mask, bounds)

    pub mutating func blit_anti_h2(x: u32, y: u32, alpha0: AlphaU8, alpha1: AlphaU8):
        let bounds = ScreenIntRect.from_xywh(x, y, 2, 1) else trap("unreachable")

        let mask = BlitMask(image = [alpha0, alpha1], bounds = bounds, row_bytes = 2)

        self.blit_mask(&mask, bounds)

    pub mutating func blit_anti_v2(x: u32, y: u32, alpha0: AlphaU8, alpha1: AlphaU8):
        let bounds = ScreenIntRect.from_xywh(x, y, 1, 2) else trap("unreachable")

        let mask = BlitMask(image = [alpha0, alpha1], bounds = bounds, row_bytes = 1)

        self.blit_mask(&mask, bounds)

    pub mutating func blit_rect(rect: ScreenIntRect):
        if let c = self.memset2d_color:
            if self.is_mask:
                for y in 0..<rect.height():
                    let start = self.pixmap.offset((usize)rect.x(), (usize)(rect.y() + y))
                    let end = start + (usize)rect.width()
                    for p in &self.pixmap.data[start..<end]:
                        *p = c.alpha()
            else:
                let pixels = self.pixmap.pixels_mut()
                for y in 0..<rect.height():
                    let start = self.pixmap.offset((usize)rect.x(), (usize)(rect.y() + y))
                    let end = start + (usize)rect.width()
                    for p in &pixels[start..<end]:
                        *p = c

            return

        let mask_ctx = self.mask_ctx()

        self.blit_rect_rp.run(rect, AAMaskCtx(), mask_ctx, self.pixmap_src, self.pixmap)

    pub mutating func blit_mask(mask: const BlitMask*, clip: ScreenIntRect):
        let aa_mask_ctx = AAMaskCtx(pixels = mask.image, stride = mask.row_bytes, shift = (usize)(mask.bounds.left() + mask.bounds.top() * mask.row_bytes))

        let mask_ctx = self.mask_ctx()

        self.blit_mask_rp.run(clip, aa_mask_ctx, mask_ctx, self.pixmap_src, self.pixmap)

## The 1x1 transparent pixmap the pipeline gets when there is no pattern.
let dummy_pixel: u8[4] = [0, 0, 0, 0]

func dummy_pixmap_ref() -> PixmapRef:
    return PixmapRef.from_bytes(dummy_pixel, 1, 1) else trap("unreachable")
