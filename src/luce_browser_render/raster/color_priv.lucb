#   color_priv - Skia's 8-bit color helpers
#
#   DESCRIPTION:
#       Port of SkMulDiv255Round (include/private/base/SkMath.h), which scales coverage by
#       a clip's alpha, and of the channel conversion of SkColor4f::toSkColor
#       (src/core/SkSwizzlePriv.h, Sk4f_toL32), with which SkPaint::getAlpha rounds.
