#==============================================================================================
#
#   highp_blend - the blend mode stages of the high precision pipeline
#
#   DESCRIPTION:
#       Port of tiny-skia pipeline/highp.rs, part 2 (the blend_fn!, blend_fn2! and
#       blend_fn3! stages), as Skia m144's BLEND_MODE stages compute them on NEON: the
#       Porter-Duff modes, the separable blend modes and the non-separable ones (hue,
#       saturation, color, luminosity), with fused mads, vminq/vmaxq and the reciprocal
#       estimate (rcp_fast). Each kernel is a function; `highp_blend_fn` /
#       `highp_blend_fn2` apply it as the macros do.
#
#       Copyright (c) 2018 Google Inc. All rights reserved.
#       Copyright (c) 2020 Yevhenii Reizner All rights reserved.
#       SPDX-License-Identifier: BSD-3-Clause (see LICENSE-skia, LICENSE-tiny-skia)
#
#==============================================================================================

type HighpBlendKernel = func(F8, F8, F8, F8) -> F8

func highp_blend_fn(p: HighpPipeline*, f: HighpBlendKernel):
    p.r = f(p.r, p.dr, p.a, p.da)
    p.g = f(p.g, p.dg, p.a, p.da)
    p.b = f(p.b, p.db, p.a, p.da)
    p.a = f(p.a, p.da, p.a, p.da)

    highp_next_stage(p)

# The same logic applied to color, and source_over for alpha.
func highp_blend_fn2(p: HighpPipeline*, f: HighpBlendKernel):
    p.r = f(p.r, p.dr, p.a, p.da)
    p.g = f(p.g, p.dg, p.a, p.da)
    p.b = f(p.b, p.db, p.a, p.da)
    p.a = highp_mad(p.da, highp_inv(p.a), p.a)

    highp_next_stage(p)

# mark: blend_fn! =============================================================================

func highp_clear_k(_s: F8, _d: F8, _sa: F8, _da: F8) -> F8:
    return f8_splat(0.0)

func highp_source_atop_k(s: F8, d: F8, sa: F8, da: F8) -> F8:
    return highp_mad(s, da, f8_mul(d, highp_inv(sa)))

func highp_destination_atop_k(s: F8, d: F8, sa: F8, da: F8) -> F8:
    return highp_mad(d, sa, f8_mul(s, highp_inv(da)))

func highp_source_in_k(s: F8, _d: F8, _sa: F8, da: F8) -> F8:
    return f8_mul(s, da)

func highp_destination_in_k(_s: F8, d: F8, sa: F8, _da: F8) -> F8:
    return f8_mul(d, sa)

func highp_source_out_k(s: F8, _d: F8, _sa: F8, da: F8) -> F8:
    return f8_mul(s, highp_inv(da))

func highp_destination_out_k(_s: F8, d: F8, sa: F8, _da: F8) -> F8:
    return f8_mul(d, highp_inv(sa))

func highp_source_over_k(s: F8, d: F8, sa: F8, _da: F8) -> F8:
    return highp_mad(d, highp_inv(sa), s)

func highp_destination_over_k(s: F8, d: F8, _sa: F8, da: F8) -> F8:
    return highp_mad(s, highp_inv(da), d)

func highp_modulate_k(s: F8, d: F8, _sa: F8, _da: F8) -> F8:
    return f8_mul(s, d)

func highp_multiply_k(s: F8, d: F8, sa: F8, da: F8) -> F8:
    return highp_mad(s, d, highp_mad(s, highp_inv(da), f8_mul(d, highp_inv(sa))))

func highp_screen_k(s: F8, d: F8, _sa: F8, _da: F8) -> F8:
    return f8_fms(s, d, f8_add(s, d))

func highp_xor_k(s: F8, d: F8, sa: F8, da: F8) -> F8:
    return highp_mad(s, highp_inv(da), f8_mul(d, highp_inv(sa)))

func highp_plus_k(s: F8, d: F8, _sa: F8, _da: F8) -> F8:
    return f8_vmin(f8_add(s, d), f8_splat(1.0))

func highp_clear(p: HighpPipeline*):
    highp_blend_fn(p, highp_clear_k)

func highp_source_atop(p: HighpPipeline*):
    highp_blend_fn(p, highp_source_atop_k)

func highp_destination_atop(p: HighpPipeline*):
    highp_blend_fn(p, highp_destination_atop_k)

func highp_source_in(p: HighpPipeline*):
    highp_blend_fn(p, highp_source_in_k)

func highp_destination_in(p: HighpPipeline*):
    highp_blend_fn(p, highp_destination_in_k)

func highp_source_out(p: HighpPipeline*):
    highp_blend_fn(p, highp_source_out_k)

func highp_destination_out(p: HighpPipeline*):
    highp_blend_fn(p, highp_destination_out_k)

func highp_source_over(p: HighpPipeline*):
    highp_blend_fn(p, highp_source_over_k)

func highp_destination_over(p: HighpPipeline*):
    highp_blend_fn(p, highp_destination_over_k)

func highp_modulate(p: HighpPipeline*):
    highp_blend_fn(p, highp_modulate_k)

func highp_multiply(p: HighpPipeline*):
    highp_blend_fn(p, highp_multiply_k)

func highp_screen(p: HighpPipeline*):
    highp_blend_fn(p, highp_screen_k)

func highp_xor(p: HighpPipeline*):
    highp_blend_fn(p, highp_xor_k)

func highp_plus(p: HighpPipeline*):
    highp_blend_fn(p, highp_plus_k)

# mark: blend_fn2! ============================================================================

func highp_darken_k(s: F8, d: F8, sa: F8, da: F8) -> F8:
    return f8_sub(f8_add(s, d), f8_vmax(f8_mul(s, da), f8_mul(d, sa)))

func highp_lighten_k(s: F8, d: F8, sa: F8, da: F8) -> F8:
    return f8_sub(f8_add(s, d), f8_vmin(f8_mul(s, da), f8_mul(d, sa)))

func highp_difference_k(s: F8, d: F8, sa: F8, da: F8) -> F8:
    return f8_sub(f8_add(s, d), highp_two(f8_vmin(f8_mul(s, da), f8_mul(d, sa))))

func highp_exclusion_k(s: F8, d: F8, _sa: F8, _da: F8) -> F8:
    return f8_sub(f8_add(s, d), highp_two(f8_mul(s, d)))

func highp_color_burn_k(s: F8, d: F8, sa: F8, da: F8) -> F8:
    return f8_blend(
        f8_cmp_eq(d, da),
        f8_add(d, f8_mul(s, highp_inv(da))),
        f8_blend(
            f8_cmp_eq(s, f8_splat(0.0)),
            f8_mul(d, highp_inv(sa)),
            f8_add(f8_add(f8_mul(sa, f8_sub(da, f8_vmin(da, f8_mul(f8_mul(f8_sub(da, d), sa), f8_rcp_fast(s))))), f8_mul(s, highp_inv(da))), f8_mul(d, highp_inv(sa))),
        ),
    )

func highp_color_dodge_k(s: F8, d: F8, sa: F8, da: F8) -> F8:
    return f8_blend(
        f8_cmp_eq(d, f8_splat(0.0)),
        f8_mul(s, highp_inv(da)),
        f8_blend(
            f8_cmp_eq(s, sa),
            f8_add(s, f8_mul(d, highp_inv(sa))),
            f8_add(f8_add(f8_mul(sa, f8_vmin(da, f8_mul(f8_mul(d, sa), f8_rcp_fast(f8_sub(sa, s))))), f8_mul(s, highp_inv(da))), f8_mul(d, highp_inv(sa))),
        ),
    )

func highp_hard_light_k(s: F8, d: F8, sa: F8, da: F8) -> F8:
    return f8_add(
        f8_add(f8_mul(s, highp_inv(da)), f8_mul(d, highp_inv(sa))),
        f8_blend(f8_cmp_le(highp_two(s), sa), highp_two(f8_mul(s, d)), f8_sub(f8_mul(sa, da), highp_two(f8_mul(f8_sub(da, d), f8_sub(sa, s))))),
    )

func highp_overlay_k(s: F8, d: F8, sa: F8, da: F8) -> F8:
    return f8_add(
        f8_add(f8_mul(s, highp_inv(da)), f8_mul(d, highp_inv(sa))),
        f8_blend(f8_cmp_le(highp_two(d), da), highp_two(f8_mul(s, d)), f8_sub(f8_mul(sa, da), highp_two(f8_mul(f8_sub(da, d), f8_sub(sa, s))))),
    )

func highp_soft_light_k(s: F8, d: F8, sa: F8, da: F8) -> F8:
    let m = f8_blend(f8_cmp_gt(da, f8_splat(0.0)), f8_div(d, da), f8_splat(0.0))
    let s2 = highp_two(s)
    let m4 = highp_two(highp_two(m))

    # The logic forks three ways:
    #    1. dark src?
    #    2. light src, dark dst?
    #    3. light src, light dst?
    let one = f8_splat(1.0)
    let dark_src = f8_mul(d, f8_add(sa, f8_mul(f8_sub(s2, sa), f8_sub(one, m))))
    let dark_dst = f8_add(f8_mul(f8_add(f8_mul(m4, m4), m4), f8_sub(m, one)), f8_mul(f8_splat(7.0), m))
    let lite_dst = f8_sub(f8_sqrt(m), m)
    let lite_src = f8_add(f8_mul(d, sa), f8_mul(f8_mul(da, f8_sub(s2, sa)), f8_blend(f8_cmp_le(highp_two(highp_two(d)), da), dark_dst, lite_dst)))  # 2 or 3?

    return f8_add(f8_add(f8_mul(s, highp_inv(da)), f8_mul(d, highp_inv(sa))), f8_blend(f8_cmp_le(s2, sa), dark_src, lite_src))  # 1 or (2 or 3)?

func highp_darken(p: HighpPipeline*):
    highp_blend_fn2(p, highp_darken_k)

func highp_lighten(p: HighpPipeline*):
    highp_blend_fn2(p, highp_lighten_k)

func highp_difference(p: HighpPipeline*):
    highp_blend_fn2(p, highp_difference_k)

func highp_exclusion(p: HighpPipeline*):
    highp_blend_fn2(p, highp_exclusion_k)

func highp_color_burn(p: HighpPipeline*):
    highp_blend_fn2(p, highp_color_burn_k)

func highp_color_dodge(p: HighpPipeline*):
    highp_blend_fn2(p, highp_color_dodge_k)

func highp_hard_light(p: HighpPipeline*):
    highp_blend_fn2(p, highp_hard_light_k)

func highp_overlay(p: HighpPipeline*):
    highp_blend_fn2(p, highp_overlay_k)

func highp_soft_light(p: HighpPipeline*):
    highp_blend_fn2(p, highp_soft_light_k)

# mark: blend_fn3! ============================================================================
# We're basing our implementation of non-separable blend modes on
#   https://www.w3.org/TR/compositing-1/#blendingnonseparable.
# and
#   https://www.khronos.org/registry/OpenGL/specs/es/3.2/es_spec_3.2.pdf
# They're equivalent, but ES' math has been better simplified.
#
# Anything extra we add beyond that is to make the math work with premul inputs.

func highp_hue(p: HighpPipeline*):
    let a = p.a
    var c = Rgb8(r = f8_mul(p.r, a), g = f8_mul(p.g, a), b = f8_mul(p.b, a))

    set_sat(&c, f8_mul(sat(p.dr, p.dg, p.db), a))
    set_lum(&c, f8_mul(lum(p.dr, p.dg, p.db), a))
    clip_color(&c, f8_mul(a, p.da))

    highp_blend_fn3_finish(p, c)

func highp_saturation(p: HighpPipeline*):
    let a = p.a
    var c = Rgb8(r = f8_mul(p.dr, a), g = f8_mul(p.dg, a), b = f8_mul(p.db, a))

    set_sat(&c, f8_mul(sat(p.r, p.g, p.b), p.da))
    set_lum(&c, f8_mul(lum(p.dr, p.dg, p.db), a))  # (This is not redundant.)
    clip_color(&c, f8_mul(a, p.da))

    highp_blend_fn3_finish(p, c)

func highp_color(p: HighpPipeline*):
    let da = p.da
    var c = Rgb8(r = f8_mul(p.r, da), g = f8_mul(p.g, da), b = f8_mul(p.b, da))

    set_lum(&c, f8_mul(lum(p.dr, p.dg, p.db), p.a))
    clip_color(&c, f8_mul(p.a, da))

    highp_blend_fn3_finish(p, c)

func highp_luminosity(p: HighpPipeline*):
    let a = p.a
    var c = Rgb8(r = f8_mul(p.dr, a), g = f8_mul(p.dg, a), b = f8_mul(p.db, a))

    set_lum(&c, f8_mul(lum(p.r, p.g, p.b), p.da))
    clip_color(&c, f8_mul(a, p.da))

    highp_blend_fn3_finish(p, c)

# The R, G, B of the non-separable stages (a struct is a workaround:
# compiler-issues/c_backend_address_of_local_array).
struct Rgb8:
    var r: F8
    var g: F8
    var b: F8

# The shared tail of the four non-separable stages.
func highp_blend_fn3_finish(p: HighpPipeline*, c: Rgb8):
    let a = p.a
    let da = p.da
    p.r = highp_mad(p.r, highp_inv(da), highp_mad(p.dr, highp_inv(a), c.r))
    p.g = highp_mad(p.g, highp_inv(da), highp_mad(p.dg, highp_inv(a), c.g))
    p.b = highp_mad(p.b, highp_inv(da), highp_mad(p.db, highp_inv(a), c.b))
    p.a = f8_add(a, f8_fms(a, da, da))

    highp_next_stage(p)

func sat(r: F8, g: F8, b: F8) -> F8:
    return f8_sub(f8_vmax(r, f8_vmax(g, b)), f8_vmin(r, f8_vmin(g, b)))

func lum(r: F8, g: F8, b: F8) -> F8:
    return highp_mad(r, f8_splat(0.30), highp_mad(g, f8_splat(0.59), f8_mul(b, f8_splat(0.11))))

func set_sat(c: Rgb8*, s0: F8):
    let mn = f8_vmin(c.r, f8_vmin(c.g, c.b))
    let mx = f8_vmax(c.r, f8_vmax(c.g, c.b))
    let sat_ = f8_sub(mx, mn)

    # Map min channel to 0, max channel to s, and scale the middle proportionally.
    let s = f8_blend(f8_cmp_eq(sat_, f8_splat(0.0)), f8_splat(0.0), f8_mul(s0, f8_rcp_fast(sat_)))
    c.r = f8_mul(f8_sub(c.r, mn), s)
    c.g = f8_mul(f8_sub(c.g, mn), s)
    c.b = f8_mul(f8_sub(c.b, mn), s)

func set_lum(c: Rgb8*, l: F8):
    let diff = f8_sub(l, lum(c.r, c.g, c.b))
    c.r = f8_add(c.r, diff)
    c.g = f8_add(c.g, diff)
    c.b = f8_add(c.b, diff)

func clip_color(c: Rgb8*, a: F8):
    let mn = f8_vmin(c.r, f8_vmin(c.g, c.b))
    let mx = f8_vmax(c.r, f8_vmax(c.g, c.b))
    let l = lum(c.r, c.g, c.b)
    let mn_scale = f8_mul(l, f8_rcp_fast(f8_sub(l, mn)))
    let mx_scale = f8_mul(f8_sub(a, l), f8_rcp_fast(f8_sub(mx, l)))
    let clip_low = m8_and(f8_cmp_lt(mn, f8_splat(0.0)), f8_cmp_ne(l, mn))
    let clip_high = m8_and(f8_cmp_gt(mx, a), f8_cmp_ne(l, mx))

    c.r = clip_channel(c.r, l, clip_low, clip_high, mn_scale, mx_scale)
    c.g = clip_channel(c.g, l, clip_low, clip_high, mn_scale, mx_scale)
    c.b = clip_channel(c.b, l, clip_low, clip_high, mn_scale, mx_scale)

func clip_channel(c0: F8, l: F8, clip_low: M8, clip_high: M8, mn_scale: F8, mx_scale: F8) -> F8:
    var c = c0
    c = f8_blend(clip_low, highp_mad(mn_scale, f8_sub(c, l), l), c)
    c = f8_blend(clip_high, highp_mad(mx_scale, f8_sub(c, l), l), c)
    c = f8_vmax(c, f8_splat(0.0))  # Sometimes without this we may dip just a little negative.
    return c
